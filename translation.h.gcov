        -:  366:    #if !defined(_)
        -:  367:#ifndef wxNO_IMPLICIT_WXSTRING_ENCODING
        -:  368:        #define _(s)                 (s)
        -:  369:#else
        -:  370:        #define _(s)                 wxASCII_STR(s)
