        -:  372:    #endif
        -:  373:    #define wxPLURAL(sing, plur, n)  ((n) == 1 ? (sing) : (plur))
        -:  374:    #define wxGETTEXT_IN_CONTEXT(c, s)                     (s)
        -:  375:    #define wxGETTEXT_IN_CONTEXT_PLURAL(c, sing, plur, n)  wxPLURAL(sing, plur, n)
