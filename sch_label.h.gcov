        -:   36:/*
        -:   37: * Spin style for labels of all kinds on schematics.
        -:   38: *
        -:   39: * Basically a higher level abstraction of rotation and justification of text.
        -:   40: */
        -:   41:class SPIN_STYLE
        -:   42:{
        -:   43:public:
        -:   44:    enum SPIN : int
        -:   45:    {
        -:   46:        LEFT   = 0,
        -:   47:        UP     = 1,
        -:   48:        RIGHT  = 2,
        -:   49:        BOTTOM = 3
        -:   50:    };
        -:   51:
        -:   52:
        -:   53:    SPIN_STYLE() = default;
        -:   54:    constexpr SPIN_STYLE( SPIN aSpin ) : m_spin( aSpin )
        -:   55:    {
        -:   56:    }
        -:   57:
        -:   58:    constexpr bool operator==( SPIN a ) const
        -:   59:    {
        -:   60:        return m_spin == a;
        -:   61:    }
        -:   62:
        -:   63:    constexpr bool operator!=( SPIN a ) const
        -:   64:    {
        -:   65:        return m_spin != a;
        -:   66:    }
        -:   67:
        -:   68:    operator int() const
        -:   69:    {
        -:   70:        return static_cast<int>( m_spin );
        -:   71:    }
        -:   72:
        -:   73:    SPIN_STYLE RotateCCW();
        -:   74:
        -:   75:    /**
        -:   76:     * Mirror the label spin style across the X axis or simply swaps up and bottom.
        -:   77:     */
        -:   78:    SPIN_STYLE MirrorX();
        -:   79:
        -:   80:    /**
        -:   81:     * Mirror the label spin style across the Y axis or simply swaps left and right.
        -:   82:     */
        -:   83:    SPIN_STYLE MirrorY();
        -:   84:
        -:   85:    /**
        -:   86:     * Get CCW rotation needed to get to the given spin style.
        -:   87:     */
        -:   88:    unsigned CCWRotationsTo( const SPIN_STYLE& aOther ) const;
        -:   89:
        -:   90:private:
        -:   91:    SPIN m_spin;
        -:   92:};
