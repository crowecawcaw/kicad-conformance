        -:  509:     */
        -:  510:    static const char* TokenName( PCB_KEYS_T::T aTok );
        -:  511:
        -:  512:    /**
        -:  513:     * Function NextTok
        -:  514:     * returns the next token found in the input file or T_EOF when reaching
        -:  515:     * the end of file.  Users should wrap this function to return an enum
        -:  516:     * to aid in grammar debugging while running under a debugger, but leave
        -:  517:     * this lower level function returning an int (so the enum does not collide
        -:  518:     * with another usage).
        -:  519:     * @return PCB_KEYS_T::T - the type of token found next.
        -:  520:     * @throw IO_ERROR - only if the LINE_READER throws it.
        -:  521:     */
        -:  522:    PCB_KEYS_T::T NextTok()
        -:  523:    {
        -:  524:        return (PCB_KEYS_T::T) DSNLEXER::NextTok();
        -:  525:    }
        -:  526:
        -:  527:    /**
        -:  528:     * Function NeedSYMBOL
        -:  529:     * calls NextTok() and then verifies that the token read in
        -:  530:     * satisfies bool IsSymbol().
        -:  531:     * If not, an IO_ERROR is thrown.
        -:  532:     * @return int - the actual token read in.
        -:  533:     * @throw IO_ERROR, if the next token does not satisfy IsSymbol()
        -:  534:     */
        -:  535:    PCB_KEYS_T::T NeedSYMBOL()
        -:  536:    {
        -:  537:        return (PCB_KEYS_T::T) DSNLEXER::NeedSYMBOL();
        -:  538:    }
        -:  539:
        -:  540:    /**
        -:  541:     * Function NeedSYMBOLorNUMBER
        -:  542:     * calls NextTok() and then verifies that the token read in
        -:  543:     * satisfies bool IsSymbol() or tok==T_NUMBER.
        -:  544:     * If not, an IO_ERROR is thrown.
        -:  545:     * @return int - the actual token read in.
        -:  546:     * @throw IO_ERROR, if the next token does not satisfy the above test
        -:  547:     */
        -:  548:    PCB_KEYS_T::T NeedSYMBOLorNUMBER()
        -:  549:    {
        -:  550:        return (PCB_KEYS_T::T) DSNLEXER::NeedSYMBOLorNUMBER();
        -:  551:    }
        -:  552:
        -:  553:    /**
        -:  554:     * Function CurTok
        -:  555:     * returns whatever NextTok() returned the last time it was called.
        -:  556:     */
        -:  557:    PCB_KEYS_T::T CurTok()
        -:  558:    {
        -:  559:        return (PCB_KEYS_T::T) DSNLEXER::CurTok();
        -:  560:    }
        -:  561:
        -:  562:    /**
        -:  563:     * Function PrevTok
        -:  564:     * returns whatever NextTok() returned the 2nd to last time it was called.
        -:  565:     */
        -:  566:    PCB_KEYS_T::T PrevTok()
        -:  567:    {
        -:  568:        return (PCB_KEYS_T::T) DSNLEXER::PrevTok();
        -:  569:    }
        -:  570:
        -:  571:    /**
        -:  572:     * Function GetCurStrAsToken
        -:  573:     * Used to support 'loose' matches (quoted tokens)
        -:  574:     */
        -:  575:    PCB_KEYS_T::T GetCurStrAsToken()
        -:  576:    {
        -:  577:        return (PCB_KEYS_T::T) DSNLEXER::GetCurStrAsToken();
        -:  578:    }
        -:  579:};
        -:  580:
        -:  581:// example usage
        -:  582:
        -:  583:/**
        -:  584: * Class _PARSER
        -:  585: * holds data and functions pertinent to parsing a S-expression file .
        -:  586: *
        -:  587:class PCB_PARSER : public PCB_LEXER
        -:  588:{
        -:  589:
        -:  590:};
        -:  591:*/
