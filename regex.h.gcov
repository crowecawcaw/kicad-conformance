        -:   24:
        -:   25:// flags for regex compilation: these can be used with Compile()
        -:   26:enum
        -:   27:{
        -:   28:    // use extended regex syntax
        -:   29:    wxRE_EXTENDED = 0,
        -:   30:
        -:   31:    // use advanced RE syntax (deprecated, same as wxRE_EXTENDED now)
        -:   32:    wxRE_ADVANCED = 1,
        -:   33:
        -:   34:    // use basic RE syntax
        -:   35:    wxRE_BASIC    = 2,
        -:   36:
        -:   37:    // ignore case in match
        -:   38:    wxRE_ICASE    = 4,
        -:   39:
        -:   40:    // only check match, don't set back references
        -:   41:    wxRE_NOSUB    = 8,
        -:   42:
        -:   43:    // if not set, treat '\n' as an ordinary character, otherwise it is
        -:   44:    // special: it is not matched by '.' and '^' and '$' always match
        -:   45:    // after/before it regardless of the setting of wxRE_NOT[BE]OL
        -:   46:    wxRE_NEWLINE  = 16,
        -:   47:
        -:   48:    // default flags
        -:   49:    wxRE_DEFAULT  = wxRE_EXTENDED
        -:   50:};
        -:   51:
        -:   52:// flags for regex matching: these can be used with Matches()
        -:   53://
        -:   54:// these flags are mainly useful when doing several matches in a long string,
        -:   55:// they can be used to prevent erroneous matches for '^' and '$'
        -:   56:enum
        -:   57:{
        -:   58:    // '^' doesn't match at the start of line
        -:   59:    wxRE_NOTBOL = 32,
        -:   60:
        -:   61:    // '$' doesn't match at the end of line
        -:   62:    wxRE_NOTEOL = 64,
        -:   63:
        -:   64:    // don't accept empty string as valid match, try alternatives or fail
        -:   65:    wxRE_NOTEMPTY = 128
        -:   66:};
        -:   67:
