        -:  158:/**
        -:  159: * Template to compare two floating point values for equality within a required epsilon.
        -:  160: *
        -:  161: * @param aFirst value to compare.
        -:  162: * @param aSecond value to compare.
        -:  163: * @param aEpsilon allowed error.
        -:  164: * @return true if the values considered equal within the specified epsilon, otherwise false.
        -:  165: */
        -:  166:template <class T>
        -:  167:typename std::enable_if<std::is_floating_point<T>::value, bool>::type
        -:  168:equals( T aFirst, T aSecond, T aEpsilon = std::numeric_limits<T>::epsilon() )
        -:  169:{
        -:  170:    const T diff = std::abs( aFirst - aSecond );
        -:  171:
        -:  172:    if( diff < aEpsilon )
        -:  173:    {
        -:  174:        return true;
        -:  175:    }
        -:  176:
        -:  177:    aFirst = std::abs( aFirst );
        -:  178:    aSecond = std::abs( aSecond );
        -:  179:    T largest = aFirst > aSecond ? aFirst : aSecond;
        -:  180:
        -:  181:    if( diff <= largest * aEpsilon )
        -:  182:    {
        -:  183:        return true;
        -:  184:    }
        -:  185:
        -:  186:    return false;
        -:  187:}
