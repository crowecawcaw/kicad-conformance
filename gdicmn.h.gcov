        -:  282:class WXDLLIMPEXP_CORE wxWARN_UNUSED wxSize
        -:  283:{
        -:  284:public:
        -:  285:    // members are public for compatibility, don't use them directly.
        -:  286:    int x, y;
        -:  287:
        -:  288:    // constructors
        -:  289:    wxSize() : x(0), y(0) { }
    #####:  290:    wxSize(int xx, int yy) : x(xx), y(yy) { }
        -:  291:
        -:  292:    // no copy ctor or assignment operator - the defaults are ok
        -:  293:
        -:  294:    wxSize& operator+=(const wxSize& sz) { x += sz.x; y += sz.y; return *this; }
        -:  295:    wxSize& operator-=(const wxSize& sz) { x -= sz.x; y -= sz.y; return *this; }
        -:  296:    wxSize& operator/=(int i) { x /= i; y /= i; return *this; }
        -:  297:    wxSize& operator*=(int i) { x *= i; y *= i; return *this; }
        -:  298:    wxSize& operator/=(unsigned int i) { x /= i; y /= i; return *this; }
        -:  299:    wxSize& operator*=(unsigned int i) { x *= i; y *= i; return *this; }
        -:  300:    wxSize& operator/=(long i) { x /= i; y /= i; return *this; }
        -:  301:    wxSize& operator*=(long i) { x *= i; y *= i; return *this; }
        -:  302:    wxSize& operator/=(unsigned long i) { x /= i; y /= i; return *this; }
        -:  303:    wxSize& operator*=(unsigned long i) { x *= i; y *= i; return *this; }
        -:  304:    wxSize& operator/=(double i) { x = wxRound(x/i); y = wxRound(y/i); return *this; }
        -:  305:    wxSize& operator*=(double i) { x = wxRound(x*i); y = wxRound(y*i); return *this; }
        -:  306:
        -:  307:    void IncTo(const wxSize& sz)
        -:  308:        { if ( sz.x > x ) x = sz.x; if ( sz.y > y ) y = sz.y; }
        -:  309:    void DecTo(const wxSize& sz)
        -:  310:        { if ( sz.x < x ) x = sz.x; if ( sz.y < y ) y = sz.y; }
        -:  311:    void DecToIfSpecified(const wxSize& sz)
        -:  312:    {
        -:  313:        if ( sz.x != wxDefaultCoord && sz.x < x )
        -:  314:            x = sz.x;
        -:  315:        if ( sz.y != wxDefaultCoord && sz.y < y )
        -:  316:            y = sz.y;
        -:  317:    }
        -:  318:
        -:  319:    void IncBy(int dx, int dy) { x += dx; y += dy; }
        -:  320:    void IncBy(const wxPoint& pt);
        -:  321:    void IncBy(const wxSize& sz) { IncBy(sz.x, sz.y); }
        -:  322:    void IncBy(int d) { IncBy(d, d); }
        -:  323:
        -:  324:    void DecBy(int dx, int dy) { IncBy(-dx, -dy); }
        -:  325:    void DecBy(const wxPoint& pt);
        -:  326:    void DecBy(const wxSize& sz) { DecBy(sz.x, sz.y); }
        -:  327:    void DecBy(int d) { DecBy(d, d); }
        -:  328:
        -:  329:
        -:  330:    wxSize& Scale(double xscale, double yscale)
        -:  331:        { x = wxRound(x*xscale); y = wxRound(y*yscale); return *this; }
        -:  332:
        -:  333:    // accessors
        -:  334:    void Set(int xx, int yy) { x = xx; y = yy; }
        -:  335:    void SetWidth(int w) { x = w; }
        -:  336:    void SetHeight(int h) { y = h; }
        -:  337:
        -:  338:    int GetWidth() const { return x; }
        -:  339:    int GetHeight() const { return y; }
        -:  340:
        -:  341:    bool IsFullySpecified() const { return x != wxDefaultCoord && y != wxDefaultCoord; }
        -:  342:
        -:  343:    // combine this size with the other one replacing the default (i.e. equal
        -:  344:    // to wxDefaultCoord) components of this object with those of the other
        -:  345:    void SetDefaults(const wxSize& size)
        -:  346:    {
        -:  347:        if ( x == wxDefaultCoord )
        -:  348:            x = size.x;
        -:  349:        if ( y == wxDefaultCoord )
        -:  350:            y = size.y;
        -:  351:    }
        -:  352:
        -:  353:    // compatibility
        -:  354:    int GetX() const { return x; }
        -:  355:    int GetY() const { return y; }
        -:  356:};
        -:  357:
        -:  358:inline bool operator==(const wxSize& s1, const wxSize& s2)
        -:  359:{
        -:  360:    return s1.x == s2.x && s1.y == s2.y;
