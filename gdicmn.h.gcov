        -:  185:
        -:  186:// The difference between wxHAS_IMAGES_IN_RESOURCES and wxHAS_IMAGE_RESOURCES
        -:  187:// is that the former is, historically, only defined under MSW while the latter
        -:  188:// is also defined under macOS, which uses a different resource concept, and
        -:  189:// may be also defined for any other ports where images don't need to be
        -:  190:// embedded into the program text in order to be available during run-time.
        -:  191:#if defined(__WINDOWS__) && wxUSE_WXDIB
        -:  192:    #define wxHAS_IMAGES_IN_RESOURCES
        -:  193:#endif
        -:  194:
        -:  195:#if defined(wxHAS_IMAGES_IN_RESOURCES) || defined(__WXOSX__)
        -:  196:    #define wxHAS_IMAGE_RESOURCES
        -:  197:#endif
        -:  198:
        -:  199:/* Useful macro for creating icons portably, for example:
        -:  200:
        -:  201:    wxIcon *icon = new wxICON(sample);
        -:  202:
        -:  203:  expands into:
        -:  204:
        -:  205:    wxIcon *icon = new wxIcon("sample");      // On Windows
        -:  206:    wxIcon *icon = new wxIcon(sample_xpm);    // On wxGTK/Linux
        -:  207: */
        -:  208:
        -:  209:#ifdef wxHAS_IMAGES_IN_RESOURCES
        -:  210:    // Load from a resource
        -:  211:    #define wxICON(X) wxIcon(wxT(#X))
        -:  212:#elif defined(__WXDFB__)
        -:  213:    // Initialize from an included XPM
        -:  214:    #define wxICON(X) wxIcon( X##_xpm )
        -:  215:#elif defined(__WXGTK__)
        -:  216:    // Initialize from an included XPM
        -:  217:    #define wxICON(X) wxIcon( X##_xpm )
        -:  218:#elif defined(__WXMAC__)
        -:  219:    // Initialize from an included XPM
        -:  220:    #define wxICON(X) wxIcon( X##_xpm )
        -:  221:#elif defined(__WXMOTIF__)
        -:  222:    // Initialize from an included XPM
        -:  223:    #define wxICON(X) wxIcon( X##_xpm )
        -:  224:#elif defined(__WXX11__)
        -:  225:    // Initialize from an included XPM
        -:  226:    #define wxICON(X) wxIcon( X##_xpm )
        -:  227:#elif defined(__WXQT__)
        -:  228:    // Initialize from an included XPM
        -:  229:    #define wxICON(X) wxIcon( X##_xpm )
        -:  230:#else
        -:  231:    // This will usually mean something on any platform
        -:  232:    #define wxICON(X) wxIcon(wxT(#X))
        -:  233:#endif // platform
        -:  234:
        -:  235:/* Another macro: this one is for portable creation of bitmaps. We assume that
        -:  236:   under Unix bitmaps live in XPMs and under Windows they're in resources.
        -:  237: */
        -:  238:
        -:  239:#if defined(__WINDOWS__) && wxUSE_WXDIB
        -:  240:    #define wxBITMAP(name) wxBitmap(wxT(#name), wxBITMAP_TYPE_BMP_RESOURCE)
        -:  241:#elif defined(__WXGTK__)   || \
        -:  242:      defined(__WXMOTIF__) || \
        -:  243:      defined(__WXX11__)   || \
        -:  244:      defined(__WXMAC__)   || \
        -:  245:      defined(__WXDFB__)
        -:  246:    // Initialize from an included XPM
        -:  247:    #define wxBITMAP(name) wxBitmap(name##_xpm)
        -:  248:#else // other platforms
        -:  249:    #define wxBITMAP(name) wxBitmap(name##_xpm, wxBITMAP_TYPE_XPM)
        -:  250:#endif // platform
        -:  251:
        -:  252:// Macro for creating wxBitmap from in-memory PNG data.
        -:  253://
        -:  254:// It reads PNG data from name_png static byte arrays that can be created using
        -:  255:// e.g. misc/scripts/png2c.py.
        -:  256://
        -:  257:// This macro exists mostly as a helper for wxBITMAP_PNG() below but also
        -:  258:// because it's slightly more convenient to use than NewFromPNGData() directly.
        -:  259:#define wxBITMAP_PNG_FROM_DATA(name) \
        -:  260:    wxBitmap::NewFromPNGData(name##_png, WXSIZEOF(name##_png))
        -:  261:
        -:  262:// Similar to wxBITMAP but used for the bitmaps in PNG format.
        -:  263://
        -:  264:// Under Windows they should be embedded into the resource file using RT_RCDATA
        -:  265:// resource type and under OS X the PNG file with the specified name must be
        -:  266:// available in the resource subdirectory of the bundle. Elsewhere, this is
        -:  267:// exactly the same thing as wxBITMAP_PNG_FROM_DATA() described above.
        -:  268:#ifdef wxHAS_IMAGE_RESOURCES
        -:  269:    #define wxBITMAP_PNG(name) wxBitmap(wxS(#name), wxBITMAP_TYPE_PNG_RESOURCE)
        -:  270:#else
        -:  271:    #define wxBITMAP_PNG(name) wxBITMAP_PNG_FROM_DATA(name)
        -:  272:#endif
        -:  273:
