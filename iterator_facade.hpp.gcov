        -:  182:        {
        -:  183:            return boost::addressof(stored_value);
        -:  184:        }
        -:  185:
        -:  186:     private:
        -:  187:        Iterator stored_iterator;
        -:  188:        mutable value_type stored_value;
        -:  189:    };
