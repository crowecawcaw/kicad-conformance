        -:   50:/**
        -:   51: * A base class that #BOARD loading and saving plugins should derive from.
        -:   52: *
        -:   53: * Implementations can provide either Load() or Save() functions, or both. PCB_IOs throw
        -:   54: * exceptions, so it is best that you wrap your calls to these functions in a try catch block.
        -:   55: * Plugins throw exceptions because it is illegal for them to have any user interface calls in
        -:   56: * them whatsoever, i.e. no windowing or screen printing at all.
        -:   57: *
        -:   58: *The compiler writes the "zero argument" constructor for a PCB_IO automatically if you do
        -:   59: * not provide one.  If you decide you need to provide a zero argument constructor of your
        -:   60: * own design, that is allowed.  It must be public, and it is what the #PCB_IO_MGR uses.  Parameters
        -:   61: * may be passed into a PCB_IO via the #PROPERTIES variable for any of the public API functions
        -:   62: * which take one.
        -:   63: *
        -:   64: *
        -:   65: * <pre>
        -:   66: *   try
        -:   67: *   {
        -:   68: *        PCB_IO_MGR::Load(...);
        -:   69: *   or
        -:   70: *        PCB_IO_MGR::Save(...);
        -:   71: *   }
        -:   72: *   catch( const IO_ERROR& ioe )
        -:   73: *   {
        -:   74: *        // grab text from ioe, show in error window.
        -:   75: *   }
        -:   76: * </pre>
        -:   77: */
        -:   78:class PCB_IO : public IO_BASE
        -:   79:{
        -:   80:public:
        -:   81:    /**
        -:   82:     * Returns board file description for the PCB_IO.
        -:   83:     */
        -:   84:    virtual const IO_BASE::IO_FILE_DESC GetBoardFileDesc() const
        -:   85:    {
        -:   86:        return IO_BASE::IO_FILE_DESC( wxEmptyString, {} );
        -:   87:    }
        -:   88:
        -:   89:    /**
        -:   90:     * Work-around for lack of dynamic_cast across compile units on Mac
        -:   91:     */
    #####:   92:    bool IsPCB_IO() const override { return true; }
