        -:  261:    /**
        -:  262:     * Check for the existence of a footprint.
        -:  263:     */
        -:  264:    virtual bool FootprintExists( const wxString& aLibraryPath, const wxString& aFootprintName,
        -:  265:                                  const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  266:
        -:  267:    /**
        -:  268:     * Write @a aFootprint to an existing library located at @a aLibraryPath.
        -:  269:     * If a footprint by the same name already exists, it is replaced.
        -:  270:     *
        -:  271:     * @param aLibraryPath is a locator for the "library", usually a directory, file, or URL
        -:  272:     *                      containing several footprints.
        -:  273:     * @param aFootprint is what to store in the library. The caller continues to own the
        -:  274:     *                   footprint after this call.
        -:  275:     * @param aProperties is an associative array that can be used to tell the saver how to
        -:  276:     *                    save the footprint, because it can take any number of additional
        -:  277:     *                    named tuning arguments that the plugin is known to support.  The
        -:  278:     *                    caller continues to own this object (plugin may not delete it), and
        -:  279:     *                    plugins should expect it to be optionally NULL.
        -:  280:     *
        -:  281:     * @throw IO_ERROR if there is a problem saving.
        -:  282:     */
        -:  283:    virtual void FootprintSave( const wxString& aLibraryPath, const FOOTPRINT* aFootprint,
        -:  284:                                const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  285:
        -:  286:    /**
        -:  287:     * Delete @a aFootprintName from the library at @a aLibraryPath.
        -:  288:     *
        -:  289:     * @param aLibraryPath is a locator for the "library", usually a directory, file, or URL
        -:  290:     *                     containing several footprints.
