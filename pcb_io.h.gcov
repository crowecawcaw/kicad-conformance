        -:  311:    virtual void ClearCachedFootprints( const wxString& aLibraryPath ) {}
        -:  312:
        -:  313:    /**
        -:  314:     * Append supported PLUGIN options to @a aListToAppenTo along with internationalized
        -:  315:     * descriptions.
        -:  316:     *
        -:  317:     * Options are typically appended so that a derived #PLUGIN can call its base class
        -:  318:     * function by the same name first, thus inheriting options declared there.  Some base
        -:  319:     * class options could pertain to all Footprint*() functions in all derived PLUGINs.
        -:  320:     *
        -:  321:     * @note Since aListToAppendTo is a #PROPERTIES object, all options will be unique and
        -:  322:     *       last guy wins.
        -:  323:     *
        -:  324:     * @param aListToAppendTo holds a tuple of
        -:  325:     * <dl>
        -:  326:     *  <dt>option</dt>
        -:  327:     *  <dd>This eventually is what shows up into the fp-lib-table "options"
        -:  328:     *      field, possibly combined with others.</dd>
        -:  329:     *  <dt>internationalized description</dt>
        -:  330:     *  <dd>The internationalized description is displayed in DIALOG_PLUGIN_OPTIONS.
        -:  331:     *      It may be multi-line and be quite explanatory of the option.</dd>
        -:  332:     * </dl>
        -:  333:     * <br>
        -:  334:     *  In the future perhaps @a aListToAppendTo evolves to something capable of also
        -:  335:     *  holding a wxValidator for the cells in said dialog:
        -:  336:     *  http://forums.wxwidgets.org/viewtopic.php?t=23277&p=104180.
        -:  337:     *  This would require a 3 column list, and introducing wx GUI knowledge to
        -:  338:     * PLUGIN, which has been avoided to date.
        -:  339:     */
        -:  340:    virtual void GetLibraryOptions( std::map<std::string, UTF8>* aListToAppendTo ) const override;
