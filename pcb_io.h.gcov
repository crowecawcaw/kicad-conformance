        -:  109:    virtual void SetQueryUserCallback( std::function<bool( wxString aTitle, int aIcon,
        -:  110:                                                           wxString aMessage,
        -:  111:                                                           wxString aAction )> aCallback )
        -:  112:    { }
        -:  113:
        -:  114:    /**
        -:  115:     * Load information from some input file format that this PCB_IO implementation
        -:  116:     * knows about into either a new #BOARD or an existing one.
        -:  117:     *
        -:  118:     * This may be used to load an entire new #BOARD, or to augment an existing one if
        -:  119:     * @a aAppendToMe is not NULL.
        -:  120:     *
        -:  121:     * @param aFileName is the name of the file to use as input and may be foreign in
        -:  122:     *                  nature or native in nature.
        -:  123:     * @param aAppendToMe is an existing BOARD to append to, but if NULL then this means
        -:  124:     *                    "do not append, rather load anew".
        -:  125:     * @param aProperties is an associative array that can be used to tell the loader how to
        -:  126:     *                    load the file, because it can take any number of additional named
        -:  127:     *                    arguments that the plugin is known to support. These are tuning
        -:  128:     *                    parameters for the import or load.  The caller continues to own
        -:  129:     *                    this object (plugin may not delete it), and plugins should expect
        -:  130:     *                    it to be optionally NULL.
        -:  131:     * @param aProject is the optional #PROJECT object primarily used by third party
        -:  132:     *                 importers.
        -:  133:     * @return the successfully loaded board, or the same one as \a aAppendToMe if aAppendToMe
        -:  134:     *         was not NULL, and caller owns it.
        -:  135:     *
        -:  136:     * @throw IO_ERROR if there is a problem loading, and its contents should say what went
        -:  137:     *                 wrong, using line number and character offsets of the input file if
        -:  138:     *                 possible.
        -:  139:     */
        -:  140:    virtual BOARD* LoadBoard( const wxString& aFileName, BOARD* aAppendToMe,
        -:  141:                              const std::map<std::string, UTF8>* aProperties = nullptr,
        -:  142:                              PROJECT* aProject = nullptr );
        -:  143:
        -:  144:    /**
        -:  145:     * Return a container with the cached library footprints generated in the last call to
        -:  146:     * #Load. This function is intended to be used ONLY by the non-KiCad board importers for the
        -:  147:     * purpose of obtaining the footprint library of the design and creating a project-specific
        -:  148:     * library.
        -:  149:     *
        -:  150:     * @return Footprints (caller owns the objects)
        -:  151:     */
        -:  152:    virtual std::vector<FOOTPRINT*> GetImportedCachedLibraryFootprints();
        -:  153:
        -:  154:    /**
        -:  155:     * Write @a aBoard to a storage file in a format that this PCB_IO implementation knows
        -:  156:     * about or it can be used to write a portion of \a aBoard to a special kind of export
        -:  157:     * file.
        -:  158:     *
        -:  159:     * @param aFileName is the name of a file to save to on disk.
        -:  160:     * @param aBoard is the class #BOARD in memory document tree from which to extract
        -:  161:     *               information when writing to \a aFileName.  The caller continues to
        -:  162:     *               own the BOARD, and the plugin should refrain from modifying the BOARD
        -:  163:     *               if possible.
        -:  164:     * @param aProperties is an associative array that can be used to tell the saver how to
        -:  165:     *                    save the file, because it can take any number of additional named
        -:  166:     *                    tuning arguments that the plugin is known to support.  The caller
        -:  167:     *                    continues to own this object (plugin may not delete it) and plugins
        -:  168:     *                    should expect it to be optionally NULL.
        -:  169:     *
        -:  170:     * @throw IO_ERROR if there is a problem saving or exporting.
        -:  171:     */
        -:  172:    virtual void SaveBoard( const wxString& aFileName, BOARD* aBoard,
        -:  173:                            const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  174:
        -:  175:    /**
        -:  176:     * Return a list of footprint names contained within the library at @a aLibraryPath.
        -:  177:     *
        -:  178:     * @param aLibraryPath is a locator for the "library", usually a directory, file,
        -:  179:     *                     or URL containing several footprints.
        -:  180:     * @param aProperties is an associative array that can be used to tell the plugin
        -:  181:     *                    anything needed about how to perform with respect to @a aLibraryPath.
        -:  182:     *                    The caller continues to own this object (plugin may not delete it),
        -:  183:     *                    and plugins should expect it to be optionally NULL.
        -:  184:     * @param aFootprintNames is the array of available footprint names inside a library.
        -:  185:     * @param aBestEfforts if true, don't throw on errors, just return an empty list.
        -:  186:     *
        -:  187:     * @throw IO_ERROR if the library cannot be found, or footprint cannot be loaded.
        -:  188:     */
        -:  189:    virtual void FootprintEnumerate( wxArrayString& aFootprintNames, const wxString& aLibraryPath,
        -:  190:                                     bool aBestEfforts,
        -:  191:                                     const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  192:
        -:  193:    /**
        -:  194:     * Generate a timestamp representing all the files in the library (including the library
        -:  195:     * directory).
        -:  196:     *
        -:  197:     * Timestamps should not be considered ordered, they either match or they don't.
        -:  198:     */
        -:  199:    virtual long long GetLibraryTimestamp( const wxString& aLibraryPath ) const = 0;
        -:  200:
        -:  201:    /**
        -:  202:     * Load a single footprint from @a aFootprintPath and put its name in @a aFootprintNameOut.
        -:  203:     * If this is a footprint library, the first footprint should be loaded.
        -:  204:     * The default implementation uses FootprintEnumerate and FootprintLoad to load first footprint.
        -:  205:     *
        -:  206:     * @param aLibraryPath is a path of the footprint file.
        -:  207:     * @param aFootprintNameOut is the name output of the loaded footprint.
        -:  208:     * @param aProperties is an associative array that can be used to tell the loader
        -:  209:     *                    implementation to do something special, because it can take
        -:  210:     *                    any number of  additional named tuning arguments that the plugin
        -:  211:     *                    is known to support.  The caller continues to own this object
        -:  212:     *                    (plugin may not delete it), and plugins should expect it to be
        -:  213:     *                    optionally NULL.
        -:  214:     * @return the #FOOTPRINT object if found, caller owns it, else NULL if not found.
        -:  215:     *
        -:  216:     * @throw   IO_ERROR if the footprint cannot be found or read.
        -:  217:     */
        -:  218:    virtual FOOTPRINT* ImportFootprint( const wxString& aFootprintPath, wxString& aFootprintNameOut,
        -:  219:                                        const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  220:
        -:  221:    /**
        -:  222:     * Load a footprint having @a aFootprintName from the @a aLibraryPath containing a library
        -:  223:     * format that this PCB_IO knows about.
        -:  224:     *
        -:  225:     * @param aLibraryPath is a locator for the "library", usually a directory, file, or URL
        -:  226:     *                     containing several footprints.
        -:  227:     * @param aFootprintName is the name of the footprint to load.
        -:  228:     * @param aProperties is an associative array that can be used to tell the loader
        -:  229:     *                    implementation to do something special, because it can take
        -:  230:     *                    any number of  additional named tuning arguments that the plugin
        -:  231:     *                    is known to support.  The caller continues to own this object
        -:  232:     *                    (plugin may not delete it), and plugins should expect it to be
        -:  233:     *                    optionally NULL.
        -:  234:     * @param aKeepUUID = true to keep initial items UUID, false to set new UUID
        -:  235:     *                   normally true if loaded in the footprint editor, false
        -:  236:     *                   if loaded in the board editor. Make sense only in kicad_plugin
        -:  237:     * @return the #FOOTPRINT object if found, caller owns it, else NULL if not found.
        -:  238:     *
        -:  239:     * @throw   IO_ERROR if the library cannot be found or read.  No exception is thrown in
        -:  240:     *                   the case where \a aFootprintName cannot be found.
        -:  241:     */
        -:  242:    virtual FOOTPRINT* FootprintLoad( const wxString& aLibraryPath, const wxString& aFootprintName,
        -:  243:                                      bool  aKeepUUID = false,
        -:  244:                                      const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  245:
        -:  246:    /**
        -:  247:     * A version of FootprintLoad() for use after FootprintEnumerate() for more efficient
        -:  248:     * cache management.
        -:  249:     */
        -:  250:    virtual const FOOTPRINT* GetEnumeratedFootprint( const wxString& aLibraryPath, const wxString& aFootprintName,
        -:  251:                                                     const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  252:
        -:  253:    /**
        -:  254:     * Return true if GetEnumeratedFootprint() returns a borrowed pointer from an internal cache.
        -:  255:     *
        -:  256:     * When true, the caller must NOT delete the returned pointer. When false (the default),
        -:  257:     * GetEnumeratedFootprint() allocates a new FOOTPRINT and the caller owns the memory.
        -:  258:     */
        -:  259:    virtual bool CachesEnumeratedFootprints() const { return false; }
