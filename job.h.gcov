        -:  214:    void ClearExistingOutputs()                 { m_outputs.clear(); }
        -:  215:    const std::vector<JOB_OUTPUT>& GetOutputs() { return m_outputs; }
        -:  216:    void AddOutput( wxString aOutputPath )      { m_outputs.emplace_back( aOutputPath ); }
        -:  217:
        -:  218:    /**
        -:  219:     * Sets the temporary output directory for the job, this is used to prefix with a given
        -:  220:     * output path when GetFullOutputPath is called. This is intended for use with running jobsets
        -:  221:     * and otherwise has no impact on individual job runs outside jobsets.
        -:  222:     */
        -:  223:    void SetTempOutputDirectory( const wxString& aBase );
        -:  224:
        -:  225:    /**
        -:  226:     * Sets the configured output path for the job, this path is always saved to file.
        -:  227:     * Any transient working output path is cleared so the new configured path takes precedence
        -:  228:     * on the next call to GetFullOutputPath().
        -:  229:     */
        -:  230:    void SetConfiguredOutputPath( const wxString& aPath );
        -:  231:
        -:  232:    /**
        -:  233:     * Returns the configured output path for the job
