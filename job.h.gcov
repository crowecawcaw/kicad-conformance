        -:  235:    wxString GetConfiguredOutputPath() const { return m_outputPath; }
        -:  236:
        -:  237:    /**
        -:  238:     * Sets a transient output path for the job, it takes priority over the configured output path
        -:  239:     * when GetFullOutputPath is called.
        -:  240:     */
        -:  241:    void     SetWorkingOutputPath( const wxString& aPath ) { m_workingOutputPath = aPath; }
        -:  242:
        -:  243:    /**
        -:  244:     * Returns the working output path for the job, if one has been set
        -:  245:     */
        -:  246:    wxString GetWorkingOutputPath() const { return m_workingOutputPath; }
        -:  247:
        -:  248:    /**
        -:  249:     * Returns the full output path for the job, taking into account the configured output path,
        -:  250:     * any configured working path and the temporary output directory.
        -:  251:     *
        -:  252:     * Additionally variable resolution will take place
        -:  253:     */
        -:  254:    wxString GetFullOutputPath( PROJECT* aProject ) const;
        -:  255:
        -:  256:    wxString ResolveOutputPath( const wxString& aPath, bool aPathIsDirectory, PROJECT* aProject ) const;
        -:  257:
        -:  258:    bool GetOutputPathIsDirectory() const { return m_outputPathIsDirectory; }
        -:  259:
        -:  260:protected:
        -:  261:    std::string                  m_type;
        -:  262:    std::map<wxString, wxString> m_varOverrides;
        -:  263:    TITLE_BLOCK                  m_titleBlock;
        -:  264:
