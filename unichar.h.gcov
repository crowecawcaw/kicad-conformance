        -:   27:// This class represents single Unicode character. It can be converted to
        -:   28:// and from char or wchar_t and implements commonly used character operations.
        -:   29:class WXDLLIMPEXP_BASE wxUniChar
        -:   30:{
        -:   31:public:
        -:   32:    // NB: this is not wchar_t on purpose, it needs to represent the entire
        -:   33:    //     Unicode code points range and wchar_t may be too small for that
        -:   34:    //     (e.g. on Win32 where wchar_t* is encoded in UTF-16)
        -:   35:    typedef wxUint32 value_type;
        -:   36:
        -:   37:    wxUniChar() : m_value(0) {}
        -:   38:
        -:   39:    // Create the character from 8bit character value encoded in the current
        -:   40:    // locale's charset.
    #####:   41:    wxUniChar(char c) { m_value = From8bit(c); }
        -:   42:    wxUniChar(unsigned char c) { m_value = From8bit((char)c); }
        -:   43:
        -:   44:#define wxUNICHAR_DEFINE_CTOR(type) \
        -:   45:    wxUniChar(type c) { m_value = (value_type)c; }
        -:   46:    wxDO_FOR_INT_TYPES(wxUNICHAR_DEFINE_CTOR)
        -:   47:#undef wxUNICHAR_DEFINE_CTOR
        -:   48:
        -:   49:    wxUniChar(const wxUniCharRef& c);
        -:   50:
        -:   51:    // Returns Unicode code point value of the character
        -:   52:    value_type GetValue() const { return m_value; }
        -:   53:
        -:   54:#if wxUSE_UNICODE_UTF8
        -:   55:    // buffer for single UTF-8 character
        -:   56:    struct Utf8CharBuffer
        -:   57:    {
        -:   58:        char data[5];
        -:   59:        operator const char*() const { return data; }
        -:   60:    };
        -:   61:
        -:   62:    // returns the character encoded as UTF-8
        -:   63:    // (NB: implemented in stringops.cpp)
        -:   64:    Utf8CharBuffer AsUTF8() const;
        -:   65:#endif // wxUSE_UNICODE_UTF8
        -:   66:
        -:   67:    // Returns true if the character is an ASCII character:
        -:   68:    bool IsAscii() const { return m_value < 0x80; }
        -:   69:
        -:   70:    // Returns true if the character is representable as a single byte in the
        -:   71:    // current locale encoding and return this byte in output argument c (which
        -:   72:    // must be non-NULL)
        -:   73:    bool GetAsChar(char *c) const
        -:   74:    {
        -:   75:#if wxUSE_UNICODE
        -:   76:        if ( !IsAscii() )
        -:   77:        {
        -:   78:#if !wxUSE_UTF8_LOCALE_ONLY
        -:   79:            if ( GetAsHi8bit(m_value, c) )
        -:   80:                return true;
        -:   81:#endif // !wxUSE_UTF8_LOCALE_ONLY
        -:   82:
        -:   83:            return false;
        -:   84:        }
        -:   85:#endif // wxUSE_UNICODE
        -:   86:
        -:   87:        *c = wx_truncate_cast(char, m_value);
        -:   88:        return true;
        -:   89:    }
        -:   90:
        -:   91:    // Returns true if the character is a BMP character:
        -:   92:    static bool IsBMP(wxUint32 value) { return value < 0x10000; }
        -:   93:
        -:   94:    // Returns true if the character is a supplementary character:
        -:   95:    static bool IsSupplementary(wxUint32 value) { return 0x10000 <= value && value < 0x110000; }
        -:   96:
        -:   97:    // Returns the high surrogate code unit for the supplementary character
        -:   98:    static wxUint16 HighSurrogate(wxUint32 value)
        -:   99:    {
        -:  100:        wxASSERT_MSG(IsSupplementary(value), "wxUniChar::HighSurrogate() must be called on a supplementary character");
        -:  101:        return static_cast<wxUint16>(0xD800 | ((value - 0x10000) >> 10));
        -:  102:    }
        -:  103:
        -:  104:    // Returns the low surrogate code unit for the supplementary character
        -:  105:    static wxUint16 LowSurrogate(wxUint32 value)
        -:  106:    {
        -:  107:        wxASSERT_MSG(IsSupplementary(value), "wxUniChar::LowSurrogate() must be called on a supplementary character");
        -:  108:        return static_cast<wxUint16>(0xDC00 | ((value - 0x10000) & 0x03FF));
        -:  109:    }
        -:  110:
        -:  111:    // Returns true if the character is a BMP character:
        -:  112:    bool IsBMP() const { return IsBMP(m_value); }
        -:  113:
        -:  114:    // Returns true if the character is a supplementary character:
        -:  115:    bool IsSupplementary() const { return IsSupplementary(m_value); }
        -:  116:
        -:  117:    // Returns the high surrogate code unit for the supplementary character
        -:  118:    wxUint16 HighSurrogate() const { return HighSurrogate(m_value); }
        -:  119:
        -:  120:    // Returns the low surrogate code unit for the supplementary character
        -:  121:    wxUint16 LowSurrogate() const { return LowSurrogate(m_value); }
        -:  122:
        -:  123:    // Conversions to char and wchar_t types: all of those are needed to be
        -:  124:    // able to pass wxUniChars to various standard narrow and wide character
        -:  125:    // functions
        -:  126:    operator char() const { return To8bit(m_value); }
        -:  127:    operator unsigned char() const { return (unsigned char)To8bit(m_value); }
        -:  128:
        -:  129:#define wxUNICHAR_DEFINE_OPERATOR_PAREN(type) \
        -:  130:    operator type() const { return (type)m_value; }
        -:  131:    wxDO_FOR_INT_TYPES(wxUNICHAR_DEFINE_OPERATOR_PAREN)
        -:  132:#undef wxUNICHAR_DEFINE_OPERATOR_PAREN
        -:  133:
        -:  134:    // We need this operator for the "*p" part of expressions like "for (
        -:  135:    // const_iterator p = begin() + nStart; *p; ++p )". In this case,
        -:  136:    // compilation would fail without it because the conversion to bool would
        -:  137:    // be ambiguous (there are all these int types conversions...). (And adding
        -:  138:    // operator unspecified_bool_type() would only makes the ambiguity worse.)
        -:  139:    operator bool() const { return m_value != 0; }
        -:  140:    bool operator!() const { return !((bool)*this); }
        -:  141:
        -:  142:    // And this one is needed by some (not all, but not using ifdefs makes the
        -:  143:    // code easier) compilers to parse "str[0] && *p" successfully
        -:  144:    bool operator&&(bool v) const { return (bool)*this && v; }
        -:  145:
        -:  146:    // Assignment operators:
        -:  147:    wxUniChar& operator=(const wxUniCharRef& c);
        -:  148:    wxUniChar& operator=(char c) { m_value = From8bit(c); return *this; }
        -:  149:    wxUniChar& operator=(unsigned char c) { m_value = From8bit((char)c); return *this; }
        -:  150:
        -:  151:#define wxUNICHAR_DEFINE_OPERATOR_EQUAL(type) \
        -:  152:    wxUniChar& operator=(type c) { m_value = (value_type)c; return *this; }
        -:  153:    wxDO_FOR_INT_TYPES(wxUNICHAR_DEFINE_OPERATOR_EQUAL)
        -:  154:#undef wxUNICHAR_DEFINE_OPERATOR_EQUAL
        -:  155:
        -:  156:    // Comparison operators:
        -:  157:#define wxDEFINE_UNICHAR_CMP_WITH_INT(T, op) \
        -:  158:    bool operator op(T c) const { return m_value op (value_type)c; }
        -:  159:
        -:  160:    // define the given comparison operator for all the types
        -:  161:#define wxDEFINE_UNICHAR_OPERATOR(op)                                         \
        -:  162:    bool operator op(const wxUniChar& c) const { return m_value op c.m_value; }\
        -:  163:    bool operator op(char c) const { return m_value op From8bit(c); }         \
        -:  164:    bool operator op(unsigned char c) const { return m_value op From8bit((char)c); } \
        -:  165:    wxDO_FOR_INT_TYPES_1(wxDEFINE_UNICHAR_CMP_WITH_INT, op)
        -:  166:
        -:  167:    wxFOR_ALL_COMPARISONS(wxDEFINE_UNICHAR_OPERATOR)
        -:  168:
        -:  169:#undef wxDEFINE_UNICHAR_OPERATOR
        -:  170:#undef wxDEFINE_UNICHAR_CMP_WITH_INT
        -:  171:
        -:  172:    // this is needed for expressions like 'Z'-c
        -:  173:    int operator-(const wxUniChar& c) const { return m_value - c.m_value; }
        -:  174:    int operator-(char c) const { return m_value - From8bit(c); }
        -:  175:    int operator-(unsigned char c) const { return m_value - From8bit((char)c); }
        -:  176:    int operator-(wchar_t c) const { return m_value - (value_type)c; }
        -:  177:
        -:  178:
        -:  179:private:
        -:  180:    // notice that we implement these functions inline for 7-bit ASCII
        -:  181:    // characters purely for performance reasons
    #####:  182:    static value_type From8bit(char c)
        -:  183:    {
        -:  184:#if wxUSE_UNICODE
    #####:  185:        if ( (unsigned char)c < 0x80 )
    #####:  186:            return c;
        -:  187:
    #####:  188:        return FromHi8bit(c);
        -:  189:#else
        -:  190:        return c;
        -:  191:#endif
        -:  192:    }
        -:  193:
        -:  194:    static char To8bit(value_type c)
        -:  195:    {
        -:  196:#if wxUSE_UNICODE
        -:  197:        if ( c < 0x80 )
        -:  198:            return wx_truncate_cast(char, c);
        -:  199:
        -:  200:        return ToHi8bit(c);
        -:  201:#else
        -:  202:        return wx_truncate_cast(char, c);
        -:  203:#endif
        -:  204:    }
        -:  205:
        -:  206:    // helpers of the functions above called to deal with non-ASCII chars
        -:  207:    static value_type FromHi8bit(char c);
        -:  208:    static char ToHi8bit(value_type v);
        -:  209:    static bool GetAsHi8bit(value_type v, char *c);
        -:  210:
        -:  211:private:
        -:  212:    value_type m_value;
        -:  213:};
        -:  214:
        -:  215:
        -:  216:// Writeable reference to a character in wxString.
        -:  217://
        -:  218:// This class can be used in the same way wxChar is used, except that changing
        -:  219:// its value updates the underlying string object.
        -:  220:class WXDLLIMPEXP_BASE wxUniCharRef
        -:  221:{
        -:  222:private:
        -:  223:    typedef wxStringImpl::iterator iterator;
        -:  224:
        -:  225:    // create the reference
        -:  226:#if wxUSE_UNICODE_UTF8
        -:  227:    wxUniCharRef(wxString& str, iterator pos) : m_str(str), m_pos(pos) {}
        -:  228:#else
        -:  229:    wxUniCharRef(iterator pos) : m_pos(pos) {}
        -:  230:#endif
        -:  231:
        -:  232:public:
        -:  233:    // NB: we have to make this public, because we don't have wxString
        -:  234:    //     declaration available here and so can't declare wxString::iterator
        -:  235:    //     as friend; so at least don't use a ctor but a static function
        -:  236:    //     that must be used explicitly (this is more than using 'explicit'
        -:  237:    //     keyword on ctor!):
        -:  238:#if wxUSE_UNICODE_UTF8
        -:  239:    static wxUniCharRef CreateForString(wxString& str, iterator pos)
        -:  240:        { return wxUniCharRef(str, pos); }
        -:  241:#else
        -:  242:    static wxUniCharRef CreateForString(iterator pos)
        -:  243:        { return wxUniCharRef(pos); }
        -:  244:#endif
        -:  245:
        -:  246:    wxUniChar::value_type GetValue() const { return UniChar().GetValue(); }
        -:  247:
        -:  248:#if wxUSE_UNICODE_UTF8
        -:  249:    wxUniChar::Utf8CharBuffer AsUTF8() const { return UniChar().AsUTF8(); }
        -:  250:#endif // wxUSE_UNICODE_UTF8
        -:  251:
        -:  252:    bool IsAscii() const { return UniChar().IsAscii(); }
        -:  253:    bool GetAsChar(char *c) const { return UniChar().GetAsChar(c); }
        -:  254:
        -:  255:    bool IsBMP() const { return UniChar().IsBMP(); }
        -:  256:    bool IsSupplementary() const { return UniChar().IsSupplementary(); }
        -:  257:    wxUint16 HighSurrogate() const { return UniChar().HighSurrogate(); }
        -:  258:    wxUint16 LowSurrogate() const { return UniChar().LowSurrogate(); }
        -:  259:
        -:  260:    // Assignment operators:
        -:  261:#if wxUSE_UNICODE_UTF8
        -:  262:    wxUniCharRef& operator=(const wxUniChar& c);
        -:  263:#else
        -:  264:    wxUniCharRef& operator=(const wxUniChar& c) { *m_pos = c; return *this; }
        -:  265:#endif
        -:  266:
        -:  267:    wxUniCharRef& operator=(const wxUniCharRef& c)
        -:  268:        { if (&c != this) *this = c.UniChar(); return *this; }
        -:  269:
        -:  270:#ifdef wxHAS_MEMBER_DEFAULT
        -:  271:    wxUniCharRef(const wxUniCharRef&) = default;
        -:  272:#endif
        -:  273:
        -:  274:#define wxUNICHAR_REF_DEFINE_OPERATOR_EQUAL(type) \
        -:  275:    wxUniCharRef& operator=(type c) { return *this = wxUniChar(c); }
        -:  276:    wxDO_FOR_CHAR_INT_TYPES(wxUNICHAR_REF_DEFINE_OPERATOR_EQUAL)
        -:  277:#undef wxUNICHAR_REF_DEFINE_OPERATOR_EQUAL
        -:  278:
        -:  279:    // Conversions to the same types as wxUniChar is convertible too:
        -:  280:#define wxUNICHAR_REF_DEFINE_OPERATOR_PAREN(type) \
        -:  281:    operator type() const { return UniChar(); }
        -:  282:    wxDO_FOR_CHAR_INT_TYPES(wxUNICHAR_REF_DEFINE_OPERATOR_PAREN)
        -:  283:#undef wxUNICHAR_REF_DEFINE_OPERATOR_PAREN
        -:  284:
        -:  285:    // see wxUniChar::operator bool etc. for explanation
        -:  286:    operator bool() const { return (bool)UniChar(); }
        -:  287:    bool operator!() const { return !UniChar(); }
        -:  288:    bool operator&&(bool v) const { return UniChar() && v; }
        -:  289:
        -:  290:#define wxDEFINE_UNICHARREF_CMP_WITH_INT(T, op) \
        -:  291:    bool operator op(T c) const { return UniChar() op c; }
        -:  292:
        -:  293:    // Comparison operators:
        -:  294:#define wxDEFINE_UNICHARREF_OPERATOR(op)                                      \
        -:  295:    bool operator op(const wxUniCharRef& c) const { return UniChar() op c.UniChar(); }\
        -:  296:    bool operator op(const wxUniChar& c) const { return UniChar() op c; }     \
        -:  297:    wxDO_FOR_CHAR_INT_TYPES_1(wxDEFINE_UNICHARREF_CMP_WITH_INT, op)
        -:  298:
        -:  299:    wxFOR_ALL_COMPARISONS(wxDEFINE_UNICHARREF_OPERATOR)
        -:  300:
        -:  301:#undef wxDEFINE_UNICHARREF_OPERATOR
        -:  302:#undef wxDEFINE_UNICHARREF_CMP_WITH_INT
        -:  303:
        -:  304:    // for expressions like c-'A':
        -:  305:    int operator-(const wxUniCharRef& c) const { return UniChar() - c.UniChar(); }
        -:  306:    int operator-(const wxUniChar& c) const { return UniChar() - c; }
        -:  307:    int operator-(char c) const { return UniChar() - c; }
        -:  308:    int operator-(unsigned char c) const { return UniChar() - c; }
        -:  309:    int operator-(wchar_t c) const { return UniChar() - c; }
        -:  310:
        -:  311:private:
        -:  312:#if wxUSE_UNICODE_UTF8
        -:  313:    wxUniChar UniChar() const;
        -:  314:#else
        -:  315:    wxUniChar UniChar() const { return *m_pos; }
        -:  316:#endif
        -:  317:
        -:  318:    friend class WXDLLIMPEXP_FWD_BASE wxUniChar;
        -:  319:
        -:  320:private:
        -:  321:    // reference to the string and pointer to the character in string
        -:  322:#if wxUSE_UNICODE_UTF8
        -:  323:    wxString& m_str;
        -:  324:#endif
        -:  325:    iterator m_pos;
        -:  326:};
        -:  327:
        -:  328:inline wxUniChar::wxUniChar(const wxUniCharRef& c)
        -:  329:{
        -:  330:    m_value = c.UniChar().m_value;
        -:  331:}
        -:  332:
        -:  333:inline wxUniChar& wxUniChar::operator=(const wxUniCharRef& c)
        -:  334:{
        -:  335:    m_value = c.UniChar().m_value;
        -:  336:    return *this;
        -:  337:}
        -:  338:
        -:  339:// wxUniCharRef doesn't behave quite like a reference, notably because template
        -:  340:// deduction from wxUniCharRef doesn't yield wxUniChar as would have been the
        -:  341:// case if it were a real reference. This results in a number of problems and
        -:  342:// we can't fix all of them but we can at least provide a working swap() for
        -:  343:// it, instead of the default version which doesn't work because a "wrong" type
        -:  344:// is deduced.
        -:  345:namespace std
        -:  346:{
        -:  347:
        -:  348:template <>
        -:  349:inline
        -:  350:void swap<wxUniCharRef>(wxUniCharRef& lhs, wxUniCharRef& rhs)
        -:  351:{
        -:  352:    if ( &lhs != &rhs )
        -:  353:    {
        -:  354:        // The use of wxUniChar here is the crucial difference: in the default
        -:  355:        // implementation, tmp would be wxUniCharRef and so assigning to lhs
        -:  356:        // would modify it too. Here we make a real copy, not affected by
        -:  357:        // changing lhs, instead.
        -:  358:        wxUniChar tmp = lhs;
        -:  359:        lhs = rhs;
        -:  360:        rhs = tmp;
        -:  361:    }
        -:  362:}
        -:  363:
        -:  364:} // namespace std
        -:  365:
        -:  366:#if __cplusplus >= 201103L || wxCHECK_VISUALC_VERSION(10)
        -:  367:
        -:  368:// For std::iter_swap() to work with wxString::iterator, which uses
        -:  369:// wxUniCharRef as its reference type, we need to ensure that swap() works with
        -:  370:// wxUniCharRef objects by defining this overload.
        -:  371://
        -:  372:// See https://bugs.llvm.org/show_bug.cgi?id=28559#c9
        -:  373:inline
        -:  374:void swap(wxUniCharRef&& lhs, wxUniCharRef&& rhs)
        -:  375:{
        -:  376:    wxUniChar tmp = lhs;
        -:  377:    lhs = rhs;
        -:  378:    rhs = tmp;
        -:  379:}
        -:  380:
        -:  381:#endif // C++11
        -:  382:
        -:  383:
        -:  384:// Comparison operators for the case when wxUniChar(Ref) is the second operand
        -:  385:// implemented in terms of member comparison functions
        -:  386:
        -:  387:wxDEFINE_COMPARISONS_BY_REV(char, const wxUniChar&)
        -:  388:wxDEFINE_COMPARISONS_BY_REV(char, const wxUniCharRef&)
        -:  389:
        -:  390:wxDEFINE_COMPARISONS_BY_REV(wchar_t, const wxUniChar&)
        -:  391:wxDEFINE_COMPARISONS_BY_REV(wchar_t, const wxUniCharRef&)
        -:  392:
        -:  393:wxDEFINE_COMPARISONS_BY_REV(const wxUniChar&, const wxUniCharRef&)
        -:  394:
        -:  395:// for expressions like c-'A':
        -:  396:inline int operator-(char c1, const wxUniCharRef& c2) { return -(c2 - c1); }
        -:  397:inline int operator-(const wxUniChar& c1, const wxUniCharRef& c2) { return -(c2 - c1); }
        -:  398:inline int operator-(wchar_t c1, const wxUniCharRef& c2) { return -(c2 - c1); }
        -:  399:
        -:  400:#endif /* _WX_UNICHAR_H_ */
