        -:  207:
        -:  208:/// Macro for obtaining netname layer for a given PCB layer
        -:  209:#define NETNAMES_LAYER_INDEX( layer )   ( static_cast<int>( NETNAMES_LAYER_ID_START ) + layer )
        -:  210:
        -:  211:#define GAL_UI_LAYER_COUNT 10
        -:  212:
        -:  213:/**
        -:  214: *  GAL layers are "virtual" layers, i.e. not tied into design data.
        -:  215: *
        -:  216: *  Some layers here are shared between applications.
        -:  217: *
        -:  218: *  @note Be very careful where you add new layers here.  Layers up to #GAL_LAYER_ID_BITMASK_END
        -:  219: *  must never be re-ordered and new layers must always be added after this value, because the
        -:  220: *  layers before this value are mapped to bit locations in legacy board files.
        -:  221: *
        -:  222: *  The values in this enum that are used to store visibility state are explicitly encoded with an
        -:  223: *  offset from #GAL_LAYER_ID_START, which is explicitly encoded itself. The exact value of
        -:  224: *  #GAL_LAYER_ID_START is not that sensitive, but the offsets should never be changed or else any
        -:  225: *  existing visibility settings will be disrupted.
        -:  226: */
        -:  227:enum GAL_LAYER_ID: int
        -:  228:{
        -:  229:    GAL_LAYER_ID_START = NETNAMES_LAYER_ID_END,
        -:  230:
        -:  231:     /// Meta control for all vias opacity/visibility.
        -:  232:    LAYER_VIAS               = GAL_LAYER_ID_START +  0,
        -:  233:    LAYER_VIA_MICROVIA       = GAL_LAYER_ID_START +  1, /// Draw micro vias.
        -:  234:    LAYER_VIA_BLIND          = GAL_LAYER_ID_START +  2, /// Draw blind vias.
        -:  235:    LAYER_VIA_BURIED         = GAL_LAYER_ID_START +  3, /// Draw buried vias.
        -:  236:    LAYER_VIA_THROUGH        = GAL_LAYER_ID_START +  4, /// Draw usual through hole vias.
        -:  237:
        -:  238:    /// Handle color for not plated holes (holes, not pads).
        -:  239:    LAYER_NON_PLATEDHOLES    = GAL_LAYER_ID_START +  5,
        -:  240:    LAYER_FP_TEXT            = GAL_LAYER_ID_START +  6,
        -:  241:
        -:  242://  LAYER_MOD_TEXT_BK deprecated                  +  6,
        -:  243:
        -:  244://  DEPRECATED, UNUSED SINCE 9.0. text marked as invisible.
        -:  245://  LAYER_HIDDEN_TEXT        = GAL_LAYER_ID_START +  7,
        -:  246:
        -:  247:    /// Anchor of items having an anchor point (texts, footprints).
        -:  248:    LAYER_ANCHOR             = GAL_LAYER_ID_START +  8,
        -:  249:
        -:  250://  LAYER_PADS_SMD_FR        = GAL_LAYER_ID_START +  9, // Deprecated since 9.0
        -:  251://  LAYER_PADS_SMD_BK        = GAL_LAYER_ID_START + 10, // Deprecated since 9.0
        -:  252:
        -:  253:    LAYER_RATSNEST           = GAL_LAYER_ID_START + 11,
        -:  254:    LAYER_GRID               = GAL_LAYER_ID_START + 12,
        -:  255:    LAYER_GRID_AXES          = GAL_LAYER_ID_START + 13,
        -:  256:
        -:  257://  LAYER_NO_CONNECTS deprecated                  + 14, // show a marker on pads with no nets
        -:  258:
        -:  259:    LAYER_FOOTPRINTS_FR      = GAL_LAYER_ID_START + 15, ///< Show footprints on front.
        -:  260:    LAYER_FOOTPRINTS_BK      = GAL_LAYER_ID_START + 16, ///< Show footprints on back.
        -:  261:
        -:  262:    /// Show footprints values (when texts are visible).
        -:  263:    LAYER_FP_VALUES          = GAL_LAYER_ID_START + 17,
        -:  264:
        -:  265:    /// Show footprints references (when texts are visible).
        -:  266:    LAYER_FP_REFERENCES      = GAL_LAYER_ID_START + 18,
        -:  267:    LAYER_TRACKS             = GAL_LAYER_ID_START + 19,
        -:  268:
        -:  269://  LAYER_PADS_TH            = GAL_LAYER_ID_START + 20, ///< Deprecated since 9.0
        -:  270:
        -:  271:    LAYER_PAD_PLATEDHOLES    = GAL_LAYER_ID_START + 21, ///< to draw pad holes (plated)
        -:  272:
        -:  273:    /// Draw via holes (pad holes do not use this layer).
        -:  274:    LAYER_VIA_HOLES          = GAL_LAYER_ID_START + 22,
        -:  275:
        -:  276:     /// Layer for DRC markers with #SEVERITY_ERROR.
        -:  277:    LAYER_DRC_ERROR          = GAL_LAYER_ID_START + 23,
        -:  278:    LAYER_DRAWINGSHEET       = GAL_LAYER_ID_START + 24, ///< Sheet frame and title block.
        -:  279:    LAYER_GP_OVERLAY         = GAL_LAYER_ID_START + 25, ///< General purpose overlay.
        -:  280:    LAYER_SELECT_OVERLAY     = GAL_LAYER_ID_START + 26, ///< Selected items overlay.
        -:  281:    LAYER_PCB_BACKGROUND     = GAL_LAYER_ID_START + 27, ///< PCB background color.
        -:  282:    LAYER_CURSOR             = GAL_LAYER_ID_START + 28, ///< PCB cursor.
        -:  283:    LAYER_AUX_ITEMS          = GAL_LAYER_ID_START + 29, ///< Auxiliary items (guides, rule, etc).
        -:  284:    LAYER_DRAW_BITMAPS       = GAL_LAYER_ID_START + 30, ///< Draw images.
        -:  285:
        -:  286:    /// This is the end of the layers used for visibility bit masks in legacy board files
        -:  287:    GAL_LAYER_ID_BITMASK_END = GAL_LAYER_ID_START + 31,
        -:  288:
        -:  289:    // Layers in this section have visibility controls but were not present in legacy board files.
        -:  290:
        -:  291:    /// Meta control for all pads opacity/visibility (color ignored).
        -:  292:    LAYER_PADS               = GAL_LAYER_ID_START + 32,
        -:  293:
        -:  294:    /// Control for copper zone opacity/visibility (color ignored).
        -:  295:    LAYER_ZONES              = GAL_LAYER_ID_START + 33,
        -:  296:
        -:  297:    LAYER_PAD_HOLEWALLS      = GAL_LAYER_ID_START + 34,
        -:  298:    LAYER_VIA_HOLEWALLS      = GAL_LAYER_ID_START + 35,
        -:  299:
        -:  300:    /// Layer for DRC markers with #SEVERITY_WARNING.
        -:  301:    LAYER_DRC_WARNING        = GAL_LAYER_ID_START + 36,
        -:  302:
        -:  303:    /// Layer for DRC markers which have been individually excluded.
        -:  304:    LAYER_DRC_EXCLUSION      = GAL_LAYER_ID_START + 37,
        -:  305:    LAYER_MARKER_SHADOWS     = GAL_LAYER_ID_START + 38, ///< Shadows for DRC markers.
        -:  306:
        -:  307:    LAYER_LOCKED_ITEM_SHADOW = GAL_LAYER_ID_START + 39, ///< Shadow layer for locked items.
        -:  308:
        -:  309:    /// Shadow layer for items flagged conflicting.
        -:  310:    LAYER_CONFLICTS_SHADOW   = GAL_LAYER_ID_START + 40,
        -:  311:
        -:  312:    /// Copper graphic shape opacity/visibility (color ignored).
        -:  313:    LAYER_FILLED_SHAPES      = GAL_LAYER_ID_START + 41,
        -:  314:
        -:  315:    LAYER_DRC_SHAPES         = GAL_LAYER_ID_START + 42,  ///< Custom shapes for DRC markers.
        -:  316://  LAYER_DRC_SHAPE2         = GAL_LAYER_ID_START + 43,  ///< Deprecated since 10.0
        -:  317:
        -:  318:    LAYER_BOARD_OUTLINE_AREA = GAL_LAYER_ID_START + 44, ///< PCB board outline
        -:  319:
        -:  320:    /// PCB reference/manual snap points visibility
        -:  321:    LAYER_POINTS             = GAL_LAYER_ID_START + 45,
        -:  322:
        -:  323:    // Add layers below this point that do not have visibility controls, so don't need explicit
        -:  324:    // enum values
        -:  325:
        -:  326:    LAYER_DRAWINGSHEET_PAGE1,      ///< Sheet Editor previewing first page.
        -:  327:    LAYER_DRAWINGSHEET_PAGEn,      ///< Sheet Editor previewing pages after first page.
        -:  328:
        -:  329:    LAYER_PAGE_LIMITS,             ///< Color for drawing the page extents (visibility stored in
        -:  330:                                   ///< PCBNEW_SETTINGS::m_ShowPageLimits)
        -:  331:
        -:  332:    /// Virtual layers for stacking zones and tracks on a given copper layer.
        -:  333:    LAYER_ZONE_START,
        -:  334:    LAYER_ZONE_END = LAYER_ZONE_START + PCB_LAYER_ID_COUNT,
        -:  335:
        -:  336:    /// Virtual layers for pad copper on a given copper layer.
        -:  337:    LAYER_PAD_COPPER_START,
        -:  338:    LAYER_PAD_COPPER_END = LAYER_PAD_COPPER_START + PCB_LAYER_ID_COUNT,
        -:  339:
        -:  340:    /// Virtual layers for via copper on a given copper layer.
        -:  341:    LAYER_VIA_COPPER_START,
        -:  342:    LAYER_VIA_COPPER_END = LAYER_VIA_COPPER_START + PCB_LAYER_ID_COUNT,
        -:  343:
        -:  344:    /// Virtual layers for pad/via/track clearance outlines for a given copper layer.
        -:  345:    LAYER_CLEARANCE_START,
        -:  346:    LAYER_CLEARANCE_END = LAYER_CLEARANCE_START + PCB_LAYER_ID_COUNT,
        -:  347:
        -:  348:    /// Virtual layers for background images per board layer.
        -:  349:    LAYER_BITMAP_START,
        -:  350:    LAYER_BITMAP_END = LAYER_BITMAP_START + PCB_LAYER_ID_COUNT,
        -:  351:
        -:  352:    /// Virtual layers for points per board layer.
        -:  353:    LAYER_POINT_START,
        -:  354:    LAYER_POINT_END = LAYER_POINT_START + PCB_LAYER_ID_COUNT,
        -:  355:
        -:  356:    // Layers for drawing on-canvas UI
        -:  357:    LAYER_UI_START,
        -:  358:    LAYER_UI_END = LAYER_UI_START + GAL_UI_LAYER_COUNT,
        -:  359:
        -:  360:    GAL_LAYER_ID_END
        -:  361:};
        -:  362:
        -:  363:/// Use this macro to convert a #GAL layer to a 0-indexed offset from #LAYER_VIAS.
        -:  364:#define GAL_LAYER_INDEX( x ) ( x - GAL_LAYER_ID_START )
        -:  365:
        -:  366:/// Macros for getting the extra layers for a given board layer.
        -:  367:#define BITMAP_LAYER_FOR( boardLayer ) ( LAYER_BITMAP_START + boardLayer )
        -:  368:#define ZONE_LAYER_FOR( boardLayer ) ( LAYER_ZONE_START + boardLayer )
        -:  369:#define PAD_COPPER_LAYER_FOR( boardLayer ) ( LAYER_PAD_COPPER_START + boardLayer )
        -:  370:#define VIA_COPPER_LAYER_FOR( boardLayer ) ( LAYER_VIA_COPPER_START + boardLayer )
        -:  371:#define CLEARANCE_LAYER_FOR( boardLayer ) ( LAYER_CLEARANCE_START + boardLayer )
        -:  372:#define POINT_LAYER_FOR( boardLayer ) ( LAYER_POINT_START + boardLayer )
        -:  373:
        -:  374:constexpr int GAL_LAYER_ID_COUNT = GAL_LAYER_ID_END - GAL_LAYER_ID_START;
        -:  375:
        -:  376:inline GAL_LAYER_ID operator++( GAL_LAYER_ID& a )
        -:  377:{
        -:  378:    a = GAL_LAYER_ID( int( a ) + 1 );
        -:  379:    return a;
        -:  380:}
        -:  381:
        -:  382:inline GAL_LAYER_ID ToGalLayer( int aInteger )
        -:  383:{
        -:  384:    wxASSERT( aInteger >= GAL_LAYER_ID_START && aInteger <= GAL_LAYER_ID_END );
        -:  385:    return static_cast<GAL_LAYER_ID>( aInteger );
        -:  386:}
        -:  387:
        -:  388:/// Used for via types.
        -:  389:inline GAL_LAYER_ID operator+( const GAL_LAYER_ID& a, int b )
        -:  390:{
        -:  391:    GAL_LAYER_ID t = GAL_LAYER_ID( int( a ) + b );
        -:  392:    wxASSERT( t <= GAL_LAYER_ID_END );
        -:  393:    return t;
        -:  394:}
