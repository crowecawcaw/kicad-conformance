        -:  189:
        -:  190:/// Dedicated layers for net names used in Pcbnew.
        -:  191:enum NETNAMES_LAYER_ID: int
        -:  192:{
        -:  193:
        -:  194:    NETNAMES_LAYER_ID_START = PCB_LAYER_ID_COUNT,
        -:  195:
        -:  196:    /// Reserved space for board layer netnames.
        -:  197:    NETNAMES_LAYER_ID_RESERVED = NETNAMES_LAYER_ID_START + PCB_LAYER_ID_COUNT,
        -:  198:
        -:  199:    /// Additional netnames layers (not associated with a PCB layer).
        -:  200:    LAYER_PAD_FR_NETNAMES,
        -:  201:    LAYER_PAD_BK_NETNAMES,
        -:  202:    LAYER_PAD_NETNAMES,
        -:  203:    LAYER_VIA_NETNAMES,
        -:  204:
        -:  205:    NETNAMES_LAYER_ID_END
