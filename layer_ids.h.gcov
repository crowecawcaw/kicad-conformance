        -:  397:/// Wraps a std::bitset.
        -:  398:typedef std::bitset<GAL_LAYER_ID_COUNT> GAL_BASE_SET;
        -:  399:
        -:  400:
        -:  401:/// Helper for storing and iterating over GAL_LAYER_IDs.
        -:  402:class KICOMMON_API GAL_SET : public GAL_BASE_SET
        -:  403:{
        -:  404:
        -:  405:private:
        -:  406:    static constexpr int start = static_cast<int>( GAL_LAYER_ID_START );
        -:  407:
        -:  408:public:
        -:  409:    GAL_SET() : std::bitset<GAL_LAYER_ID_COUNT>()
        -:  410:    {
        -:  411:    }
        -:  412:
        -:  413:    GAL_SET( const GAL_SET& aOther ) : std::bitset<GAL_LAYER_ID_COUNT>( aOther )
        -:  414:    {
        -:  415:    }
        -:  416:
        -:  417:    GAL_SET( const GAL_LAYER_ID* aArray, unsigned aCount );
        -:  418:
        -:  419:    GAL_SET& set()
        -:  420:    {
        -:  421:        GAL_BASE_SET::set();
        -:  422:        return *this;
        -:  423:    }
        -:  424:
        -:  425:    GAL_SET& set( int aPos, bool aVal = true )
