        -:  428:        return *this;
        -:  429:    }
        -:  430:
        -:  431:    GAL_SET& set( GAL_LAYER_ID aPos, bool aVal = true )
        -:  432:    {
        -:  433:        GAL_BASE_SET::set( static_cast<std::size_t>( aPos ) - start, aVal );
