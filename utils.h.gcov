        -:  336:// ----------------------------------------------------------------------------
        -:  337:// Process management
        -:  338:// ----------------------------------------------------------------------------
        -:  339:
        -:  340:// NB: for backwards compatibility reasons the values of wxEXEC_[A]SYNC *must*
        -:  341://     be 0 and 1, don't change!
        -:  342:
        -:  343:enum
        -:  344:{
        -:  345:    // execute the process asynchronously
        -:  346:    wxEXEC_ASYNC    = 0,
        -:  347:
        -:  348:    // execute it synchronously, i.e. wait until it finishes
        -:  349:    wxEXEC_SYNC     = 1,
        -:  350:
        -:  351:    // under Windows, don't hide the child even if it's IO is redirected (this
        -:  352:    // is done by default)
        -:  353:    wxEXEC_SHOW_CONSOLE   = 2,
        -:  354:
        -:  355:    // deprecated synonym for wxEXEC_SHOW_CONSOLE, use the new name as it's
        -:  356:    // more clear
        -:  357:    wxEXEC_NOHIDE = wxEXEC_SHOW_CONSOLE,
        -:  358:
        -:  359:    // under Unix, if the process is the group leader then passing wxKILL_CHILDREN to wxKill
        -:  360:    // kills all children as well as pid
        -:  361:    // under Windows (NT family only), sets the CREATE_NEW_PROCESS_GROUP flag,
        -:  362:    // which allows to target Ctrl-Break signal to the spawned process.
        -:  363:    // applies to console processes only.
        -:  364:    wxEXEC_MAKE_GROUP_LEADER = 4,
        -:  365:
        -:  366:    // by default synchronous execution disables all program windows to avoid
        -:  367:    // that the user interacts with the program while the child process is
        -:  368:    // running, you can use this flag to prevent this from happening
        -:  369:    wxEXEC_NODISABLE = 8,
        -:  370:
        -:  371:    // by default, the event loop is run while waiting for synchronous execution
        -:  372:    // to complete and this flag can be used to simply block the main process
        -:  373:    // until the child process finishes
        -:  374:    wxEXEC_NOEVENTS = 16,
        -:  375:
        -:  376:    // under Windows, hide the console of the child process if it has one, even
        -:  377:    // if its IO is not redirected
        -:  378:    wxEXEC_HIDE_CONSOLE = 32,
        -:  379:
        -:  380:    // convenient synonym for flags given system()-like behaviour
        -:  381:    wxEXEC_BLOCK = wxEXEC_SYNC | wxEXEC_NOEVENTS
        -:  382:};
