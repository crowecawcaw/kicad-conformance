        -:  295:// Convert 2-digit hex number to decimal
        -:  296:WXDLLIMPEXP_BASE int wxHexToDec(const wxString& buf);
        -:  297:
        -:  298:// Convert 2-digit hex number to decimal
        -:  299:inline int wxHexToDec(const char* buf)
        -:  300:{
        -:  301:    int firstDigit, secondDigit;
        -:  302:
        -:  303:    if (buf[0] >= 'A')
        -:  304:        firstDigit = buf[0] - 'A' + 10;
        -:  305:    else if (buf[0] >= '0')
        -:  306:        firstDigit = buf[0] - '0';
        -:  307:    else
        -:  308:        firstDigit = -1;
        -:  309:
        -:  310:    wxCHECK_MSG( firstDigit >= 0 && firstDigit <= 15, -1, wxS("Invalid argument") );
        -:  311:
        -:  312:    if (buf[1] >= 'A')
        -:  313:        secondDigit = buf[1] - 'A' + 10;
        -:  314:    else if (buf[1] >= '0')
        -:  315:        secondDigit = buf[1] - '0';
        -:  316:    else
        -:  317:        secondDigit = -1;
        -:  318:
        -:  319:    wxCHECK_MSG( secondDigit >= 0 && secondDigit <= 15, -1, wxS("Invalid argument") );
        -:  320:
        -:  321:    return firstDigit * 16 + secondDigit;
        -:  322:}
