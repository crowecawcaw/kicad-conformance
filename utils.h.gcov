        -:  848:
        -:  849:// Windows only: get user-defined resource from the .res file.
        -:  850:#ifdef __WINDOWS__
        -:  851:    // default resource type for wxLoadUserResource()
        -:  852:    extern WXDLLIMPEXP_DATA_BASE(const wxChar*) wxUserResourceStr;
        -:  853:
        -:  854:    // Return the pointer to the resource data. This pointer is read-only, use
        -:  855:    // the overload below if you need to modify the data.
        -:  856:    //
        -:  857:    // Notice that the resource type can be either a real string or an integer
        -:  858:    // produced by MAKEINTRESOURCE(). In particular, any standard resource type,
        -:  859:    // i.e any RT_XXX constant, could be passed here.
        -:  860:    //
        -:  861:    // Returns true on success, false on failure. Doesn't log an error message
        -:  862:    // if the resource is not found (because this could be expected) but does
        -:  863:    // log one if any other error occurs.
        -:  864:    WXDLLIMPEXP_BASE bool
        -:  865:    wxLoadUserResource(const void **outData,
        -:  866:                       size_t *outLen,
        -:  867:                       const wxString& resourceName,
        -:  868:                       const wxChar* resourceType = wxUserResourceStr,
        -:  869:                       WXHINSTANCE module = NULL);
        -:  870:
        -:  871:    // This function allocates a new buffer and makes a copy of the resource
        -:  872:    // data, remember to delete[] the buffer. And avoid using it entirely if
        -:  873:    // the overload above can be used.
        -:  874:    //
        -:  875:    // Returns NULL on failure.
        -:  876:    WXDLLIMPEXP_BASE char*
        -:  877:    wxLoadUserResource(const wxString& resourceName,
        -:  878:                       const wxChar* resourceType = wxUserResourceStr,
