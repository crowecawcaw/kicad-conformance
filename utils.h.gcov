        -:  663:
        -:  664:    // strip everything after '\t'
        -:  665:    wxStrip_Accel = 2,
        -:  666:
        -:  667:    // strip mnemonics of the form "(&X)" appended to the string (used in CJK
        -:  668:    // translations)
        -:  669:    wxStrip_CJKMnemonics = 4,
        -:  670:
        -:  671:    // strip everything (this doesn't include wxStrip_CJKMnemonics for
        -:  672:    // compatibility)
        -:  673:    wxStrip_All = wxStrip_Mnemonics | wxStrip_Accel,
        -:  674:
        -:  675:    // strip everything including CJK mnemonics, suitable for menu items labels
        -:  676:    // only (despite its name, wxStripMenuCodes() is currently used for control
        -:  677:    // labels too)
        -:  678:    wxStrip_Menu = wxStrip_All | wxStrip_CJKMnemonics
        -:  679:};
