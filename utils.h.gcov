        -:  195:
        -:  196:/*
        -:  197: * Class to make it easier to specify platform-dependent values
        -:  198: *
        -:  199: * Examples:
        -:  200: *  long val = wxPlatform::If(wxMac, 1).ElseIf(wxGTK, 2).ElseIf(stPDA, 5).Else(3);
        -:  201: *  wxString strVal = wxPlatform::If(wxMac, wxT("Mac")).ElseIf(wxMSW, wxT("MSW")).Else(wxT("Other"));
        -:  202: *
        -:  203: * A custom platform symbol:
        -:  204: *
        -:  205: *  #define stPDA 100
        -:  206: *  #ifdef __WXMSW__
        -:  207: *      wxPlatform::AddPlatform(stPDA);
        -:  208: *  #endif
        -:  209: *
        -:  210: *  long windowStyle = wxCAPTION | (long) wxPlatform::IfNot(stPDA, wxRESIZE_BORDER);
        -:  211: *
        -:  212: */
        -:  213:
        -:  214:class WXDLLIMPEXP_BASE wxPlatform
        -:  215:{
        -:  216:public:
        -:  217:    wxPlatform() { Init(); }
        -:  218:    wxPlatform(const wxPlatform& platform) { Copy(platform); }
        -:  219:    void operator = (const wxPlatform& platform) { if (&platform != this) Copy(platform); }
        -:  220:    void Copy(const wxPlatform& platform);
        -:  221:
        -:  222:    // Specify an optional default value
        -:  223:    wxPlatform(int defValue) { Init(); m_longValue = (long)defValue; }
        -:  224:    wxPlatform(long defValue) { Init(); m_longValue = defValue; }
        -:  225:    wxPlatform(const wxString& defValue) { Init(); m_stringValue = defValue; }
        -:  226:    wxPlatform(double defValue) { Init(); m_doubleValue = defValue; }
        -:  227:
        -:  228:    static wxPlatform If(int platform, long value);
        -:  229:    static wxPlatform IfNot(int platform, long value);
        -:  230:    wxPlatform& ElseIf(int platform, long value);
        -:  231:    wxPlatform& ElseIfNot(int platform, long value);
        -:  232:    wxPlatform& Else(long value);
        -:  233:
        -:  234:    static wxPlatform If(int platform, int value) { return If(platform, (long)value); }
        -:  235:    static wxPlatform IfNot(int platform, int value) { return IfNot(platform, (long)value); }
        -:  236:    wxPlatform& ElseIf(int platform, int value) { return ElseIf(platform, (long) value); }
        -:  237:    wxPlatform& ElseIfNot(int platform, int value) { return ElseIfNot(platform, (long) value); }
        -:  238:    wxPlatform& Else(int value) { return Else((long) value); }
        -:  239:
        -:  240:    static wxPlatform If(int platform, double value);
        -:  241:    static wxPlatform IfNot(int platform, double value);
        -:  242:    wxPlatform& ElseIf(int platform, double value);
        -:  243:    wxPlatform& ElseIfNot(int platform, double value);
        -:  244:    wxPlatform& Else(double value);
        -:  245:
        -:  246:    static wxPlatform If(int platform, const wxString& value);
        -:  247:    static wxPlatform IfNot(int platform, const wxString& value);
        -:  248:    wxPlatform& ElseIf(int platform, const wxString& value);
        -:  249:    wxPlatform& ElseIfNot(int platform, const wxString& value);
        -:  250:    wxPlatform& Else(const wxString& value);
        -:  251:
        -:  252:    long GetInteger() const { return m_longValue; }
        -:  253:    const wxString& GetString() const { return m_stringValue; }
        -:  254:    double GetDouble() const { return m_doubleValue; }
        -:  255:
        -:  256:    operator int() const { return (int) GetInteger(); }
        -:  257:    operator long() const { return GetInteger(); }
        -:  258:    operator double() const { return GetDouble(); }
        -:  259:    operator const wxString&() const { return GetString(); }
        -:  260:
        -:  261:    static void AddPlatform(int platform);
        -:  262:    static bool Is(int platform);
        -:  263:    static void ClearPlatforms();
        -:  264:
        -:  265:private:
        -:  266:
        -:  267:    void Init() { m_longValue = 0; m_doubleValue = 0.0; }
        -:  268:
        -:  269:    long                m_longValue;
        -:  270:    double              m_doubleValue;
        -:  271:    wxString            m_stringValue;
        -:  272:    static wxArrayInt*  sm_customPlatforms;
        -:  273:};
