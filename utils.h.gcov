        -:  481:
        -:  482:// Shutdown or reboot the PC
        -:  483:WXDLLIMPEXP_BASE bool wxShutdown(int flags = wxSHUTDOWN_POWEROFF);
        -:  484:
        -:  485:// send the given signal to the process (only NONE and KILL are supported under
        -:  486:// Windows, all others mean TERM), return 0 if ok and -1 on error
