        -:   56:    static inline bool ClassOf( const EDA_ITEM* aItem )
        -:   57:    {
        -:   58:        if( aItem == nullptr )
        -:   59:            return false;
        -:   60:
        -:   61:        switch( aItem->Type() )
        -:   62:        {
        -:   63:        case PCB_PAD_T:
        -:   64:        case PCB_TRACE_T:
        -:   65:        case PCB_ARC_T:
