        -:  182:/**
        -:  183: * @brief Returns the length of the longest common subset of values between two containers.
        -:  184:*/
        -:  185:template <class _Container>
        -:  186:size_t longest_common_subset( const _Container& __c1, const _Container& __c2 )
        -:  187:{
        -:  188:    size_t __c1_size = __c1.size();
        -:  189:    size_t __c2_size = __c2.size();
        -:  190:
        -:  191:    if( __c1_size == 0 || __c2_size == 0 )
        -:  192:        return 0;
        -:  193:
        -:  194:    // Create a 2D table to store the lengths of common subsets
        -:  195:    std::vector<std::vector<size_t>> table( __c1_size + 1, std::vector<size_t>( __c2_size + 1, 0 ) );
        -:  196:
        -:  197:    size_t longest = 0;
        -:  198:
        -:  199:    for( size_t i = 1; i <= __c1_size; ++i )
        -:  200:    {
        -:  201:        for( size_t j = 1; j <= __c2_size; ++j )
        -:  202:        {
        -:  203:            if( __c1[i - 1] == __c2[j - 1] )
        -:  204:            {
        -:  205:                table[i][j] = table[i - 1][j - 1] + 1;
        -:  206:                longest = std::max( longest, static_cast<size_t>( table[i][j] ) );
        -:  207:            }
        -:  208:        }
        -:  209:    }
        -:  210:
        -:  211:    return longest;
        -:  212:}
