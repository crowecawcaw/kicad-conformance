        -:  157:/**
        -:  158: * @brief Deletes all duplicate values from \a __c.
        -:  159: */
        -:  160:template <class _Container>
        -:  161:void remove_duplicates( _Container& __c )
        -:  162:{
        -:  163:    __c.erase( std::unique( __c.begin(), __c.end() ), __c.end() );
        -:  164:}
        -:  165:
        -:  166:template <class _Container, class _Function>
        -:  167:void remove_duplicates( _Container& __c, _Function&& __f )
        -:  168:{
        -:  169:    __c.erase( std::unique( __c.begin(), __c.end(), std::forward<_Function>( __f ) ), __c.end() );
        -:  170:}
