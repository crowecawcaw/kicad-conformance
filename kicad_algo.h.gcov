        -:  214:/**
        -:  215: * @brief Compares two containers lexicographically.
        -:  216: *
        -:  217: * Returns a negative value if the first container is less than the second,
        -:  218: * zero if they are equal, and a positive value if the first container is
        -:  219: * greater than the second.  This is a re-implementation of
        -:  220: * std::lexicographical_compare_three_way because it is not available in all
        -:  221: * compilers.
        -:  222: */
        -:  223:template <class Container1Iter, class Container2Iter>
        -:  224:int lexicographical_compare_three_way( Container1Iter aC1_first, Container1Iter aC1_last,
        -:  225:                                       Container2Iter aC2_first, Container2Iter aC2_last )
        -:  226:{
        -:  227:#ifdef __cpp_lib_three_way_comparison // Check to see if we have an optimized version
        -:  228:    auto retval =
        -:  229:            std::lexicographical_compare_three_way( aC1_first, aC1_last, aC2_first, aC2_last );
        -:  230:    return retval == std::strong_ordering::equal
        -:  231:                   ? 0
        -:  232:                   : ( retval == std::strong_ordering::less ? -1 : 1 );
        -:  233:#else
        -:  234:    Container1Iter it1 = aC1_first;
        -:  235:    Container2Iter it2 = aC2_first;
        -:  236:
        -:  237:    while( it1 != aC1_last && it2 != aC2_last )
        -:  238:    {
        -:  239:        if( *it1 < *it2 )
        -:  240:            return -1;
        -:  241:        if( *it1 > *it2 )
        -:  242:            return 1;
        -:  243:        ++it1;
        -:  244:        ++it2;
        -:  245:    }
        -:  246:
        -:  247:    if( it2 == aC2_last )
        -:  248:        return !( it1 == aC1_last );
        -:  249:    else
        -:  250:        return -1;
        -:  251:#endif // __cpp_lib_three_way_comparison
        -:  252:}
        -:  253:
        -:  254:
        -:  255:} // namespace alg
