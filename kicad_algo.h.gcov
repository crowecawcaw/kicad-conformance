        -:  172:/**
        -:  173: * @brief Integral version of std::signbit that works all compilers.
        -:  174: */
        -:  175:template <typename T, std::enable_if_t<std::is_integral<T>::value, int> = 0>
        -:  176:bool signbit( T v )
        -:  177:{
        -:  178:    return v < 0;
        -:  179:}
