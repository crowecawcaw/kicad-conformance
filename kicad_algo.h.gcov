        -:   34:namespace alg
        -:   35:{
        -:   36:/**
        -:   37: *  @brief Apply a function to the first and second element of a std::pair
        -:   38: *  @param  __pair   A pair of elements (both elements must be the same type).
        -:   39: *  @param  __f      A unary function object.
        -:   40: *
        -:   41: *  Applies the function object @p __f to @p __pair.first and @p __pair.second
        -:   42: *  If @p __f has a return value it is ignored.
        -:   43:*/
        -:   44:template <typename _Type, typename _Function>
        -:   45:void run_on_pair( std::pair<_Type, _Type>& __pair, _Function __f )
        -:   46:{
        -:   47:    __f( __pair.first );
        -:   48:    __f( __pair.second );
        -:   49:}
        -:   50:
        -:   51:/**
        -:   52: *  @brief Apply a function to every sequential pair of elements of a sequence.
        -:   53: *  @param  __first  An input iterator.
        -:   54: *  @param  __last   An input iterator.
        -:   55: *  @param  __f      A unary function object.
        -:   56: *
        -:   57: *  Applies the function object @p __f to each sequential pair of elements in the range
        -:   58: *  @p [first,last).  @p __f must not modify the order of the sequence.
        -:   59: *  If @p __f has a return value it is ignored.
        -:   60:*/
        -:   61:template <typename _InputIterator, typename _Function>
        -:   62:void adjacent_pairs( _InputIterator __first, _InputIterator __last, _Function __f )
        -:   63:{
        -:   64:    if( __first != __last )
        -:   65:    {
        -:   66:        _InputIterator __follow = __first;
        -:   67:        ++__first;
        -:   68:        for( ; __first != __last; ++__first, ++__follow )
        -:   69:            __f( *__follow, *__first );
        -:   70:    }
        -:   71:}
        -:   72:
        -:   73:/**
        -:   74: *  @brief Apply a function to every possible pair of elements of a sequence.
        -:   75: *  @param  __first  An input iterator.
        -:   76: *  @param  __last   An input iterator.
        -:   77: *  @param  __f      A unary function object.
        -:   78: *
        -:   79: *  Applies the function object @p __f to every possible pair of elements in the range
        -:   80: *  @p [first,last).  @p __f must not modify the order of the sequence.
        -:   81: *  If @p __f has a return value it is ignored.
        -:   82:*/
        -:   83:template <typename _InputIterator, typename _Function>
        -:   84:void for_all_pairs( _InputIterator __first, _InputIterator __last, _Function __f )
        -:   85:{
        -:   86:    if( __first != __last )
        -:   87:    {
        -:   88:        _InputIterator __follow = __first;
        -:   89:        ++__first;
        -:   90:        for( ; __first != __last; ++__first, ++__follow )
        -:   91:            for( _InputIterator __it = __first; __it != __last; ++__it )
        -:   92:                __f( *__follow, *__it );
        -:   93:    }
        -:   94:}
