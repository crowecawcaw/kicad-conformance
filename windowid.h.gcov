        -:    9:
        -:   10:#ifndef _WX_WINDOWID_H_
        -:   11:#define _WX_WINDOWID_H_
        -:   12:
        -:   13:#include "wx/defs.h"
        -:   14:
        -:   15:// ----------------------------------------------------------------------------
        -:   16:// wxWindowIDRef: reference counted id value
        -:   17:// ----------------------------------------------------------------------------
        -:   18:
        -:   19:// A wxWindowIDRef object wraps an id value and marks it as (un)used as
        -:   20:// necessary. All ids returned from wxWindow::NewControlId() should be assigned
        -:   21:// to an instance of this class to ensure that the id is marked as being in
        -:   22:// use.
        -:   23://
        -:   24:// This class is always defined but it is trivial if wxUSE_AUTOID_MANAGEMENT is
        -:   25:// off.
        -:   26:class WXDLLIMPEXP_CORE wxWindowIDRef
        -:   27:{
        -:   28:public:
        -:   29:    // default ctor
        -:   30:    wxWindowIDRef()
        -:   31:    {
        -:   32:        m_id = wxID_NONE;
        -:   33:    }
        -:   34:
        -:   35:    // ctor taking id values
        -:   36:    wxWindowIDRef(int id)
        -:   37:    {
        -:   38:        Init(id);
        -:   39:    }
        -:   40:
        -:   41:    wxWindowIDRef(long id)
        -:   42:    {
        -:   43:        Init(wxWindowID(id));
        -:   44:    }
        -:   45:
        -:   46:    wxWindowIDRef(const wxWindowIDRef& id)
        -:   47:    {
        -:   48:        Init(id.m_id);
        -:   49:    }
        -:   50:
        -:   51:    // dtor
        -:   52:    ~wxWindowIDRef()
        -:   53:    {
        -:   54:        Assign(wxID_NONE);
        -:   55:    }
        -:   56:
        -:   57:    // assignment
    #####:   58:    wxWindowIDRef& operator=(int id)
        -:   59:    {
    #####:   60:        Assign(id);
    #####:   61:        return *this;
        -:   62:    }
        -:   63:
        -:   64:    wxWindowIDRef& operator=(long id)
        -:   65:    {
        -:   66:        Assign(wxWindowID(id));
        -:   67:        return *this;
        -:   68:    }
        -:   69:
        -:   70:    wxWindowIDRef& operator=(const wxWindowIDRef& id)
        -:   71:    {
        -:   72:        if (&id != this)
        -:   73:            Assign(id.m_id);
        -:   74:        return *this;
        -:   75:    }
        -:   76:
        -:   77:    // access to the stored id value
        -:   78:    wxWindowID GetValue() const
        -:   79:    {
        -:   80:        return m_id;
        -:   81:    }
        -:   82:
        -:   83:    operator wxWindowID() const
        -:   84:    {
        -:   85:        return m_id;
        -:   86:    }
        -:   87:
        -:   88:private:
        -:   89:#if wxUSE_AUTOID_MANAGEMENT
        -:   90:    // common part of all ctors: call Assign() for our new id
        -:   91:    void Init(wxWindowID id)
        -:   92:    {
        -:   93:        // m_id must be initialized before calling Assign()
        -:   94:        m_id = wxID_NONE;
        -:   95:        Assign(id);
        -:   96:    }
        -:   97:
        -:   98:    // increase reference count of id, decrease the one of m_id
        -:   99:    void Assign(wxWindowID id);
        -:  100:#else // !wxUSE_AUTOID_MANAGEMENT
        -:  101:    // trivial stubs for the functions above
        -:  102:    void Init(wxWindowID id)
        -:  103:    {
        -:  104:        m_id = id;
        -:  105:    }
        -:  106:
    #####:  107:    void Assign(wxWindowID id)
        -:  108:    {
    #####:  109:        m_id = id;
    #####:  110:    }
        -:  111:#endif // wxUSE_AUTOID_MANAGEMENT/!wxUSE_AUTOID_MANAGEMENT
        -:  112:
        -:  113:
        -:  114:    wxWindowID m_id;
        -:  115:};
        -:  116:
        -:  117:// comparison operators
        -:  118:inline bool operator==(const wxWindowIDRef& lhs, const wxWindowIDRef& rhs)
        -:  119:{
        -:  120:    return lhs.GetValue() == rhs.GetValue();
        -:  121:}
        -:  122:
        -:  123:inline bool operator==(const wxWindowIDRef& lhs, int rhs)
        -:  124:{
        -:  125:    return lhs.GetValue() == rhs;
        -:  126:}
        -:  127:
        -:  128:inline bool operator==(const wxWindowIDRef& lhs, long rhs)
        -:  129:{
        -:  130:    return lhs.GetValue() == rhs;
        -:  131:}
        -:  132:
        -:  133:inline bool operator==(int lhs, const wxWindowIDRef& rhs)
        -:  134:{
        -:  135:    return rhs == lhs;
        -:  136:}
        -:  137:
        -:  138:inline bool operator==(long lhs, const wxWindowIDRef& rhs)
        -:  139:{
        -:  140:    return rhs == lhs;
        -:  141:}
        -:  142:
        -:  143:inline bool operator!=(const wxWindowIDRef& lhs, const wxWindowIDRef& rhs)
        -:  144:{
        -:  145:    return !(lhs == rhs);
        -:  146:}
        -:  147:
        -:  148:inline bool operator!=(const wxWindowIDRef& lhs, int rhs)
        -:  149:{
        -:  150:    return !(lhs == rhs);
        -:  151:}
        -:  152:
        -:  153:inline bool operator!=(const wxWindowIDRef& lhs, long rhs)
        -:  154:{
        -:  155:    return !(lhs == rhs);
        -:  156:}
        -:  157:
        -:  158:inline bool operator!=(int lhs, const wxWindowIDRef& rhs)
        -:  159:{
        -:  160:    return !(lhs == rhs);
        -:  161:}
        -:  162:
        -:  163:inline bool operator!=(long lhs, const wxWindowIDRef& rhs)
        -:  164:{
        -:  165:    return !(lhs == rhs);
        -:  166:}
        -:  167:
        -:  168:// ----------------------------------------------------------------------------
        -:  169:// wxIdManager
        -:  170:// ----------------------------------------------------------------------------
        -:  171:
        -:  172:class WXDLLIMPEXP_CORE wxIdManager
        -:  173:{
        -:  174:public:
        -:  175:    // This returns an id value and not an wxWindowIDRef.  The returned value
        -:  176:    // should be assigned a.s.a.p to a wxWindowIDRef.  The IDs are marked as
        -:  177:    // reserved so that another call to ReserveId before assigning the id to a
        -:  178:    // wxWindowIDRef will not use the same ID
        -:  179:    static wxWindowID ReserveId(int count = 1);
        -:  180:
        -:  181:    // This will release an unused reserved ID.  This should only be called
        -:  182:    // if the ID returned by ReserveId was NOT assigned to a wxWindowIDRef
        -:  183:    // for some purpose, maybe an early return from a function
        -:  184:    static void UnreserveId(wxWindowID id, int count = 1);
        -:  185:};
        -:  186:
        -:  187:#endif // _WX_WINDOWID_H_
