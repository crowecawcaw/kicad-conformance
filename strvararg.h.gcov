        -:  323:
        -:  324:#if wxDEBUG_LEVEL
        -:  325:    // Check that the format specifier for index-th argument in 'fmt' has
        -:  326:    // the correct type (one of wxFormatString::Arg_XXX or-combination in
        -:  327:    // 'expected_mask').
        -:  328:    #define wxASSERT_ARG_TYPE(fmt, index, expected_mask)                    \
        -:  329:        wxSTATEMENT_MACRO_BEGIN                                             \
        -:  330:            if ( !fmt )                                                     \
        -:  331:                break;                                                      \
        -:  332:            const int argtype = fmt->GetArgumentType(index);                \
        -:  333:            wxASSERT_MSG( (argtype & (expected_mask)) == argtype,           \
        -:  334:                          "format specifier doesn't match argument type" ); \
        -:  335:        wxSTATEMENT_MACRO_END
        -:  336:#else
        -:  337:    // Just define it to suppress "unused parameter" warnings for the
        -:  338:    // parameters which we don't use otherwise
        -:  339:    #define wxASSERT_ARG_TYPE(fmt, index, expected_mask)                      \
        -:  340:        wxUnusedVar(fmt);                                                     \
        -:  341:        wxUnusedVar(index)
        -:  342:#endif // wxDEBUG_LEVEL/!wxDEBUG_LEVEL
