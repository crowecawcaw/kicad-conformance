        -:  158:            // type search as this should not change.
        -:  159:
        -:  160:            const int mmin2[3] = { type, INT_MIN, INT_MIN };
        -:  161:            const int mmax2[3] = { type, INT_MAX, INT_MAX };
        -:  162:
        -:  163:            m_tree->Search( mmin2, mmax2, search );
        -:  164:        }
