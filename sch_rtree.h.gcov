        -:   74:    /**
        -:   75:     * Remove an item from the tree.
        -:   76:     *
        -:   77:     * Removal is done by comparing pointers, attempting to remove a copy of the item will fail.
        -:   78:     */
        -:   79:    bool remove( SCH_ITEM* aItem )
        -:   80:    {
