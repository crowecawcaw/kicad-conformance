    #####:  260:    void Add( BOARD_STACKUP_ITEM* aItem ) { m_list.push_back( aItem ); }
        -:  261:
        -:  262:    /**
        -:  263:     * Synchronize the BOARD_STACKUP_ITEM* list with the board.
        -:  264:     * Not enabled layers are removed
        -:  265:     * Missing layers are added
        -:  266:     * @param aSettings, is the current board setting.
        -:  267:     * @return true if changes are made
        -:  268:     */
        -:  269:    bool SynchronizeWithBoard( BOARD_DESIGN_SETTINGS* aSettings );
        -:  270:
        -:  271:    /**
        -:  272:     * Create a default stackup, according to the current BOARD_DESIGN_SETTINGS settings.
        -:  273:     * @param aSettings is the current board setting.
        -:  274:     * if nullptr, build a full stackup (with 32 copper layers)
        -:  275:     * @param aActiveCopperLayersCount is used only if aSettings == nullptr is the number
        -:  276:     * of copper layers to use to calculate a default dielectric thickness.
        -:  277:     * ((<= 0 to use all copper layers)
        -:  278:     */
        -:  279:    void BuildDefaultStackupList( const BOARD_DESIGN_SETTINGS* aSettings,
        -:  280:            int aActiveCopperLayersCount = 0 );
        -:  281:
        -:  282:    /**
        -:  283:     * Write the stackup info on board file
        -:  284:     * @param aFormatter is the OUTPUTFORMATTER used to create the file
        -:  285:     * @param aBoard is the board
        -:  286:     */
        -:  287:    void FormatBoardStackup( OUTPUTFORMATTER* aFormatter, const BOARD* aBoard ) const;
        -:  288:
        -:  289:    /**
        -:  290:     * Calculate the distance (height) between the two given copper layers.
        -:  291:     *
        -:  292:     * This factors in the thickness of any dielectric and copper layers between the two given
        -:  293:     * layers, and half the height of the given start and end layers.  This half-height calculation
        -:  294:     * allows this to be used for consistent length measurements when calculating net length through
        -:  295:     * a series of vias.  A more advanced algorithm would be possible once we have a good concept of
        -:  296:     * the start and end for a length measurement, but for now this will do.
        -:  297:     * See https://gitlab.com/kicad/code/kicad/-/issues/8384 for more background.
        -:  298:     *
        -:  299:     * @param aFirstLayer is a copper layer
        -:  300:     * @param aSecondLayer is a different copper layer
        -:  301:     * @return the height (in IU) between the two layers
        -:  302:     */
        -:  303:    int GetLayerDistance( PCB_LAYER_ID aFirstLayer, PCB_LAYER_ID aSecondLayer ) const;
        -:  304:
        -:  305:    /**
        -:  306:     * The name of external copper finish
        -:  307:     */
        -:  308:    wxString m_FinishType;
        -:  309:
        -:  310:    /**
        -:  311:     * True if some layers have impedance controlled tracks or have specific
        -:  312:     * constrains for micro-wave applications
        -:  313:     * If the board has dielectric constrains, the .gbrjob will contain
        -:  314:     * info about dielectric constrains: loss tangent and Epsilon rel.
        -:  315:     * If not, these values will be not specified in job file.
        -:  316:     */
        -:  317:    bool m_HasDielectricConstrains;
        -:  318:
