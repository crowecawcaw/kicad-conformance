        -:  320:     * True if some layers (copper and/or dielectric) have specific thickness
        -:  321:     */
        -:  322:    bool m_HasThicknessConstrains;
        -:  323:
        -:  324:    /**
        -:  325:     * If the board has edge connector cards, some constrains can be specified
        -:  326:     * in job file:
        -:  327:     *  BS_EDGE_CONNECTOR_NONE = no edge connector
        -:  328:     *  BS_EDGE_CONNECTOR_IN_USE = board has edge connectors
        -:  329:     *  BS_EDGE_CONNECTOR_BEVELLED = edge connectors are beveled
        -:  330:     */
        -:  331:    BS_EDGE_CONNECTOR_CONSTRAINTS m_EdgeConnectorConstraints;
        -:  332:
        -:  333:    bool m_EdgePlating;             ///< True if the edge board is plated
        -:  334:
        -:  335:private:
        -:  336:    // The list of items describing the stackup for fabrication.
        -:  337:    // this is not just copper layers, but also mask dielectric layers
        -:  338:    std::vector<BOARD_STACKUP_ITEM*> m_list;
        -:  339:};
