        -:  209:/**
        -:  210: * Manage layers needed to make a physical board.
        -:  211: *
        -:  212: * They are solder mask, silk screen, copper and dielectric.  Some other layers, used in
        -:  213: * fabrication, are not managed here because they are not used to make a physical board itself.
        -:  214: *
        -:  215: * @note There are a few other parameters related to the physical stackup like finish type,
        -:  216: *       impedance control and a few others.
        -:  217: */
        -:  218:class BOARD_STACKUP : public SERIALIZABLE
        -:  219:{
        -:  220:public:
        -:  221:    BOARD_STACKUP();
        -:  222:    BOARD_STACKUP( const BOARD_STACKUP& aOther );
        -:  223:    BOARD_STACKUP& operator=( const BOARD_STACKUP& aOther );
        -:  224:
        -:  225:    bool operator==( const BOARD_STACKUP& aOther ) const;
        -:  226:    bool operator!=( const BOARD_STACKUP& aOther ) const { return !operator==( aOther ); }
        -:  227:
        -:  228:    ~BOARD_STACKUP() { RemoveAll(); }
        -:  229:
        -:  230:    void Serialize( google::protobuf::Any &aContainer ) const override;
        -:  231:
        -:  232:    bool Deserialize( const google::protobuf::Any &aContainer ) override;
        -:  233:
        -:  234:    const std::vector<BOARD_STACKUP_ITEM*>& GetList() const { return m_list; }
        -:  235:
        -:  236:    /// @return a reference to the layer aIndex, or nullptr if not exists
        -:  237:    BOARD_STACKUP_ITEM* GetStackupLayer( int aIndex );
        -:  238:
        -:  239:    /**
        -:  240:     * @return the board layers full mask allowed in the stackup list
        -:  241:     * i.e. the SilkS, Mask, Paste and all copper layers
        -:  242:     */
        -:  243:    static LSET StackupAllowedBrdLayers()
        -:  244:    {
        -:  245:        return LSET( { F_SilkS, F_Mask, F_Paste, B_SilkS, B_Mask, B_Paste } )
        -:  246:               | LSET::ExternalCuMask() | LSET::InternalCuMask();
        -:  247:    }
        -:  248:
        -:  249:
        -:  250:    /// Delete all items in list and clear the list
        -:  251:    void RemoveAll();
        -:  252:
