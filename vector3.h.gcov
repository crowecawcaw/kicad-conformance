        -:   77:
        -:   78:    /**
        -:   79:     * Compute cross product of self with \a aVector
        -:   80:     */
        -:   81:    VECTOR3<T> Cross( const VECTOR3<T>& aVector ) const;
        -:   82:
        -:   83:    /**
        -:   84:     * Compute the dot product of self with \a aVector
        -:   85:     */
        -:   86:    VECTOR3<T>::extended_type Dot( const VECTOR3<T>& aVector ) const;
        -:   87:
        -:   88:    /**
        -:   89:     * Compute the Euclidean norm of the vector, which is defined as sqrt(x ** 2 + y ** 2).
        -:   90:     *
        -:   91:     * It is used to calculate the length of the vector.
        -:   92:     *
        -:   93:     * @return Scalar, the euclidean norm
