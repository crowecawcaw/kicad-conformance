        -:   46:/**
        -:   47: * Define a general 3D-vector.
        -:   48: *
        -:   49: * This class uses templates to be universal. Several operators are provided to help
        -:   50: * easy implementing of linear algebra equations.
        -:   51: *
        -:   52: */
        -:   53:template <class T = int>
        -:   54:class VECTOR3
        -:   55:{
        -:   56:public:
        -:   57:    typedef typename VECTOR3_TRAITS<T>::extended_type extended_type;
        -:   58:    typedef T                                         coord_type;
        -:   59:
        -:   60:    static constexpr extended_type ECOORD_MAX = std::numeric_limits<extended_type>::max();
        -:   61:    static constexpr extended_type ECOORD_MIN = std::numeric_limits<extended_type>::min();
        -:   62:
        -:   63:    T x{};
        -:   64:    T y{};
        -:   65:    T z{};
        -:   66:
        -:   67:    /// Construct a 3D-vector with x, y, z = 0
        -:   68:    VECTOR3() = default;
        -:   69:
        -:   70:    /// Construct a vector with given components x, y, z
        -:   71:    VECTOR3( T x, T y, T z );
        -:   72:
        -:   73:    /// Initializes a vector from another specialization. Beware of rounding
        -:   74:    /// issues.
