        -:   37:/**
        -:   38: * A set of EDA_ITEMs (i.e., without duplicates).
        -:   39: *
        -:   40: * The group parent is always board/sheet, not logical parent group. The group is transparent
        -:   41: * container - e.g., its position is derived from the position of its members.  A selection
        -:   42: * containing a group implicitly contains its members. However other operations on sets of
        -:   43: * items, like committing, updating the view, etc the set is explicit.
        -:   44: */
        -:   45:class EDA_GROUP
        -:   46:{
        -:   47:public:
        -:   48:    virtual EDA_ITEM* AsEdaItem() = 0;
        -:   49:    virtual ~EDA_GROUP() = default;
        -:   50:
    #####:   51:    wxString GetName() const { return m_name; }
        -:   52:    void     SetName( const wxString& aName ) { m_name = aName; }
        -:   53:
        -:   54:    std::unordered_set<EDA_ITEM*>& GetItems() { return m_items; }
    #####:   55:    const std::unordered_set<EDA_ITEM*>& GetItems() const { return m_items; }
        -:   56:
        -:   57:    /**
        -:   58:     * Test if an item is a direct or nested member of this group.
        -:   59:     */
        -:   60:    bool ContainsItem( const EDA_ITEM* aItem ) const;
        -:   61:
        -:   62:    /**
        -:   63:     * Add item to group. Does not take ownership of item.
        -:   64:     */
        -:   65:    void AddItem( EDA_ITEM* aItem );
        -:   66:
        -:   67:    /**
        -:   68:     * Remove item from group.
        -:   69:     */
        -:   70:    void RemoveItem( EDA_ITEM* aItem );
        -:   71:    void RemoveAll();
        -:   72:
        -:   73:    KIID_VECT_LIST GetGroupMemberIds() const;
        -:   74:
    #####:   75:    bool HasDesignBlockLink() const { return m_designBlockLibId.IsValid(); }
        -:   76:
        -:   77:    void SetDesignBlockLibId( const LIB_ID& aLibId ) { m_designBlockLibId = aLibId; }
    #####:   78:    const LIB_ID& GetDesignBlockLibId() const { return m_designBlockLibId; }
        -:   79:
        -:   80:protected:
        -:   81:    std::unordered_set<EDA_ITEM*> m_items;             // Members of the group (no ownership)
        -:   82:    wxString                      m_name;              // Optional group name
        -:   83:    LIB_ID                        m_designBlockLibId;  // Optional link to a design block
        -:   84:};
