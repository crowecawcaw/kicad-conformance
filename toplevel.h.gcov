        -:  254:
        -:  255:    // Class for saving/restoring fields describing the window geometry.
        -:  256:    //
        -:  257:    // This class is used by the functions below to allow saving the geometry
        -:  258:    // of the window and restoring it later. The components describing geometry
        -:  259:    // are platform-dependent, so there is no struct containing them and
        -:  260:    // instead the methods of this class are used to save or [try to] restore
        -:  261:    // whichever components are used under the current platform.
        -:  262:    class GeometrySerializer
        -:  263:    {
        -:  264:    public:
        -:  265:        virtual ~GeometrySerializer() {}
        -:  266:
        -:  267:        // If saving a field returns false, it's fatal error and SaveGeometry()
        -:  268:        // will return false.
        -:  269:        virtual bool SaveField(const wxString& name, int value) const = 0;
        -:  270:
        -:  271:        // If restoring a field returns false, it just means that the field is
        -:  272:        // not present and RestoreToGeometry() still continues with restoring
        -:  273:        // the other values.
        -:  274:        virtual bool RestoreField(const wxString& name, int* value) = 0;
        -:  275:    };
        -:  276:
        -:  277:    // Save the current window geometry using the provided serializer and
        -:  278:    // restore the window to the previously saved geometry.
        -:  279:    bool SaveGeometry(const GeometrySerializer& ser) const;
        -:  280:    bool RestoreToGeometry(GeometrySerializer& ser);
        -:  281:
        -:  282:
        -:  283:    // implementation only from now on
