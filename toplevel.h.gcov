        -:  129:// ----------------------------------------------------------------------------
        -:  130:// wxTopLevelWindow: a top level (as opposed to child) window
        -:  131:// ----------------------------------------------------------------------------
        -:  132:
        -:  133:class WXDLLIMPEXP_CORE wxTopLevelWindowBase : public wxNonOwnedWindow
        -:  134:{
        -:  135:public:
        -:  136:    // construction
        -:  137:    wxTopLevelWindowBase();
        -:  138:    virtual ~wxTopLevelWindowBase();
        -:  139:
        -:  140:    // top level wnd state
        -:  141:    // --------------------
        -:  142:
        -:  143:    // maximize = true => maximize, otherwise - restore
        -:  144:    virtual void Maximize(bool maximize = true) = 0;
        -:  145:
        -:  146:    // undo Maximize() or Iconize()
        -:  147:    virtual void Restore() = 0;
        -:  148:
        -:  149:    // iconize = true => iconize, otherwise - restore
        -:  150:    virtual void Iconize(bool iconize = true) = 0;
        -:  151:
        -:  152:    // return true if the frame is maximized
        -:  153:    virtual bool IsMaximized() const = 0;
        -:  154:
        -:  155:    // return true if the frame is always maximized
        -:  156:    // due to native guidelines or current policy
        -:  157:    virtual bool IsAlwaysMaximized() const;
        -:  158:
        -:  159:    // return true if the frame is iconized
        -:  160:    virtual bool IsIconized() const = 0;
        -:  161:
        -:  162:    // get the frame icon
        -:  163:    wxIcon GetIcon() const;
        -:  164:
        -:  165:    // get the frame icons
        -:  166:    const wxIconBundle& GetIcons() const { return m_icons; }
        -:  167:
        -:  168:    // set the frame icon: implemented in terms of SetIcons()
        -:  169:    void SetIcon(const wxIcon& icon);
        -:  170:
        -:  171:    // set the frame icons
        -:  172:    virtual void SetIcons(const wxIconBundle& icons) { m_icons = icons; }
        -:  173:
    #####:  174:    virtual bool EnableFullScreenView(bool WXUNUSED(enable) = true,
        -:  175:                                      long WXUNUSED(style) = wxFULLSCREEN_ALL)
        -:  176:    {
    #####:  177:        return false;
        -:  178:    }
        -:  179:
        -:  180:    // maximize the window to cover entire screen
        -:  181:    virtual bool ShowFullScreen(bool show, long style = wxFULLSCREEN_ALL) = 0;
        -:  182:
        -:  183:    // shows the window, but doesn't activate it. If the base code is being run,
        -:  184:    // it means the port doesn't implement this method yet and so alert the user.
        -:  185:    virtual void ShowWithoutActivating() {
        -:  186:        wxFAIL_MSG("ShowWithoutActivating not implemented on this platform.");
        -:  187:    }
        -:  188:
        -:  189:    // return true if the frame is in fullscreen mode
        -:  190:    virtual bool IsFullScreen() const = 0;
        -:  191:
    #####:  192:    virtual wxContentProtection GetContentProtection() const
    #####:  193:        { return wxCONTENT_PROTECTION_NONE; }
    #####:  194:    virtual bool SetContentProtection(wxContentProtection WXUNUSED(contentProtection))
    #####:  195:        { return false; }
        -:  196:
        -:  197:    // the title of the top level window: the text which the
        -:  198:    // window shows usually at the top of the frame/dialog in dedicated bar
        -:  199:    virtual void SetTitle(const wxString& title) = 0;
        -:  200:    virtual wxString GetTitle() const = 0;
        -:  201:
        -:  202:    // enable/disable close button [x]
        -:  203:    virtual bool EnableCloseButton(bool WXUNUSED(enable) = true) { return false; }
    #####:  204:    virtual bool EnableMaximizeButton(bool WXUNUSED(enable) = true) { return false; }
    #####:  205:    virtual bool EnableMinimizeButton(bool WXUNUSED(enable) = true) { return false; }
        -:  206:
        -:  207:    // Attracts the users attention to this window if the application is
        -:  208:    // inactive (should be called when a background event occurs)
        -:  209:    virtual void RequestUserAttention(int flags = wxUSER_ATTENTION_INFO);
        -:  210:
        -:  211:    // Is this the active frame (highlighted in the taskbar)?
        -:  212:    //
        -:  213:    // A TLW is active only if it contains the currently focused window.
        -:  214:    virtual bool IsActive() { return IsDescendant(FindFocus()); }
        -:  215:
        -:  216:    // this function may be overridden to return false to allow closing the
        -:  217:    // application even when this top level window is still open
        -:  218:    //
        -:  219:    // notice that the window is still closed prior to the application exit and
        -:  220:    // so it can still veto it even if it returns false from here
    #####:  221:    virtual bool ShouldPreventAppExit() const { return true; }
        -:  222:
        -:  223:    // centre the window on screen: this is just a shortcut
        -:  224:    void CentreOnScreen(int dir = wxBOTH) { DoCentre(dir | wxCENTRE_ON_SCREEN); }
        -:  225:    void CenterOnScreen(int dir = wxBOTH) { CentreOnScreen(dir); }
        -:  226:
        -:  227:    // Get the default size for a new top level window. This is used when
        -:  228:    // creating a wxTLW under some platforms if no explicit size given.
        -:  229:    static wxSize GetDefaultSize();
        -:  230:
        -:  231:
        -:  232:    // default item access: we have a permanent default item which is the one
        -:  233:    // set by the user code but we may also have a temporary default item which
        -:  234:    // would be chosen if the user pressed "Enter" now but the default action
        -:  235:    // reverts to the "permanent" default as soon as this temporary default
        -:  236:    // item loses focus
        -:  237:
        -:  238:    // get the default item, temporary or permanent
        -:  239:    wxWindow *GetDefaultItem() const
        -:  240:        { return m_winTmpDefault ? m_winTmpDefault : m_winDefault; }
        -:  241:
        -:  242:    // set the permanent default item, return the old default
        -:  243:    wxWindow *SetDefaultItem(wxWindow *win)
        -:  244:        { wxWindow *old = GetDefaultItem(); m_winDefault = win; return old; }
        -:  245:
        -:  246:    // return the temporary default item, can be NULL
        -:  247:    wxWindow *GetTmpDefaultItem() const { return m_winTmpDefault; }
        -:  248:
        -:  249:    // set a temporary default item, SetTmpDefaultItem(NULL) should be called
        -:  250:    // soon after a call to SetTmpDefaultItem(window), return the old default
        -:  251:    wxWindow *SetTmpDefaultItem(wxWindow *win)
        -:  252:        { wxWindow *old = GetDefaultItem(); m_winTmpDefault = win; return old; }
