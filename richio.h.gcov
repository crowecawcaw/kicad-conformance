        -:  152:/**
        -:  153: * A LINE_READER that reads from an open file.
        -:  154: *
        -:  155: * File must be already open so that this class can exist without any UI policy.
        -:  156: */
        -:  157:class KICOMMON_API FILE_LINE_READER : public LINE_READER
        -:  158:{
        -:  159:public:
        -:  160:    /**
        -:  161:     * Take @a aFileName and the size of the desired line buffer and opens the file and
        -:  162:     * assumes the obligation to close it.
        -:  163:     *
        -:  164:     * @param aFileName is the name of the file to open and to use for error reporting purposes.
        -:  165:     * @param aStartingLineNumber is the initial line number to report on error, and is
        -:  166:     *  accessible here for the case where multiple DSNLEXERs are reading from the
        -:  167:     *  same file in sequence, all from the same open file (with @a doOwn = false).
        -:  168:     *  Internally it is incremented by one after each ReadLine(), so the first
        -:  169:     *  reported line number will always be one greater than what is provided here.
        -:  170:     * @param aMaxLineLength is the number of bytes to use in the line buffer.
        -:  171:     *
        -:  172:     * @throw IO_ERROR if @a aFileName cannot be opened.
        -:  173:     */
        -:  174:    FILE_LINE_READER( const wxString& aFileName, unsigned aStartingLineNumber = 0,
        -:  175:                      unsigned aMaxLineLength = LINE_READER_LINE_DEFAULT_MAX );
        -:  176:
        -:  177:    /**
        -:  178:     * Take an open FILE and the size of the desired line buffer and takes ownership of
        -:  179:     * the open file, i.e. assumes the obligation to close it.
        -:  180:     *
        -:  181:     * @param aFile is an open file.
        -:  182:     * @param aFileName is the name of the file for error reporting purposes.
        -:  183:     * @param doOwn if true, means I should close the open file, else not.
        -:  184:     * @param aStartingLineNumber is the initial line number to report on error, and is
        -:  185:     *  accessible here for the case where multiple DSNLEXERs are reading from the
        -:  186:     *  same file in sequence, all from the same open file (with @a doOwn = false).
        -:  187:     *  Internally it is incremented by one after each ReadLine(), so the first
        -:  188:     *  reported line number will always be one greater than what is provided here.
        -:  189:     * @param aMaxLineLength is the number of bytes to use in the line buffer.
        -:  190:     */
        -:  191:    FILE_LINE_READER( FILE* aFile, const wxString& aFileName, bool doOwn = true,
        -:  192:                      unsigned aStartingLineNumber = 0,
        -:  193:                      unsigned aMaxLineLength = LINE_READER_LINE_DEFAULT_MAX );
        -:  194:
        -:  195:    /**
        -:  196:     * May or may not close the open file, depending on @a doOwn in constructor.
        -:  197:     */
        -:  198:    ~FILE_LINE_READER();
        -:  199:
        -:  200:    char* ReadLine() override;
        -:  201:
        -:  202:    /**
        -:  203:     * Rewind the file and resets the line number back to zero.
        -:  204:     *
        -:  205:     * Line number will go to 1 on first ReadLine().
        -:  206:     */
    #####:  207:    void Rewind()
        -:  208:    {
    #####:  209:        rewind( m_fp );
    #####:  210:        m_lineNum = 0;
    #####:  211:    }
        -:  212:
        -:  213:    long int FileLength();
        -:  214:    long int CurPos();
        -:  215:
        -:  216:protected:
        -:  217:    bool    m_iOwn; ///< if I own the file, I'll promise to close it, else not.
        -:  218:    FILE*   m_fp;   ///< I may own this file, but might not.
        -:  219:};
