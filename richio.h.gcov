        -:  128:    unsigned Length() const
        -:  129:    {
        -:  130:        return m_length;
        -:  131:    }
        -:  132:
        -:  133:protected:
        -:  134:    /**
        -:  135:     * Will expand the capacity of @a line up to maxLineLength but not greater, so
        -:  136:     * be careful about making assumptions of @a capacity after calling this.
        -:  137:     */
        -:  138:    void        expandCapacity( unsigned aNewsize );
        -:  139:
        -:  140:    unsigned    m_length;         ///< no. bytes in line before trailing nul.
        -:  141:    unsigned    m_lineNum;
        -:  142:
        -:  143:    char*       m_line;           ///< the read line of UTF8 text
