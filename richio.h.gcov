        -:   61:/**
        -:   62: * An abstract class from which implementation specific LINE_READERs may be derived to
        -:   63: * read single lines of text and manage a line number counter.
        -:   64: */
        -:   65:class KICOMMON_API LINE_READER
        -:   66:{
        -:   67:public:
        -:   68:
        -:   69:    /**
        -:   70:     * Build a line reader and fixes the length of the maximum supported line length
        -:   71:     * to @a aMaxLineLength.
        -:   72:     */
        -:   73:    LINE_READER( unsigned aMaxLineLength = LINE_READER_LINE_DEFAULT_MAX );
        -:   74:
        -:   75:    virtual ~LINE_READER();
        -:   76:
        -:   77:    /**
        -:   78:     * Read a line of text into the buffer and increments the line number counter.
        -:   79:     *
        -:   80:     * If the line is larger than the maximum length passed to the constructor, then an
        -:   81:     * exception is thrown.  The line is nul terminated.
        -:   82:     *
        -:   83:     * @return The beginning of the read line, or NULL if EOF.
        -:   84:     * @throw IO_ERROR when a line is too long.
        -:   85:     */
        -:   86:    virtual char* ReadLine() = 0;
        -:   87:
        -:   88:    /**
        -:   89:     * Returns the name of the source of the lines in an abstract sense.
        -:   90:     *
        -:   91:     * This may be a file or it may be the clipboard or any other source of lines of text.
        -:   92:     * The returned string is useful for reporting error messages.
        -:   93:     */
        -:   94:    virtual const wxString& GetSource() const
        -:   95:    {
        -:   96:        return m_source;
        -:   97:    }
        -:   98:
        -:   99:    /**
        -:  100:     * Return a pointer to the last line that was read in.
        -:  101:     */
    #####:  102:    char* Line() const
        -:  103:    {
    #####:  104:        return m_line;
        -:  105:    }
        -:  106:
        -:  107:    /**
        -:  108:     * A casting operator that returns a char* pointer to the start of the line buffer.
        -:  109:     */
    #####:  110:    operator char* () const
        -:  111:    {
    #####:  112:        return Line();
        -:  113:    }
        -:  114:
        -:  115:    /**
        -:  116:     * Return the line number of the last line read from this LINE_READER.
