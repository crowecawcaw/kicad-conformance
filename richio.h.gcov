        -:  277:#define OUTPUTFMTBUFZ    500        ///< default buffer size for any OUTPUT_FORMATTER
        -:  278:
        -:  279:/**
        -:  280: * An interface used to output 8 bit text in a convenient way.
        -:  281: *
        -:  282: * The primary interface is "printf() - like" but with support for indentation control.  The
        -:  283: * destination of the 8 bit wide text is up to the implementer.
        -:  284: * <p>
        -:  285: * The implementer only has to implement the write() function, but can also optionally
        -:  286: * re-implement GetQuoteChar().
        -:  287: * <p>
        -:  288: * If you want to output a wxString, then use TO_UTF8() on it before passing it as an
        -:  289: * argument to Print().
        -:  290: * <p>
        -:  291: * Since this is an abstract interface, only classes derived from this one may actually be
        -:  292: * used.
        -:  293: */
        -:  294:class KICOMMON_API OUTPUTFORMATTER
        -:  295:{
        -:  296:protected:
    #####:  297:    OUTPUTFORMATTER( int aReserve = OUTPUTFMTBUFZ, char aQuoteChar = '"' ) :
    #####:  298:            m_buffer( aReserve, '\0' )
        -:  299:    {
    #####:  300:        quoteChar[0] = aQuoteChar;
    #####:  301:        quoteChar[1] = '\0';
    #####:  302:    }
        -:  303:
        -:  304:    /**
        -:  305:     * Perform quote character need determination according to the Specctra DSN specification.
        -:  306:
        -:  307:     * @param wrapee A string that might need wrapping on each end.
        -:  308:     * @param quote_char A single character C string which provides the current
        -:  309:     *                   quote character, should it be needed by the wrapee.
        -:  310:     *
        -:  311:     * @return the quote_char as a single character string, or "" if the wrapee does not need
        -:  312:     *         to be wrapped.
        -:  313:     */
        -:  314:    static const char* GetQuoteChar( const char* wrapee, const char* quote_char );
        -:  315:
        -:  316:    /**
        -:  317:     * Should be coded in the interface implementation (derived) classes.
        -:  318:     *
        -:  319:     * @param aOutBuf is the start of a byte buffer to write.
        -:  320:     * @param aCount  tells how many bytes to write.
        -:  321:     * @throw IO_ERROR, if there is a problem outputting, such as a full disk.
        -:  322:     */
        -:  323:    virtual void write( const char* aOutBuf, int aCount ) = 0;
        -:  324:
        -:  325:#if defined(__GNUG__)   // The GNU C++ compiler defines this
        -:  326:
        -:  327:    // When used on a C++ function, we must account for the "this" pointer,
        -:  328:    // so increase the STRING-INDEX and FIRST-TO_CHECK by one.
        -:  329:    // See http://docs.freebsd.org/info/gcc/gcc.info.Function_Attributes.html
        -:  330:    // Then to get format checking during the compile, compile with -Wall or -Wformat
        -:  331:#define PRINTF_FUNC_N __attribute__( ( format( printf, 3, 4 ) ) )
        -:  332:#define PRINTF_FUNC __attribute__( ( format( printf, 2, 3 ) ) )
        -:  333:#else
        -:  334:#define PRINTF_FUNC_N     // nothing
        -:  335:#define PRINTF_FUNC       // nothing
        -:  336:#endif
        -:  337:
        -:  338:public:
        -:  339:    /**
        -:  340:     * This is a polymorphic class that can validly be handled by a pointer to the base class.
        -:  341:     */
    #####:  342:    virtual ~OUTPUTFORMATTER() {}
------------------
OUTPUTFORMATTER::~OUTPUTFORMATTER():
    #####:  342:    virtual ~OUTPUTFORMATTER() {}
------------------
OUTPUTFORMATTER::~OUTPUTFORMATTER():
    #####:  342:    virtual ~OUTPUTFORMATTER() {}
