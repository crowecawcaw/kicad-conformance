        -:   31:/**
        -:   32: * A specialisation of the RC_TREE_MODEL class to enable ERC errors / warnings to be resolved in
        -:   33: * a specific sheet path context. This allows the displayed ERC descriptions in the ERC dialog to
        -:   34: * reflect component references on a per-sheet basis in hierarchical schematics.
        -:   35: * @see RC_TREE_MODEL
        -:   36: */
        -:   37:class ERC_TREE_MODEL : public RC_TREE_MODEL
        -:   38:{
        -:   39:public:
        -:   40:    ERC_TREE_MODEL( EDA_DRAW_FRAME* aParentFrame, wxDataViewCtrl* aView ) :
        -:   41:            RC_TREE_MODEL( aParentFrame, aView )
        -:   42:    {
        -:   43:    }
        -:   44:
        -:   45:    ~ERC_TREE_MODEL() {}
        -:   46:
        -:   47:    /**
        -:   48:     * Override of RC_TREE_MODEL::GetValue which returns item descriptions in a specific
        -:   49:     * SCH_SHEET_PATH context, if a context is available on the given SCH_MARKER or ERC_ITEM
        -:   50:     * targets.
        -:   51:     */
        -:   52:    void GetValue( wxVariant& aVariant, wxDataViewItem const& aItem,
        -:   53:                   unsigned int aCol ) const override;
        -:   54:};
