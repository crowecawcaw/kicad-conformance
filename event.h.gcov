        -:  211:
        -:  212:    // Return a wxEventType reference for the initialization of the static
        -:  213:    // event tables. See wxEventTableEntry::m_eventType for a more thorough
        -:  214:    // explanation.
    #####:  215:    operator const wxEventType&() const { return m_type; }
------------------
wxEventTypeTag<wxCommandEvent>::operator int const&() const:
    #####:  215:    operator const wxEventType&() const { return m_type; }
------------------
