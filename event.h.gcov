        -: 1414:        : wxEvent(other)
        -: 1415:    {
        -: 1416:    }
        -: 1417:
        -: 1418:    virtual void Execute() = 0;
        -: 1419:};
        -: 1420:
        -: 1421:// This is a version for calling methods without parameters.
        -: 1422:template <typename T>
        -: 1423:class wxAsyncMethodCallEvent0 : public wxAsyncMethodCallEvent
        -: 1424:{
        -: 1425:public:
        -: 1426:    typedef T ObjectType;
        -: 1427:    typedef void (ObjectType::*MethodType)();
        -: 1428:
        -: 1429:    wxAsyncMethodCallEvent0(ObjectType* object,
        -: 1430:                            MethodType method)
        -: 1431:        : wxAsyncMethodCallEvent(object),
        -: 1432:          m_object(object),
        -: 1433:          m_method(method)
        -: 1434:    {
        -: 1435:    }
        -: 1436:
        -: 1437:    wxAsyncMethodCallEvent0(const wxAsyncMethodCallEvent0& other)
        -: 1438:        : wxAsyncMethodCallEvent(other),
        -: 1439:          m_object(other.m_object),
        -: 1440:          m_method(other.m_method)
        -: 1441:    {
        -: 1442:    }
        -: 1443:
        -: 1444:    virtual wxEvent *Clone() const wxOVERRIDE
        -: 1445:    {
        -: 1446:        return new wxAsyncMethodCallEvent0(*this);
        -: 1447:    }
        -: 1448:
        -: 1449:    virtual void Execute() wxOVERRIDE
        -: 1450:    {
        -: 1451:        (m_object->*m_method)();
        -: 1452:    }
        -: 1453:
        -: 1454:private:
        -: 1455:    ObjectType* const m_object;
        -: 1456:    const MethodType m_method;
        -: 1457:};
        -: 1458:
        -: 1459:// This is a version for calling methods with a single parameter.
        -: 1460:template <typename T, typename T1>
        -: 1461:class wxAsyncMethodCallEvent1 : public wxAsyncMethodCallEvent
        -: 1462:{
        -: 1463:public:
        -: 1464:    typedef T ObjectType;
        -: 1465:    typedef void (ObjectType::*MethodType)(T1 x1);
        -: 1466:    typedef typename wxRemoveRef<T1>::type ParamType1;
        -: 1467:
        -: 1468:    wxAsyncMethodCallEvent1(ObjectType* object,
        -: 1469:                            MethodType method,
        -: 1470:                            const ParamType1& x1)
        -: 1471:        : wxAsyncMethodCallEvent(object),
        -: 1472:          m_object(object),
        -: 1473:          m_method(method),
        -: 1474:          m_param1(x1)
        -: 1475:    {
