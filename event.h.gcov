        -: 4129:    wxEventConnectionRef(wxEvtHandler *src, wxEvtHandler *sink)
        -: 4130:        : m_src(src), m_sink(sink), m_refCount(1)
        -: 4131:    {
        -: 4132:        m_sink->AddNode(this);
        -: 4133:    }
        -: 4134:
        -: 4135:    // The sink is being destroyed
        -: 4136:    virtual void OnObjectDestroy( ) wxOVERRIDE
        -: 4137:    {
        -: 4138:        if ( m_src )
        -: 4139:            m_src->OnSinkDestroyed( m_sink );
        -: 4140:        delete this;
        -: 4141:    }
        -: 4142:
        -: 4143:    virtual wxEventConnectionRef *ToEventConnection() wxOVERRIDE { return this; }
        -: 4144:
        -: 4145:    void IncRef() { m_refCount++; }
        -: 4146:    void DecRef()
        -: 4147:    {
        -: 4148:        if ( !--m_refCount )
        -: 4149:        {
        -: 4150:            // The sink holds the only external pointer to this object
        -: 4151:            if ( m_sink )
        -: 4152:                m_sink->RemoveNode(this);
        -: 4153:            delete this;
        -: 4154:        }
        -: 4155:    }
        -: 4156:
        -: 4157:private:
