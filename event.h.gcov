        -:  944:
        -:  945:    // a special category used as an argument to wxEventLoopBase::YieldFor to indicate that
        -:  946:    // Yield() should leave all wxEvents on the queue while emptying the native event queue
        -:  947:    // (native events will be processed but the wxEvents they generate will be queued)
        -:  948:    wxEVT_CATEGORY_CLIPBOARD = 64,
        -:  949:
        -:  950:
        -:  951:    // shortcut masks
        -:  952:
        -:  953:    // this category groups those events which are emitted in response to
        -:  954:    // events of the native toolkit and which typically are not-"delayable".
