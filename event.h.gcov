        -:  933:
        -:  934:    // this category is for any event used to send notifications from the
        -:  935:    // secondary threads to the main one or in general for notifications among
        -:  936:    // different threads (which may or may not be user-generated)
        -:  937:    wxEVT_CATEGORY_THREAD = 16,
        -:  938:
        -:  939:
        -:  940:    // implementation only
        -:  941:
        -:  942:    // used in the implementations of wxEventLoopBase::YieldFor
