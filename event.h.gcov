        -: 3238:          m_flags(event.m_flags),
        -: 3239:          m_focus(event.m_focus)
        -: 3240:        { }
        -: 3241:
        -: 3242:    // direction: forward (true) or backward (false)
        -: 3243:    bool GetDirection() const
        -: 3244:        { return (m_flags & IsForward) != 0; }
        -: 3245:    void SetDirection(bool bForward)
        -: 3246:        { if ( bForward ) m_flags |= IsForward; else m_flags &= ~IsForward; }
        -: 3247:
        -: 3248:    // it may be a window change event (MDI, notebook pages...) or a control
        -: 3249:    // change event
        -: 3250:    bool IsWindowChange() const
        -: 3251:        { return (m_flags & WinChange) != 0; }
        -: 3252:    void SetWindowChange(bool bIs)
        -: 3253:        { if ( bIs ) m_flags |= WinChange; else m_flags &= ~WinChange; }
        -: 3254:
        -: 3255:    // Set to true under MSW if the event was generated using the tab key.
        -: 3256:    // This is required for proper navogation over radio buttons
        -: 3257:    bool IsFromTab() const
        -: 3258:        { return (m_flags & FromTab) != 0; }
        -: 3259:    void SetFromTab(bool bIs)
        -: 3260:        { if ( bIs ) m_flags |= FromTab; else m_flags &= ~FromTab; }
        -: 3261:
        -: 3262:    // the child which has the focus currently (may be NULL - use
        -: 3263:    // wxWindow::FindFocus then)
        -: 3264:    wxWindow* GetCurrentFocus() const { return m_focus; }
        -: 3265:    void SetCurrentFocus(wxWindow *win) { m_focus = win; }
        -: 3266:
        -: 3267:    // Set flags
        -: 3268:    void SetFlags(long flags) { m_flags = flags; }
        -: 3269:
