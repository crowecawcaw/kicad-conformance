        -: 1499:    const ParamType1 m_param1;
        -: 1500:};
        -: 1501:
        -: 1502:// This is a version for calling methods with two parameters.
        -: 1503:template <typename T, typename T1, typename T2>
        -: 1504:class wxAsyncMethodCallEvent2 : public wxAsyncMethodCallEvent
        -: 1505:{
        -: 1506:public:
