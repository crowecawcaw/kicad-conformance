        -: 4494:/*
        -: 4495: * Event table macros
        -: 4496: */
        -: 4497:
        -: 4498:// helpers for writing shorter code below: declare an event macro taking 2, 1
        -: 4499:// or none ids (the missing ids default to wxID_ANY)
        -: 4500://
        -: 4501:// macro arguments:
        -: 4502://  - evt one of wxEVT_XXX constants
        -: 4503://  - id1, id2 ids of the first/last id
        -: 4504://  - fn the function (should be cast to the right type)
        -: 4505:#define wx__DECLARE_EVT2(evt, id1, id2, fn) \
        -: 4506:    wxDECLARE_EVENT_TABLE_ENTRY(evt, id1, id2, fn, NULL),
        -: 4507:#define wx__DECLARE_EVT1(evt, id, fn) \
        -: 4508:    wx__DECLARE_EVT2(evt, id, wxID_ANY, fn)
        -: 4509:#define wx__DECLARE_EVT0(evt, fn) \
        -: 4510:    wx__DECLARE_EVT1(evt, wxID_ANY, fn)
        -: 4511:
        -: 4512:
        -: 4513:// Generic events
        -: 4514:#define EVT_CUSTOM(event, winid, func) \
        -: 4515:    wx__DECLARE_EVT1(event, winid, wxEventHandler(func))
        -: 4516:#define EVT_CUSTOM_RANGE(event, id1, id2, func) \
        -: 4517:    wx__DECLARE_EVT2(event, id1, id2, wxEventHandler(func))
        -: 4518:
        -: 4519:// EVT_COMMAND
        -: 4520:#define EVT_COMMAND(winid, event, func) \
        -: 4521:    wx__DECLARE_EVT1(event, winid, wxCommandEventHandler(func))
        -: 4522:
        -: 4523:#define EVT_COMMAND_RANGE(id1, id2, event, func) \
        -: 4524:    wx__DECLARE_EVT2(event, id1, id2, wxCommandEventHandler(func))
        -: 4525:
        -: 4526:#define EVT_NOTIFY(event, winid, func) \
        -: 4527:    wx__DECLARE_EVT1(event, winid, wxNotifyEventHandler(func))
        -: 4528:
        -: 4529:#define EVT_NOTIFY_RANGE(event, id1, id2, func) \
        -: 4530:    wx__DECLARE_EVT2(event, id1, id2, wxNotifyEventHandler(func))
        -: 4531:
        -: 4532:// Miscellaneous
        -: 4533:#define EVT_SIZE(func)  wx__DECLARE_EVT0(wxEVT_SIZE, wxSizeEventHandler(func))
        -: 4534:#define EVT_SIZING(func)  wx__DECLARE_EVT0(wxEVT_SIZING, wxSizeEventHandler(func))
        -: 4535:#define EVT_MOVE(func)  wx__DECLARE_EVT0(wxEVT_MOVE, wxMoveEventHandler(func))
