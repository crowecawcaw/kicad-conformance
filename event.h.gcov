        -: 3220:/*
        -: 3221: Event generated by dialog navigation keys
        -: 3222: wxEVT_NAVIGATION_KEY
        -: 3223: */
        -: 3224:// NB: don't derive from command event to avoid being propagated to the parent
        -: 3225:class WXDLLIMPEXP_CORE wxNavigationKeyEvent : public wxEvent
        -: 3226:{
        -: 3227:public:
        -: 3228:    wxNavigationKeyEvent()
        -: 3229:        : wxEvent(0, wxEVT_NAVIGATION_KEY),
        -: 3230:          m_flags(IsForward | FromTab),    // defaults are for TAB
        -: 3231:          m_focus(NULL)
