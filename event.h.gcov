        -:  580:
        -:  581:// Create functors for the templatized events, either allocated on the heap for
        -:  582:// wxNewXXX() variants (this is needed in wxEvtHandler::Bind<>() to store them
        -:  583:// in dynamic event table) or just by returning them as temporary objects (this
        -:  584:// is enough for Unbind<>() and we avoid unnecessary heap allocation like this).
        -:  585:
        -:  586:
        -:  587:// Create functors wrapping functions:
        -:  588:template <typename EventTag, typename EventArg>
        -:  589:inline wxEventFunctorFunction<EventTag, EventArg> *
        -:  590:wxNewEventFunctor(const EventTag&, void (*func)(EventArg &))
        -:  591:{
        -:  592:    return new wxEventFunctorFunction<EventTag, EventArg>(func);
        -:  593:}
        -:  594:
        -:  595:template <typename EventTag, typename EventArg>
        -:  596:inline wxEventFunctorFunction<EventTag, EventArg>
        -:  597:wxMakeEventFunctor(const EventTag&, void (*func)(EventArg &))
        -:  598:{
        -:  599:    return wxEventFunctorFunction<EventTag, EventArg>(func);
        -:  600:}
        -:  601:
        -:  602:// Create functors wrapping other functors:
        -:  603:template <typename EventTag, typename Functor>
        -:  604:inline wxEventFunctorFunctor<EventTag, Functor> *
        -:  605:wxNewEventFunctor(const EventTag&, const Functor &func)
        -:  606:{
        -:  607:    return new wxEventFunctorFunctor<EventTag, Functor>(func);
        -:  608:}
        -:  609:
        -:  610:template <typename EventTag, typename Functor>
        -:  611:inline wxEventFunctorFunctor<EventTag, Functor>
        -:  612:wxMakeEventFunctor(const EventTag&, const Functor &func)
        -:  613:{
        -:  614:    return wxEventFunctorFunctor<EventTag, Functor>(func);
        -:  615:}
        -:  616:
        -:  617:// Create functors wrapping methods:
        -:  618:template
        -:  619:  <typename EventTag, typename Class, typename EventArg, typename EventHandler>
        -:  620:inline wxEventFunctorMethod<EventTag, Class, EventArg, EventHandler> *
        -:  621:wxNewEventFunctor(const EventTag&,
        -:  622:                  void (Class::*method)(EventArg&),
        -:  623:                  EventHandler *handler)
        -:  624:{
        -:  625:    return new wxEventFunctorMethod<EventTag, Class, EventArg, EventHandler>(
        -:  626:                method, handler);
        -:  627:}
        -:  628:
        -:  629:template
        -:  630:    <typename EventTag, typename Class, typename EventArg, typename EventHandler>
        -:  631:inline wxEventFunctorMethod<EventTag, Class, EventArg, EventHandler>
        -:  632:wxMakeEventFunctor(const EventTag&,
        -:  633:                   void (Class::*method)(EventArg&),
        -:  634:                   EventHandler *handler)
        -:  635:{
        -:  636:    return wxEventFunctorMethod<EventTag, Class, EventArg, EventHandler>(
        -:  637:                method, handler);
        -:  638:}
        -:  639:
        -:  640:// Create an event functor for the event table via wxDECLARE_EVENT_TABLE_ENTRY:
        -:  641:// in this case we don't have the handler (as it's always the same as the
        -:  642:// object which generated the event) so we must use Class as its type
        -:  643:template <typename EventTag, typename Class, typename EventArg>
        -:  644:inline wxEventFunctorMethod<EventTag, Class, EventArg, Class> *
        -:  645:wxNewEventTableFunctor(const EventTag&, void (Class::*method)(EventArg&))
        -:  646:{
        -:  647:    return new wxEventFunctorMethod<EventTag, Class, EventArg, Class>(
        -:  648:                    method, NULL);
        -:  649:}
