        -:  194:// Try to cast the given event handler to the correct handler type:
        -:  195:#define wxEVENT_HANDLER_CAST( functype, func ) \
        -:  196:    wxEventFunctionCast(wxEventHandlerNoexceptCast(functype, &func))
