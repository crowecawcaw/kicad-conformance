        -:  463:    EventHandler *m_handler;
        -:  464:    void (Class::*m_method)(EventArg&);
        -:  465:
        -:  466:    // Provide a dummy default ctor for type info purposes
        -:  467:    wxEventFunctorMethod() { }
        -:  468:
