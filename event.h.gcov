        -:  122:// The type-erased method signature used for event handling.
        -:  123:typedef void (wxEvtHandler::*wxEventFunction)(wxEvent&);
        -:  124:
        -:  125:template <typename T>
        -:  126:inline wxEventFunction wxEventFunctionCast(void (wxEvtHandler::*func)(T&))
        -:  127:{
        -:  128:    // There is no going around the cast here: we do rely calling the event
        -:  129:    // handler method, which takes a reference to an object of a class derived
        -:  130:    // from wxEvent, as if it took wxEvent itself. On all platforms supported
        -:  131:    // by wxWidgets, this cast is harmless, but it's not a valid cast in C++
        -:  132:    // and gcc 8 started giving warnings about this (with -Wextra), so suppress
        -:  133:    // them locally to avoid generating hundreds of them when compiling any
        -:  134:    // code using event table macros.
        -:  135:
        -:  136:    wxGCC_WARNING_SUPPRESS_CAST_FUNCTION_TYPE()
        -:  137:    wxCLANG_WARNING_SUPPRESS(cast-function-type)
        -:  138:
        -:  139:    return reinterpret_cast<wxEventFunction>(func);
        -:  140:
        -:  141:    wxCLANG_WARNING_RESTORE(cast-function-type)
        -:  142:    wxGCC_WARNING_RESTORE_CAST_FUNCTION_TYPE()
        -:  143:}
        -:  144:
        -:  145:// In good old pre-C++17 times we could just static_cast the event handler,
        -:  146:// defined in some class deriving from wxEvtHandler, to the "functype" which is
        -:  147:// a type of wxEvtHandler method. But with C++17 this doesn't work when the
        -:  148:// handler is a noexcept function, so we need to cast it to a noexcept function
        -:  149:// pointer first.
        -:  150:#if wxCHECK_CXX_STD(201703L)
        -:  151:
        -:  152:namespace wxPrivate
        -:  153:{
        -:  154:
        -:  155:// Cast to noexcept function type first if necessary.
        -:  156:template <typename E, typename C>
        -:  157:constexpr auto DoCast(void (C::*pmf)(E&))
        -:  158:{
        -:  159:    return static_cast<void (wxEvtHandler::*)(E&)>(pmf);
        -:  160:}
        -:  161:
        -:  162:template <typename E, typename C>
        -:  163:constexpr auto DoCast(void (C::*pmf)(E&) noexcept)
        -:  164:{
        -:  165:    return static_cast<void (wxEvtHandler::*)(E&)>(
        -:  166:            static_cast<void (wxEvtHandler::*)(E&) noexcept>(pmf)
        -:  167:        );
        -:  168:}
        -:  169:
        -:  170:// Helper used to recover the type of the handler argument from the function
        -:  171:// type. This is required in order to explicitly pass this type to DoCast<> as
        -:  172:// the compiler would be unable to deduce it for overloaded functions.
        -:  173:
        -:  174:// Generic template version, doing nothing.
        -:  175:template <typename F>
        -:  176:struct EventArgOf;
        -:  177:
        -:  178:// Specialization sufficient to cover all event handler function types.
        -:  179:template <typename C, typename E>
        -:  180:struct EventArgOf<void (C::*)(E&)>
        -:  181:{
        -:  182:    using type = E;
        -:  183:};
        -:  184:
        -:  185:
        -:  186:} // namespace wxPrivate
        -:  187:
        -:  188:#define wxEventHandlerNoexceptCast(functype, pmf) \
        -:  189:    wxPrivate::DoCast<wxPrivate::EventArgOf<functype>::type>(pmf)
        -:  190:#else
        -:  191:#define wxEventHandlerNoexceptCast(functype, pmf) static_cast<functype>(pmf)
        -:  192:#endif
