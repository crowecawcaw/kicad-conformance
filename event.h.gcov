        -: 1638:    wxClientData *GetClientObject() const { return m_clientObject; }
        -: 1639:
        -: 1640:    // Note: this shadows wxEventBasicPayloadMixin::GetString(), because it does some
        -: 1641:    // GUI-specific hacks
        -: 1642:    wxString GetString() const;
        -: 1643:
        -: 1644:    // Get listbox selection if single-choice
        -: 1645:    int GetSelection() const { return m_commandInt; }
        -: 1646:
        -: 1647:    // Get checkbox value
        -: 1648:    bool IsChecked() const { return m_commandInt != 0; }
        -: 1649:
        -: 1650:    // true if the listbox event was a selection.
