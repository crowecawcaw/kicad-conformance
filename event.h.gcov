        -:   98:// define a new custom event type, can be used alone or after event
        -:   99:// declaration in the header using one of the macros below
        -:  100:#define wxDEFINE_EVENT( name, type ) \
        -:  101:    const wxEventTypeTag< type > name( wxNewEventType() )
