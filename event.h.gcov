        -:  911:// The different categories for a wxEvent; see wxEvent::GetEventCategory.
        -:  912:// NOTE: they are used as OR-combinable flags by wxEventLoopBase::YieldFor
        -:  913:enum wxEventCategory
        -:  914:{
        -:  915:    // this is the category for those events which are generated to update
        -:  916:    // the appearance of the GUI but which (usually) do not comport data
        -:  917:    // processing, i.e. which do not provide input or output data
        -:  918:    // (e.g. size events, scroll events, etc).
        -:  919:    // They are events NOT directly generated by the user's input devices.
        -:  920:    wxEVT_CATEGORY_UI = 1,
        -:  921:
        -:  922:    // this category groups those events which are generated directly from the
        -:  923:    // user through input devices like mouse and keyboard and usually result in
        -:  924:    // data to be processed from the application.
        -:  925:    // (e.g. mouse clicks, key presses, etc)
        -:  926:    wxEVT_CATEGORY_USER_INPUT = 2,
        -:  927:
        -:  928:    // this category is for wxSocketEvent
        -:  929:    wxEVT_CATEGORY_SOCKET = 4,
        -:  930:
        -:  931:    // this category is for wxTimerEvent
