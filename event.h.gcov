        -:  383:// functor forwarding the event to a method of the given object
        -:  384://
        -:  385:// notice that the object class may be different from the class in which the
        -:  386:// method is defined but it must be convertible to this class
        -:  387://
        -:  388:// also, the type of the handler parameter doesn't need to be exactly the same
        -:  389:// as EventTag::EventClass but it must be its base class -- this is explicitly
        -:  390:// allowed to handle different events in the same handler taking wxEvent&, for
        -:  391:// example
        -:  392:template
        -:  393:  <typename EventTag, typename Class, typename EventArg, typename EventHandler>
        -:  394:class wxEventFunctorMethod
        -:  395:    : public wxEventFunctor,
        -:  396:      private wxPrivate::HandlerImpl
        -:  397:              <
        -:  398:                Class,
        -:  399:                EventArg,
        -:  400:                wxIsPubliclyDerived<Class, wxEvtHandler>::value != 0
        -:  401:              >
        -:  402:{
        -:  403:private:
        -:  404:    static void CheckHandlerArgument(EventArg *) { }
        -:  405:
        -:  406:public:
        -:  407:    // the event class associated with the given event tag
        -:  408:    typedef typename wxPrivate::EventClassOf<EventTag>::type EventClass;
        -:  409:
        -:  410:
        -:  411:    wxEventFunctorMethod(void (Class::*method)(EventArg&), EventHandler *handler)
        -:  412:        : m_handler( handler ), m_method( method )
        -:  413:    {
        -:  414:        wxASSERT_MSG( handler || this->IsEvtHandler(),
        -:  415:                      "handlers defined in non-wxEvtHandler-derived classes "
        -:  416:                      "must be connected with a valid sink object" );
        -:  417:
        -:  418:        // if you get an error here it means that the signature of the handler
        -:  419:        // you're trying to use is not compatible with (i.e. is not the same as
        -:  420:        // or a base class of) the real event class used for this event type
        -:  421:        CheckHandlerArgument(static_cast<EventClass *>(NULL));
        -:  422:    }
        -:  423:
        -:  424:    virtual void operator()(wxEvtHandler *handler, wxEvent& event) wxOVERRIDE
        -:  425:    {
        -:  426:        Class * realHandler = m_handler;
        -:  427:        if ( !realHandler )
        -:  428:        {
        -:  429:            realHandler = this->ConvertFromEvtHandler(handler);
        -:  430:
        -:  431:            // this is not supposed to happen but check for it nevertheless
        -:  432:            wxCHECK_RET( realHandler, "invalid event handler" );
        -:  433:        }
        -:  434:
        -:  435:        // the real (run-time) type of event is EventClass and we checked in
        -:  436:        // the ctor that EventClass can be converted to EventArg, so this cast
        -:  437:        // is always valid
        -:  438:        (realHandler->*m_method)(static_cast<EventArg&>(event));
        -:  439:    }
        -:  440:
        -:  441:    virtual bool IsMatching(const wxEventFunctor& functor) const wxOVERRIDE
        -:  442:    {
        -:  443:        if ( wxTypeId(functor) != wxTypeId(*this) )
        -:  444:            return false;
        -:  445:
        -:  446:        typedef wxEventFunctorMethod<EventTag, Class, EventArg, EventHandler>
        -:  447:            ThisFunctor;
        -:  448:
        -:  449:        // the cast is valid because wxTypeId()s matched above
        -:  450:        const ThisFunctor& other = static_cast<const ThisFunctor &>(functor);
        -:  451:
        -:  452:        return (m_method == other.m_method || other.m_method == NULL) &&
        -:  453:               (m_handler == other.m_handler || other.m_handler == NULL);
        -:  454:    }
        -:  455:
        -:  456:    virtual wxEvtHandler *GetEvtHandler() const wxOVERRIDE
        -:  457:        { return this->ConvertToEvtHandler(m_handler); }
        -:  458:
        -:  459:    virtual wxEventFunction GetEvtMethod() const wxOVERRIDE
        -:  460:        { return this->ConvertToEvtMethod(m_method); }
        -:  461:
