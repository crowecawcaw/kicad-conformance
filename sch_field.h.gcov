        -:  471:
        -:  472:        aFields.back().SetText( aValue );
        -:  473:        aFields.back().SetVisible( aIsVisible );
        -:  474:        return;
        -:  475:    }
        -:  476:
        -:  477:    if( SCH_FIELD* field = FindField( aFields, aFieldName ) )
        -:  478:    {
        -:  479:        field->SetText( aValue, aSheetPath, aVariantName );
        -:  480:        return;
        -:  481:    }
        -:  482:
        -:  483:    SCH_ITEM* parent = static_cast<SCH_ITEM*>( aFields.at( 0 ).GetParent() );
        -:  484:    aFields.emplace_back( parent, FIELD_T::USER, aFieldName );
        -:  485:
        -:  486:    // Since the default variant doesn't have this field at all, we're going to set it to the same value
        -:  487:    // and visibility as specified for the variant.  We therefore don't really have a variant at all, so we
        -:  488:    // can ignore variant processing here.
        -:  489:    aFields.back().SetText( aValue );
        -:  490:    aFields.back().SetVisible( aIsVisible );
        -:  491:}
