        -:  225:/**
        -:  226: * Helper class for creating a footprint library cache.
        -:  227: *
        -:  228: * The new footprint library design is a file path of individual footprint files that contain
        -:  229: * a single footprint per file.  This class is a helper only for the footprint portion of the
        -:  230: * PLUGIN API, and only for the #PCB_PLUGIN plugin.  It is private to this implementation file so
        -:  231: * it is not placed into a header.
        -:  232: */
        -:  233:class FP_CACHE_ENTRY
        -:  234:{
        -:  235:    WX_FILENAME                m_filename;
        -:  236:    std::unique_ptr<FOOTPRINT> m_footprint;
        -:  237:
        -:  238:public:
        -:  239:    FP_CACHE_ENTRY( FOOTPRINT* aFootprint, const WX_FILENAME& aFileName );
        -:  240:
    #####:  241:    const WX_FILENAME& GetFileName() const { return m_filename; }
    #####:  242:    void SetFilePath( const wxString& aFilePath ) { m_filename.SetPath( aFilePath ); }
    #####:  243:    std::unique_ptr<FOOTPRINT>& GetFootprint() { return m_footprint; }
        -:  244:};
        -:  245:
        -:  246:class FP_CACHE
        -:  247:{
        -:  248:    PCB_IO_KICAD_SEXPR*   m_owner;          // Plugin object that owns the cache.
        -:  249:    wxFileName            m_lib_path;       // The path of the library.
        -:  250:    wxString              m_lib_raw_path;   // For quick comparisons.
        -:  251:
        -:  252:    boost::ptr_map<wxString, FP_CACHE_ENTRY> m_footprints;  // Map of footprint filename to
        -:  253:                                                            //   cache entry.
        -:  254:
        -:  255:    bool      m_cache_dirty;       // Stored separately because it's expensive to check
        -:  256:                                   // m_cache_timestamp against all the files.
        -:  257:    long long m_cache_timestamp;   // A hash of the timestamps for all the footprint
        -:  258:                                   // files.
        -:  259:
        -:  260:public:
        -:  261:    FP_CACHE( PCB_IO_KICAD_SEXPR* aOwner, const wxString& aLibraryPath );
        -:  262:
        -:  263:    wxString GetPath() const { return m_lib_raw_path; }
        -:  264:
    #####:  265:    bool IsWritable() const { return m_lib_path.IsOk() && m_lib_path.IsDirWritable(); }
        -:  266:
    #####:  267:    bool Exists() const { return m_lib_path.IsOk() && m_lib_path.DirExists(); }
        -:  268:
    #####:  269:    boost::ptr_map<wxString, FP_CACHE_ENTRY>& GetFootprints() { return m_footprints; }
        -:  270:
        -:  271:    // Most all functions in this class throw IO_ERROR exceptions.  There are no
        -:  272:    // error codes nor user interface calls from here, nor in any PLUGIN.
        -:  273:    // Catch these exceptions higher up please.
        -:  274:
        -:  275:    /**
        -:  276:     * Save the footprint cache or a single footprint from it to disk
        -:  277:     *
        -:  278:     * @param aFootprintFilter if set, save only this footprint, otherwise, save the full library
        -:  279:     */
        -:  280:    void Save( FOOTPRINT* aFootprintFilter = nullptr );
        -:  281:
        -:  282:    void Load();
        -:  283:
        -:  284:    void Remove( const wxString& aFootprintName );
        -:  285:
        -:  286:    /**
        -:  287:     * Generate a timestamp representing all source files in the cache (including the
        -:  288:     * parent directory).
        -:  289:     * Timestamps should not be considered ordered.  They either match or they don't.
        -:  290:     */
        -:  291:    static long long GetTimestamp( const wxString& aLibPath );
        -:  292:
        -:  293:    /**
        -:  294:     * Return true if the cache is not up-to-date.
        -:  295:     */
        -:  296:    bool IsModified();
        -:  297:
        -:  298:    /**
        -:  299:     * Check if \a aPath is the same as the current cache path.
        -:  300:     *
        -:  301:     * This tests paths by converting \a aPath using the native separators.  Internally
        -:  302:     * #FP_CACHE stores the current path using native separators.  This prevents path
        -:  303:     * miscompares on Windows due to the fact that paths can be stored with / instead of \\
        -:  304:     * in the footprint library table.
        -:  305:     *
        -:  306:     * @param aPath is the library path to test against.
        -:  307:     * @return true if \a aPath is the same as the cache path.
        -:  308:     */
        -:  309:    bool IsPath( const wxString& aPath ) const;
        -:  310:
        -:  311:    void SetPath( const wxString& aPath );
        -:  312:};
