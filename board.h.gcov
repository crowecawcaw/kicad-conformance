        -:  198:/**
        -:  199: * Container to hold information pertinent to a layer of a BOARD.
        -:  200: */
        -:  201:struct LAYER
        -:  202:{
        -:  203:    LAYER()
        -:  204:    {
        -:  205:        clear();
        -:  206:    }
        -:  207:
        -:  208:    void clear()
        -:  209:    {
        -:  210:        m_type    = LT_SIGNAL;
        -:  211:        m_visible = true;
        -:  212:        m_number  = 0;
        -:  213:        m_name.clear();
        -:  214:        m_userName.clear();
        -:  215:        m_opposite = m_number;
        -:  216:    }
        -:  217:
        -:  218:    /*
        -:  219:    LAYER( const wxString& aName = wxEmptyString,
        -:  220:            LAYER_T aType = LT_SIGNAL, bool aVisible = true, int aNumber = -1 ) :
        -:  221:        m_name( aName ),
        -:  222:        m_type( aType ),
        -:  223:        m_visible( aVisible ),
        -:  224:        m_number( aNumber )
        -:  225:    {
        -:  226:    }
        -:  227:    */
        -:  228:
        -:  229:    wxString    m_name;      ///< The canonical name of the layer. @see #LSET::Name
        -:  230:    wxString    m_userName;  ///< The user defined name of the layer.
        -:  231:    LAYER_T     m_type;      ///< The type of the layer. @see #LAYER_T
        -:  232:    bool        m_visible;
        -:  233:    int         m_number;    ///< The layer ID. @see PCB_LAYER_ID
        -:  234:    int         m_opposite;  ///< Similar layer on opposite side of the board, if any.
        -:  235:
        -:  236:    /**
        -:  237:     * Convert a #LAYER_T enum to a string representation of the layer type.
        -:  238:     *
        -:  239:     * @param aType The #LAYER_T to convert
        -:  240:     * @return The string representation of the layer type.
        -:  241:     */
        -:  242:    static const char* ShowType( LAYER_T aType );
        -:  243:
        -:  244:    /**
        -:  245:     * Convert a string to a #LAYER_T
        -:  246:     *
        -:  247:     * @param aType The layer name to convert.
        -:  248:     * @return The binary representation of the layer type, or
        -:  249:     *         LAYER_T(-1) if the string is invalid.
        -:  250:     */
        -:  251:    static LAYER_T     ParseType( const char* aType );
        -:  252:};
