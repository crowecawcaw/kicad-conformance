        -:  828:    /**
        -:  829:     * Extract the board outlines and build a closed polygon from lines, arcs and circle items
        -:  830:     * on edge cut layer.
        -:  831:     *
        -:  832:     * Any closed outline inside the main outline is a hole.  All contours should be closed,
        -:  833:     * i.e. have valid vertices to build a closed polygon.
        -:  834:     *
        -:  835:     * @param aOutlines is the #SHAPE_POLY_SET to fill in with outlines/holes.
        -:  836:     * @param aInferOutlineIfNecessary if the edges do not define a closed shape then we'll approximate the
        -:  837:     *                                 bounding box outline based on the edges, or failing that, any other items
        -:  838:     *                                 on the board
        -:  839:     * @param aErrorHandler is an optional DRC_ITEM error handler.
        -:  840:     * @param aAllowUseArcsInPolygons = an optional option to allow adding arcs in
        -:  841:     *  SHAPE_LINE_CHAIN polylines/polygons when building outlines from aShapeList
        -:  842:     *  This is mainly for export to STEP files
        -:  843:     * @param aIncludeNPTHAsOutlines = an optional option to include NPTH pad holes
        -:  844:     * in board outlines. These holes can be seen like holes created by closed shapes
        -:  845:     * drawn on edge cut layer inside the board main outline.
        -:  846:     * @return true if success, false if a contour is not valid
        -:  847:     */
        -:  848:    bool GetBoardPolygonOutlines( SHAPE_POLY_SET& aOutlines, bool aInferOutlineIfNecessary,
        -:  849:                                  OUTLINE_ERROR_HANDLER* aErrorHandler = nullptr,
        -:  850:                                  bool aAllowUseArcsInPolygons = false, bool aIncludeNPTHAsOutlines = false );
        -:  851:
        -:  852:    /**
        -:  853:     * @return a epsilon value that is the max distance between 2 points to see them
        -:  854:     * at the same coordinate when building the board outlines and tray to connect 2 end points
        -:  855:     * when buildind the outlines of the board
        -:  856:     * Too small value do not allow connecting 2 shapes (i.e. segments) not exactly connected
        -:  857:     * Too large value do not allow safely connecting 2 shapes like very short segments.
        -:  858:     */
        -:  859:    int GetOutlinesChainingEpsilon() { return( m_outlinesChainingEpsilon ); }
        -:  860:    void SetOutlinesChainingEpsilon( int aValue) { m_outlinesChainingEpsilon = aValue; }
        -:  861:
        -:  862:   /**
