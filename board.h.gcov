    #####: 1430:    const std::unordered_map<KIID, BOARD_ITEM*>& GetItemByIdCache() const
        -: 1431:    {
    #####: 1432:        return m_itemByIdCache;
        -: 1433:    }
        -: 1434:
        -: 1435:    /**
        -: 1436:     * Add an item to the item-by-id cache.
        -: 1437:     *
        -: 1438:     * This is called by FOOTPRINT::Add() when items are added to footprints that are already
        -: 1439:     * on the board, to keep the cache in sync.
        -: 1440:     */
        -: 1441:    void CacheItemById( BOARD_ITEM* aItem )
        -: 1442:    {
        -: 1443:        if( IsFootprintHolder() )
        -: 1444:            return;
        -: 1445:
        -: 1446:        m_itemByIdCache.insert( { aItem->m_Uuid, aItem } );
        -: 1447:    }
        -: 1448:
        -: 1449:    /**
        -: 1450:     * Remove an item from the item-by-id cache.
        -: 1451:     *
        -: 1452:     * This is called by FOOTPRINT::Remove() when items are removed from footprints that are
        -: 1453:     * already on the board, to keep the cache in sync.
        -: 1454:     */
        -: 1455:    void UncacheItemById( const KIID& aId )
        -: 1456:    {
        -: 1457:        m_itemByIdCache.erase( aId );
        -: 1458:    }
