        -:  330:    /* Sort functions:
        -:  331:     * Sort functions are used to sort symbols for annotation or BOM generation.  Because
        -:  332:     * sorting depends on what we want to do, there are many sort functions.
        -:  333:     * Note:
        -:  334:     *    When creating BOM, symbols are fully annotated.  References are something like U3,
        -:  335:     *    U5 or R4, R8.  When annotating,  some or all symbols are not annotated, i.e. ref is
        -:  336:     *    only U or R, with no number.
        -:  337:     */
        -:  338:
        -:  339:    /**
        -:  340:     * Attempt to split all reference designators into a name (U) and number (1).
        -:  341:     *
        -:  342:     * If the last character is '?' or not a digit, the reference is tagged as not annotated.
        -:  343:     * For symbols with multiple parts, keeps the unit number intact
        -:  344:     * @see SCH_REFERENCE::Split()
        -:  345:     */
        -:  346:    void SplitReferences()
        -:  347:    {
        -:  348:        for( unsigned ii = 0; ii < GetCount(); ii++ )
        -:  349:            m_flatList[ii].Split();
        -:  350:    }
        -:  351:
        -:  352:    /**
        -:  353:     * Treat all symbols in this list as non-annotated. Does not update annotation state of the
        -:  354:     * symbols.
        -:  355:     *
        -:  356:     * @see SCH_REFERENCE_LIST::UpdateAnnotation()
        -:  357:     */
        -:  358:    void RemoveAnnotation()
        -:  359:    {
        -:  360:        for( unsigned ii = 0; ii < GetCount(); ii++ )
        -:  361:            m_flatList[ii].m_isNew = true;
        -:  362:    }
        -:  363:
        -:  364:    /**
        -:  365:     * Update the symbol references for the schematic project (or the current sheet).
        -:  366:     *
        -:  367:     * @note This function does not calculate the reference numbers stored in m_numRef so it
        -:  368:     *       must be called after calculation of new reference numbers.
        -:  369:     *
        -:  370:     * @see SCH_REFERENCE::Annotate()
        -:  371:     */
        -:  372:    void UpdateAnnotation()
        -:  373:    {
        -:  374:        /* update the reference numbers */
        -:  375:        for( unsigned ii = 0; ii < GetCount(); ii++ )
        -:  376:            m_flatList[ii].Annotate();
        -:  377:    }
        -:  378:
        -:  379:    /**
        -:  380:     * Forces reannotation of the provided references. Will also reannotate
        -:  381:     * associated multi-unit symbols.
