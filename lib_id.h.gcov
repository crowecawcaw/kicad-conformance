        -:   26:#ifndef _LIB_ID_H_
        -:   27:#define _LIB_ID_H_
        -:   28:
        -:   29:#include <kicommon.h>
        -:   30:#include <core/utf8.h>
        -:   31:
        -:   32:/**
        -:   33: * A logical library item identifier and consists of various portions much like a URI.
        -:   34: *
        -:   35: * It consists of of a dyad of the library nickname and the name of the item in the library
        -:   36: * This is a generic library identifier that can be
        -:   37: * used for any type of library that contains multiple named items such as footprint or
        -:   38: * symbol libraries.
        -:   39: *
        -:   40: * Example LIB_ID string:
        -:   41: * "smt:R_0805".
        -:   42: *
        -:   43: * - "smt" is the logical library name used to look up library information saved in the #LIB_TABLE.
        -:   44: * - "R" is the name of the item within the library.
        -:   45: *
        -:   46: * @author Dick Hollenbeck
        -:   47: */
        -:   48:class KICOMMON_API LIB_ID
        -:   49:{
        -:   50:public:
        -:   51:    LIB_ID() {}
        -:   52:
        -:   53:    // NOTE: don't define any constructors which call Parse() on their arguments.  We want it
        -:   54:    // to be obvious to callers that parsing is involved (and that valid IDs are guaranteed in
        -:   55:    // the presence of disallowed characters, malformed ids, etc.).
        -:   56:
        -:   57:    /**
        -:   58:     * This LIB_ID ctor is a special version which ignores the parsing due to symbol
        -:   59:     * names allowing '/' as a valid character.  This was causing the symbol names to
        -:   60:     * be truncated at the first occurrence of '/' in the symbol name.
        -:   61:     *
        -:   62:     * @param aLibraryName is the library name used to look up the library item in the #LIB_TABLE.
        -:   63:     * @param aItemName is the name of the library item which is not parsed by the standard
        -:   64:     *                     LIB_ID::Parse() function.
        -:   65:     */
        -:   66:    LIB_ID( const wxString& aLibraryName, const wxString& aItemName );
        -:   67:
        -:   68:    /**
        -:   69:     * Parse LIB_ID with the information from @a aId.
        -:   70:     *
        -:   71:     * A typical LIB_ID string consists of a library nickname followed by a library item name.
        -:   72:     * e.g.: "smt:R_0805", or
        -:   73:     * e.g.: "mylib:R_0805", or
        -:   74:     * e.g.: "ttl:7400"
        -:   75:     *
        -:   76:     * @param aId is the string to populate the #LIB_ID object.
        -:   77:     * @param aFix indicates invalid chars should be replaced with '_'.
        -:   78:     *
        -:   79:     * @return minus 1 (i.e. -1) means success, >= 0 indicates the character offset into
        -:   80:     *         aId at which an error was detected.
        -:   81:     */
        -:   82:    int Parse( const UTF8& aId, bool aFix = false );
        -:   83:
        -:   84:    /**
        -:   85:     * Return the logical library name portion of a LIB_ID.
        -:   86:     */
        -:   87:    const UTF8& GetLibNickname() const { return m_libraryName; }
        -:   88:    const wxString GetUniStringLibNickname() const { return m_libraryName.wx_str(); }
        -:   89:
        -:   90:    /**
        -:   91:     * Override the logical library name portion of the LIB_ID to @a aLibNickname.
        -:   92:     *
        -:   93:     * @return int - minus 1 (i.e. -1) means success, >= 0 indicates the  character offset
        -:   94:     *               into the parameter at which an error was detected, usually because it
        -:   95:     *               contained '/' or ':'.
        -:   96:     */
        -:   97:    int SetLibNickname( const UTF8& aLibNickname );
        -:   98:
        -:   99:    /**
        -:  100:     * @return the library item name, i.e. footprintName, in UTF8.
        -:  101:     */
    #####:  102:    const UTF8& GetLibItemName() const { return m_itemName; }
        -:  103:
        -:  104:    /**
        -:  105:     * Get strings for display messages in dialogs.
        -:  106:     *
        -:  107:     * Equivalent to m_itemName.wx_str(), but more explicit when building a Unicode string
        -:  108:     * in messages.
        -:  109:     *
        -:  110:     * @return the library item name, i.e. footprintName in a wxString (UTF16 or 32).
        -:  111:     */
    #####:  112:    const wxString GetUniStringLibItemName() const { return m_itemName.wx_str(); }
        -:  113:
        -:  114:    /**
        -:  115:     * Override the library item name portion of the LIB_ID to @a aLibItemName
        -:  116:     *
        -:  117:     * @return int - minus 1 (i.e. -1) means success, >= 0 indicates the  character offset
        -:  118:     *               into the parameter at which an error was detected, usually because it
        -:  119:     *               contained '/'.
        -:  120:     */
        -:  121:    int SetLibItemName( const UTF8& aLibItemName );
        -:  122:
        -:  123:    /**
        -:  124:     * Some LIB_IDs can have a sub-library identifier in addition to a library nickname.
        -:  125:     * This identifier is *not* part of the canonical LIB_ID and is not written out / parsed.
        -:  126:     * It is only used for internal sorting/grouping, if present.
        -:  127:     *
        -:  128:     * @return the sub-library name for this LIB_ID, if one exists
        -:  129:     */
        -:  130:    UTF8 GetSubLibraryName() const { return m_subLibraryName; }
        -:  131:    void SetSubLibraryName( const UTF8& aName ) { m_subLibraryName = aName; }
        -:  132:    const wxString GetUniStringSubLibraryName() const { return m_subLibraryName.wx_str(); }
        -:  133:
        -:  134:    /**
        -:  135:     * @return a display-formatted name of the library and sublibrary (if present)
        -:  136:     */
        -:  137:    const wxString GetFullLibraryName() const;
        -:  138:
        -:  139:    /**
        -:  140:     * @return the fully formatted text of the LIB_ID in a UTF8 string.
        -:  141:     */
        -:  142:    UTF8 Format() const;
        -:  143:
        -:  144:    /**
        -:  145:     * @return the fully formatted text of the LIB_ID in a wxString (UTF16 or UTF32),
        -:  146:     *         suitable to display the LIB_ID in dialogs.
        -:  147:     */
        -:  148:    wxString GetUniStringLibId() const
        -:  149:    {
        -:  150:        return Format().wx_str();
        -:  151:    }
        -:  152:
        -:  153:    /**
        -:  154:     * @return a string in the proper format as an LIB_ID for a combination of
        -:  155:     *         aLibraryName, aLibItemName
        -:  156:     *
        -:  157:     * @throw PARSE_ERROR if any of the pieces are illegal.
        -:  158:     */
        -:  159:    static UTF8 Format( const UTF8& aLibraryName, const UTF8& aLibItemName );
        -:  160:
        -:  161:    /**
        -:  162:     * Check if this LID_ID is valid.
        -:  163:     *
        -:  164:     * A valid #LIB_ID must have both the library nickname and the library item name defined.
        -:  165:     *
        -:  166:     * @note A return value of true does not indicated that the #LIB_ID is a valid #LIB_TABLE
        -:  167:     *       entry.
        -:  168:     *
        -:  169:     * @return true is the #LIB_ID is valid.
        -:  170:     *
        -:  171:     */
    #####:  172:    bool IsValid() const
        -:  173:    {
    #####:  174:        return !m_libraryName.empty() && !m_itemName.empty();
        -:  175:    }
        -:  176:
        -:  177:    /**
        -:  178:     * @return true if the #LIB_ID only has the #m_itemName name defined.
        -:  179:     */
        -:  180:    bool IsLegacy() const
        -:  181:    {
        -:  182:        return m_libraryName.empty() && !m_itemName.empty();
        -:  183:    }
        -:  184:
        -:  185:    /**
        -:  186:     * Clear the contents of the library nickname, library entry name
        -:  187:     */
        -:  188:    void clear();
        -:  189:
        -:  190:    /**
        -:  191:     * @return a boolean true value if the LIB_ID is empty.  Otherwise return false.
        -:  192:     */
        -:  193:    bool empty() const
        -:  194:    {
        -:  195:        return m_libraryName.empty() && m_itemName.empty();
        -:  196:    }
        -:  197:
        -:  198:    /**
        -:  199:     * Compare the contents of LIB_ID objects by performing a std::string comparison of the
        -:  200:     * library nickname, library entry name
        -:  201:     *
        -:  202:     * @param aLibId is the LIB_ID to compare against.
        -:  203:     * @return -1 if less than \a aLibId, 1 if greater than \a aLibId, and 0 if equal to \a aLibId.
        -:  204:     */
        -:  205:    int compare( const LIB_ID& aLibId ) const;
        -:  206:
        -:  207:    bool operator < ( const LIB_ID& aLibId ) const { return this->compare( aLibId ) < 0; }
        -:  208:    bool operator > ( const LIB_ID& aLibId ) const { return this->compare( aLibId ) > 0; }
        -:  209:    bool operator ==( const LIB_ID& aLibId ) const { return this->compare( aLibId ) == 0; }
        -:  210:    bool operator !=( const LIB_ID& aLibId ) const { return !(*this == aLibId); }
        -:  211:
        -:  212:    /**
        -:  213:     * Examine \a aLibItemName for invalid #LIB_ID item name characters.
        -:  214:     *
        -:  215:     * @param aLibItemName is the #LIB_ID name to test for illegal characters.
        -:  216:     * @return offset of first illegal character otherwise -1.
        -:  217:     */
        -:  218:    static int HasIllegalChars( const UTF8& aLibItemName );
        -:  219:
        -:  220:    /**
        -:  221:     * Replace illegal #LIB_ID item name characters with underscores '_'.
        -:  222:     *
        -:  223:     * @param aLibItemName is the #LIB_ID item name to replace illegal characters.
        -:  224:     * @param aLib True if we are checking library names, false if we are checking item names
        -:  225:     * @return the corrected version of \a aLibItemName.
        -:  226:     */
        -:  227:    static UTF8 FixIllegalChars( const UTF8& aLibItemName, bool aLib );
        -:  228:
        -:  229:    /**
        -:  230:     * Looks for characters that are illegal in library nicknames.
        -:  231:     *
        -:  232:     * @param aLibraryName is the logical library name to be tested.
        -:  233:     * @return Invalid character found in the name or 0 is the name is valid.
        -:  234:     */
        -:  235:    static unsigned FindIllegalLibraryNameChar( const UTF8& aLibraryName );
        -:  236:
        -:  237:protected:
        -:  238:    /**
        -:  239:     * Tests whether a Unicode character is a legal LIB_ID item name character.
        -:  240:     *
        -:  241:     * The criteria for legal LIB_ID character is as follows:
        -:  242:     * - For both symbol and footprint names, neither '/' or ':' are legal.  They are
        -:  243:     *   reserved characters used by #LIB_ID::Parse.
        -:  244:     * - Spaces are allowed in footprint names as they are a legal filename character
        -:  245:     *   on all operating systems.
        -:  246:     * - Spaces are not allowed in symbol names since symbol names are not quoted in the
        -:  247:     *   schematic or symbol library file formats.
        -:  248:     * - Spaces are allowed in footprint library nicknames as they are quoted in the
        -:  249:     *   footprint library table file format.
        -:  250:     * - Spaces are now also allowed in symbol library nicknames since they are quoted in
        -:  251:     *   the new symbol library sexpr file format.
        -:  252:     * - Illegal file name characters are not allowed in footprint names since the file
        -:  253:     *   name is the footprint name.
        -:  254:     * - Illegal file name characters except '/' are allowed in symbol names since the
        -:  255:     *   name is not the file name.
        -:  256:     *
        -:  257:     *
        -:  258:     * @note @a aUniChar is expected to be a 32 bit Unicode character, not a UTF8 char, that use
        -:  259:     *                   a variable length coding value.
        -:  260:     */
        -:  261:    static bool isLegalChar( unsigned aUniChar );
        -:  262:
        -:  263:    /**
        -:  264:     * Tests whether a Unicode character is a legal LIB_ID library nickname character
        -:  265:     *
        -:  266:     * @note @a aUniChar is expected to be a 32 bit Unicode character, not a UTF8 char, that use
        -:  267:     *                   a variable length coding value.
        -:  268:     */
        -:  269:    static bool isLegalLibraryNameChar( unsigned aUniChar );
        -:  270:
        -:  271:    UTF8    m_libraryName;    ///< The nickname of the library or empty.
        -:  272:    UTF8    m_itemName;       ///< The name of the entry in the logical library.
        -:  273:    UTF8    m_subLibraryName; ///< Optional sub-library name used for grouping within a library
        -:  274:};
        -:  275:
        -:  276:
        -:  277:#endif // _LIB_ID_H_
