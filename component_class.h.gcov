        -:   21:#ifndef PCBNEW_COMPONENT_CLASS_H
        -:   22:#define PCBNEW_COMPONENT_CLASS_H
        -:   23:
        -:   24:#include <wx/string.h>
        -:   25:#include <vector>
        -:   26:
        -:   27:/**
        -:   28: * A lightweight representation of a component class. The membership within
        -:   29: * m_consituentClasses allows determination of the type of class this is:
        -:   30: *
        -:   31: * m_constituentClasses.size() == 0: This is a null class (no assigment).
        -:   32: *     m_name is empty.
        -:   33: * m_constituentClasses.size() == 1: This is an atomic class. The constituent class
        -:   34: *     pointer refers to itself. m_name contains the name of the atomic class
        -:   35: * m_constituentClasses.size() > 1: This is a composite class. The constituent class
        -:   36: *     pointers refer to all atomic members. m_name contains a comma-delimited list of
        -:   37: *     all atomic member class names.
        -:   38: */
        -:   39:class COMPONENT_CLASS
        -:   40:{
        -:   41:public:
        -:   42:    /// The assignment context in which this component class is used
        -:   43:    enum class USAGE
        -:   44:    {
        -:   45:        STATIC,
        -:   46:        DYNAMIC,
        -:   47:        STATIC_AND_DYNAMIC,
        -:   48:        EFFECTIVE
        -:   49:    };
        -:   50:
        -:   51:    /// Construct a new component class
        -:   52:    explicit COMPONENT_CLASS( const wxString& name, const USAGE aUsageContext ) :
        -:   53:            m_name( name ), m_usageContext( aUsageContext )
        -:   54:    {
        -:   55:    }
        -:   56:
        -:   57:    /// @brief Gets the consolidated name of this component class (which may be an aggregate). This is
        -:   58:    /// intended for display to users (e.g. in infobars or messages). WARNING: Do not use this
        -:   59:    /// to compare equivalence, or to export to other tools)
        -:   60:    wxString GetHumanReadableName() const;
        -:   61:
        -:   62:    /// Fetches the full name of this component class
    #####:   63:    const wxString& GetName() const { return m_name; }
        -:   64:
        -:   65:    /// Adds a constituent component class to an effective component class
        -:   66:    void AddConstituentClass( COMPONENT_CLASS* componentClass );
        -:   67:
        -:   68:    /// Returns a named constituent class of this component class, or nullptr if not found
        -:   69:    const COMPONENT_CLASS* GetConstituentClass( const wxString& className ) const;
        -:   70:
        -:   71:    /// Determines if this (effective) component class contains a specific constituent class
        -:   72:    bool ContainsClassName( const wxString& className ) const;
        -:   73:
        -:   74:    /// Determines if this (effective) component class is empty (i.e. no classes defined)
        -:   75:    bool IsEmpty() const;
        -:   76:
        -:   77:    /// Fetches a vector of the constituent classes for this (effective) class
    #####:   78:    const std::vector<COMPONENT_CLASS*>& GetConstituentClasses() const
        -:   79:    {
    #####:   80:        return m_constituentClasses;
        -:   81:    }
        -:   82:
        -:   83:    /// Gets the assignment context in which this component class is being used
        -:   84:    USAGE GetUsageContext() const { return m_usageContext; }
        -:   85:
        -:   86:    /// Sets the assignment context in which this component class is being used
        -:   87:    void SetUsageContext( const USAGE aUsageContext ) { m_usageContext = aUsageContext; }
        -:   88:
        -:   89:    /// Tests two component classes for equality based on full class name
        -:   90:    bool operator==( const COMPONENT_CLASS& aComponent ) const;
        -:   91:
        -:   92:    /// Tests two component classes for inequality based on full class name
        -:   93:    bool operator!=( const COMPONENT_CLASS& aComponent ) const;
        -:   94:
        -:   95:private:
        -:   96:    /// The full name of the component class
        -:   97:    wxString m_name;
        -:   98:
        -:   99:    /// The COMPONENT_CLASS objects contributing to this complete component class
        -:  100:    std::vector<COMPONENT_CLASS*> m_constituentClasses;
        -:  101:
        -:  102:    /// The assignment context in which this component class is being used
        -:  103:    USAGE m_usageContext;
        -:  104:};
        -:  105:
        -:  106:#endif //PCBNEW_COMPONENT_CLASS_H
