        -:   77:/**
        -:   78: * The set of attributes allowed within a FOOTPRINT, using FOOTPRINT::SetAttributes()
        -:   79: * and FOOTPRINT::GetAttributes().  These are to be ORed together when calling
        -:   80: * FOOTPRINT::SetAttributes()
        -:   81: */
        -:   82:enum FOOTPRINT_ATTR_T
        -:   83:{
        -:   84:    FP_THROUGH_HOLE             = 0x0001,
        -:   85:    FP_SMD                      = 0x0002,
        -:   86:    FP_EXCLUDE_FROM_POS_FILES   = 0x0004,
        -:   87:    FP_EXCLUDE_FROM_BOM         = 0x0008,
        -:   88:    FP_BOARD_ONLY               = 0x0010,   // Footprint has no corresponding symbol
        -:   89:    FP_JUST_ADDED               = 0x0020,   // Footprint just added by netlist update
        -:   90:    FP_DNP                      = 0x0040
        -:   91:};
        -:   92:
        -:   93:enum class FOOTPRINT_STACKUP
        -:   94:{
        -:   95:    /**
        -:   96:     * The 'normal' stackup handling, where there is a single inner layer
        -:   97:     * (In1) and rule areas using it expand to all inner layer on the host PCB.
        -:   98:     */
        -:   99:    EXPAND_INNER_LAYERS,
        -:  100:    /**
        -:  101:     * Stackup handling where the footprint can have any number of copper layers,
        -:  102:     * and objects on those layers go to the matching inner layer on the host PCB.
        -:  103:     */
        -:  104:    CUSTOM_LAYERS,
        -:  105:};
