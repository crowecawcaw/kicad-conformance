        -:  158:
        -:  159:/**
        -:  160: * Variant information for a footprint.
        -:  161: *
        -:  162: * Footprint variants store per-variant overrides for DNP, exclusion flags, and field values.
        -:  163: * These are synchronized with SCH_SYMBOL_VARIANT during Update PCB from Schematic operations.
        -:  164: */
        -:  165:class FOOTPRINT_VARIANT
        -:  166:{
        -:  167:public:
        -:  168:    FOOTPRINT_VARIANT( const wxString& aName = wxEmptyString ) :
        -:  169:            m_name( aName ),
        -:  170:            m_dnp( false ),
        -:  171:            m_excludedFromBOM( false ),
        -:  172:            m_excludedFromPosFiles( false )
        -:  173:    {
        -:  174:    }
        -:  175:
        -:  176:    wxString GetName() const { return m_name; }
        -:  177:    void SetName( const wxString& aName ) { m_name = aName; }
        -:  178:
    #####:  179:    bool GetDNP() const { return m_dnp; }
        -:  180:    void SetDNP( bool aDNP ) { m_dnp = aDNP; }
        -:  181:
    #####:  182:    bool GetExcludedFromBOM() const { return m_excludedFromBOM; }
        -:  183:    void SetExcludedFromBOM( bool aExclude ) { m_excludedFromBOM = aExclude; }
        -:  184:
    #####:  185:    bool GetExcludedFromPosFiles() const { return m_excludedFromPosFiles; }
        -:  186:    void SetExcludedFromPosFiles( bool aExclude ) { m_excludedFromPosFiles = aExclude; }
        -:  187:
        -:  188:    /**
        -:  189:     * Get a field value override for this variant.
        -:  190:     * @param aFieldName The name of the field.
        -:  191:     * @return The field value, or empty string if not overridden or overridden to empty.
        -:  192:     */
        -:  193:    wxString GetFieldValue( const wxString& aFieldName ) const
        -:  194:    {
        -:  195:        auto it = m_fields.find( aFieldName );
        -:  196:
        -:  197:        if( it != m_fields.end() )
        -:  198:            return it->second;
        -:  199:
        -:  200:        return wxString();
        -:  201:    }
        -:  202:
        -:  203:    /**
        -:  204:     * Set a field value override for this variant.
        -:  205:     * @param aFieldName The name of the field.
        -:  206:     * @param aValue The value to set.
        -:  207:     */
        -:  208:    void SetFieldValue( const wxString& aFieldName, const wxString& aValue )
        -:  209:    {
        -:  210:        m_fields[aFieldName] = aValue;
        -:  211:    }
        -:  212:
        -:  213:    bool HasFieldValue( const wxString& aFieldName ) const
        -:  214:    {
        -:  215:        return m_fields.find( aFieldName ) != m_fields.end();
        -:  216:    }
        -:  217:
    #####:  218:    const std::map<wxString, wxString>& GetFields() const { return m_fields; }
        -:  219:
        -:  220:    bool operator==( const FOOTPRINT_VARIANT& aOther ) const
        -:  221:    {
        -:  222:        return m_name == aOther.m_name
        -:  223:                && m_dnp == aOther.m_dnp
        -:  224:                && m_excludedFromBOM == aOther.m_excludedFromBOM
        -:  225:                && m_excludedFromPosFiles == aOther.m_excludedFromPosFiles
        -:  226:                && m_fields == aOther.m_fields;
        -:  227:    }
        -:  228:
        -:  229:private:
        -:  230:    wxString                     m_name;
        -:  231:    bool                         m_dnp;
        -:  232:    bool                         m_excludedFromBOM;
        -:  233:    bool                         m_excludedFromPosFiles;
        -:  234:    std::map<wxString, wxString> m_fields;  ///< Field value overrides for this variant
        -:  235:};
