        -:  107:class FP_3DMODEL
        -:  108:{
        -:  109:public:
        -:  110:    FP_3DMODEL() :
        -:  111:        // Initialize with sensible values
        -:  112:        m_Scale { 1, 1, 1 },
        -:  113:        m_Rotation { 0, 0, 0 },
        -:  114:        m_Offset { 0, 0, 0 },
        -:  115:        m_Opacity( 1.0 ),
        -:  116:        m_Show( true )
        -:  117:    {
        -:  118:    }
        -:  119:
        -:  120:    VECTOR3D m_Scale;       ///< 3D model scaling factor (dimensionless)
        -:  121:    VECTOR3D m_Rotation;    ///< 3D model rotation (degrees)
        -:  122:    VECTOR3D m_Offset;      ///< 3D model offset (mm)
        -:  123:    double   m_Opacity;
        -:  124:    wxString m_Filename;    ///< The 3D shape filename in 3D library
        -:  125:    bool     m_Show;        ///< Include model in rendering
        -:  126:
        -:  127:    bool operator==( const FP_3DMODEL& aOther ) const
        -:  128:    {
        -:  129:        return m_Scale == aOther.m_Scale
        -:  130:                && m_Rotation == aOther.m_Rotation
        -:  131:                && m_Offset == aOther.m_Offset
        -:  132:                && m_Opacity == aOther.m_Opacity
        -:  133:                && m_Filename == aOther.m_Filename
        -:  134:                && m_Show == aOther.m_Show;
        -:  135:    }
        -:  136:};
