        -:   54:};
        -:   55:
        -:   56:// different conventions that may be used with GetHumanReadableSize()
        -:   57:enum wxSizeConvention
        -:   58:{
        -:   59:    wxSIZE_CONV_TRADITIONAL,  // 1024 bytes = 1 KB
        -:   60:    wxSIZE_CONV_IEC,          // 1024 bytes = 1 KiB
        -:   61:    wxSIZE_CONV_SI            // 1000 bytes = 1 KB
        -:   62:};
        -:   63:
        -:   64:// the kind of normalization to do with the file name: these values can be
        -:   65:// or'd together to perform several operations at once
        -:   66:enum wxPathNormalize
        -:   67:{
        -:   68:    wxPATH_NORM_ENV_VARS = 0x0001,  // replace env vars with their values
        -:   69:    wxPATH_NORM_DOTS     = 0x0002,  // squeeze all .. and .
        -:   70:    wxPATH_NORM_TILDE    = 0x0004,  // Unix only: replace ~ and ~user
        -:   71:    wxPATH_NORM_CASE     = 0x0008,  // if case insensitive => tolower
        -:   72:    wxPATH_NORM_ABSOLUTE = 0x0010,  // make the path absolute
        -:   73:    wxPATH_NORM_LONG     = 0x0020,  // make the path the long form (MSW-only)
        -:   74:    wxPATH_NORM_SHORTCUT = 0x0040,  // resolve the shortcut, if it is a shortcut
        -:   75:
        -:   76:    // Don't use this constant, it used to correspond to the default
        -:   77:    // Normalize() behaviour but this is deprecated now.
        -:   78:    wxPATH_NORM_DEPR_OLD_DEFAULT= 0x00ff & ~wxPATH_NORM_CASE,
        -:   79:
        -:   80:    // This constant name is misleading, as it doesn't really include all the
        -:   81:    // flags above, so its use is discouraged, please use the flags you want
        -:   82:    // explicitly instead.
        -:   83:    wxPATH_NORM_ALL
        -:   84:    wxDEPRECATED_ATTR("specify the wanted flags explicitly to avoid surprises")
        -:   85:        = wxPATH_NORM_DEPR_OLD_DEFAULT
        -:   86:};
        -:   87:
        -:   88:// what exactly should GetPath() return?
        -:   89:enum
        -:   90:{
        -:   91:    wxPATH_NO_SEPARATOR  = 0x0000,  // for symmetry with wxPATH_GET_SEPARATOR
        -:   92:    wxPATH_GET_VOLUME    = 0x0001,  // include the volume if applicable
        -:   93:    wxPATH_GET_SEPARATOR = 0x0002   // terminate the path with the separator
        -:   94:};
        -:   95:
