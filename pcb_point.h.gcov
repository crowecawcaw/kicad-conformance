        -:   29:
        -:   30:/**
        -:   31: * A PCB_POINT is a 0-dimensional point that is used to mark a position on a PCB,
        -:   32: * or more usually a footprint for some purpose. This can be, for example:
        -:   33: *
        -:   34: * * As a defined snap anchor for component alignment
        -:   35: * * As a routing snap point in a custom pad
        -:   36: *
        -:   37: * For now, the point has only location, and a size. The size is the size of
        -:   38: * the displayed point in board space. Having the points a constant size in screen
        -:   39: * space regardless of zoom seems plasible, but it means at low zoom, the board will
        -:   40: * be full of "huge" markers. So allow users to set how big they are as needed.
        -:   41: */
        -:   42:class PCB_POINT : public BOARD_ITEM
        -:   43:{
        -:   44:public:
        -:   45:
        -:   46:    PCB_POINT( BOARD_ITEM* aParent );
        -:   47:
        -:   48:    /**
        -:   49:     * Construct a point at the given location.
        -:   50:     */
        -:   51:    PCB_POINT( BOARD_ITEM* aParent, const VECTOR2I& aPos, const int aSize);
        -:   52:
        -:   53:    static inline bool ClassOf( const EDA_ITEM* aItem )
        -:   54:    {
        -:   55:        return aItem && PCB_POINT_T == aItem->Type();
        -:   56:    }
        -:   57:
        -:   58:    struct cmp_points
        -:   59:    {
        -:   60:        bool operator()( const PCB_POINT* a, const PCB_POINT* b ) const;
        -:   61:    };
        -:   62:
        -:   63:    void     SetPosition( const VECTOR2I& aPos ) override { m_pos = aPos; }
        -:   64:    VECTOR2I GetPosition() const override { return m_pos; }
        -:   65:
        -:   66:    void SetSize( const int aSize ) { m_size = aSize; }
    #####:   67:    int  GetSize() const { return m_size; }
        -:   68:
        -:   69:    void Move( const VECTOR2I& aMoveVector ) override
        -:   70:    {
        -:   71:        m_pos += aMoveVector;
        -:   72:    }
        -:   73:
        -:   74:    double ViewGetLOD( int aLayer, const KIGFX::VIEW* aView ) const override;
        -:   75:    std::vector<int> ViewGetLayers() const override;
