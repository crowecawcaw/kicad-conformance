        -:  692:        // set m_thread to NULL so don't delete it then.
        -:  693:        // But if KillThread is called before wxThreadHelperThread (in detached mode)
        -:  694:        // sets it to NULL, then the thread object still exists and can be killed
        -:  695:        wxCriticalSectionLocker locker(m_critSection);
        -:  696:
        -:  697:        if ( m_thread )
        -:  698:        {
        -:  699:            m_thread->Kill();
        -:  700:
        -:  701:            if ( m_kind == wxTHREAD_JOINABLE )
        -:  702:              delete m_thread;
        -:  703:
        -:  704:            m_thread = NULL;
        -:  705:        }
        -:  706:    }
        -:  707:
        -:  708:public:
        -:  709:    // constructor only initializes m_thread to NULL
        -:  710:    wxThreadHelper(wxThreadKind kind = wxTHREAD_JOINABLE)
        -:  711:        : m_thread(NULL), m_kind(kind) { }
        -:  712:
        -:  713:    // destructor deletes m_thread
        -:  714:    virtual ~wxThreadHelper() { KillThread(); }
        -:  715:
        -:  716:#if WXWIN_COMPATIBILITY_2_8
        -:  717:    wxDEPRECATED( wxThreadError Create(unsigned int stackSize = 0) );
        -:  718:#endif
        -:  719:
        -:  720:    // create a new thread (and optionally set the stack size on platforms that
        -:  721:    // support/need that), call Run() to start it
        -:  722:    wxThreadError CreateThread(wxThreadKind kind = wxTHREAD_JOINABLE,
        -:  723:                               unsigned int stackSize = 0)
        -:  724:    {
        -:  725:        KillThread();
        -:  726:
        -:  727:        m_kind = kind;
        -:  728:        m_thread = new wxThreadHelperThread(*this, m_kind);
        -:  729:
        -:  730:        return m_thread->Create(stackSize);
        -:  731:    }
        -:  732:
        -:  733:    // entry point for the thread - called by Run() and executes in the context
        -:  734:    // of this thread.
        -:  735:    virtual void *Entry() = 0;
        -:  736:
        -:  737:    // returns a pointer to the thread which can be used to call Run()
        -:  738:    wxThread *GetThread() const
        -:  739:    {
        -:  740:        wxCriticalSectionLocker locker(m_critSection);
        -:  741:
        -:  742:        wxThread* thread = m_thread;
        -:  743:
        -:  744:        return thread;
        -:  745:    }
        -:  746:
        -:  747:protected:
        -:  748:    wxThread *m_thread;
        -:  749:    wxThreadKind m_kind;
        -:  750:    mutable wxCriticalSection m_critSection; // To guard the m_thread variable
        -:  751:
        -:  752:    friend class wxThreadHelperThread;
        -:  753:};
