        -:  760:// call Entry() in owner, put it down here to avoid circular declarations
    #####:  761:inline void *wxThreadHelperThread::Entry()
        -:  762:{
    #####:  763:    void * const result = m_owner.Entry();
        -:  764:
    #####:  765:    wxCriticalSectionLocker locker(m_owner.m_critSection);
        -:  766:
        -:  767:    // Detached thread will be deleted after returning, so make sure
        -:  768:    // wxThreadHelper::GetThread will not return an invalid pointer.
        -:  769:    // And that wxThreadHelper::KillThread will not try to kill
