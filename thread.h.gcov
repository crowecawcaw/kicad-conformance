        -:  780:
        -:  781:// GUI mutex handling.
        -:  782:void WXDLLIMPEXP_BASE wxMutexGuiEnter();
        -:  783:void WXDLLIMPEXP_BASE wxMutexGuiLeave();
        -:  784:
        -:  785:// macros for entering/leaving critical sections which may be used without
        -:  786:// having to take them inside "#if wxUSE_THREADS"
        -:  787:#define wxENTER_CRIT_SECT(cs)   (cs).Enter()
        -:  788:#define wxLEAVE_CRIT_SECT(cs)   (cs).Leave()
        -:  789:#define wxCRIT_SECT_DECLARE(cs) static wxCriticalSection cs
        -:  790:#define wxCRIT_SECT_DECLARE_MEMBER(cs) wxCriticalSection cs
        -:  791:#define wxCRIT_SECT_LOCKER(name, cs)  wxCriticalSectionLocker name(cs)
        -:  792:
        -:  793:// function for checking if we're in the main thread which may be used whether
        -:  794:// wxUSE_THREADS is 0 or 1
        -:  795:inline bool wxIsMainThread() { return wxThread::IsMain(); }
        -:  796:
        -:  797:#else // !wxUSE_THREADS
        -:  798:
        -:  799:// no thread support
        -:  800:inline void wxMutexGuiEnter() { }
        -:  801:inline void wxMutexGuiLeave() { }
        -:  802:
        -:  803:// macros for entering/leaving critical sections which may be used without
        -:  804:// having to take them inside "#if wxUSE_THREADS"
        -:  805:// (the implementation uses dummy structs to force semicolon after the macro)
        -:  806:#define wxENTER_CRIT_SECT(cs)            do {} while (0)
        -:  807:#define wxLEAVE_CRIT_SECT(cs)            do {} while (0)
        -:  808:#define wxCRIT_SECT_DECLARE(cs)          struct wxDummyCS##cs
        -:  809:#define wxCRIT_SECT_DECLARE_MEMBER(cs)   struct wxDummyCSMember##cs { }
        -:  810:#define wxCRIT_SECT_LOCKER(name, cs)     struct wxDummyCSLocker##name
        -:  811:
        -:  812:// if there is only one thread, it is always the main one
        -:  813:inline bool wxIsMainThread() { return true; }
        -:  814:
        -:  815:#endif // wxUSE_THREADS/!wxUSE_THREADS
        -:  816:
        -:  817:// mark part of code as being a critical section: this macro declares a
        -:  818:// critical section with the given name and enters it immediately and leaves
        -:  819:// it at the end of the current scope
        -:  820://
        -:  821:// example:
        -:  822://
        -:  823://      int Count()
        -:  824://      {
        -:  825://          static int s_counter = 0;
        -:  826://
        -:  827://          wxCRITICAL_SECTION(counter);
        -:  828://
        -:  829://          return ++s_counter;
        -:  830://      }
        -:  831://
        -:  832:// this function is MT-safe in presence of the threads but there is no
        -:  833:// overhead when the library is compiled without threads
        -:  834:#define wxCRITICAL_SECTION(name) \
        -:  835:    wxCRIT_SECT_DECLARE(s_cs##name);  \
        -:  836:    wxCRIT_SECT_LOCKER(cs##name##Locker, s_cs##name)
        -:  837:
        -:  838:// automatically lock GUI mutex in ctor and unlock it in dtor
        -:  839:class WXDLLIMPEXP_BASE wxMutexGuiLocker
        -:  840:{
        -:  841:public:
        -:  842:    wxMutexGuiLocker() { wxMutexGuiEnter(); }
        -:  843:   ~wxMutexGuiLocker() { wxMutexGuiLeave(); }
        -:  844:};
