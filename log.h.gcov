        -:  885:
        -:  886:// ----------------------------------------------------------------------------
        -:  887:// wxLogger
        -:  888:// ----------------------------------------------------------------------------
        -:  889:
        -:  890:// wxLogger is a helper class used by wxLogXXX() functions implementation,
        -:  891:// don't use it directly as it's experimental and subject to change (OTOH it
        -:  892:// might become public in the future if it's deemed to be useful enough)
        -:  893:
        -:  894:// contains information about the context from which a log message originates
        -:  895:// and provides Log() vararg method which forwards to wxLog::OnLog() and passes
        -:  896:// this context to it
        -:  897:class wxLogger
        -:  898:{
        -:  899:public:
        -:  900:    // ctor takes the basic information about the log record
    #####:  901:    wxLogger(wxLogLevel level,
        -:  902:             const char *filename,
        -:  903:             int line,
        -:  904:             const char *func,
        -:  905:             const char *component)
    #####:  906:        : m_level(level),
    #####:  907:          m_info(filename, line, func, component)
        -:  908:    {
    #####:  909:    }
        -:  910:
        -:  911:    // store extra data in our log record and return this object itself (so
        -:  912:    // that further calls to its functions could be chained)
        -:  913:    template <typename T>
    #####:  914:    wxLogger& Store(const wxString& key, T val)
        -:  915:    {
    #####:  916:        m_info.StoreValue(key, val);
    #####:  917:        return *this;
        -:  918:    }
        -:  919:
        -:  920:    // hack for "overloaded" wxLogXXX() functions: calling this method
        -:  921:    // indicates that we may have an extra first argument preceding the format
        -:  922:    // string and that if we do have it, we should store it in m_info using the
        -:  923:    // given key (while by default 0 value will be used)
        -:  924:    wxLogger& MaybeStore(const wxString& key, wxUIntPtr value = 0)
        -:  925:    {
        -:  926:        wxASSERT_MSG( m_optKey.empty(), "can only have one optional value" );
        -:  927:        m_optKey = key;
        -:  928:
        -:  929:        m_info.StoreValue(key, value);
        -:  930:        return *this;
        -:  931:    }
        -:  932:
        -:  933:
        -:  934:    // non-vararg function used by wxVLogXXX():
        -:  935:
        -:  936:    // log the message at the level specified in the ctor if this log message
        -:  937:    // is enabled
        -:  938:    void LogV(const wxString& format, va_list argptr)
        -:  939:    {
        -:  940:        // remember that fatal errors can't be disabled
        -:  941:        if ( m_level == wxLOG_FatalError ||
        -:  942:                wxLog::IsLevelEnabled(m_level, wxASCII_STR(m_info.component)) )
        -:  943:            DoCallOnLog(format, argptr);
        -:  944:    }
        -:  945:
        -:  946:    // overloads used by functions with optional leading arguments (whose
        -:  947:    // values are stored in the key passed to MaybeStore())
        -:  948:    void LogV(long num, const wxString& format, va_list argptr)
        -:  949:    {
        -:  950:        Store(m_optKey, num);
        -:  951:
        -:  952:        LogV(format, argptr);
        -:  953:    }
        -:  954:
        -:  955:    void LogV(void *ptr, const wxString& format, va_list argptr)
        -:  956:    {
        -:  957:        Store(m_optKey, wxPtrToUInt(ptr));
        -:  958:
        -:  959:        LogV(format, argptr);
        -:  960:    }
        -:  961:
        -:  962:    void LogVTrace(const wxString& mask, const wxString& format, va_list argptr)
        -:  963:    {
        -:  964:        if ( !wxLog::IsAllowedTraceMask(mask) )
        -:  965:            return;
        -:  966:
        -:  967:        Store(wxLOG_KEY_TRACE_MASK, mask);
        -:  968:
        -:  969:        LogV(format, argptr);
        -:  970:    }
        -:  971:
        -:  972:
        -:  973:    // vararg functions used by wxLogXXX():
        -:  974:
        -:  975:    // will log the message at the level specified in the ctor
        -:  976:    //
        -:  977:    // notice that this function supposes that the caller already checked that
        -:  978:    // the level was enabled and does no checks itself
        -:  979:    WX_DEFINE_VARARG_FUNC_VOID
        -:  980:    (
        -:  981:        Log,
        -:  982:        1, (const wxFormatString&),
        -:  983:        DoLog, DoLogUtf8
        -:  984:    )
        -:  985:
        -:  986:    // same as Log() but with an extra numeric or pointer parameters: this is
        -:  987:    // used to pass an optional value by storing it in m_info under the name
        -:  988:    // passed to MaybeStore() and is required to support "overloaded" versions
        -:  989:    // of wxLogStatus() and wxLogSysError()
        -:  990:    WX_DEFINE_VARARG_FUNC_VOID
        -:  991:    (
        -:  992:        Log,
        -:  993:        2, (long, const wxFormatString&),
        -:  994:        DoLogWithNum, DoLogWithNumUtf8
        -:  995:    )
        -:  996:
        -:  997:    // unfortunately we can't use "void *" here as we get overload ambiguities
        -:  998:    // with Log(wxFormatString, ...) when the first argument is a "char *" or
        -:  999:    // "wchar_t *" then -- so we only allow passing wxObject here, which is
        -: 1000:    // ugly but fine in practice as this overload is only used by wxLogStatus()
        -: 1001:    // whose first argument is a wxFrame
        -: 1002:    WX_DEFINE_VARARG_FUNC_VOID
        -: 1003:    (
        -: 1004:        Log,
        -: 1005:        2, (wxObject *, const wxFormatString&),
        -: 1006:        DoLogWithPtr, DoLogWithPtrUtf8
        -: 1007:    )
        -: 1008:
        -: 1009:    // log the message at the level specified as its first argument
        -: 1010:    //
        -: 1011:    // as the macros don't have access to the level argument in this case, this
        -: 1012:    // function does check that the level is enabled itself
        -: 1013:    WX_DEFINE_VARARG_FUNC_VOID
        -: 1014:    (
        -: 1015:        LogAtLevel,
        -: 1016:        2, (wxLogLevel, const wxFormatString&),
        -: 1017:        DoLogAtLevel, DoLogAtLevelUtf8
        -: 1018:    )
        -: 1019:
        -: 1020:    // special versions for wxLogTrace() which is passed either string or
        -: 1021:    // integer mask as first argument determining whether the message should be
        -: 1022:    // logged or not
