        -:  772:
        -:  773:// ----------------------------------------------------------------------------
        -:  774:// /dev/null log target: suppress logging until this object goes out of scope
        -:  775:// ----------------------------------------------------------------------------
        -:  776:
        -:  777:// example of usage:
        -:  778:/*
        -:  779:    void Foo()
        -:  780:    {
        -:  781:        wxFile file;
        -:  782:
        -:  783:        // wxFile.Open() normally complains if file can't be opened, we don't
        -:  784:        // want it
        -:  785:        wxLogNull logNo;
        -:  786:
        -:  787:        if ( !file.Open("bar") )
        -:  788:            ... process error ourselves ...
        -:  789:
        -:  790:        // ~wxLogNull called, old log sink restored
        -:  791:    }
        -:  792: */
        -:  793:class WXDLLIMPEXP_BASE wxLogNull
        -:  794:{
        -:  795:public:
        -:  796:    wxLogNull() : m_flagOld(wxLog::EnableLogging(false)) { }
        -:  797:    ~wxLogNull() { (void)wxLog::EnableLogging(m_flagOld); }
        -:  798:
        -:  799:private:
        -:  800:    bool m_flagOld; // the previous value of the wxLog::ms_doLog
        -:  801:};
        -:  802:
        -:  803:// ----------------------------------------------------------------------------
        -:  804:// chaining log target: installs itself as a log target and passes all
        -:  805:// messages to the real log target given to it in the ctor but also forwards
        -:  806:// them to the previously active one
        -:  807://
        -:  808:// note that you don't have to call SetActiveTarget() with this class, it
        -:  809:// does it itself in its ctor
        -:  810:// ----------------------------------------------------------------------------
        -:  811:
        -:  812:class WXDLLIMPEXP_BASE wxLogChain : public wxLog
        -:  813:{
        -:  814:public:
        -:  815:    wxLogChain(wxLog *logger);
        -:  816:    virtual ~wxLogChain();
        -:  817:
        -:  818:    // change the new log target
        -:  819:    void SetLog(wxLog *logger);
        -:  820:
        -:  821:    // this can be used to temporarily disable (and then re-enable) passing
        -:  822:    // messages to the old logger (by default we do pass them)
        -:  823:    void PassMessages(bool bDoPass) { m_bPassMessages = bDoPass; }
        -:  824:
        -:  825:    // are we passing the messages to the previous log target?
        -:  826:    bool IsPassingMessages() const { return m_bPassMessages; }
        -:  827:
        -:  828:    // return the previous log target (may be NULL)
        -:  829:    wxLog *GetOldLog() const { return m_logOld; }
        -:  830:
        -:  831:    // override base class version to flush the old logger as well
        -:  832:    virtual void Flush() wxOVERRIDE;
        -:  833:
        -:  834:    // call to avoid destroying the old log target
        -:  835:    void DetachOldLog() { m_logOld = NULL; }
        -:  836:
        -:  837:protected:
        -:  838:    // pass the record to the old logger if needed
        -:  839:    virtual void DoLogRecord(wxLogLevel level,
        -:  840:                             const wxString& msg,
        -:  841:                             const wxLogRecordInfo& info) wxOVERRIDE;
        -:  842:
        -:  843:private:
        -:  844:    // the current log target
        -:  845:    wxLog *m_logNew;
        -:  846:
        -:  847:    // the previous log target
        -:  848:    wxLog *m_logOld;
        -:  849:
        -:  850:    // do we pass the messages to the old logger?
        -:  851:    bool m_bPassMessages;
        -:  852:
        -:  853:    wxDECLARE_NO_COPY_CLASS(wxLogChain);
        -:  854:};
        -:  855:
        -:  856:// a chain log target which uses itself as the new logger
        -:  857:
