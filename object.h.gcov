        -:  225:// wxRefCounter: ref counted data "manager"
        -:  226:// ----------------------------------------------------------------------------
        -:  227:
        -:  228:class WXDLLIMPEXP_BASE wxRefCounter
        -:  229:{
        -:  230:public:
        -:  231:    wxRefCounter() { m_count = 1; }
        -:  232:
        -:  233:    int GetRefCount() const { return m_count; }
        -:  234:
        -:  235:    void IncRef() { m_count++; }
        -:  236:    void DecRef();
        -:  237:
        -:  238:protected:
        -:  239:    // this object should never be destroyed directly but only as a
        -:  240:    // result of a DecRef() call:
        -:  241:    virtual ~wxRefCounter() { }
        -:  242:
        -:  243:private:
        -:  244:    // our refcount:
        -:  245:    int m_count;
        -:  246:
        -:  247:    // It doesn't make sense to copy the reference counted objects, a new ref
        -:  248:    // counter should be created for a new object instead and compilation
        -:  249:    // errors in the code using wxRefCounter due to the lack of copy ctor often
        -:  250:    // indicate a problem, e.g. a forgotten copy ctor implementation somewhere.
        -:  251:    wxDECLARE_NO_COPY_CLASS(wxRefCounter);
        -:  252:};
