        -:  173:    _WX_WANT_DELETE_VOID_WXCHAR_INT           = void operator delete(void *buf, wxChar*, int)
        -:  174:    _WX_WANT_ARRAY_NEW_SIZET_WXCHAR_INT       = void *operator new[] (size_t size, wxChar *fileName , int lineNum = 0)
        -:  175:    _WX_WANT_ARRAY_DELETE_VOID                = void operator delete[] (void *buf)
