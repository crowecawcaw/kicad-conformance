        -:  454:protected:
        -:  455:    // ensure that our data is not shared with anybody else: if we have no
        -:  456:    // data, it is created using CreateRefData() below, if we have shared data
        -:  457:    // it is copied using CloneRefData(), otherwise nothing is done
