        -:  367:
        -:  368:// We can't use wxArgNormalizer<T> for variadic arguments to wxScanf() etc.
        -:  369:// because they are writable, so instead of providing friendly template
        -:  370:// vararg-like functions, we just provide both char* and wchar_t* variants
        -:  371:// of these functions. The type of output variadic arguments for %s must match
        -:  372:// the type of 'str' and 'format' arguments.
        -:  373://
        -:  374:// For compatibility with earlier wx versions, we also provide wxSscanf()
        -:  375:// version with the first argument (input string) wxString; for this version,
        -:  376:// the type of output string values is determined by the type of format string
        -:  377:// only.
        -:  378:
        -:  379:#define _WX_SCANFUNC_EXTRACT_ARGS_1(x)   x
        -:  380:#define _WX_SCANFUNC_EXTRACT_ARGS_2(x,y) x, y
        -:  381:#define _WX_SCANFUNC_EXTRACT_ARGS(N, args) _WX_SCANFUNC_EXTRACT_ARGS_##N args
        -:  382:
        -:  383:#define _WX_VARARG_PASS_WRITABLE(i) a##i
        -:  384:
        -:  385:#define _WX_DEFINE_SCANFUNC(N, dummy1, name, impl, passfixed, numfixed, fixed)\
        -:  386:    template<_WX_VARARG_JOIN(N, _WX_VARARG_TEMPL)>                            \
        -:  387:    int name(_WX_SCANFUNC_EXTRACT_ARGS(numfixed, fixed),                      \
        -:  388:             _WX_VARARG_JOIN(N, _WX_VARARG_ARG))                              \
        -:  389:    {                                                                         \
        -:  390:        return  impl(_WX_SCANFUNC_EXTRACT_ARGS(numfixed, passfixed),          \
        -:  391:                     _WX_VARARG_JOIN(N, _WX_VARARG_PASS_WRITABLE));           \
        -:  392:    }
        -:  393:
        -:  394:#define WX_DEFINE_SCANFUNC(name, numfixed, fixed, impl, passfixed)            \
        -:  395:    _WX_VARARG_ITER(_WX_VARARG_MAX_ARGS,                                      \
        -:  396:                    _WX_DEFINE_SCANFUNC,                                      \
        -:  397:                    dummy1, name, impl, passfixed, numfixed, fixed)
