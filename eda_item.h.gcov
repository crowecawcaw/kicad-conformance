        -:  334:    /**
        -:  335:     * This changes first parameter to avoid the DList and use the main queue instead.
        -:  336:     */
        -:  337:    template< class T >
        -:  338:    static INSPECT_RESULT IterateForward( std::deque<T>& aList, INSPECTOR inspector, void* testData,
        -:  339:                                          const std::vector<KICAD_T>& scanTypes )
        -:  340:    {
        -:  341:        for( const auto& it : aList )
