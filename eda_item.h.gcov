        -:  344:
        -:  345:            if( item && item->Visit( inspector, testData, scanTypes ) == INSPECT_RESULT::QUIT )
        -:  346:            {
        -:  347:                return INSPECT_RESULT::QUIT;
        -:  348:            }
        -:  349:        }
        -:  350:
        -:  351:        return INSPECT_RESULT::CONTINUE;
        -:  352:    }
