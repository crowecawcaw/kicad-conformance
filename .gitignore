# Local runner scratch / caches
__pycache__/
*.pyc
.venv/

# Coverage measurement artifacts (tools/coverage/README.md)
tools/coverage/out/

# gcov text output (generated by tools/coverage/collect.sh)
*.gcov

# KiCad writes a project-local settings file beside any board it opens, so
# running a case's input through kicad-cli leaves one in the case directory.
# It is a product of running the suite, never part of a case.
*.kicad_prl
