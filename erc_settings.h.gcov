        -:   34:/// ERC error codes
        -:   35:enum ERCE_T
        -:   36:{
        -:   37:    ERCE_UNSPECIFIED = 0,
        -:   38:    ERCE_FIRST,
        -:   39:    ERCE_DUPLICATE_SHEET_NAME = ERCE_FIRST,  ///< Duplicate sheet names within a given sheet.
        -:   40:    ERCE_ENDPOINT_OFF_GRID,       ///< Pin or wire-end off grid.
        -:   41:    ERCE_PIN_NOT_CONNECTED,       ///< Pin not connected and not no connect symbol.
        -:   42:    ERCE_PIN_NOT_DRIVEN,          ///< Pin connected to some others pins but no pin to drive it.
        -:   43:                                  ///<   pins to drive it can be output, passive, 3sttae, I/O
        -:   44:    ERCE_POWERPIN_NOT_DRIVEN,     ///< Power input pin connected to some others pins but no
        -:   45:                                  ///<   power out pin to drive it.
        -:   46:    ERCE_HIERACHICAL_LABEL,       ///< Mismatch between hierarchical labels and pins sheets.
        -:   47:    ERCE_NOCONNECT_CONNECTED,     ///< A no connect symbol is connected to more than 1 pin.
        -:   48:    ERCE_NOCONNECT_NOT_CONNECTED, ///< A no connect symbol is not connected to anything.
        -:   49:    ERCE_LABEL_NOT_CONNECTED,     ///< Label not connected to any pins.
        -:   50:    ERCE_SIMILAR_LABELS,          ///< 2 labels are equal for case insensitive comparisons.
        -:   51:    ERCE_SIMILAR_POWER,           ///< 2 power pins are equal for case insensitive comparisons.
        -:   52:    ERCE_SIMILAR_LABEL_AND_POWER, ///< label and pin are equal for case insensitive comparisons.
        -:   53:    ERCE_SINGLE_GLOBAL_LABEL,            ///< A label only exists once in the schematic.
        -:   54:    ERCE_SAME_LOCAL_GLOBAL_LABEL, ///< 2 labels are equal for case insensitive comparisons.
        -:   55:    ERCE_DIFFERENT_UNIT_FP,       ///< Different units of the same symbol have different
        -:   56:                                  ///<   footprints assigned.
        -:   57:    ERCE_MISSING_POWER_INPUT_PIN, ///< Symbol has power input pins that are not placed on the
        -:   58:                                  ///<   schematic
        -:   59:    ERCE_MISSING_INPUT_PIN,       ///< Symbol has input pins that are not placed
        -:   60:    ERCE_MISSING_BIDI_PIN,        ///< Symbol has bi-directional pins that are not placed
        -:   61:    ERCE_MISSING_UNIT,            ///< Symbol has units that are not placed on the schematic
        -:   62:    ERCE_DIFFERENT_UNIT_NET,      ///< Shared pin in a multi-unit symbol is connected to
        -:   63:                                  ///<   more than one net.
        -:   64:    ERCE_BUS_ALIAS_CONFLICT,      ///< Conflicting bus alias definitions across sheets.
        -:   65:    ERCE_DRIVER_CONFLICT,         ///< Conflicting drivers (labels, etc) on a subgraph.
        -:   66:    ERCE_BUS_ENTRY_CONFLICT,      ///< A wire connected to a bus doesn't match the bus.
        -:   67:    ERCE_BUS_TO_BUS_CONFLICT,     ///< A connection between bus objects doesn't share at least
        -:   68:                                  ///<   one net.
        -:   69:    ERCE_BUS_TO_NET_CONFLICT,     ///< A bus wire is graphically connected to a net port/pin
        -:   70:                                  ///<   (or vice versa).
        -:   71:    ERCE_GROUND_PIN_NOT_GROUND,   ///< A ground-labeled pin is not on a ground net while another pin is.
        -:   72:    ERCE_LABEL_SINGLE_PIN,        ///< A label is connected only to a single pin
        -:   73:    ERCE_UNRESOLVED_VARIABLE,     ///< A text variable could not be resolved.
        -:   74:    ERCE_UNDEFINED_NETCLASS,      ///< A netclass was referenced but not defined.
        -:   75:    ERCE_SIMULATION_MODEL,        ///< An error was found in the simulation model.
        -:   76:    ERCE_WIRE_DANGLING,           ///< Some wires are not connected to anything else.
        -:   77:    ERCE_LIB_SYMBOL_ISSUES,       ///< Symbol not found in active libraries.
        -:   78:    ERCE_LIB_SYMBOL_MISMATCH,     ///< Symbol doesn't match copy in library.
        -:   79:    ERCE_FOOTPRINT_LINK_ISSUES,   ///< The footprint link is invalid, or points to a missing
        -:   80:                                  ///<   (or inactive) footprint or library.
        -:   81:    ERCE_FOOTPRINT_FILTERS,       ///< The assigned footprint doesn't match the footprint filters
        -:   82:    ERCE_UNANNOTATED,             ///< Symbol has not been annotated.
        -:   83:    ERCE_EXTRA_UNITS,             ///< Symbol has more units than are defined.
        -:   84:    ERCE_DIFFERENT_UNIT_VALUE,    ///< Units of same symbol have different values.
        -:   85:    ERCE_DUPLICATE_REFERENCE,     ///< More than one symbol with the same reference.
        -:   86:    ERCE_BUS_ENTRY_NEEDED,        ///< Importer failed to auto-place a bus entry.
        -:   87:    ERCE_FOUR_WAY_JUNCTION,       ///< A four-way junction was found.
        -:   88:    ERCE_LABEL_MULTIPLE_WIRES,    ///< A label is connected to more than one wire.
        -:   89:    ERCE_UNCONNECTED_WIRE_ENDPOINT, ///< A label is connected to more than one wire.
        -:   90:    ERCE_STACKED_PIN_SYNTAX,      ///< Pin name resembles stacked pin notation.
        -:   91:    ERCE_FIELD_NAME_WHITESPACE,   ///< Field name has leading or trailing whitespace.
        -:   92:
        -:   93:    ERCE_LAST = ERCE_FIELD_NAME_WHITESPACE,
        -:   94:
        -:   95:    ERCE_DUPLICATE_PIN_ERROR,
        -:   96:    ERCE_PIN_TO_PIN_WARNING,    // pin connected to an other pin: warning level
        -:   97:    ERCE_PIN_TO_PIN_ERROR,      // pin connected to an other pin: error level
        -:   98:    ERCE_ANNOTATION_ACTION,     // Not actually an error; just an action performed during
        -:   99:                                // annotation which is passed back through the error handler.
        -:  100:    ERCE_GENERIC_WARNING,
        -:  101:    ERCE_GENERIC_ERROR
        -:  102:};
