        -:  120:/// Types of drive on a net (used for legacy ERC)
        -:  121:#define NPI    4  // Net with Pin isolated, this pin has type Not Connected and must be left N.C.
        -:  122:#define DRV    3  // Net driven by a signal (a pin output for instance)
        -:  123:#define NET_NC 2  // Net "connected" to a "NoConnect symbol"
        -:  124:#define NOD    1  // Net not driven ( Such as 2 or more connected inputs )
        -:  125:#define NOC    0  // initial state of a net: no connection
