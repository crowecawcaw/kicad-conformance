        -:   32:// IDs for targets when creating teardrops
        -:   33:enum TARGET_TD
        -:   34:{
        -:   35:    TARGET_UNKNOWN = -1,
        -:   36:    TARGET_ROUND = 0,
        -:   37:    TARGET_RECT =  1,
        -:   38:    TARGET_TRACK = 2,
        -:   39:    TARGET_COUNT = 3
        -:   40:};
        -:   41:
        -:   42:/**
        -:   43: * TEARDROP_PARAMETARS is a helper class to handle parameters needed to build teardrops
        -:   44: * for a board
        -:   45: * these parameters are sizes and filters
        -:   46: */
        -:   47:class TEARDROP_PARAMETERS
        -:   48:{
        -:   49:public:
    #####:   50:    TEARDROP_PARAMETERS():
    #####:   51:            m_TdMaxLen( pcbIUScale.mmToIU( 1.0 ) ),
    #####:   52:            m_TdMaxWidth( pcbIUScale.mmToIU( 2.0 ) ),
    #####:   53:            m_BestLengthRatio( 0.5),
    #####:   54:            m_BestWidthRatio( 1.0 ),
    #####:   55:            m_WidthtoSizeFilterRatio( 0.9 ),
    #####:   56:            m_CurvedEdges( false ),
    #####:   57:            m_Enabled( false ),
    #####:   58:            m_AllowUseTwoTracks( true ),
    #####:   59:            m_TdOnPadsInZones( false )
        -:   60:    {
    #####:   61:    }
        -:   62:
        -:   63:    /**
        -:   64:     * Set max allowed length and height for teardrops in IU.
        -:   65:     * a value <= 0 disable the constraint
        -:   66:     */
        -:   67:    void SetTeardropMaxSize( int aMaxLen, int aMaxHeight )
        -:   68:    {
        -:   69:        m_TdMaxLen = aMaxLen;
        -:   70:        m_TdMaxWidth = aMaxHeight;
        -:   71:    }
        -:   72:
        -:   73:    /**
        -:   74:     * Set prefered length and height ratio for teardrops
        -:   75:     * the prefered length and height are VIAPAD width * aLenghtRatio and
        -:   76:     * VIAPAD width * aHeightRatio
        -:   77:     */
        -:   78:    void SetTeardropSizeRatio( double aLenghtRatio = 0.5, double aHeightRatio = 1.0 )
        -:   79:    {
        -:   80:        m_BestLengthRatio = aLenghtRatio;
        -:   81:        m_BestWidthRatio = aHeightRatio;
        -:   82:    }
        -:   83:
        -:   84:    bool operator== ( const TEARDROP_PARAMETERS& aOther ) const
        -:   85:    {
        -:   86:        return m_Enabled == aOther.m_Enabled &&
        -:   87:               m_AllowUseTwoTracks == aOther.m_AllowUseTwoTracks &&
        -:   88:               m_TdMaxLen == aOther.m_TdMaxLen &&
        -:   89:               m_TdMaxWidth == aOther.m_TdMaxWidth &&
        -:   90:               m_BestLengthRatio == aOther.m_BestLengthRatio &&
        -:   91:               m_BestWidthRatio == aOther.m_BestWidthRatio &&
        -:   92:               m_CurvedEdges == aOther.m_CurvedEdges &&
        -:   93:               m_WidthtoSizeFilterRatio == aOther.m_WidthtoSizeFilterRatio &&
        -:   94:               m_TdOnPadsInZones == aOther.m_TdOnPadsInZones;
        -:   95:    }
        -:   96:
        -:   97:    bool operator!= ( const TEARDROP_PARAMETERS& aOther ) const
        -:   98:    {
        -:   99:        return !( *this == aOther );
        -:  100:    }
        -:  101:
        -:  102:public:
        -:  103:    /// max allowed length for teardrops in IU. <= 0 to disable
        -:  104:    int     m_TdMaxLen;
        -:  105:    /// max allowed height for teardrops in IU. <= 0 to disable
        -:  106:    int     m_TdMaxWidth;
        -:  107:    /// The length of a teardrop as ratio between length and size of pad/via
        -:  108:    double  m_BestLengthRatio;
        -:  109:    /// The height of a teardrop as ratio between height and size of pad/via
        -:  110:    double  m_BestWidthRatio;
        -:  111:    /// The ratio (H/D) between the via/pad size and the track width max value to create a teardrop
        -:  112:    /// 1.0 (100 %) always creates a teardrop, 0.0 (0%) never create a teardrop
        -:  113:    double  m_WidthtoSizeFilterRatio;
        -:  114:    /// True if the teardrop should be curved
        -:  115:    bool    m_CurvedEdges;
        -:  116:
        -:  117:    /// Flag to enable teardrops
        -:  118:    bool m_Enabled;
        -:  119:    /// True to create teardrops using 2 track segments if the first in too small
        -:  120:    bool m_AllowUseTwoTracks;
        -:  121:    /// A filter to exclude pads inside zone fills
        -:  122:    bool m_TdOnPadsInZones;
        -:  123:};
        -:  124:
        -:  125:
        -:  126:
        -:  127:/**
        -:  128: * TEARDROP_PARAMETERS_LIST is a helper class to handle the list of TEARDROP_PARAMETERS
        -:  129: * needed  to build teardrops of different shapes (round, rect, tracks)
        -:  130: */
        -:  131:class TEARDROP_PARAMETERS_LIST
        -:  132:{
        -:  133:    std::vector<TEARDROP_PARAMETERS> m_params_list;
        -:  134:
        -:  135:public:
        -:  136:    /// True to create teardrops for vias
        -:  137:    bool     m_TargetVias;
        -:  138:    /// True to create teardrops for pads with holes
        -:  139:    bool     m_TargetPTHPads;
        -:  140:    /// True to create teardrops for pads SMD, edge connectors,
        -:  141:    bool     m_TargetSMDPads;
        -:  142:    /// True to create teardrops at the end of a track connected to the end of
        -:  143:    /// another track having a different width
        -:  144:    bool     m_TargetTrack2Track;
        -:  145:    /// True to create teardrops for round shapes only
        -:  146:    bool     m_UseRoundShapesOnly;
        -:  147:
        -:  148:public:
        -:  149:    TEARDROP_PARAMETERS_LIST() :
        -:  150:            m_TargetVias( true ),
        -:  151:            m_TargetPTHPads( true ),
        -:  152:            m_TargetSMDPads( true ),
        -:  153:            m_TargetTrack2Track( false ),
        -:  154:            m_UseRoundShapesOnly( false )
        -:  155:    {
        -:  156:        m_params_list.emplace_back();     // parameters for TARGET_ROUND
        -:  157:        m_params_list.emplace_back();     // parameters for TARGET_RECT
        -:  158:        m_params_list.emplace_back();     // parameters for TARGET_TRACK
        -:  159:    }
        -:  160:
        -:  161:    /**
        -:  162:     * @return the TEARDROP_PARAMETERS for aTdType target item
        -:  163:     */
        -:  164:    TEARDROP_PARAMETERS* GetParameters( TARGET_TD aTdType )
        -:  165:    {
        -:  166:        return &m_params_list.at( aTdType );
        -:  167:    }
        -:  168:
        -:  169:    /**
        -:  170:     * @return the number of TEARDROP_PARAMETERS item. Should be 3
        -:  171:     */
        -:  172:    size_t GetParametersCount()
        -:  173:    {
        -:  174:        return m_params_list.size();
        -:  175:    }
        -:  176:};
        -:  177:
        -:  178:
        -:  179:/**
        -:  180: * @return the canonical name of a target type of a TEARDROP_PARAMETERS
        -:  181: * @param aTdType is the target type
        -:  182: */
        -:  183:std::string GetTeardropTargetCanonicalName( TARGET_TD aTdType );
        -:  184:
        -:  185:/**
        -:  186: * @return the target type from a canonical name of a TEARDROP_PARAMETERS
        -:  187: * @param aTargetName is the canonical name
        -:  188: */
        -:  189:TARGET_TD GetTeardropTargetTypeFromCanonicalName( const std::string& aTargetName );
        -:  190:
        -:  191:#endif  // ifndef TEARDROP_PARAMS_H
