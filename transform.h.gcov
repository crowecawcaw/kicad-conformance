        -:   37:/**
        -:   38: * for transforming drawing coordinates for a wxDC device context.
        -:   39: *
        -:   40: * This probably should be a base class with all pure virtual methods and a WXDC_TRANSFORM
        -:   41: * derived class.  Then in the future if some new device context is used, a new transform could
        -:   42: * be derived from the base class and all the drawable objects would have to do is provide
        -:   43: * overloaded draw methods to use the new transform.
        -:   44: */
        -:   45:class TRANSFORM
        -:   46:{
        -:   47:public:
        -:   48:    int x1;
        -:   49:    int y1;
        -:   50:    int x2;
        -:   51:    int y2;
        -:   52:
        -:   53:    /**
        -:   54:     * The default construct creates a transform that draws object is the normal orientation.
        -:   55:     */
     5852:   56:    TRANSFORM() :
     5852:   57:            x1( 1 ),
     5852:   58:            y1( 0 ),
     5852:   59:            x2( 0 ),
     5852:   60:            y2( 1 )
     5852:   61:    {}
        -:   62:
      421:   63:    TRANSFORM( int ax1, int ay1, int ax2, int ay2 ) :
      421:   64:            x1( ax1 ),
      421:   65:            y1( ay1 ),
      421:   66:            x2( ax2 ),
      421:   67:            y2( ay2 )
      421:   68:    {}
        -:   69:
        -:   70:    bool operator==( const TRANSFORM& aTransform ) const;
        -:   71:
        -:   72:    bool operator!=( const TRANSFORM& aTransform ) const { return !( *this == aTransform ); }
        -:   73:
        -:   74:   /**
        -:   75:    * Calculate a new coordinate according to the mirror/rotation transform.
        -:   76:    * Useful to calculate actual coordinates of a point from coordinates relative to a symbol,
        -:   77:    * which are given for a non-rotated,-non mirrored item.
        -:   78:    * @param aPoint = The position to transform
        -:   79:    * @return The transformed coordinate.
        -:   80:    */
        -:   81:    VECTOR2I TransformCoordinate( const VECTOR2I& aPoint ) const;
        -:   82:
        -:   83:   /**
        -:   84:    * Calculate a new rect according to the mirror/rotation transform.
        -:   85:    * Useful to calculate actual coordinates of a point from coordinates relative to a symbol,
        -:   86:    * which are given for a non-rotated,-non mirrored item.
        -:   87:    * @param aRect = The rectangle to transform
        -:   88:    * @return The transformed rectangle.
        -:   89:    */
        -:   90:    BOX2I TransformCoordinate( const BOX2I& aRect ) const;
        -:   91:
        -:   92:    /**
        -:   93:    * Calculate the Inverse mirror/rotation transform.
        -:   94:    * Useful to calculate coordinates relative to a symbol, which must be for a non-rotated,
        -:   95:    * non-mirrored item from the actual coordinate.
        -:   96:    * @return The inverse transform.
        -:   97:    */
        -:   98:    TRANSFORM InverseTransform( ) const;
        -:   99:
        -:  100:   /**
        -:  101:    * Calculate new angles according to the transform.
        -:  102:    *
        -:  103:    * @param aAngle1 = The first angle to transform
        -:  104:    * @param aAngle2 = The second angle to transform
        -:  105:    * @return True if the angles were swapped during the transform.
        -:  106:    */
        -:  107:   bool MapAngles( EDA_ANGLE* aAngle1, EDA_ANGLE* aAngle2 ) const;
        -:  108:};
