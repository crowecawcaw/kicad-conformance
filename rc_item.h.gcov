        -:   47:/**
        -:   48: * Provide an abstract interface of a RC_ITEM* list manager.
        -:   49: *
        -:   50: * The details of the actual list architecture are hidden from the caller.  Any class that
        -:   51: * implements this interface can then be used by a RC_TREE_MODEL class without it knowing
        -:   52: * the actual architecture of the list.
        -:   53: */
        -:   54:class RC_ITEMS_PROVIDER
        -:   55:{
        -:   56:public:
        -:   57:    virtual void SetSeverities( int aSeverities ) = 0;
        -:   58:
        -:   59:    virtual int GetSeverities() const = 0;
        -:   60:
        -:   61:    virtual int GetCount( int aSeverity = -1 ) const = 0;
        -:   62:
        -:   63:    /**
        -:   64:     * Retrieve a RC_ITEM by index.
        -:   65:     */
        -:   66:    virtual std::shared_ptr<RC_ITEM> GetItem( int aIndex ) const = 0;
        -:   67:
        -:   68:    /**
        -:   69:     * Remove (and optionally deletes) the indexed item from the list.
        -:   70:     * @param aDeep If true, the source item should be deleted as well as its entry in the list.
        -:   71:     */
        -:   72:    virtual void DeleteItem( int aIndex, bool aDeep ) = 0;
        -:   73:
        -:   74:    virtual ~RC_ITEMS_PROVIDER() { }
        -:   75:};
