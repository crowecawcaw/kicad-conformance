        -:  218:class RC_TREE_NODE
        -:  219:{
        -:  220:public:
        -:  221:    enum NODE_TYPE
        -:  222:    {
        -:  223:        MARKER,
        -:  224:        MAIN_ITEM,
        -:  225:        AUX_ITEM,
        -:  226:        AUX_ITEM2,
        -:  227:        AUX_ITEM3,
        -:  228:        COMMENT
        -:  229:    };
        -:  230:
        -:  231:    RC_TREE_NODE( RC_TREE_NODE* aParent, const std::shared_ptr<RC_ITEM>& aRcItem,
        -:  232:                  NODE_TYPE aType ) :
        -:  233:            m_Type( aType ),
        -:  234:            m_RcItem( aRcItem ),
        -:  235:            m_Parent( aParent )
        -:  236:    {}
        -:  237:
        -:  238:    ~RC_TREE_NODE()
        -:  239:    {
        -:  240:        for( RC_TREE_NODE* child : m_Children )
        -:  241:            delete child;
        -:  242:    }
        -:  243:
        -:  244:    // We own at least one list of raw pointers.  Don't let the compiler fill in copy c'tors that
        -:  245:    // will only land us in trouble.
        -:  246:    RC_TREE_NODE( const RC_TREE_NODE& ) = delete;
        -:  247:    RC_TREE_NODE& operator=( const RC_TREE_NODE& ) = delete;
        -:  248:
        -:  249:    NODE_TYPE                  m_Type;
        -:  250:    std::shared_ptr<RC_ITEM>   m_RcItem;
        -:  251:
        -:  252:    struct HANDLE
        -:  253:    {
        -:  254:        RC_TREE_NODE* m_Node = nullptr;
        -:  255:    };
        -:  256:
        -:  257:    HANDLE*                    m_Handle = nullptr;
        -:  258:    RC_TREE_NODE*              m_Parent;
        -:  259:    std::vector<RC_TREE_NODE*> m_Children;
        -:  260:};
