        -:   78:/**
        -:   79: * A holder for a rule check item, DRC in Pcbnew or ERC in Eeschema.
        -:   80: *
        -:   81: * RC_ITEMs can have zero, one, or two related EDA_ITEMs.
        -:   82: */
        -:   83:class RC_ITEM
        -:   84:{
        -:   85:public:
        -:   86:    typedef std::vector<KIID> KIIDS;
        -:   87:
        -:   88:    RC_ITEM() :
        -:   89:        m_errorCode( 0 ),
        -:   90:        m_parent( nullptr )
        -:   91:    {
        -:   92:    }
        -:   93:
        -:   94:    RC_ITEM( const std::shared_ptr<RC_ITEM>& aItem )
        -:   95:    {
        -:   96:        m_errorCode    = aItem->m_errorCode;
        -:   97:        m_errorMessage = aItem->m_errorMessage;
        -:   98:        m_errorTitle   = aItem->m_errorTitle;
        -:   99:        m_settingsKey  = aItem->m_settingsKey;
        -:  100:        m_parent       = aItem->m_parent;
        -:  101:        m_ids          = aItem->m_ids;
        -:  102:    }
        -:  103:
        -:  104:    virtual ~RC_ITEM() { }
        -:  105:
    #####:  106:    void SetErrorMessage( const wxString& aMessage ) { m_errorMessage = aMessage; }
        -:  107:
        -:  108:    void SetErrorDetail( const wxString& aMsg ) { SetErrorMessage( GetErrorText( true ) + wxS( " " ) + aMsg ); }
        -:  109:
        -:  110:    void SetItems( const KIIDS& aIds ) { m_ids = aIds; }
        -:  111:
        -:  112:    void AddItem( EDA_ITEM* aItem );
        -:  113:
        -:  114:    void SetItems( const EDA_ITEM* aItem, const EDA_ITEM* bItem = nullptr,
        -:  115:                   const EDA_ITEM* cItem = nullptr, const EDA_ITEM* dItem = nullptr );
        -:  116:
        -:  117:    void SetItems( const KIID& aItem, const KIID& bItem = niluuid, const KIID& cItem = niluuid,
        -:  118:                   const KIID& dItem = niluuid )
        -:  119:    {
        -:  120:        m_ids.clear();
        -:  121:
        -:  122:        m_ids.push_back( aItem );
        -:  123:        m_ids.push_back( bItem );
        -:  124:        m_ids.push_back( cItem );
        -:  125:        m_ids.push_back( dItem );
        -:  126:    }
        -:  127:
        -:  128:    virtual KIID GetMainItemID() const { return m_ids.size() > 0 ? m_ids[0] : niluuid; }
        -:  129:    virtual KIID GetAuxItemID() const { return m_ids.size() > 1 ? m_ids[1] : niluuid; }
        -:  130:    virtual KIID GetAuxItem2ID() const { return m_ids.size() > 2 ? m_ids[2] : niluuid; }
        -:  131:    virtual KIID GetAuxItem3ID() const { return m_ids.size() > 3 ? m_ids[3] : niluuid; }
        -:  132:
        -:  133:    std::vector<KIID> GetIDs() const { return m_ids; }
        -:  134:
        -:  135:    void SetParent( MARKER_BASE* aMarker ) { m_parent = aMarker; }
        -:  136:    MARKER_BASE* GetParent() const { return m_parent; }
        -:  137:
        -:  138:
        -:  139:    /**
        -:  140:     * Translate this object into a text string suitable for saving to disk in a report.
        -:  141:     *
        -:  142:     * @return wxString - the simple multi-line report text.
        -:  143:     */
        -:  144:    virtual wxString ShowReport( UNITS_PROVIDER* aUnitsProvider, SEVERITY aSeverity,
        -:  145:                                 const std::map<KIID, EDA_ITEM*>& aItemMap ) const;
        -:  146:
        -:  147:    /**
        -:  148:     * Translate this object into an RC_JSON::VIOLATION object
        -:  149:     *
        -:  150:     * @param aViolation is the violation to be populated by info from this item
        -:  151:     * @param aUnitsProvider is the units provider that will be used to output coordinates
        -:  152:     * @param aSeverity is the severity of this item
        -:  153:     * @param aItemMap is a map allowing the lookup of items from KIIDs
        -:  154:     *
        -:  155:     * @return None
        -:  156:     */
        -:  157:    virtual void GetJsonViolation( RC_JSON::VIOLATION& aViolation, UNITS_PROVIDER* aUnitsProvider,
        -:  158:                                   SEVERITY aSeverity,
        -:  159:                                   const std::map<KIID, EDA_ITEM*>& aItemMap ) const;
        -:  160:
        -:  161:    int GetErrorCode() const { return m_errorCode; }
        -:  162:    void SetErrorCode( int aCode ) { m_errorCode = aCode; }
        -:  163:
        -:  164:    /**
        -:  165:     * @return the error message describing the specific details of a RC_ITEM.  For instance,
        -:  166:     * "Clearance violation (netclass '100ohm' clearance 0.4000mm; actual 0.3200mm)"
        -:  167:     */
        -:  168:    virtual wxString GetErrorMessage( bool aTranslate ) const;
        -:  169:
        -:  170:    /**
        -:  171:     * @return the error text for the class of error of this RC_ITEM represents.  For instance,
        -:  172:     * "Clearance violation".
        -:  173:     */
        -:  174:    wxString GetErrorText( bool aTranslate ) const
        -:  175:    {
        -:  176:        if( aTranslate )
        -:  177:            return wxGetTranslation( m_errorTitle );
        -:  178:        else
        -:  179:            return m_errorTitle;
        -:  180:    }
        -:  181:
        -:  182:    wxString GetSettingsKey() const
        -:  183:    {
        -:  184:        return m_settingsKey;
        -:  185:    }
        -:  186:
        -:  187:    virtual wxString GetViolatingRuleDesc( bool aTranslate ) const
        -:  188:    {
        -:  189:        return wxEmptyString;
        -:  190:    }
        -:  191:
        -:  192:protected:
        -:  193:    static wxString getSeverityString( SEVERITY aSeverity );
        -:  194:
        -:  195:    /**
        -:  196:     * Resolve the description string used for an affected item in ShowReport and
        -:  197:     * GetJsonViolation.  Subclasses that need per-context formatting (e.g. ERC's
        -:  198:     * per-sheet-instance symbol references) override this rather than reimplementing
        -:  199:     * the surrounding report layout.
        -:  200:     *
        -:  201:     * @param aItem is the affected item being described
        -:  202:     * @param aIndex is 0 for the main item and 1 for the aux item
        -:  203:     */
        -:  204:    virtual wxString getItemDescription( EDA_ITEM* aItem, int aIndex,
        -:  205:                                         UNITS_PROVIDER* aUnitsProvider ) const;
        -:  206:
        -:  207:    int           m_errorCode;         ///< The error code's numeric value
        -:  208:    wxString      m_errorMessage;      ///< A message describing the details of this specific error
        -:  209:    wxString      m_errorTitle;        ///< The string describing the type of error
        -:  210:    wxString      m_settingsKey;       ///< The key used to describe this type of error in settings
        -:  211:    MARKER_BASE*  m_parent;            ///< The marker this item belongs to, if any
        -:  212:
        -:  213:    KIIDS         m_ids;
        -:  214:
        -:  215:};
