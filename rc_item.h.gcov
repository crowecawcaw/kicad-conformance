        -:  263:class RC_TREE_MODEL : public wxDataViewModel, public wxEvtHandler
        -:  264:{
        -:  265:public:
        -:  266:    static wxDataViewItem ToItem( RC_TREE_NODE const* aNode )
        -:  267:    {
        -:  268:        return aNode && aNode->m_Handle ? wxDataViewItem( aNode->m_Handle ) : wxDataViewItem();
        -:  269:    }
        -:  270:
        -:  271:    static RC_TREE_NODE* ToNode( wxDataViewItem aItem )
        -:  272:    {
        -:  273:        auto* handle = static_cast<RC_TREE_NODE::HANDLE*>( aItem.GetID() );
        -:  274:        return handle ? handle->m_Node : nullptr;
        -:  275:    }
