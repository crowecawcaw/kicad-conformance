        -:  126:/**
        -:  127: * Determine the center of an arc or circle given three points on its circumference.
        -:  128: *
        -:  129: * @param aStart The starting point of the circle (equivalent to aEnd).
        -:  130: * @param aMid The point on the arc, half-way between aStart and aEnd.
        -:  131: * @param aEnd The ending point of the circle (equivalent to aStart).
        -:  132: * @return The center of the circle.
        -:  133: */
        -:  134:const VECTOR2I CalcArcCenter( const VECTOR2I& aStart, const VECTOR2I& aMid, const VECTOR2I& aEnd );
        -:  135:const VECTOR2D CalcArcCenter( const VECTOR2D& aStart, const VECTOR2D& aMid, const VECTOR2D& aEnd );
        -:  136:const VECTOR2D CalcArcCenter( const VECTOR2D& aStart, const VECTOR2D& aEnd,
        -:  137:                              const EDA_ANGLE& aAngle );
        -:  138:
        -:  139:/**
        -:  140: * Return the middle point of an arc, half-way between aStart and aEnd.
        -:  141: *
        -:  142: * There are two possible solutions which can be found by toggling aMinArcAngle. The behavior
        -:  143: * is undefined for semicircles (i.e. 180 degree arcs).
        -:  144: *
        -:  145: * @param aStart The starting point of the arc (for calculating the radius).
        -:  146: * @param aEnd The end point of the arc (for determining the arc angle).
        -:  147: * @param aCenter The center point of the arc.
        -:  148: * @param aMinArcAngle If true, returns the point that results in the smallest arc angle.
        -:  149: * @return The middle point of the arc.
        -:  150:*/
        -:  151:const VECTOR2I CalcArcMid( const VECTOR2I& aStart, const VECTOR2I& aEnd, const VECTOR2I& aCenter,
        -:  152:                           bool aMinArcAngle = true );
