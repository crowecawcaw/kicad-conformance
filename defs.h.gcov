        -: 1690:#define wxPOPUP_WINDOW          0x00020000
        -: 1691:
        -: 1692:/*  force a full repaint when the window is resized (instead of repainting just */
        -: 1693:/*  the invalidated area) */
        -: 1694:#define wxFULL_REPAINT_ON_RESIZE 0x00010000
        -: 1695:
        -: 1696:/*  obsolete: now this is the default behaviour */
        -: 1697:/*  */
        -: 1698:/*  don't invalidate the whole window (resulting in a PAINT event) when the */
        -: 1699:/*  window is resized (currently, makes sense for wxMSW only) */
        -: 1700:#define wxNO_FULL_REPAINT_ON_RESIZE 0
        -: 1701:
        -: 1702:/* A mask which can be used to filter (out) all wxWindow-specific styles.
        -: 1703: */
        -: 1704:#define wxWINDOW_STYLE_MASK     \
        -: 1705:    (wxVSCROLL|wxHSCROLL|wxBORDER_MASK|wxALWAYS_SHOW_SB|wxCLIP_CHILDREN| \
        -: 1706:     wxCLIP_SIBLINGS|wxTRANSPARENT_WINDOW|wxTAB_TRAVERSAL|wxWANTS_CHARS| \
        -: 1707:     wxRETAINED|wxPOPUP_WINDOW|wxFULL_REPAINT_ON_RESIZE)
        -: 1708:
        -: 1709:/*
        -: 1710: * Extra window style flags (use wxWS_EX prefix to make it clear that they
