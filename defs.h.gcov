        -: 1584:/*  ---------------------------------------------------------------------------- */
        -: 1585:/*  Window style flags */
        -: 1586:/*  ---------------------------------------------------------------------------- */
        -: 1587:
        -: 1588:/*
        -: 1589: * Values are chosen so they can be |'ed in a bit list.
        -: 1590: * Some styles are used across more than one group,
        -: 1591: * so the values mustn't clash with others in the group.
        -: 1592: * Otherwise, numbers can be reused across groups.
        -: 1593: */
        -: 1594:
        -: 1595:/*
        -: 1596:    Summary of the bits used by various styles.
        -: 1597:
        -: 1598:    High word, containing styles which can be used with many windows:
        -: 1599:
        -: 1600:    +--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+
        -: 1601:    |31|30|29|28|27|26|25|24|23|22|21|20|19|18|17|16|
        -: 1602:    +--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+--+
        -: 1603:      |  |  |  |  |  |  |  |  |  |  |  |  |  |  |  |
        -: 1604:      |  |  |  |  |  |  |  |  |  |  |  |  |  |  |  \_ wxFULL_REPAINT_ON_RESIZE
        -: 1605:      |  |  |  |  |  |  |  |  |  |  |  |  |  |  \____ wxPOPUP_WINDOW
        -: 1606:      |  |  |  |  |  |  |  |  |  |  |  |  |  \_______ wxWANTS_CHARS
        -: 1607:      |  |  |  |  |  |  |  |  |  |  |  |  \__________ wxTAB_TRAVERSAL
        -: 1608:      |  |  |  |  |  |  |  |  |  |  |  \_____________ wxTRANSPARENT_WINDOW
        -: 1609:      |  |  |  |  |  |  |  |  |  |  \________________ wxBORDER_NONE
        -: 1610:      |  |  |  |  |  |  |  |  |  \___________________ wxCLIP_CHILDREN
        -: 1611:      |  |  |  |  |  |  |  |  \______________________ wxALWAYS_SHOW_SB
        -: 1612:      |  |  |  |  |  |  |  \_________________________ wxBORDER_STATIC
        -: 1613:      |  |  |  |  |  |  \____________________________ wxBORDER_SIMPLE
        -: 1614:      |  |  |  |  |  \_______________________________ wxBORDER_RAISED
        -: 1615:      |  |  |  |  \__________________________________ wxBORDER_SUNKEN
        -: 1616:      |  |  |  \_____________________________________ wxBORDER_{DOUBLE,THEME}
        -: 1617:      |  |  \________________________________________ wxCAPTION/wxCLIP_SIBLINGS
        -: 1618:      |  \___________________________________________ wxHSCROLL
        -: 1619:      \______________________________________________ wxVSCROLL
        -: 1620:
        -: 1621:
        -: 1622:    Low word style bits is class-specific meaning that the same bit can have
        -: 1623:    different meanings for different controls (e.g. 0x10 is wxCB_READONLY
        -: 1624:    meaning that the control can't be modified for wxComboBox but wxLB_SORT
        -: 1625:    meaning that the control should be kept sorted for wxListBox, while
        -: 1626:    wxLB_SORT has a different value -- and this is just fine).
        -: 1627: */
        -: 1628:
        -: 1629:/*
        -: 1630: * Window (Frame/dialog/subwindow/panel item) style flags
        -: 1631: */
        -: 1632:
        -: 1633:/* The cast is needed to avoid g++ -Wnarrowing warnings when initializing
        -: 1634: * values of int type with wxVSCROLL on 32 bit platforms, where its value is
        -: 1635: * greater than INT_MAX.
        -: 1636: */
        -: 1637:#define wxVSCROLL               ((int)0x80000000)
        -: 1638:#define wxHSCROLL               0x40000000
        -: 1639:#define wxCAPTION               0x20000000
        -: 1640:
        -: 1641:/*  New styles (border styles are now in their own enum) */
        -: 1642:#define wxDOUBLE_BORDER         wxBORDER_DOUBLE
        -: 1643:#define wxSUNKEN_BORDER         wxBORDER_SUNKEN
        -: 1644:#define wxRAISED_BORDER         wxBORDER_RAISED
        -: 1645:#define wxBORDER                wxBORDER_SIMPLE
        -: 1646:#define wxSIMPLE_BORDER         wxBORDER_SIMPLE
        -: 1647:#define wxSTATIC_BORDER         wxBORDER_STATIC
        -: 1648:#define wxNO_BORDER             wxBORDER_NONE
        -: 1649:
        -: 1650:/*  wxALWAYS_SHOW_SB: instead of hiding the scrollbar when it is not needed, */
        -: 1651:/*  disable it - but still show (see also wxLB_ALWAYS_SB style) */
        -: 1652:/*  */
        -: 1653:/*  NB: as this style is only supported by wxUniversal and wxMSW so far */
        -: 1654:#define wxALWAYS_SHOW_SB        0x00800000
        -: 1655:
        -: 1656:/*  Clip children when painting, which reduces flicker in e.g. frames and */
        -: 1657:/*  splitter windows, but can't be used in a panel where a static box must be */
        -: 1658:/*  'transparent' (panel paints the background for it) */
