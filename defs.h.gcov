        -:  752:#ifdef __cplusplus
        -:  753:
        -:  754:/*
        -:  755:    wxDEPRECATED_EXPORT_CORE is a special macro used for the classes that are
        -:  756:    exported and deprecated (but not when building the library itself, as this
