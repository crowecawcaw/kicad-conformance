        -: 1682:#else
        -: 1683:#define wxRETAINED              0x00000000
        -: 1684:#endif
        -: 1685:#define wxBACKINGSTORE          wxRETAINED
        -: 1686:
        -: 1687:/*  set this flag to create a special popup window: it will be always shown on */
