        -:  501:/* provide replacement for C99 va_copy() if the compiler doesn't have it */
        -:  502:
        -:  503:/* could be already defined by configure or the user */
        -:  504:#ifndef wxVaCopy
        -:  505:    /* if va_copy is a macro or configure detected that we have it, use it */
        -:  506:    #if defined(va_copy) || defined(HAVE_VA_COPY)
        -:  507:        #define wxVaCopy va_copy
        -:  508:    #else /* no va_copy, try to provide a replacement */
        -:  509:        /*
        -:  510:           configure tries to determine whether va_list is an array or struct
        -:  511:           type, but it may not be used under Windows, so deal with a few
        -:  512:           special cases.
        -:  513:         */
        -:  514:
        -:  515:        #if defined(__PPC__) && (defined(_CALL_SYSV) || defined (_WIN32))
        -:  516:            /*
        -:  517:                PPC using SysV ABI and NT/PPC are special in that they use an
        -:  518:                extra level of indirection.
        -:  519:             */
        -:  520:            #define VA_LIST_IS_POINTER
        -:  521:        #endif /* SysV or Win32 on __PPC__ */
        -:  522:
        -:  523:        /*
        -:  524:            note that we use memmove(), not memcpy(), in case anybody tries
        -:  525:            to do wxVaCopy(ap, ap)
        -:  526:         */
        -:  527:        #if defined(VA_LIST_IS_POINTER)
        -:  528:            #define wxVaCopy(d, s)  memmove(*(d), *(s), sizeof(va_list))
        -:  529:        #elif defined(VA_LIST_IS_ARRAY)
        -:  530:            #define wxVaCopy(d, s) memmove((d), (s), sizeof(va_list))
        -:  531:        #else /* we can only hope that va_lists are simple lvalues */
        -:  532:            #define wxVaCopy(d, s) ((d) = (s))
        -:  533:        #endif
        -:  534:    #endif /* va_copy/!va_copy */
        -:  535:#endif /* wxVaCopy */
