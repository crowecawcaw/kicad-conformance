        -: 2240:/*  Use internally-calculated height if -1 */
        -: 2241:#define wxSIZE_AUTO_HEIGHT      0x0002
        -: 2242:/*  Use internally-calculated width and height if each is -1 */
        -: 2243:#define wxSIZE_AUTO             (wxSIZE_AUTO_WIDTH|wxSIZE_AUTO_HEIGHT)
        -: 2244:/*  Ignore missing (-1) dimensions (use existing). */
        -: 2245:/*  For readability only: test for wxSIZE_AUTO_WIDTH/HEIGHT in code. */
        -: 2246:#define wxSIZE_USE_EXISTING     0x0000
        -: 2247:/*  Allow -1 as a valid position */
        -: 2248:#define wxSIZE_ALLOW_MINUS_ONE  0x0004
        -: 2249:/*  Don't do parent client adjustments (for implementation only) */
        -: 2250:#define wxSIZE_NO_ADJUSTMENTS   0x0008
