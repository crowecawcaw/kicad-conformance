        -:  784:/*
        -:  785:   Macros to suppress and restore gcc warnings, requires g++ >= 4.6 and don't
        -:  786:   do anything otherwise.
        -:  787:
        -:  788:   Example of use:
        -:  789:
        -:  790:        wxGCC_WARNING_SUPPRESS(float-equal)
        -:  791:        inline bool wxIsSameDouble(double x, double y) { return x == y; }
        -:  792:        wxGCC_WARNING_RESTORE(float-equal)
        -:  793:
        -:  794:   Note that these macros apply to both gcc and clang, even though they only
        -:  795:   have "GCC" in their names.
        -:  796: */
        -:  797:#if defined(__clang__) || wxCHECK_GCC_VERSION(4, 6)
