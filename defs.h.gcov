        -: 1426:        inline int operator|(en1 v1, en2 v2)                                  \
        -: 1427:            { return static_cast<int>(v1) | static_cast<int>(v2); }           \
        -: 1428:        inline int operator+(en1 v1, en2 v2)                                  \
        -: 1429:            { return static_cast<int>(v1) + static_cast<int>(v2); }
        -: 1430:
        -: 1431:    #define wxALLOW_COMBINING_ENUMS(en1, en2)                                 \
        -: 1432:        wxALLOW_COMBINING_ENUMS_IMPL(en1, en2)                                \
