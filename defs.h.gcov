        -:  633:/*
        -:  634:    Macros for marking functions as being deprecated.
        -:  635:
        -:  636:    The preferred macro in the new code is wxDEPRECATED_ATTR() which expands to
        -:  637:    the standard [[deprecated]] attribute if supported and allows to explain
        -:  638:    why is the function deprecated. If supporting older compilers is important,
        -:  639:    wxDEPRECATED_MSG() can be used as it's almost universally available and
        -:  640:    still allows to explain the reason for the deprecation.
        -:  641:
        -:  642:    However almost all the existing code uses the older wxDEPRECATED() or its
        -:  643:    variants currently, but this will hopefully change in the future.
        -:  644: */
        -:  645:
        -:  646:#if defined(__has_cpp_attribute)
        -:  647:    #if __has_cpp_attribute(deprecated)
        -:  648:        /* gcc 5 claims to support this attribute, but actually doesn't */
        -:  649:        #if !defined(__GNUC__) || wxCHECK_GCC_VERSION(6, 0)
        -:  650:            /* Even later gcc versions only support it when using C++11. */
        -:  651:            #ifdef __cplusplus
        -:  652:                #if __cplusplus >= 201103L
        -:  653:                    #define wxHAS_DEPRECATED_ATTR
        -:  654:                #endif
        -:  655:            #endif
        -:  656:        #endif
        -:  657:    #endif
        -:  658:#endif
        -:  659:
        -:  660:/* The basic compiler-specific construct to generate a deprecation warning. */
        -:  661:#ifdef wxHAS_DEPRECATED_ATTR
        -:  662:    #define wxDEPRECATED_DECL [[deprecated]]
        -:  663:#elif defined(__clang__)
        -:  664:    #define wxDEPRECATED_DECL __attribute__((deprecated))
        -:  665:#elif defined(__GNUC__)
        -:  666:    #define wxDEPRECATED_DECL __attribute__((deprecated))
        -:  667:#elif defined(__VISUALC__)
        -:  668:    #define wxDEPRECATED_DECL __declspec(deprecated)
        -:  669:#else
        -:  670:    #define wxDEPRECATED_DECL
        -:  671:#endif
        -:  672:
        -:  673:#ifdef wxHAS_DEPRECATED_ATTR
        -:  674:    #define wxDEPRECATED_ATTR(msg) [[deprecated(msg)]]
        -:  675:#else
        -:  676:    /*
        -:  677:        Note that we can't fall back on wxDEPRECATED_DECL here, as the standard
        -:  678:        attribute works in places where the compiler-specific one don't,
        -:  679:        notably it can be used after enumerator declaration with MSVC, while
        -:  680:        __declspec(deprecated) can't occur there as it can only be used before
        -:  681:        the declaration.
        -:  682:     */
        -:  683:    #define wxDEPRECATED_ATTR(msg)
        -:  684:#endif
        -:  685:
        -:  686:/*
        -:  687:    Macro taking the deprecation message. It applies to the next declaration.
        -:  688:
        -:  689:    If the compiler doesn't support showing the message, this degrades to a
        -:  690:    simple wxDEPRECATED(), i.e. at least gives a warning, if possible.
        -:  691: */
        -:  692:#ifdef wxHAS_DEPRECATED_ATTR
        -:  693:    #define wxDEPRECATED_MSG(msg) [[deprecated(msg)]]
        -:  694:#elif defined(__clang__) && defined(__has_extension)
        -:  695:    #if __has_extension(attribute_deprecated_with_message)
        -:  696:        #define wxDEPRECATED_MSG(msg) __attribute__((deprecated(msg)))
        -:  697:    #else
        -:  698:        #define wxDEPRECATED_MSG(msg) __attribute__((deprecated))
        -:  699:    #endif
        -:  700:#elif wxCHECK_GCC_VERSION(4, 5)
        -:  701:    #define wxDEPRECATED_MSG(msg) __attribute__((deprecated(msg)))
        -:  702:#elif wxCHECK_VISUALC_VERSION(8)
        -:  703:    #define wxDEPRECATED_MSG(msg) __declspec(deprecated("deprecated: " msg))
        -:  704:#else
        -:  705:    #define wxDEPRECATED_MSG(msg) wxDEPRECATED_DECL
        -:  706:#endif
        -:  707:
        -:  708:/*
        -:  709:    Macro taking the declaration that it deprecates. Prefer to use
        -:  710:    wxDEPRECATED_MSG() instead as it's simpler (wrapping the entire declaration
        -:  711:    makes the code unclear) and allows to specify the explanation.
        -:  712: */
        -:  713:#define wxDEPRECATED(x) wxDEPRECATED_DECL x
        -:  714:
        -:  715:/*
        -:  716:    This macro used to be defined differently for gcc < 3.4, but we don't
        -:  717:    support it any more, so it's just the same thing as wxDEPRECATED now.
        -:  718: */
        -:  719:#define wxDEPRECATED_CONSTRUCTOR(x) wxDEPRECATED(x)
        -:  720:
        -:  721:/*
        -:  722:   Macro which marks the function as being deprecated but also defines it
        -:  723:   inline.
        -:  724:
        -:  725:   Currently it's defined in the same trivial way in all cases but it could
