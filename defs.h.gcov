        -: 2946:/* Objective-C type declarations.
        -: 2947: * These are to be used in public headers in lieu of NSSomething* because
        -: 2948: * Objective-C class names are not available in C/C++ code.
        -: 2949: */
        -: 2950:
        -: 2951:/*  NOTE: This ought to work with other compilers too, but I'm being cautious */
        -: 2952:#if (defined(__GNUC__) && defined(__APPLE__))
        -: 2953:/* It's desirable to have type safety for Objective-C(++) code as it does
        -: 2954:at least catch typos of method names among other things.  However, it
        -: 2955:is not possible to declare an Objective-C class from plain old C or C++
        -: 2956:code.  Furthermore, because of C++ name mangling, the type name must
        -: 2957:be the same for both C++ and Objective-C++ code.  Therefore, we define
        -: 2958:what should be a pointer to an Objective-C class as a pointer to a plain
        -: 2959:old C struct with the same name.  Unfortunately, because the compiler
        -: 2960:does not see a struct as an Objective-C class we cannot declare it
        -: 2961:as a struct in Objective-C(++) mode.
        -: 2962:*/
        -: 2963:#if defined(__OBJC__)
        -: 2964:#define DECLARE_WXCOCOA_OBJC_CLASS(klass) \
        -: 2965:@class klass; \
        -: 2966:typedef klass *WX_##klass
        -: 2967:#else /*  not defined(__OBJC__) */
        -: 2968:#define DECLARE_WXCOCOA_OBJC_CLASS(klass) \
        -: 2969:typedef struct klass *WX_##klass
        -: 2970:#endif /*  defined(__OBJC__) */
        -: 2971:
        -: 2972:#else /*  not Apple's gcc */
        -: 2973:#warning "Objective-C types will not be checked by the compiler."
        -: 2974:/*  NOTE: typedef struct objc_object *id; */
        -: 2975:/*  IOW, we're declaring these using the id type without using that name, */
        -: 2976:/*  since "id" is used extensively not only within wxWidgets itself, but */
        -: 2977:/*  also in wxWidgets application code.  The following works fine when */
        -: 2978:/*  compiling C(++) code, and works without typesafety for Obj-C(++) code */
        -: 2979:#define DECLARE_WXCOCOA_OBJC_CLASS(klass) \
        -: 2980:typedef struct objc_object *WX_##klass
        -: 2981:
        -: 2982:#endif /*  (defined(__GNUC__) && defined(__APPLE__)) */
