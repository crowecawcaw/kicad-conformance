        -:  691:    /**
        -:  692:     * The list of flags used by the #compare function.
        -:  693:     *
        -:  694:     * UNIT  This flag relaxes unit, body-style and pin-number constraints.  It is used for
        -:  695:     *       #SCH_ITEM object unit comparisons.
        -:  696:     *
        -:  697:     * EQUALITY  This flag relaxes ordering constraints so that fields, etc. don't have to
        -:  698:     *           appear in the same order to be considered equal.
        -:  699:     *
        -:  700:     * ERC  This flag relaxes constraints on data that is settable in the schematic editor.
        -:  701:     *      It compares only symbol-editor-only data.
        -:  702:     *
        -:  703:     * SKIP_TST_POS   This flag relaxes comparisons on position (mainly for fields) for ERC.
        -:  704:     */
        -:  705:    enum COMPARE_FLAGS : int
        -:  706:    {
        -:  707:        UNIT          = 0x01,
        -:  708:        EQUALITY      = 0x02,
        -:  709:        ERC           = 0x04,
        -:  710:        SKIP_TST_POS  = 0x08
        -:  711:    };
