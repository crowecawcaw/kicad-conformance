        -: 1252:class GAL_SCOPED_ATTRS
        -: 1253:{
        -: 1254:public:
        -: 1255:    enum FLAGS
        -: 1256:    {
        -: 1257:        STROKE_WIDTH = 1,
        -: 1258:        STROKE_COLOR = 2,
        -: 1259:        IS_STROKE = 4,
        -: 1260:        FILL_COLOR = 8,
        -: 1261:        IS_FILL = 16,
        -: 1262:        LAYER_DEPTH = 32,
        -: 1263:
        -: 1264:        // It is not clear to me that GAL needs to save text attributes.
        -: 1265:        // Only BitmapText uses it, and maybe that should be passed in
        -: 1266:        // explicitly (like for Draw) - every caller of BitmapText sets
        -: 1267:        // the text attributes anyway.
