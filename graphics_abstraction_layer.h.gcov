        -: 1269:
        -: 1270:        // Convenience flags
        -: 1271:        STROKE = STROKE_WIDTH | STROKE_COLOR | IS_STROKE,
        -: 1272:        FILL = FILL_COLOR | IS_FILL,
        -: 1273:        STROKE_FILL = STROKE | FILL,
        -: 1274:
        -: 1275:        ALL_ATTRS = STROKE | FILL | LAYER_DEPTH,
        -: 1276:    };
        -: 1277:
        -: 1278:    /**
        -: 1279:     * Instantiate a GAL_SCOPED_ATTRS object, saving the current attributes of the GAL.
        -: 1280:     *
        -: 1281:     * Specify the flags to save/restore in aFlags.
        -: 1282:     */
        -: 1283:    GAL_SCOPED_ATTRS( KIGFX::GAL& aGal, int aFlags )
        -: 1284:        : m_gal( aGal ), m_flags( aFlags )
        -: 1285:    {
        -: 1286:        // Save what we need to restore later.
        -: 1287:        // These are all so cheap to copy, it's likely not worth if'ing
        -: 1288:        m_strokeWidth = aGal.GetLineWidth();
        -: 1289:        m_strokeColor = aGal.GetStrokeColor();
        -: 1290:        m_isStroke = aGal.GetIsStroke();
        -: 1291:        m_fillColor = aGal.GetFillColor();
        -: 1292:        m_isFill = aGal.GetIsFill();
        -: 1293:        m_layerDepth = aGal.getLayerDepth();
        -: 1294:    }
        -: 1295:
        -: 1296:    ~GAL_SCOPED_ATTRS()
        -: 1297:    {
        -: 1298:        // Restore the attributes that were saved
        -: 1299:        // based on the flags that were set.
        -: 1300:
        -: 1301:        if( m_flags & STROKE_WIDTH )
        -: 1302:            m_gal.SetLineWidth( m_strokeWidth );
        -: 1303:
        -: 1304:        if( m_flags & STROKE_COLOR )
        -: 1305:            m_gal.SetStrokeColor( m_strokeColor );
        -: 1306:
        -: 1307:        if( m_flags & IS_STROKE )
        -: 1308:            m_gal.SetIsStroke( m_isStroke );
        -: 1309:
        -: 1310:        if( m_flags & FILL_COLOR )
        -: 1311:            m_gal.SetFillColor( m_fillColor );
        -: 1312:
        -: 1313:        if( m_flags & IS_FILL )
        -: 1314:            m_gal.SetIsFill( m_isFill );
        -: 1315:
        -: 1316:        if( m_flags & LAYER_DEPTH )
        -: 1317:            m_gal.SetLayerDepth( m_layerDepth );
        -: 1318:    }
        -: 1319:
