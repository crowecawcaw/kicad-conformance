        -:  150:     */
        -:  151:    bool SyncLineReaderWith( DSNLEXER& aLexer );
        -:  152:
        -:  153:    /**
        -:  154:     * Change the behavior of this lexer into or out of "specctra mode".
        -:  155:     *
        -:  156:     * If specctra mode, then:
        -:  157:     *  -#) stringDelimiter can be changed.
        -:  158:     *  -#) KiCad quoting protocol is not in effect.
        -:  159:     *  -#) space_in_quoted_tokens is functional else none of the above are true.
        -:  160:     *
        -:  161:     * The default mode is non-specctra mode, meaning:
        -:  162:     *  -#) stringDelimiter cannot be changed.
        -:  163:     *  -#) KiCad quoting protocol is in effect.
        -:  164:     *  -#) space_in_quoted_tokens is not functional.
        -:  165:     */
        -:  166:    void SetSpecctraMode( bool aMode );
        -:  167:
        -:  168:    /**
        -:  169:     * Manage a stack of LINE_READERs in order to handle nested file inclusion.
        -:  170:     *
        -:  171:     * This function pushes aLineReader onto the top of a stack of LINE_READERs and makes
        -:  172:     * it the current #LINE_READER with its own #GetSource(), line number and line text.
        -:  173:     * A grammar must be designed such that the "include" token (whatever its various names),
        -:  174:     * and any of its parameters are not followed by anything on that same line,
        -:  175:     * because PopReader always starts reading from a new line upon returning to
        -:  176:     * the original #LINE_READER.
        -:  177:     */
        -:  178:    void PushReader( LINE_READER* aLineReader );
        -:  179:
        -:  180:    /**
        -:  181:     * Delete the top most #LINE_READER from an internal stack of LINE_READERs and
        -:  182:     * in the case of #FILE_LINE_READER this means the associated FILE is closed.
        -:  183:     *
        -:  184:     * The most recently used former #LINE_READER on the stack becomes the
        -:  185:     * current #LINE_READER and its previous position in its input stream and the
        -:  186:     * its latest line number should pertain.  PopReader always starts reading
        -:  187:     * from a new line upon returning to the previous #LINE_READER.  A pop is only
        -:  188:     * possible if there are at least 2 #LINE_READERs on the stack, since popping
        -:  189:     * the last one is not supported.
        -:  190:     *
        -:  191:     * @return the LINE_READER that was in use before the pop, or NULL
        -:  192:     *   if there was not at least two readers on the stack and therefore the
        -:  193:     *   pop failed.
        -:  194:     */
        -:  195:    LINE_READER* PopReader();
        -:  196:
        -:  197:    /**
        -:  198:     * Return the next token found in the input file or DSN_EOF when reaching the end of
        -:  199:     * file.
        -:  200:     *
        -:  201:     * Users should wrap this function to return an enum to aid in grammar debugging while
        -:  202:     * running under a debugger, but leave this lower level function returning an int (so
        -:  203:     * the enum does not collide with another usage).
        -:  204:     *
        -:  205:     * @return the type of token found next.
        -:  206:     * @throw IO_ERROR only if the #LINE_READER throws it.
        -:  207:     */
        -:  208:    int NextTok();
        -:  209:
        -:  210:    /**
