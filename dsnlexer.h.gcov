        -:   53:/**
        -:   54: * List all the DSN lexer's tokens that are supported in lexing.
        -:   55: *
        -:   56: * It is up to the parser if it wants also to support them.
        -:   57: */
        -:   58:enum DSN_SYNTAX_T
        -:   59:{
        -:   60:    DSN_NONE         = -12,
        -:   61:    DSN_BAR          = -11, // Also called pipe '|'
        -:   62:    DSN_COMMENT      = -10,
        -:   63:    DSN_STRING_QUOTE = -9,
        -:   64:    DSN_QUOTE_DEF    = -8,
        -:   65:    DSN_DASH         = -7,
        -:   66:    DSN_SYMBOL       = -6,
        -:   67:    DSN_NUMBER       = -5,
        -:   68:    DSN_RIGHT        = -4,  // right bracket, ')'
        -:   69:    DSN_LEFT         = -3,  // left bracket, '('
        -:   70:    DSN_STRING       = -2,  // a quoted string, stripped of the quotes
        -:   71:    DSN_EOF          = -1   // special case for end of file
        -:   72:};
