        -:   75:/**
        -:   76: * Implement a lexical analyzer for the SPECCTRA DSN file format.
        -:   77: *
        -:   78: * It reads lexical tokens from the current #LINE_READER through the #NextTok() function.
        -:   79: */
        -:   80:class KICOMMON_API DSNLEXER
        -:   81:{
        -:   82:public:
        -:   83:    /**
        -:   84:     * Initialize a DSN lexer and prepares to read from aFile which is already open and has
        -:   85:     * \a aFilename.
        -:   86:     *
        -:   87:     * @param aKeywordTable is an array of KEYWORDS holding \a aKeywordCount.  This
        -:   88:     *  token table need not contain the lexer separators such as '(' ')', etc.
        -:   89:     * @param aKeywordCount is the count of tokens in aKeywordTable.
        -:   90:     * @param aFile is an open file, which will be closed when this is destructed.
        -:   91:     * @param aFileName is the name of the file
        -:   92:     */
        -:   93:    DSNLEXER( const KEYWORD* aKeywordTable, unsigned aKeywordCount, const KEYWORD_MAP* aKeywordMap,
        -:   94:              FILE* aFile, const wxString& aFileName );
        -:   95:
        -:   96:    /**
        -:   97:     * Initialize a DSN lexer and prepares to read from @a aSExpression.
        -:   98:     *
        -:   99:     * @param aKeywordTable is an array of KEYWORDS holding \a aKeywordCount.  This
        -:  100:     *  token table need not contain the lexer separators such as '(' ')', etc.
        -:  101:     * @param aKeywordCount is the count of tokens in aKeywordTable.
        -:  102:     * @param aSExpression is text to feed through a STRING_LINE_READER
        -:  103:     * @param aSource is a description of aSExpression, used for error reporting.
        -:  104:     */
        -:  105:    DSNLEXER( const KEYWORD* aKeywordTable, unsigned aKeywordCount, const KEYWORD_MAP* aKeywordMap,
        -:  106:              const std::string& aSExpression, const wxString& aSource = wxEmptyString );
        -:  107:
        -:  108:    /**
        -:  109:     * Initialize a DSN lexer and prepares to read from @a aSExpression.
        -:  110:     *
        -:  111:     * Use this one without a keyword table with the DOM parser in ptree.h.
