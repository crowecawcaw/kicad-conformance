        -:  116:    DSNLEXER( const std::string& aSExpression, const wxString& aSource = wxEmptyString );
        -:  117:
        -:  118:    /**
        -:  119:     * Initialize a DSN lexer and prepares to read from @a aLineReader which is already
        -:  120:     * open, and may be in use by other DSNLEXERs also.
        -:  121:     *
        -:  122:     * No ownership is taken of @a aLineReader. This enables it to be used by other DSNLEXERs.
        -:  123:     *
        -:  124:     * @param aKeywordTable is an array of #KEYWORDS holding \a aKeywordCount.  This
        -:  125:     *  token table need not contain the lexer separators such as '(' ')', etc.
        -:  126:     * @param aKeywordCount is the count of tokens in aKeywordTable.
        -:  127:     * @param aLineReader is any subclassed instance of LINE_READER, such as
        -:  128:     *  #STRING_LINE_READER or #FILE_LINE_READER.  No ownership is taken.
        -:  129:     */
        -:  130:    DSNLEXER( const KEYWORD* aKeywordTable, unsigned aKeywordCount, const KEYWORD_MAP* aKeywordMap,
        -:  131:              LINE_READER* aLineReader = nullptr );
