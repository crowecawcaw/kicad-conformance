        -:  183:
        -:  184:    // decodes single UTF-8 character from UTF-8 string
        -:  185:    static wxUniChar DecodeChar(wxStringImpl::const_iterator i)
        -:  186:    {
        -:  187:        if ( (unsigned char)*i < 0x80 )
