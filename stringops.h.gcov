        -:   47:#if wxUSE_UNICODE_UTF16
        -:   48:    // encodes the characters as UTF-16:
        -:   49:    struct Utf16CharBuffer
        -:   50:    {
        -:   51:        // Notice that data is left uninitialized, it is filled by EncodeChar()
        -:   52:        // which is the only function creating objects of this class.
        -:   53:
        -:   54:        wchar_t data[3];
        -:   55:        operator const wchar_t*() const { return data; }
        -:   56:    };
        -:   57:    static Utf16CharBuffer EncodeChar(const wxUniChar& ch);
        -:   58:    static wxWCharBuffer EncodeNChars(size_t n, const wxUniChar& ch);
        -:   59:    static bool IsSingleCodeUnitCharacter(const wxUniChar& ch)
        -:   60:        { return !ch.IsSupplementary(); }
        -:   61:#else
        -:   62:    // encodes the character to a form used to represent it in internal
        -:   63:    // representation
        -:   64:    struct SingleCharBuffer
        -:   65:    {
        -:   66:        wxChar data[2];
        -:   67:        operator const wxChar*() const { return data; }
        -:   68:    };
        -:   69:    static SingleCharBuffer EncodeChar(const wxUniChar& ch)
        -:   70:    {
        -:   71:        SingleCharBuffer buf;
        -:   72:        buf.data[0] = (wxChar)ch;
        -:   73:        buf.data[1] = 0;
        -:   74:        return buf;
        -:   75:    }
        -:   76:    static wxWxCharBuffer EncodeNChars(size_t n, const wxUniChar& ch);
    #####:   77:    static bool IsSingleCodeUnitCharacter(const wxUniChar&) { return true; }
        -:   78:#endif
        -:   79:
