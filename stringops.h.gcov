        -:   87:struct WXDLLIMPEXP_BASE wxStringOperationsUtf8
        -:   88:{
        -:   89:    // checks correctness of UTF-8 sequence
        -:   90:    static bool IsValidUtf8String(const char *c,
        -:   91:                                  size_t len = wxStringImpl::npos);
        -:   92:    static bool IsValidUtf8LeadByte(unsigned char c)
        -:   93:    {
        -:   94:        return (c <= 0x7F) || (c >= 0xC2 && c <= 0xF4);
        -:   95:    }
        -:   96:
        -:   97:    // returns offset to skip forward when iterating over UTF-8 sequence
        -:   98:    static unsigned char GetUTF8IterOffset(unsigned char c);
        -:   99:
        -:  100:
        -:  101:    template<typename Iterator>
        -:  102:    static void IncIter(Iterator& i)
        -:  103:    {
        -:  104:        wxASSERT( IsValidUtf8LeadByte(*i) );
        -:  105:        i += GetUTF8IterOffset(*i);
        -:  106:    }
        -:  107:
        -:  108:    template<typename Iterator>
        -:  109:    static void DecIter(Iterator& i)
        -:  110:    {
        -:  111:        // Non-lead bytes are all in the 0x80..0xBF range (i.e. 10xxxxxx in
        -:  112:        // binary), so we just have to go back until we hit a byte that is
        -:  113:        // either < 0x80 (i.e. 0xxxxxxx in binary) or 0xC0..0xFF (11xxxxxx in
        -:  114:        // binary; this includes some invalid values, but we can ignore it
        -:  115:        // here, because we assume valid UTF-8 input for the purpose of
        -:  116:        // efficient implementation).
        -:  117:        --i;
        -:  118:        while ( ((*i) & 0xC0) == 0x80 /* 2 highest bits are '10' */ )
        -:  119:            --i;
        -:  120:    }
        -:  121:
        -:  122:    template<typename Iterator>
        -:  123:    static Iterator AddToIter(const Iterator& i, ptrdiff_t n)
        -:  124:    {
        -:  125:        Iterator out(i);
        -:  126:
        -:  127:        if ( n > 0 )
        -:  128:        {
        -:  129:            for ( ptrdiff_t j = 0; j < n; ++j )
        -:  130:                IncIter(out);
        -:  131:        }
        -:  132:        else if ( n < 0 )
        -:  133:        {
        -:  134:            for ( ptrdiff_t j = 0; j > n; --j )
        -:  135:                DecIter(out);
        -:  136:        }
        -:  137:
        -:  138:        return out;
        -:  139:    }
        -:  140:
        -:  141:    template<typename Iterator>
        -:  142:    static ptrdiff_t DiffIters(Iterator i1, Iterator i2)
        -:  143:    {
        -:  144:        ptrdiff_t dist = 0;
        -:  145:
        -:  146:        if ( i1 < i2 )
        -:  147:        {
        -:  148:            while ( i1 != i2 )
        -:  149:            {
        -:  150:                IncIter(i1);
        -:  151:                dist--;
        -:  152:            }
        -:  153:        }
        -:  154:        else if ( i2 < i1 )
        -:  155:        {
        -:  156:            while ( i2 != i1 )
        -:  157:            {
        -:  158:                IncIter(i2);
        -:  159:                dist++;
        -:  160:            }
        -:  161:        }
        -:  162:
        -:  163:        return dist;
        -:  164:    }
        -:  165:
        -:  166:    static bool IsSingleCodeUnitCharacter(const wxUniChar& ch)
        -:  167:        { return ch.IsAscii(); }
        -:  168:
        -:  169:    // encodes the character as UTF-8:
