        -:  103:    /**
        -:  104:     * Compute the bounding box from a given list of points.
        -:  105:     *
        -:  106:     * @param aPointList is the list points of the object.
        -:  107:     */
        -:  108:    template <class Container>
        -:  109:    void Compute( const Container& aPointList )
        -:  110:    {
        -:  111:        Vec vmin, vmax;
        -:  112:
        -:  113:        typename Container::const_iterator i;
