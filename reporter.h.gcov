        -:  284:
        -:  285:    /**
        -:  286:     * Enable or disable verbose mode. When enabled, debug messages are printed.
        -:  287:     */
        -:  288:    void SetVerbose( bool aVerbose ) { m_verbose = aVerbose; }
        -:  289:
