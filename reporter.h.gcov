        -:   36:/**
        -:   37: * @file reporter.h
        -:   38: * @author Wayne Stambaugh
        -:   39: * @note A special thanks to Dick Hollenbeck who came up with the idea that inspired
        -:   40: *       me to write this.
        -:   41: * @warning Do not add any dependencies to wxWidgets (or any other third party UI library )
        -:   42: *          to the REPORTER object.  All wxWidgets objects should be defined by pointer or
        -:   43: *          reference and forward declared so that using reporters in low level KiCad objects
        -:   44: *          will not require pulling in wxWidgets to building them.
        -:   45: */
        -:   46:
        -:   47:class wxString;
        -:   48:class wxStatusBar;
        -:   49:class wxTextCtrl;
        -:   50:class WX_HTML_REPORT_PANEL;
        -:   51:class WX_INFOBAR;
        -:   52:class KISTATUSBAR;
        -:   53:class STATUSBAR_WARNING_REPORTER_IMPL;
        -:   54:
        -:   55:
        -:   56:/**
        -:   57: * A pure virtual class used to derive REPORTER objects from.
        -:   58: *
        -:   59: * The purpose of the REPORTER object is to offer a way for a procedural function
        -:   60: * to report multiple errors without having to:
        -:   61: * <ul>
        -:   62: * <li> know too much about the caller's UI, i.e. wx. </li>
        -:   63: * <li> stop after the first error </li>
        -:   64: * </ul>
        -:   65: * the reporter has 4 severity levels (flags) tagging the messages:
        -:   66: *  - information
        -:   67: *  - warning
        -:   68: *  - error
        -:   69: *  - action (i.e. indication of changes - add component, change footprint, etc. )
        -:   70: *
        -:   71: * They are indicators for the message formatting and displaying code,
        -:   72: * filtering is not made here.
        -:   73: */
        -:   74:
        -:   75:class KICOMMON_API REPORTER
        -:   76:{
        -:   77:public:
    #####:   78:    REPORTER() :
    #####:   79:            m_reportedSeverityMask( 0 )
    #####:   80:    { }
        -:   81:
    #####:   82:    virtual ~REPORTER()
    #####:   83:    { }
------------------
REPORTER::~REPORTER():
    #####:   82:    virtual ~REPORTER()
    #####:   83:    { }
------------------
REPORTER::~REPORTER():
    #####:   82:    virtual ~REPORTER()
    #####:   83:    { }
------------------
        -:   84:
        -:   85:    /**
        -:   86:     * Location where the message is to be reported.
        -:   87:     * LOC_HEAD messages are printed before all others (typically intro messages)
        -:   88:     * LOC_BODY messages are printed in the middle
        -:   89:     * LOC_TAIL messages are printed after all others (typically status messages)
        -:   90:     */
        -:   91:    enum LOCATION {
        -:   92:        LOC_HEAD = 0,
        -:   93:        LOC_BODY,
        -:   94:        LOC_TAIL
        -:   95:    };
        -:   96:
        -:   97:    /**
        -:   98:     * Report a string with a given severity.
        -:   99:     *
        -:  100:     * @param aText is the string to report.
        -:  101:     * @param aSeverity is an indicator ( RPT_UNDEFINED, RPT_INFO, RPT_WARNING, RPT_ERROR,
        -:  102:     *                  RPT_ACTION ) used to filter and format messages
        -:  103:     */
        -:  104:
    #####:  105:    virtual REPORTER& Report( const wxString& aText,
        -:  106:                              SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED )
        -:  107:    {
    #####:  108:        m_reportedSeverityMask |= aSeverity;
    #####:  109:        return *this;
        -:  110:    }
        -:  111:
        -:  112:    /**
        -:  113:     * Places the report at the end of the list, for objects that support report ordering
        -:  114:     */
    #####:  115:    virtual REPORTER& ReportTail( const wxString& aText,
        -:  116:                                  SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED )
        -:  117:    {
    #####:  118:        return Report( aText, aSeverity );
        -:  119:    }
        -:  120:
        -:  121:    /**
        -:  122:     * Places the report at the beginning of the list for objects that support ordering.
        -:  123:     */
    #####:  124:    virtual REPORTER& ReportHead( const wxString& aText,
        -:  125:                                  SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED )
        -:  126:    {
    #####:  127:        return Report( aText, aSeverity );
        -:  128:    }
        -:  129:
        -:  130:    REPORTER& Report( const char* aText, SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED );
        -:  131:
        -:  132:    REPORTER& operator <<( const wxString& aText ) { return Report( aText ); }
        -:  133:
        -:  134:    /**
        -:  135:     * Returns true if any messages were reported.
        -:  136:     */
    #####:  137:    virtual bool HasMessage() const
        -:  138:    {
    #####:  139:        return m_reportedSeverityMask != 0;
        -:  140:    }
        -:  141:
        -:  142:    /**
        -:  143:     * Returns true if the reporter has one or more messages matching the specified
        -:  144:     * severity mask.
        -:  145:     */
    #####:  146:    virtual bool HasMessageOfSeverity( int aSeverityMask ) const
        -:  147:    {
    #####:  148:        return ( m_reportedSeverityMask & aSeverityMask ) != 0;
        -:  149:    }
        -:  150:
    #####:  151:    virtual EDA_UNITS GetUnits() const
        -:  152:    {
    #####:  153:        return EDA_UNITS::MM;
        -:  154:    }
        -:  155:
    #####:  156:    virtual void Clear()
        -:  157:    {
    #####:  158:        m_reportedSeverityMask = 0;
    #####:  159:    }
        -:  160:
        -:  161:private:
        -:  162:    int m_reportedSeverityMask;
        -:  163:};
        -:  164:
        -:  165:
        -:  166:/**
        -:  167: * A thread-safe REPORTER wrapper that serializes forwarding to an underlying reporter.
        -:  168: *
        -:  169: * Use it when several worker threads may report concurrently through one reporter that is not
        -:  170: * itself thread-safe.  The wrapped reporter must outlive this object.  This only guards against
        -:  171: * data races on the wrapped reporter's state, it does not marshal calls onto a UI thread, so the
        -:  172: * wrapped reporter must be safe to touch from a background thread.
        -:  173: */
        -:  174:class KICOMMON_API SYNC_REPORTER : public REPORTER
        -:  175:{
        -:  176:public:
        -:  177:    SYNC_REPORTER( REPORTER& aReporter ) :
        -:  178:            m_reporter( aReporter )
        -:  179:    { }
        -:  180:
        -:  181:    REPORTER& Report( const wxString& aText, SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED ) override;
        -:  182:
        -:  183:    REPORTER& ReportTail( const wxString& aText, SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED ) override;
        -:  184:
        -:  185:    REPORTER& ReportHead( const wxString& aText, SEVERITY aSeverity = RPT_SEVERITY_UNDEFINED ) override;
        -:  186:
        -:  187:    bool HasMessage() const override;
        -:  188:
        -:  189:    bool HasMessageOfSeverity( int aSeverityMask ) const override;
        -:  190:
        -:  191:    EDA_UNITS GetUnits() const override;
        -:  192:
        -:  193:    void Clear() override;
        -:  194:
        -:  195:private:
        -:  196:    REPORTER&          m_reporter;
        -:  197:    mutable std::mutex m_mutex;
        -:  198:};
        -:  199:
        -:  200:
