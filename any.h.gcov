        -:  140:
        -:  141:// Deprecated macro for checking the type which was originally introduced for
        -:  142:// MSVC6 compatibility and is not needed any longer now that this compiler is
        -:  143:// not supported any more.
        -:  144:#define wxANY_VALUE_TYPE_CHECK_TYPE(valueTypePtr, T) \
        -:  145:    wxAnyValueTypeImpl<T>::IsSameClass(valueTypePtr)
        -:  146:
        -:  147:
        -:  148:/**
        -:  149:    Helper macro for defining user value types.
        -:  150:
        -:  151:    Even though C++ RTTI would be fully available to use, we'd have to
        -:  152:    facilitate sub-type system which allows, for instance, wxAny with
        -:  153:    signed short '15' to be treated equal to wxAny with signed long long '15'.
        -:  154:    Having sm_instance is important here.
        -:  155:
        -:  156:    NB: We really need to have wxAnyValueType instances allocated
        -:  157:        in heap. They are stored as static template member variables,
        -:  158:        and with them we just can't be too careful (eg. not allocating
        -:  159:        them in heap broke the type identification in GCC).
        -:  160:*/
        -:  161:#define WX_DECLARE_ANY_VALUE_TYPE(CLS) \
        -:  162:    friend class wxAny; \
        -:  163:    WX_DECLARE_TYPEINFO_INLINE(CLS) \
        -:  164:public: \
        -:  165:    static bool IsSameClass(const wxAnyValueType* otherType) \
        -:  166:    { \
        -:  167:        return AreSameClasses(*sm_instance.get(), *otherType); \
        -:  168:    } \
        -:  169:    virtual bool IsSameType(const wxAnyValueType* otherType) const wxOVERRIDE \
        -:  170:    { \
        -:  171:        return IsSameClass(otherType); \
        -:  172:    } \
        -:  173:private: \
        -:  174:    static bool AreSameClasses(const wxAnyValueType& a, const wxAnyValueType& b) \
        -:  175:    { \
        -:  176:        return wxTypeId(a) == wxTypeId(b); \
        -:  177:    } \
        -:  178:    static wxAnyValueTypeScopedPtr sm_instance; \
        -:  179:public: \
        -:  180:    static wxAnyValueType* GetInstance() \
        -:  181:    { \
        -:  182:        return sm_instance.get(); \
        -:  183:    }
        -:  184:
        -:  185:
        -:  186:#define WX_IMPLEMENT_ANY_VALUE_TYPE(CLS) \
        -:  187:wxAnyValueTypeScopedPtr CLS::sm_instance(new CLS());
