        -:  122://
        -:  123:// We need to allocate wxAnyValueType instances in heap, and need to use
        -:  124:// scoped ptr to properly deallocate them in dynamic library use cases.
        -:  125:// Here we have a minimal specialized scoped ptr implementation to deal
        -:  126:// with various compiler-specific problems with template class' static
        -:  127:// member variable of template type with explicit constructor which
        -:  128:// is initialized in global scope.
        -:  129://
        -:  130:class wxAnyValueTypeScopedPtr
        -:  131:{
        -:  132:public:
    #####:  133:    wxAnyValueTypeScopedPtr(wxAnyValueType* ptr) : m_ptr(ptr) { }
    #####:  134:    ~wxAnyValueTypeScopedPtr() { delete m_ptr; }
    #####:  135:    wxAnyValueType* get() const { return m_ptr; }
        -:  136:private:
        -:  137:    wxAnyValueType* m_ptr;
        -:  138:};
