        -: 1979://calculate the minimum distance between a point and a rectangle as defined by Manolopoulos et al.
        -: 1980:// returns Euclidean norm to ensure value fits in ELEMTYPE
        -: 1981:RTREE_TEMPLATE
        -: 1982:ELEMTYPE RTREE_QUAL::MinDist( const ELEMTYPE a_point[NUMDIMS], const Rect& a_rect ) const
        -: 1983:{
        -: 1984:    const ELEMTYPE *q, *s, *t;
        -: 1985:    q = a_point;
        -: 1986:    s = a_rect.m_min;
        -: 1987:    t = a_rect.m_max;
        -: 1988:    double minDist = 0.0;
        -: 1989:
        -: 1990:    for( int index = 0; index < NUMDIMS; index++ )
        -: 1991:    {
        -: 1992:        int r = q[index];
        -: 1993:
        -: 1994:        if( q[index] < s[index] )
        -: 1995:        {
        -: 1996:            r = s[index];
        -: 1997:        }
        -: 1998:        else if( q[index] > t[index] )
        -: 1999:        {
        -: 2000:            r = t[index];
        -: 2001:        }
        -: 2002:
        -: 2003:        double addend = q[index] - r;
        -: 2004:        minDist += addend * addend;
