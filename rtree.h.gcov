        -: 1646:                    betterGroup = group;
        -: 1647:                }
        -: 1648:                else if( (diff == biggestDiff)
        -: 1649:                         && (a_parVars->m_count[group] < a_parVars->m_count[betterGroup]) )
        -: 1650:                {
        -: 1651:                    chosen = index;
        -: 1652:                    betterGroup = group;
        -: 1653:                }
        -: 1654:            }
        -: 1655:        }
        -: 1656:
        -: 1657:        Classify( chosen, betterGroup, a_parVars );
