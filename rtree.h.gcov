        -: 1936:// Search in an index tree or subtree for all data rectangles that overlap the argument rectangle.
        -: 1937:RTREE_TEMPLATE
        -: 1938:bool RTREE_QUAL::Search( const Node* a_node, const Rect* a_rect, int& a_foundCount,
        -: 1939:        std::function<bool (const DATATYPE&)> a_callback ) const
        -: 1940:{
        -: 1941:    ASSERT( a_node );
        -: 1942:    ASSERT( a_node->m_level >= 0 );
        -: 1943:    ASSERT( a_rect );
        -: 1944:
        -: 1945:    if( a_node->IsInternalNode() ) // This is an internal node in the tree
        -: 1946:    {
        -: 1947:        for( int index = 0; index < a_node->m_count; ++index )
        -: 1948:        {
        -: 1949:            if( Overlap( a_rect, &a_node->m_branch[index].m_rect ) )
        -: 1950:            {
        -: 1951:                if( !Search( a_node->m_branch[index].m_child, a_rect, a_foundCount, a_callback ) )
        -: 1952:                {
        -: 1953:                    return false; // Don't continue searching
        -: 1954:                }
        -: 1955:            }
        -: 1956:        }
        -: 1957:    }
        -: 1958:    else // This is a leaf node
        -: 1959:    {
        -: 1960:        for( int index = 0; index < a_node->m_count; ++index )
        -: 1961:        {
        -: 1962:            if( Overlap( a_rect, &a_node->m_branch[index].m_rect ) )
        -: 1963:            {
        -: 1964:                const DATATYPE& id = a_node->m_branch[index].m_data;
        -: 1965:                ++a_foundCount;
        -: 1966:
        -: 1967:                if( a_callback && !a_callback( id ) )
        -: 1968:                {
        -: 1969:                    return false; // Don't continue searching
        -: 1970:                }
        -: 1971:            }
        -: 1972:        }
        -: 1973:    }
        -: 1974:
        -: 1975:    return true; // Continue searching
        -: 1976:}
