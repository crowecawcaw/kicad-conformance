        -:   99:    ////////////////////////////////////////////////////
        -:  100:    // Library-related functions
        -:  101:    ////////////////////////////////////////////////////
        -:  102:
        -:  103:    /**
        -:  104:     * Get the descriptor for the library container that this IO plugin operates on.
        -:  105:     *
        -:  106:     * @return File descriptor for the container of the library elements
        -:  107:     */
        -:  108:    virtual const IO_FILE_DESC GetLibraryDesc() const = 0;
        -:  109:
        -:  110:    /**
        -:  111:     * Get the descriptor for the individual library elements that this IO plugin operates on.
        -:  112:     * For libraries where all the elements are in a single container (e.g. all elements in a
        -:  113:     * single file), then this will return the descriptor from #IO_BASE::GetLibraryDesc().
        -:  114:     *
        -:  115:     * @return File descriptor for the library elements
        -:  116:     */
        -:  117:    virtual const IO_FILE_DESC GetLibraryFileDesc() const { return GetLibraryDesc(); }
        -:  118:
        -:  119:    /**
        -:  120:     * Checks if this IO object can read the specified library file/directory.
        -:  121:     * If not overridden, extension check is used.
        -:  122:     */
        -:  123:    virtual bool CanReadLibrary( const wxString& aFileName ) const;
        -:  124:
        -:  125:    /**
        -:  126:     * Create a new empty library at @a aLibraryPath empty.
        -:  127:     *
        -:  128:     * It is an error to attempt to create an existing library or to attempt to create
        -:  129:     * on a "read only" location.
        -:  130:     *
        -:  131:     * @param aLibraryPath is a locator for the "library", usually a directory, file, or URL
        -:  132:     *                     containing several elements.
        -:  133:     * @param aProperties is an associative array that can be used to tell the library create
        -:  134:     *                    function anything special, because it can take any number of additional
        -:  135:     *                    named tuning arguments that the IO is known to support.  The caller
        -:  136:     *                    continues to own this object (IO may not delete it), and IOs
        -:  137:     *                    should expect it to be optionally NULL.
        -:  138:     *
        -:  139:     * @throw IO_ERROR if there is a problem finding the library, or creating it.
        -:  140:     */
        -:  141:    virtual void CreateLibrary( const wxString& aLibraryPath,
        -:  142:                                const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  143:
        -:  144:    /**
        -:  145:     * Delete an existing library and returns true, or if library does not
        -:  146:     * exist returns false, or throws an exception if library exists but is read only or
        -:  147:     * cannot be deleted for some other reason.
        -:  148:     *
        -:  149:     * @param aLibraryPath is a locator for the "library", usually a directory or file which
        -:  150:     *                     will contain several elements.
        -:  151:     * @param aProperties is an associative array that can be used to tell the library delete
        -:  152:     *                    implementation function anything special, because it can take any
        -:  153:     *                    number of additional named tuning arguments that the plugin is known
        -:  154:     *                    to support. The caller continues to own this object (plugin may not
        -:  155:     *                    delete it), and plugins should expect it to be optionally NULL.
        -:  156:     *
        -:  157:     * @return true if library deleted, false if library did not exist.
        -:  158:     *
        -:  159:     * @throw IO_ERROR if there is a problem deleting an existing library.
        -:  160:     */
        -:  161:    virtual bool DeleteLibrary( const wxString& aLibraryPath,
        -:  162:                                const std::map<std::string, UTF8>* aProperties = nullptr );
        -:  163:
        -:  164:    /**
        -:  165:     * Return true if the library at @a aLibraryPath is writable.
        -:  166:     *
        -:  167:     * The system libraries are typically read only because of where they are installed..
        -:  168:     *
        -:  169:     * @param aLibraryPath is a locator for the "library", usually a directory, file, or URL
        -:  170:     *                     containing several footprints.
        -:  171:     *
        -:  172:     * @throw IO_ERROR if no library at aLibraryPath exists.
        -:  173:     */
        -:  174:    virtual bool IsLibraryWritable( const wxString& aLibraryPath );
        -:  175:
        -:  176:    /**
        -:  177:     * Append supported IO options to \a aListToAppenTo along with internationalized
        -:  178:     * descriptions.  Options are typically appended so that a derived IO_BASE can call
        -:  179:     * its base class function by the same name first, thus inheriting options declared there.
        -:  180:     * (Some base class options could pertain to all functions in all derived IOs.)
        -:  181:     * Note that since aListToAppendTo is a PROPERTIES object, all options
        -:  182:     * will be unique and last guy wins.
        -:  183:     *
        -:  184:     * @param aListToAppendTo holds a tuple of
        -:  185:     * <dl>
        -:  186:     *   <dt>option</dt>
        -:  187:     *   <dd>This eventually is what shows up into the "options"
        -:  188:     *       field, possibly combined with others.</dd>
        -:  189:     *   <dt>internationalized description</dt>
        -:  190:     *   <dd>The internationalized description is displayed in DIALOG_PLUGIN_OPTIONS.
        -:  191:     *      It may be multi-line and be quite explanatory of the option.</dd>
        -:  192:     *  </dl>
        -:  193:     * <br>
        -:  194:     *  In the future perhaps \a aListToAppendTo evolves to something capable of also
        -:  195:     *  holding a wxValidator for the cells in said dialog:
        -:  196:     *  http://forums.wxwidgets.org/viewtopic.php?t=23277&p=104180.
        -:  197:     *  This would require a 3 column list, and introducing wx GUI knowledge to
        -:  198:     *  #SCH_IO, which has been avoided to date.
        -:  199:     */
        -:  200:    virtual void GetLibraryOptions( std::map<std::string, UTF8>* aListToAppendTo ) const;
        -:  201:
        -:  202:
        -:  203:    /**
        -:  204:     * @return true if this plugin supports a GUI for configuration that can be launched from
        -:  205:     *         the library table configuration dialog or other UI contexts
        -:  206:     */
    #####:  207:    virtual bool SupportsConfigurationDialog() const { return false; }
