        -:   45:/*
        -:   46: * @brief Standard paper sizes nicknames
        -:   47: * Do not rename entires as these names are saved to file and parsed back
        -:   48: */
        -:   49:enum class PAGE_SIZE_TYPE
        -:   50:{
        -:   51:    A5,
        -:   52:    A4,
        -:   53:    A3,
        -:   54:    A2,
        -:   55:    A1,
        -:   56:    A0,
        -:   57:    A,
        -:   58:    B,
        -:   59:    C,
