        -:  951:     * Create a new Clipper2 path from the SHAPE_LINE_CHAIN in a given orientation
        -:  952:     */
        -:  953:    Clipper2Lib::Path64 convertToClipper2( bool aRequiredOrientation,
        -:  954:            std::vector<CLIPPER_Z_VALUE> &aZValueBuffer,
        -:  955:            std::vector<SHAPE_ARC> &aArcBuffer ) const;
        -:  956:
        -:  957:    /**
        -:  958:     * Fix indices of this chain to ensure arcs are not split between the end and start indices
        -:  959:     */
        -:  960:    void fixIndicesRotation();
        -:  961:
        -:  962:    /**
        -:  963:     * Merge the first and last point if they are the same and this chain is closed.
        -:  964:     */
        -:  965:    void mergeFirstLastPointIfNeeded();
        -:  966:
        -:  967:private:
        -:  968:
        -:  969:    static const ssize_t SHAPE_IS_PT;
        -:  970:
        -:  971:    static const std::pair<ssize_t, ssize_t> SHAPES_ARE_PT;
        -:  972:
        -:  973:    /// array of vertices
        -:  974:    std::vector<VECTOR2I> m_points;
        -:  975:
        -:  976:    /**
        -:  977:     * Array of indices that refer to the index of the shape if the point is part of a larger
        -:  978:     * shape, e.g. arc or spline.
        -:  979:     * If the value is -1, the point is just a point.
        -:  980:     *
        -:  981:     * There can be up to two shapes associated with a single point (e.g. the end point of
        -:  982:     * one arc might be the start point of another).
        -:  983:     *
        -:  984:     * Generally speaking only the first element of the pair will be populated (i.e. with a value
        -:  985:     * not equal to SHAPE_IS_PT), unless the point is shared between two arc shapes. If the point
        -:  986:     * is shared, then both the first and second element of the pair should be populated.
        -:  987:     *
        -:  988:     * The second element must always be SHAPE_IS_PT if the first element is SHAPE_IS_PT.
        -:  989:     */
        -:  990:    std::vector<std::pair<ssize_t, ssize_t>> m_shapes;
        -:  991:
        -:  992:    std::vector<SHAPE_ARC> m_arcs;
        -:  993:
        -:  994:    // the maxError to use when converting arcs to points
        -:  995:    int m_accuracy;
        -:  996:
        -:  997:    /// is the line chain closed?
        -:  998:    bool m_closed;
        -:  999:
        -: 1000:    /// Width of the segments (for BBox calculations in RTree)
        -: 1001:    /// TODO Adjust usage of SHAPE_LINE_CHAIN to account for where we need a width and where not
        -: 1002:    /// Alternatively, we could split the class into a LINE_CHAIN (no width) and SHAPE_LINE_CHAIN
        -: 1003:    /// that derives from SHAPE as well that does have a width.  Not sure yet on the correct path.
        -: 1004:    /// TODO Note that we also have SHAPE_SIMPLE which is a closed, filled SHAPE_LINE_CHAIN.
        -: 1005:    int m_width;
        -: 1006:
        -: 1007:    /// cached bounding box
        -: 1008:    mutable BOX2I m_bbox;
        -: 1009:};
