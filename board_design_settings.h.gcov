        -:  137:    bool operator==( const VIA_DIMENSION& aOther ) const
        -:  138:    {
        -:  139:        return ( m_Diameter == aOther.m_Diameter ) && ( m_Drill == aOther.m_Drill );
        -:  140:    }
        -:  141:
        -:  142:    bool operator!=( const VIA_DIMENSION& aOther ) const { return !operator==( aOther ); }
