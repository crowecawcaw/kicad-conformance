        -:  120:struct VIA_DIMENSION
        -:  121:{
        -:  122:    int m_Diameter;     // <= 0 means use Netclass via diameter
        -:  123:    int m_Drill;        // <= 0 means use Netclass via drill
        -:  124:
        -:  125:    VIA_DIMENSION()
        -:  126:    {
        -:  127:        m_Diameter = 0;
        -:  128:        m_Drill    = 0;
        -:  129:    }
        -:  130:
        -:  131:    VIA_DIMENSION( int aDiameter, int aDrill )
        -:  132:    {
        -:  133:        m_Diameter = aDiameter;
        -:  134:        m_Drill    = aDrill;
        -:  135:    }
