        -:  489:     *
        -:  490:     * @warning After merging, the original graph is invalid.
        -:  491:     *
        -:  492:     * @param aGraph Input graph reference to add to the current graph.
        -:  493:     */
        -:  494:    void Merge( CONNECTION_GRAPH& aGraph );
        -:  495:
        -:  496:    void RemoveItem( SCH_ITEM* aItem );
        -:  497:
        -:  498:    /**
        -:  499:     * Replace all references to #aOldItem with #aNewItem in the graph.
        -:  500:    */
        -:  501:    void ExchangeItem( SCH_ITEM* aOldItem, SCH_ITEM* aNewItem );
        -:  502:
        -:  503:    /**
        -:  504:     * We modify how we handle the connectivity graph for small graphs vs large
        -:  505:     * graphs.  Partially this is to avoid unneeded complexity for small graphs,
        -:  506:     * where the performance of the graph is not a concern.  This is considered
        -:  507:     * a temporary solution until the connectivity graph is refactored with an
        -:  508:     * eye toward partial updates
        -:  509:    */
        -:  510:    bool IsMinor() const
        -:  511:    {
        -:  512:        return static_cast<ssize_t>( m_items.size() )
        -:  513:               < ADVANCED_CFG::GetCfg().m_MinorSchematicGraphSize;
        -:  514:    }
        -:  515:
        -:  516:private:
        -:  517:
        -:  518:    /**
        -:  519:     * Update the connectivity of a symbol and its pins.
        -:  520:     * This is called by updateItemConnectivity() for each symbol
        -:  521:     * in the schematic.
        -:  522:     */
        -:  523:    void updateSymbolConnectivity( const SCH_SHEET_PATH& aSheet,
        -:  524:                                   SCH_SYMBOL* aSymbol,
        -:  525:                                   std::map<VECTOR2I, std::vector<SCH_ITEM*>>& aConnectionMap );
        -:  526:
        -:  527:    /**
        -:  528:     * Update the connectivity of a pin and its connections.
        -:  529:     * This is called by updateItemConnectivity() for each pin
        -:  530:     * in the schematic.
        -:  531:     */
        -:  532:    void updatePinConnectivity( const SCH_SHEET_PATH& aSheet,
        -:  533:                                SCH_PIN* aPin,
        -:  534:                                SCH_CONNECTION* aConnection );
        -:  535:
        -:  536:    /**
        -:  537:     * Update the connectivity of items that are not pins or symbols.
        -:  538:     * This is called by updateItemConnectivity() for each item
        -:  539:     * in the schematic that is not a symbol or pin.
        -:  540:     */
        -:  541:    void updateGenericItemConnectivity( const SCH_SHEET_PATH& aSheet,
        -:  542:                                        SCH_ITEM* aItem,
        -:  543:                                        std::map<VECTOR2I, std::vector<SCH_ITEM*>>& aConnectionMap );
        -:  544:
        -:  545:    /**
        -:  546:     * Update the graphical connectivity between items (i.e. where they touch)
        -:  547:     * The items passed in must be on the same sheet.
        -:  548:     *
        -:  549:     * In the first phase, all items in aItemList have their connections
        -:  550:     * initialized for the given sheet (since they may have connections on more
        -:  551:     * than one sheet, and each needs to be calculated individually).  The
        -:  552:     * graphical connection points for the item are added to a map that stores
        -:  553:     * (x, y) -> [list of items].
        -:  554:     *
        -:  555:     * Any item that is stored in the list of items that have a connection point
        -:  556:     * at a given (x, y) location will eventually be electrically connected.
        -:  557:     * This means that we can't store SCH_SYMBOLs in this map -- we must store
        -:  558:     * a structure that links a specific pin on a symbol back to that symbol: a
        -:  559:     * SCH_PIN_CONNECTION.  This wrapper class is a convenience for linking a pin
        -:  560:     * and symbol to a specific (x, y) point.
        -:  561:     *
        -:  562:     * In the second phase, we iterate over each value in the map, which is a
        -:  563:     * vector of items that have overlapping connection points.  After some
        -:  564:     * checks to ensure that the items should actually connect, the items are
        -:  565:     * linked together using ConnectedItems().
        -:  566:     *
        -:  567:     * As a side effect, items are loaded into m_items for BuildConnectionGraph().
        -:  568:     *
        -:  569:     * @param aSheet is the path to the sheet of all items in the list.
        -:  570:     * @param aItemList is a list of items to consider.
        -:  571:     */
        -:  572:    void updateItemConnectivity( const SCH_SHEET_PATH& aSheet,
        -:  573:                                 const std::vector<SCH_ITEM*>& aItemList );
        -:  574:
        -:  575:    /**
        -:  576:     * Generate the connection graph (after all item connectivity has been updated).
        -:  577:     *
        -:  578:     * In the first phase, the algorithm iterates over all items, and then over
        -:  579:     * all items that are connected (graphically) to each item, placing them into
        -:  580:     * CONNECTION_SUBGRAPHs.  Items that can potentially drive connectivity (i.e.
        -:  581:     * labels, pins, etc.) are added to the m_drivers vector of the subgraph.
        -:  582:     *
        -:  583:     * In the second phase, each subgraph is resolved.  To resolve a subgraph,
        -:  584:     * the driver is first selected by CONNECTION_SUBGRAPH::ResolveDrivers(),
        -:  585:     * and then the connection for the chosen driver is propagated to all the
        -:  586:     * other items in the subgraph.
        -:  587:     *
        -:  588:     * If the unconitional flag is set, all existing net classes will be removed
        -:  589:     * and re-created.  Otherwise, we will preserve existing net classes that do not
        -:  590:     * conflict with the new net classes.
        -:  591:     */
        -:  592:    void buildConnectionGraph( std::function<void( SCH_ITEM* )>* aChangedItemHandler,
        -:  593:                               bool aUnconditional );
        -:  594:
        -:  595:    /**
        -:  596:     * Generate individual item subgraphs on a per-sheet basis.
        -:  597:     */
        -:  598:    void buildItemSubGraphs();
        -:  599:
        -:  600:    /**
        -:  601:     * Find all subgraphs in the connection graph and calls ResolveDrivers() in parallel.
        -:  602:     */
        -:  603:    void resolveAllDrivers();
        -:  604:
        -:  605:    /**
        -:  606:     * Map the driver values for each subgraph.
        -:  607:     */
        -:  608:    void collectAllDriverValues();
        -:  609:
        -:  610:    /**
        -:  611:     * Iterate through the global power pins to collect the global labels as drivers.
        -:  612:     */
        -:  613:    void generateGlobalPowerPinSubGraphs();
        -:  614:
        -:  615:    /**
        -:  616:     * Iterate through labels to create placeholders for bus elements.
        -:  617:     */
        -:  618:    void generateBusAliasMembers();
        -:  619:
        -:  620:    /**
        -:  621:     * Process all subgraphs to assign netcodes and merge subgraphs based on labels.
        -:  622:     */
        -:  623:    void processSubGraphs();
        -:  624:
        -:  625:    /**
        -:  626:     * Helper to assign a new net code to a connection.
        -:  627:     *
        -:  628:     * @return the assigned code
        -:  629:     */
        -:  630:    int assignNewNetCode( SCH_CONNECTION& aConnection );
        -:  631:
        -:  632:    /**
        -:  633:     *
        -:  634:     * @param aNetName string with the netname for coding
        -:  635:     * @return existing netcode (if it exists) or newly created one
        -:  636:     */
        -:  637:    int getOrCreateNetCode( const wxString& aNetName );
        -:  638:
        -:  639:    /**
        -:  640:     * Ensure all members of the bus connection have a valid net code assigned.
        -:  641:     *
        -:  642:     * @param aConnection is a bus connection.
        -:  643:     */
        -:  644:    void assignNetCodesToBus( SCH_CONNECTION* aConnection );
        -:  645:
        -:  646:    /**
        -:  647:     * Update all neighbors of a subgraph with this one's connectivity info.
        -:  648:     *
        -:  649:     * If this subgraph contains hierarchical links, this method will descent the
        -:  650:     * hierarchy and propagate the connectivity across all linked sheets.
        -:  651:     *
        -:  652:     * @param aSubgraph is the subgraph being processed.
        -:  653:     * @param aForce prevents this routine from skipping subgraphs.
        -:  654:     */
        -:  655:    void propagateToNeighbors( CONNECTION_SUBGRAPH* aSubgraph, bool aForce );
        -:  656:
        -:  657:    /**
        -:  658:     * Remove references to the given subgraphs from all structures in the connection graph.
        -:  659:     *
        -:  660:     * @param aSubgraphs set of unique subgraphs to find/remove.
        -:  661:     */
        -:  662:    void removeSubgraphs( std::set<CONNECTION_SUBGRAPH*>& aSubgraphs );
        -:  663:
        -:  664:    /**
        -:  665:     * Search for a matching bus member inside a bus connection.
        -:  666:     *
        -:  667:     * For bus groups, this returns a bus member that matches aSearch by name.
        -:  668:     * For bus vectors, this returns a bus member that matches by vector index.
        -:  669:     *
        -:  670:     * @param aBusConnection is the bus connection to search.
        -:  671:     * @param aSearch is the net connection to search for.
        -:  672:     * @returns a member of aBusConnection that matches aSearch.
        -:  673:     */
        -:  674:    static SCH_CONNECTION* matchBusMember( SCH_CONNECTION* aBusConnection,
        -:  675:                                           SCH_CONNECTION* aSearch );
        -:  676:
        -:  677:    /**
        -:  678:     * Build a new default connection for the given item based on its properties.
        -:  679:     *
        -:  680:     * Handles strong drivers (power pins and labels) only.
        -:  681:     *
        -:  682:     * @param aItem is an item that can generate a connection name.
        -:  683:     * @param aSubgraph is used to determine the sheet to use and retrieve the cached name.
        -:  684:     * @return a connection generated from the item, or nullptr if item is not valid.
        -:  685:     */
        -:  686:    std::shared_ptr<SCH_CONNECTION> getDefaultConnection( SCH_ITEM* aItem,
        -:  687:                                                          CONNECTION_SUBGRAPH* aSubgraph );
        -:  688:
        -:  689:    void recacheSubgraphName( CONNECTION_SUBGRAPH* aSubgraph, const wxString& aOldName );
        -:  690:
        -:  691:    /**
        -:  692:     * If the subgraph has multiple drivers of equal priority that are graphically connected,
        -:  693:     * ResolveDrivers() will have stored the second driver for use by this function, which actually
        -:  694:     * creates the markers.
        -:  695:     *
        -:  696:     * @param aSubgraph is the subgraph to examine
        -:  697:     * @return  true for no errors, false for errors
        -:  698:     */
        -:  699:    bool ercCheckMultipleDrivers( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  700:
        -:  701:    /**
        -:  702:     * Check one subgraph for conflicting connections between net and bus labels.
        -:  703:     *
        -:  704:     * For example, a net wire connected to a bus port/pin, or vice versa
        -:  705:     *
        -:  706:     * @param  aSubgraph      is the subgraph to examine.
        -:  707:     * @return                true for no errors, false for errors.
        -:  708:     */
        -:  709:    bool ercCheckBusToNetConflicts( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  710:
        -:  711:    /**
        -:  712:     * Check one subgraph for conflicting connections between two bus items.
        -:  713:     *
        -:  714:     * For example, a labeled bus wire connected to a hierarchical sheet pin
        -:  715:     * where the labeled bus doesn't contain any of the same bus members as the
        -:  716:     * sheet pin.
        -:  717:     *
        -:  718:     * @param  aSubgraph      is the subgraph to examine.
        -:  719:     * @return                true for no errors, false for errors.
        -:  720:     */
        -:  721:    bool ercCheckBusToBusConflicts( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  722:
        -:  723:    /**
        -:  724:     * Check one subgraph for conflicting bus entry to bus connections.
        -:  725:     *
        -:  726:     * For example, a wire with label "A0" is connected to a bus labeled "D[8..0]"
        -:  727:     *
        -:  728:     * Will also check for mistakes related to bus group names, for example:
        -:  729:     * A bus group named "USB{DP DM}" should have bus entry connections like
        -:  730:     * "USB.DP" but someone might accidentally just enter "DP".
        -:  731:     *
        -:  732:     * @param  aSubgraph      is the subgraph to examine.
        -:  733:     * @return                true for no errors, false for errors.
        -:  734:     */
        -:  735:    bool ercCheckBusToBusEntryConflicts( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  736:
        -:  737:    /**
        -:  738:     * Check one subgraph for proper presence or absence of no-connect symbols.
        -:  739:     *
        -:  740:     * A pin with a no-connect symbol should not have any connections.
        -:  741:     * A pin without a no-connect symbol should have at least one connection.
        -:  742:     *
        -:  743:     * @param  aSubgraph      is the subgraph to examine.
        -:  744:     * @return                true for no errors, false for errors.
        -:  745:     */
        -:  746:    bool ercCheckNoConnects( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  747:
        -:  748:    /**
        -:  749:     * Check one subgraph for floating wires.
        -:  750:     *
        -:  751:     * Will throw an error for any subgraph that consists of just wires with no driver.
        -:  752:     *
        -:  753:     * @param  aSubgraph      is the subgraph to examine.
        -:  754:     * @return                true for no errors, false for errors.
        -:  755:     */
        -:  756:    bool ercCheckFloatingWires( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  757:
        -:  758:    /**
        -:  759:     * Check one subgraph for dangling wire endpoints.
        -:  760:     *
        -:  761:     * Will throw an error for any subgraph that has wires with only one endpoing
        -:  762:     *
        -:  763:     * @param  aSubgraph      is the subgraph to examine.
        -:  764:     * @return                true for no errors, false for errors.
        -:  765:     */
        -:  766:    bool ercCheckDanglingWireEndpoints( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  767:
        -:  768:    /**
        -:  769:     * Check one subgraph for proper connection of labels.
        -:  770:     *
        -:  771:     * Labels should be connected to something.
        -:  772:     *
        -:  773:     * @param  aSubgraph      is the subgraph to examine.
        -:  774:     * @param  aCheckGlobalLabels is true if global labels should be checked for loneliness.
        -:  775:     * @return                true for no errors, false for errors.
        -:  776:     */
        -:  777:    bool ercCheckLabels( const CONNECTION_SUBGRAPH* aSubgraph );
        -:  778:
        -:  779:    /**
        -:  780:     * Check directive labels should be connected to something.
        -:  781:     *
        -:  782:     * @return                the number of errors found.
        -:  783:     */
        -:  784:    int ercCheckDirectiveLabels();
        -:  785:
        -:  786:    /**
        -:  787:     * Check that a hierarchical sheet has at least one matching label inside the sheet for each
        -:  788:     * port on the parent sheet object.
        -:  789:     *
        -:  790:     * @param  aSubgraph      is the subgraph to examine.
        -:  791:     * @return                the number of errors found.
        -:  792:     */
        -:  793:    int ercCheckHierSheets();
        -:  794:
        -:  795:    /**
        -:  796:     * Check that a global label is instantiated more that once across the schematic hierarchy
        -:  797:     */
        -:  798:    int ercCheckSingleGlobalLabel();
        -:  799:
        -:  800:    /**
        -:  801:     * Get the number of pins in a given subgraph.
        -:  802:     *
        -:  803:     * @param aLocSubgraph Subgraph to search
        -:  804:     * @return total number of pins in the subgraph
        -:  805:     */
        -:  806:    size_t hasPins( const CONNECTION_SUBGRAPH* aLocSubgraph );
        -:  807:
        -:  808:
        -:  809:private:
        -:  810:    /// All the sheets in the schematic (as long as we don't have partial updates).
        -:  811:    SCH_SHEET_LIST m_sheetList;
        -:  812:
        -:  813:    /// All connectable items in the schematic.
        -:  814:    std::vector<SCH_ITEM*> m_items;
        -:  815:
        -:  816:    /// The owner of all #CONNECTION_SUBGRAPH objects.
        -:  817:    std::vector<CONNECTION_SUBGRAPH*> m_subgraphs;
        -:  818:
        -:  819:    /// Cache of a subset of #m_subgraphs.
        -:  820:    std::vector<CONNECTION_SUBGRAPH*> m_driver_subgraphs;
        -:  821:
        -:  822:    /// Cache to lookup subgraphs in #m_driver_subgraphs by sheet path.
        -:  823:    std::unordered_map<SCH_SHEET_PATH, std::vector<CONNECTION_SUBGRAPH*>> m_sheet_to_subgraphs_map;
        -:  824:
        -:  825:    std::vector<std::pair<SCH_SHEET_PATH, SCH_PIN*>> m_global_power_pins;
        -:  826:
        -:  827:    std::unordered_map<wxString, std::shared_ptr<BUS_ALIAS>> m_bus_alias_cache;
        -:  828:
        -:  829:    std::unordered_map<wxString, int> m_net_name_to_code_map;
        -:  830:
        -:  831:    std::unordered_map<wxString, int> m_bus_name_to_code_map;
        -:  832:
        -:  833:    std::unordered_map<wxString, std::vector<const CONNECTION_SUBGRAPH*>> m_global_label_cache;
        -:  834:
        -:  835:    std::map< std::pair<SCH_SHEET_PATH, wxString>,
        -:  836:              std::vector<const CONNECTION_SUBGRAPH*> > m_local_label_cache;
        -:  837:
        -:  838:    std::unordered_map<wxString, std::vector<CONNECTION_SUBGRAPH*>> m_net_name_to_subgraphs_map;
        -:  839:
        -:  840:    /// Every subgraph referencing the item, one per instantiating sheet path for items on shared
        -:  841:    /// screens.  Removal must purge all of them or a freed item leaves a dangling driver behind.
        -:  842:    std::unordered_map<SCH_ITEM*, std::vector<CONNECTION_SUBGRAPH*>> m_item_to_subgraph_map;
        -:  843:
        -:  844:    NET_MAP m_net_code_to_subgraphs_map;
        -:  845:
        -:  846:    int m_last_net_code;
        -:  847:
        -:  848:    int m_last_bus_code;
        -:  849:
        -:  850:    int m_last_subgraph_code;
        -:  851:
        -:  852:    SCHEMATIC* m_schematic;     ///< The schematic this graph represents.
        -:  853:};
