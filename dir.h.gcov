        -:  103:
        -:  104:    // dtor calls Close() automatically
    #####:  105:    ~wxDir() { Close(); }
        -:  106:
        -:  107:    // open the directory for enumerating
        -:  108:    bool Open(const wxString& dir);
        -:  109:
        -:  110:    // close the directory, Open() can be called again later
        -:  111:    void Close();
        -:  112:
        -:  113:    // returns true if the directory was successfully opened
        -:  114:    bool IsOpened() const;
        -:  115:
        -:  116:    // get the full name of the directory (without '/' at the end)
        -:  117:    wxString GetName() const;
        -:  118:
        -:  119:    // Same as GetName() but does include the trailing separator, unless the
        -:  120:    // string is empty (only for invalid directories).
        -:  121:    wxString GetNameWithSep() const;
        -:  122:
        -:  123:
        -:  124:    // file enumeration routines
        -:  125:    // -------------------------
        -:  126:
        -:  127:    // start enumerating all files matching filespec (or all files if it is
        -:  128:    // empty) and flags, return true on success
        -:  129:    bool GetFirst(wxString *filename,
        -:  130:                  const wxString& filespec = wxEmptyString,
        -:  131:                  int flags = wxDIR_DEFAULT) const;
        -:  132:
        -:  133:    // get next file in the enumeration started with GetFirst()
        -:  134:    bool GetNext(wxString *filename) const;
        -:  135:
        -:  136:    // return true if this directory has any files in it
        -:  137:    bool HasFiles(const wxString& spec = wxEmptyString) const;
        -:  138:
        -:  139:    // return true if this directory has any subdirectories
        -:  140:    bool HasSubDirs(const wxString& spec = wxEmptyString) const;
        -:  141:
        -:  142:    // enumerate all files in this directory and its subdirectories
        -:  143:    //
        -:  144:    // return the number of files found
        -:  145:    size_t Traverse(wxDirTraverser& sink,
        -:  146:                    const wxString& filespec = wxEmptyString,
        -:  147:                    int flags = wxDIR_DEFAULT) const;
        -:  148:
        -:  149:    // simplest version of Traverse(): get the names of all files under this
        -:  150:    // directory into filenames array, return the number of files
        -:  151:    static size_t GetAllFiles(const wxString& dirname,
        -:  152:                              wxArrayString *files,
        -:  153:                              const wxString& filespec = wxEmptyString,
        -:  154:                              int flags = wxDIR_DEFAULT);
        -:  155:
