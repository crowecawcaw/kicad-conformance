        -:   23:// the error value returned by wxMBConv methods
        -:   24:#define wxCONV_FAILED ((size_t)-1)
        -:   25:
        -:   26:// ----------------------------------------------------------------------------
        -:   27:// wxMBConv (abstract base class for conversions)
        -:   28:// ----------------------------------------------------------------------------
        -:   29:
        -:   30:// When deriving a new class from wxMBConv you must reimplement ToWChar() and
        -:   31:// FromWChar() methods which are not pure virtual only for historical reasons,
        -:   32:// don't let the fact that the existing classes implement MB2WC/WC2MB() instead
        -:   33:// confuse you.
        -:   34://
        -:   35:// For many encodings you must override GetMaxCharLen().
        -:   36://
        -:   37:// You also have to implement Clone() to allow copying the conversions
        -:   38:// polymorphically.
        -:   39://
        -:   40:// And you might need to override GetMBNulLen() as well.
        -:   41:class WXDLLIMPEXP_BASE wxMBConv
        -:   42:{
        -:   43:public:
        -:   44:    // The functions doing actual conversion from/to narrow to/from wide
        -:   45:    // character strings.
        -:   46:    //
        -:   47:    // On success, the return value is the length (i.e. the number of
        -:   48:    // characters, not bytes) of the converted string including any trailing
        -:   49:    // L'\0' or (possibly multiple) '\0'(s). If the conversion fails or if
        -:   50:    // there is not enough space for everything, including the trailing NUL
        -:   51:    // character(s), in the output buffer, wxCONV_FAILED is returned.
        -:   52:    //
        -:   53:    // In the special case when dst is NULL (the value of dstLen is ignored
        -:   54:    // then) the return value is the length of the needed buffer but nothing
        -:   55:    // happens otherwise. If srcLen is wxNO_LEN, the entire string, up to and
        -:   56:    // including the trailing NUL(s), is converted, otherwise exactly srcLen
        -:   57:    // bytes are.
        -:   58:    //
        -:   59:    // Typical usage:
        -:   60:    //
        -:   61:    //          size_t dstLen = conv.ToWChar(NULL, 0, src);
        -:   62:    //          if ( dstLen == wxCONV_FAILED )
        -:   63:    //              ... handle error ...
        -:   64:    //          wchar_t *wbuf = new wchar_t[dstLen];
        -:   65:    //          conv.ToWChar(wbuf, dstLen, src);
        -:   66:    //          ... work with wbuf ...
        -:   67:    //          delete [] wbuf;
        -:   68:    //
        -:   69:    virtual size_t ToWChar(wchar_t *dst, size_t dstLen,
        -:   70:                           const char *src, size_t srcLen = wxNO_LEN) const;
        -:   71:
        -:   72:    virtual size_t FromWChar(char *dst, size_t dstLen,
        -:   73:                             const wchar_t *src, size_t srcLen = wxNO_LEN) const;
        -:   74:
        -:   75:
        -:   76:    // Convenience functions for translating NUL-terminated strings: return
        -:   77:    // the buffer containing the converted string or empty buffer if the
        -:   78:    // conversion failed.
    #####:   79:    wxWCharBuffer cMB2WC(const char *in) const
    #####:   80:        { return DoConvertMB2WC(in, wxNO_LEN); }
        -:   81:    wxCharBuffer cWC2MB(const wchar_t *in) const
        -:   82:        { return DoConvertWC2MB(in, wxNO_LEN); }
        -:   83:
        -:   84:    wxWCharBuffer cMB2WC(const wxScopedCharBuffer& in) const
        -:   85:        { return DoConvertMB2WC(in, in.length()); }
        -:   86:    wxCharBuffer cWC2MB(const wxScopedWCharBuffer& in) const
        -:   87:        { return DoConvertWC2MB(in, in.length()); }
        -:   88:
        -:   89:
        -:   90:    // Convenience functions for converting strings which may contain embedded
        -:   91:    // NULs and don't have to be NUL-terminated.
        -:   92:    //
        -:   93:    // inLen is the length of the buffer including trailing NUL if any or
        -:   94:    // wxNO_LEN if the input is NUL-terminated.
        -:   95:    //
        -:   96:    // outLen receives, if not NULL, the length of the converted string or 0 if
        -:   97:    // the conversion failed (returning 0 and not -1 in this case makes it
        -:   98:    // difficult to distinguish between failed conversion and empty input but
        -:   99:    // this is done for backwards compatibility). Notice that the rules for
        -:  100:    // whether outLen accounts or not for the last NUL are the same as for
        -:  101:    // To/FromWChar() above: if inLen is specified, outLen is exactly the
        -:  102:    // number of characters converted, whether the last one of them was NUL or
        -:  103:    // not. But if inLen == wxNO_LEN then outLen doesn't account for the last
        -:  104:    // NUL even though it is present.
        -:  105:    wxWCharBuffer
        -:  106:        cMB2WC(const char *in, size_t inLen, size_t *outLen) const;
        -:  107:    wxCharBuffer
        -:  108:        cWC2MB(const wchar_t *in, size_t inLen, size_t *outLen) const;
        -:  109:
        -:  110:    // convenience functions for converting MB or WC to/from wxWin default
        -:  111:#if wxUSE_UNICODE
        -:  112:    wxWCharBuffer cMB2WX(const char *psz) const { return cMB2WC(psz); }
        -:  113:    wxCharBuffer cWX2MB(const wchar_t *psz) const { return cWC2MB(psz); }
        -:  114:    const wchar_t* cWC2WX(const wchar_t *psz) const { return psz; }
        -:  115:    const wchar_t* cWX2WC(const wchar_t *psz) const { return psz; }
        -:  116:#else // ANSI
        -:  117:    const char* cMB2WX(const char *psz) const { return psz; }
        -:  118:    const char* cWX2MB(const char *psz) const { return psz; }
        -:  119:    wxCharBuffer cWC2WX(const wchar_t *psz) const { return cWC2MB(psz); }
        -:  120:    wxWCharBuffer cWX2WC(const char *psz) const { return cMB2WC(psz); }
        -:  121:#endif // Unicode/ANSI
        -:  122:
        -:  123:    // return the maximum number of bytes that can be required to encode a
        -:  124:    // single character in this encoding, e.g. 4 for UTF-8
        -:  125:    virtual size_t GetMaxCharLen() const { return 1; }
        -:  126:
        -:  127:    // this function is used in the implementation of cMB2WC() to distinguish
        -:  128:    // between the following cases:
        -:  129:    //
        -:  130:    //      a) var width encoding with strings terminated by a single NUL
        -:  131:    //         (usual multibyte encodings): return 1 in this case
        -:  132:    //      b) fixed width encoding with 2 bytes/char and so terminated by
        -:  133:    //         2 NULs (UTF-16/UCS-2 and variants): return 2 in this case
        -:  134:    //      c) fixed width encoding with 4 bytes/char and so terminated by
        -:  135:    //         4 NULs (UTF-32/UCS-4 and variants): return 4 in this case
        -:  136:    //
        -:  137:    // anything else is not supported currently and -1 should be returned
        -:  138:    virtual size_t GetMBNulLen() const { return 1; }
        -:  139:
        -:  140:    // return the maximal value currently returned by GetMBNulLen() for any
        -:  141:    // encoding
        -:  142:    static size_t GetMaxMBNulLen() { return 4 /* for UTF-32 */; }
        -:  143:
        -:  144:    // return true if the converter's charset is UTF-8, i.e. char* strings
        -:  145:    // decoded using this object can be directly copied to wxString's internal
        -:  146:    // storage without converting to WC and then back to UTF-8 MB string
        -:  147:    virtual bool IsUTF8() const { return false; }
        -:  148:
        -:  149:    // The old conversion functions. The existing classes currently mostly
        -:  150:    // implement these ones but we're in transition to using To/FromWChar()
        -:  151:    // instead and any new classes should implement just the new functions.
        -:  152:    // For now, however, we provide default implementation of To/FromWChar() in
        -:  153:    // this base class in terms of MB2WC/WC2MB() to avoid having to rewrite all
        -:  154:    // the conversions at once.
        -:  155:    //
        -:  156:    // On success, the return value is the length (i.e. the number of
        -:  157:    // characters, not bytes) not counting the trailing NUL(s) of the converted
        -:  158:    // string. On failure, (size_t)-1 is returned. In the special case when
        -:  159:    // outputBuf is NULL the return value is the same one but nothing is
        -:  160:    // written to the buffer.
        -:  161:    //
        -:  162:    // Note that outLen is the length of the output buffer, not the length of
        -:  163:    // the input (which is always supposed to be terminated by one or more
        -:  164:    // NULs, as appropriate for the encoding)!
        -:  165:    virtual size_t MB2WC(wchar_t *out, const char *in, size_t outLen) const;
        -:  166:    virtual size_t WC2MB(char *out, const wchar_t *in, size_t outLen) const;
        -:  167:
        -:  168:
        -:  169:    // make a heap-allocated copy of this object
        -:  170:    virtual wxMBConv *Clone() const = 0;
        -:  171:
        -:  172:    // virtual dtor for any base class
    #####:  173:    virtual ~wxMBConv() { }
------------------
wxMBConv::~wxMBConv():
    #####:  173:    virtual ~wxMBConv() { }
------------------
wxMBConv::~wxMBConv():
    #####:  173:    virtual ~wxMBConv() { }
------------------
        -:  174:
        -:  175:private:
        -:  176:    // Common part of single argument cWC2MB() and cMB2WC() overloads above.
        -:  177:    wxCharBuffer DoConvertWC2MB(const wchar_t* pwz, size_t srcLen) const;
        -:  178:    wxWCharBuffer DoConvertMB2WC(const char* psz, size_t srcLen) const;
        -:  179:};
        -:  180:
        -:  181:// ----------------------------------------------------------------------------
        -:  182:// wxMBConvLibc uses standard mbstowcs() and wcstombs() functions for
        -:  183://              conversion (hence it depends on the current locale)
        -:  184:// ----------------------------------------------------------------------------
        -:  185:
        -:  186:class WXDLLIMPEXP_BASE wxMBConvLibc : public wxMBConv
        -:  187:{
        -:  188:public:
        -:  189:    virtual size_t MB2WC(wchar_t *outputBuf, const char *psz, size_t outputSize) const wxOVERRIDE;
        -:  190:    virtual size_t WC2MB(char *outputBuf, const wchar_t *psz, size_t outputSize) const wxOVERRIDE;
        -:  191:
        -:  192:    virtual wxMBConv *Clone() const wxOVERRIDE { return new wxMBConvLibc; }
        -:  193:
        -:  194:    virtual bool IsUTF8() const wxOVERRIDE { return wxLocaleIsUtf8; }
        -:  195:};
        -:  196:
        -:  197:#ifdef __UNIX__
        -:  198:
        -:  199:// ----------------------------------------------------------------------------
        -:  200:// wxConvBrokenFileNames is made for Unix in Unicode mode when
        -:  201:// files are accidentally written in an encoding which is not
        -:  202:// the system encoding. Typically, the system encoding will be
        -:  203:// UTF8 but there might be files stored in ISO8859-1 on disk.
        -:  204:// ----------------------------------------------------------------------------
        -:  205:
        -:  206:class WXDLLIMPEXP_BASE wxConvBrokenFileNames : public wxMBConv
        -:  207:{
        -:  208:public:
        -:  209:    wxConvBrokenFileNames(const wxString& charset);
        -:  210:    wxConvBrokenFileNames(const wxConvBrokenFileNames& conv)
        -:  211:        : wxMBConv(),
        -:  212:          m_conv(conv.m_conv ? conv.m_conv->Clone() : NULL)
        -:  213:    {
        -:  214:    }
        -:  215:    virtual ~wxConvBrokenFileNames() { delete m_conv; }
        -:  216:
        -:  217:    virtual size_t MB2WC(wchar_t *out, const char *in, size_t outLen) const wxOVERRIDE
        -:  218:    {
        -:  219:        return m_conv->MB2WC(out, in, outLen);
        -:  220:    }
        -:  221:
        -:  222:    virtual size_t WC2MB(char *out, const wchar_t *in, size_t outLen) const wxOVERRIDE
        -:  223:    {
        -:  224:        return m_conv->WC2MB(out, in, outLen);
        -:  225:    }
        -:  226:
        -:  227:    virtual size_t GetMBNulLen() const wxOVERRIDE
        -:  228:    {
        -:  229:        // cast needed to call a private function
        -:  230:        return m_conv->GetMBNulLen();
        -:  231:    }
        -:  232:
        -:  233:    virtual bool IsUTF8() const wxOVERRIDE { return m_conv->IsUTF8(); }
        -:  234:
        -:  235:    virtual wxMBConv *Clone() const wxOVERRIDE { return new wxConvBrokenFileNames(*this); }
        -:  236:
        -:  237:private:
        -:  238:    // the conversion object we forward to
        -:  239:    wxMBConv *m_conv;
        -:  240:
        -:  241:    wxDECLARE_NO_ASSIGN_CLASS(wxConvBrokenFileNames);
        -:  242:};
        -:  243:
        -:  244:#endif // __UNIX__
