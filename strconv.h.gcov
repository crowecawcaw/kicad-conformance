        -:  487:// ----------------------------------------------------------------------------
        -:  488:// wxCSConv (for conversion based on loadable char sets)
        -:  489:// ----------------------------------------------------------------------------
        -:  490:
        -:  491:#include "wx/fontenc.h"
        -:  492:
        -:  493:class WXDLLIMPEXP_BASE wxCSConv : public wxMBConv
        -:  494:{
        -:  495:public:
        -:  496:    // we can be created either from charset name or from an encoding constant
        -:  497:    // but we can't have both at once
        -:  498:    wxCSConv(const wxString& charset);
        -:  499:    wxCSConv(wxFontEncoding encoding);
        -:  500:
        -:  501:    wxCSConv(const wxCSConv& conv);
        -:  502:    virtual ~wxCSConv();
        -:  503:
        -:  504:    wxCSConv& operator=(const wxCSConv& conv);
        -:  505:
        -:  506:    virtual size_t ToWChar(wchar_t *dst, size_t dstLen,
        -:  507:                           const char *src, size_t srcLen = wxNO_LEN) const wxOVERRIDE;
        -:  508:    virtual size_t FromWChar(char *dst, size_t dstLen,
        -:  509:                             const wchar_t *src, size_t srcLen = wxNO_LEN) const wxOVERRIDE;
        -:  510:    virtual size_t GetMBNulLen() const wxOVERRIDE;
        -:  511:
        -:  512:    virtual bool IsUTF8() const wxOVERRIDE;
        -:  513:
        -:  514:    virtual wxMBConv *Clone() const wxOVERRIDE { return new wxCSConv(*this); }
        -:  515:
        -:  516:    void Clear();
        -:  517:
        -:  518:    // return true if the conversion could be initialized successfully
        -:  519:    bool IsOk() const;
        -:  520:
        -:  521:private:
        -:  522:    // common part of all ctors
        -:  523:    void Init();
        -:  524:
        -:  525:    // Creates the conversion to use, called from all ctors to initialize
        -:  526:    // m_convReal.
        -:  527:    wxMBConv *DoCreate() const;
        -:  528:
        -:  529:    // Set the name (may be only called when m_name == NULL), makes copy of
        -:  530:    // the charset string.
        -:  531:    void SetName(const char *charset);
        -:  532:
        -:  533:    // Set m_encoding field respecting the rules below, i.e. making sure it has
        -:  534:    // a valid value if m_name == NULL (thus this should be always called after
        -:  535:    // SetName()).
        -:  536:    //
        -:  537:    // Input encoding may be valid or not.
        -:  538:    void SetEncoding(wxFontEncoding encoding);
        -:  539:
        -:  540:
        -:  541:    // The encoding we use is specified by the two fields below:
        -:  542:    //
        -:  543:    //  1. If m_name != NULL, m_encoding corresponds to it if it's one of
        -:  544:    //     encodings we know about (i.e. member of wxFontEncoding) or is
        -:  545:    //     wxFONTENCODING_SYSTEM otherwise.
        -:  546:    //
        -:  547:    //  2. If m_name == NULL, m_encoding is always valid, i.e. not one of
        -:  548:    //     wxFONTENCODING_{SYSTEM,DEFAULT,MAX}.
        -:  549:    char *m_name;
        -:  550:    wxFontEncoding m_encoding;
        -:  551:
        -:  552:    // The conversion object for our encoding or NULL if we failed to create it
        -:  553:    // in which case we fall back to hard-coded ISO8859-1 conversion.
        -:  554:    wxMBConv *m_convReal;
        -:  555:};
        -:  556:
        -:  557:// ----------------------------------------------------------------------------
        -:  558:// wxWhateverWorksConv: use whatever encoding works for the input
        -:  559:// ----------------------------------------------------------------------------
        -:  560:
        -:  561:class WXDLLIMPEXP_BASE wxWhateverWorksConv : public wxMBConv
        -:  562:{
        -:  563:public:
        -:  564:    wxWhateverWorksConv()
        -:  565:    {
        -:  566:    }
        -:  567:
        -:  568:    // Try to interpret the string as UTF-8, if it fails fall back to the
        -:  569:    // current locale encoding (wxConvLibc) and if this fails as well,
        -:  570:    // interpret it as wxConvISO8859_1 (which is used because it never fails
        -:  571:    // and this conversion is used when we really, really must produce
        -:  572:    // something on output).
        -:  573:    virtual size_t
        -:  574:    ToWChar(wchar_t *dst, size_t dstLen,
        -:  575:            const char *src, size_t srcLen = wxNO_LEN) const wxOVERRIDE;
        -:  576:
        -:  577:    // Try to encode the string using the current locale encoding (wxConvLibc)
        -:  578:    // and fall back to UTF-8 (which never fails) if it doesn't work. Note that
        -:  579:    // we never use wxConvISO8859_1 here as we prefer to fall back on UTF-8
        -:  580:    // even for the strings containing only code points representable in 8869-1.
        -:  581:    virtual size_t
        -:  582:    FromWChar(char *dst, size_t dstLen,
        -:  583:              const wchar_t *src, size_t srcLen = wxNO_LEN) const wxOVERRIDE;
        -:  584:
        -:  585:    // Use the value for UTF-8 here to make sure we try to decode up to 4 bytes
        -:  586:    // as UTF-8 before giving up.
        -:  587:    virtual size_t GetMaxCharLen() const wxOVERRIDE { return 4; }
        -:  588:
        -:  589:    virtual wxMBConv *Clone() const wxOVERRIDE
        -:  590:    {
        -:  591:        return new wxWhateverWorksConv();
        -:  592:    }
        -:  593:};
        -:  594:
        -:  595:// ----------------------------------------------------------------------------
        -:  596:// declare predefined conversion objects
        -:  597:// ----------------------------------------------------------------------------
        -:  598:
        -:  599:// Note: this macro is an implementation detail (see the comment in
        -:  600:// strconv.cpp). The wxGet_XXX() and wxGet_XXXPtr() functions shouldn't be
        -:  601:// used by user code and neither should XXXPtr, use the wxConvXXX macro
        -:  602:// instead.
        -:  603:#define WX_DECLARE_GLOBAL_CONV(klass, name)                             \
        -:  604:    extern WXDLLIMPEXP_DATA_BASE(klass*) name##Ptr;                     \
        -:  605:    extern WXDLLIMPEXP_BASE klass* wxGet_##name##Ptr();                 \
        -:  606:    inline klass& wxGet_##name()                                        \
        -:  607:    {                                                                   \
        -:  608:        if ( !name##Ptr )                                               \
        -:  609:            name##Ptr = wxGet_##name##Ptr();                            \
        -:  610:        return *name##Ptr;                                              \
        -:  611:    }
        -:  612:
        -:  613:
        -:  614:// conversion to be used with all standard functions affected by locale, e.g.
        -:  615:// strtol(), strftime(), ...
    #####:  616:WX_DECLARE_GLOBAL_CONV(wxMBConv, wxConvLibc)
        -:  617:#define wxConvLibc wxGet_wxConvLibc()
        -:  618:
        -:  619:// conversion ISO-8859-1/UTF-7/UTF-8 <-> wchar_t
        -:  620:WX_DECLARE_GLOBAL_CONV(wxCSConv, wxConvISO8859_1)
        -:  621:#define wxConvISO8859_1 wxGet_wxConvISO8859_1()
        -:  622:
        -:  623:WX_DECLARE_GLOBAL_CONV(wxMBConvStrictUTF8, wxConvUTF8)
        -:  624:#define wxConvUTF8 wxGet_wxConvUTF8()
        -:  625:
        -:  626:WX_DECLARE_GLOBAL_CONV(wxMBConvUTF7, wxConvUTF7)
        -:  627:#define wxConvUTF7 wxGet_wxConvUTF7()
        -:  628:
        -:  629:// conversion used when we may not afford to lose data when outputting Unicode
        -:  630:// strings (should be avoid in the other direction as it can misinterpret the
        -:  631:// input encoding)
        -:  632:WX_DECLARE_GLOBAL_CONV(wxWhateverWorksConv, wxConvWhateverWorks)
        -:  633:#define wxConvWhateverWorks wxGet_wxConvWhateverWorks()
        -:  634:
        -:  635:// conversion used for the file names on the systems where they're not Unicode
        -:  636:// (basically anything except Windows)
        -:  637://
        -:  638:// this is used by all file functions, can be changed by the application
        -:  639://
        -:  640:// by default UTF-8 under Mac OS X and wxConvLibc elsewhere (but it's not used
        -:  641:// under Windows normally)
        -:  642:extern WXDLLIMPEXP_DATA_BASE(wxMBConv *) wxConvFileName;
        -:  643:
        -:  644:// backwards compatible define
        -:  645:#define wxConvFile (*wxConvFileName)
        -:  646:
        -:  647:// the current conversion object, may be set to any conversion, is used by
        -:  648:// default in a couple of places inside wx (initially same as wxConvLibc)
        -:  649:extern WXDLLIMPEXP_DATA_BASE(wxMBConv *) wxConvCurrent;
        -:  650:
        -:  651:// the conversion corresponding to the current locale
        -:  652:WX_DECLARE_GLOBAL_CONV(wxCSConv, wxConvLocal)
        -:  653:#define wxConvLocal wxGet_wxConvLocal()
        -:  654:
        -:  655:// the conversion corresponding to the encoding of the standard UI elements
        -:  656://
        -:  657:// by default this is the same as wxConvLocal but may be changed if the program
        -:  658:// needs to use a fixed encoding
        -:  659:extern WXDLLIMPEXP_DATA_BASE(wxMBConv *) wxConvUI;
        -:  660:
        -:  661:#undef WX_DECLARE_GLOBAL_CONV
        -:  662:
        -:  663:// ----------------------------------------------------------------------------
        -:  664:// endianness-dependent conversions
        -:  665:// ----------------------------------------------------------------------------
        -:  666:
        -:  667:#ifdef WORDS_BIGENDIAN
        -:  668:    typedef wxMBConvUTF16BE wxMBConvUTF16;
        -:  669:    typedef wxMBConvUTF32BE wxMBConvUTF32;
        -:  670:#else
        -:  671:    typedef wxMBConvUTF16LE wxMBConvUTF16;
        -:  672:    typedef wxMBConvUTF32LE wxMBConvUTF32;
        -:  673:#endif
        -:  674:
        -:  675:// ----------------------------------------------------------------------------
        -:  676:// filename conversion macros
        -:  677:// ----------------------------------------------------------------------------
        -:  678:
        -:  679:// filenames are multibyte on Unix and widechar on Windows
        -:  680:#if wxMBFILES && wxUSE_UNICODE
        -:  681:    #define wxFNCONV(name) wxConvFileName->cWX2MB(name)
        -:  682:    #define wxFNSTRINGCAST wxMBSTRINGCAST
        -:  683:#else
        -:  684:#if defined(__WXOSX__) && wxMBFILES
        -:  685:    #define wxFNCONV(name) wxConvFileName->cWC2MB( wxConvLocal.cWX2WC(name) )
        -:  686:#else
        -:  687:    #define wxFNCONV(name) name
        -:  688:#endif
        -:  689:    #define wxFNSTRINGCAST WXSTRINGCAST
        -:  690:#endif
        -:  691:
        -:  692:// ----------------------------------------------------------------------------
        -:  693:// macros for the most common conversions
        -:  694:// ----------------------------------------------------------------------------
        -:  695:
        -:  696:#if wxUSE_UNICODE
        -:  697:    #define wxConvertWX2MB(s)   wxConvCurrent->cWX2MB(s)
        -:  698:    #define wxConvertMB2WX(s)   wxConvCurrent->cMB2WX(s)
        -:  699:
        -:  700:    // these functions should be used when the conversions really, really have
        -:  701:    // to succeed (usually because we pass their results to a standard C
        -:  702:    // function which would crash if we passed NULL to it), so these functions
        -:  703:    // always return a valid pointer if their argument is non-NULL
        -:  704:
        -:  705:    inline wxWCharBuffer wxSafeConvertMB2WX(const char *s)
        -:  706:    {
        -:  707:        return wxConvWhateverWorks.cMB2WC(s);
        -:  708:    }
        -:  709:
        -:  710:    inline wxCharBuffer wxSafeConvertWX2MB(const wchar_t *ws)
        -:  711:    {
        -:  712:        return wxConvWhateverWorks.cWC2MB(ws);
        -:  713:    }
        -:  714:#else // ANSI
        -:  715:    // no conversions to do
        -:  716:    #define wxConvertWX2MB(s)   (s)
        -:  717:    #define wxConvertMB2WX(s)   (s)
        -:  718:    #define wxSafeConvertMB2WX(s) (s)
        -:  719:    #define wxSafeConvertWX2MB(s) (s)
        -:  720:#endif // Unicode/ANSI
        -:  721:
        -:  722:// Macro that indicates the default encoding for converting C strings
        -:  723:// to wxString. It provides a default value for a const wxMBConv&
        -:  724:// parameter (i.e. wxConvLibc) unless wxNO_IMPLICIT_WXSTRING_ENCODING
        -:  725:// is defined.
        -:  726://
        -:  727:// Intended use:
        -:  728:// wxString(const char *data, ...,
        -:  729://          const wxMBConv &conv wxSTRING_DEFAULT_CONV_ARG);
        -:  730:#ifndef wxNO_IMPLICIT_WXSTRING_ENCODING
        -:  731:#define wxSTRING_DEFAULT_CONV_ARG = wxConvLibc
        -:  732:#else
        -:  733:#define wxSTRING_DEFAULT_CONV_ARG
        -:  734:#endif
        -:  735:
        -:  736:#endif // _WX_STRCONV_H_
