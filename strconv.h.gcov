        -:  427:
        -:  428:class WXDLLIMPEXP_BASE wxMBConvUTF16BE : public wxMBConvUTF16Base
        -:  429:{
        -:  430:public:
        -:  431:    virtual size_t ToWChar(wchar_t *dst, size_t dstLen,
        -:  432:                           const char *src, size_t srcLen = wxNO_LEN) const wxOVERRIDE;
        -:  433:    virtual size_t FromWChar(char *dst, size_t dstLen,
        -:  434:                             const wchar_t *src, size_t srcLen = wxNO_LEN) const wxOVERRIDE;
        -:  435:    virtual size_t GetMaxCharLen() const wxOVERRIDE { return 4; }
        -:  436:    virtual wxMBConv *Clone() const wxOVERRIDE { return new wxMBConvUTF16BE; }
        -:  437:};
        -:  438:
        -:  439:// ----------------------------------------------------------------------------
