        -:  447:        : m_array( array ), m_strings( NULL )
        -:  448:    { }
        -:  449:    ~wxCArrayString() { delete[] m_strings; }
        -:  450:
        -:  451:    size_t GetCount() const { return m_array.GetCount(); }
        -:  452:    wxString* GetStrings()
        -:  453:    {
        -:  454:        if( m_strings ) return m_strings;
        -:  455:        const size_t count = m_array.GetCount();
        -:  456:        m_strings = new wxString[count];
        -:  457:        for( size_t i = 0; i < count; ++i )
        -:  458:            m_strings[i] = m_array[i];
        -:  459:        return m_strings;
        -:  460:    }
        -:  461:
        -:  462:    wxString* Release()
        -:  463:    {
        -:  464:        wxString *r = GetStrings();
        -:  465:        m_strings = NULL;
        -:  466:        return r;
        -:  467:    }
        -:  468:
        -:  469:private:
        -:  470:    const wxArrayString& m_array;
        -:  471:    wxString* m_strings;
        -:  472:};
        -:  473:
        -:  474:
        -:  475:// ----------------------------------------------------------------------------
        -:  476:// helper functions for working with arrays
        -:  477:// ----------------------------------------------------------------------------
        -:  478:
        -:  479:// by default, these functions use the escape character to escape the
        -:  480:// separators occurring inside the string to be joined, this can be disabled by
        -:  481:// passing '\0' as escape
        -:  482:
        -:  483:WXDLLIMPEXP_BASE wxString wxJoin(const wxArrayString& arr,
        -:  484:                                 const wxChar sep,
        -:  485:                                 const wxChar escape = wxT('\\'));
        -:  486:
        -:  487:WXDLLIMPEXP_BASE wxArrayString wxSplit(const wxString& str,
        -:  488:                                       const wxChar sep,
        -:  489:                                       const wxChar escape = wxT('\\'));
        -:  490:
        -:  491:
        -:  492:// ----------------------------------------------------------------------------
        -:  493:// This helper class allows to pass both C array of wxStrings or wxArrayString
        -:  494:// using the same interface.
        -:  495://
        -:  496:// Use it when you have two methods taking wxArrayString or (int, wxString[]),
        -:  497:// that do the same thing. This class lets you iterate over input data in the
        -:  498:// same way whether it is a raw array of strings or wxArrayString.
        -:  499://
        -:  500:// The object does not take ownership of the data -- internally it keeps
        -:  501:// pointers to the data, therefore the data must be disposed of by user
        -:  502:// and only after this object is destroyed. Usually it is not a problem as
        -:  503:// only temporary objects of this class are used.
        -:  504:// ----------------------------------------------------------------------------
        -:  505:
        -:  506:class wxArrayStringsAdapter
        -:  507:{
        -:  508:public:
        -:  509:    // construct an adapter from a wxArrayString
        -:  510:    wxArrayStringsAdapter(const wxArrayString& strings)
        -:  511:        : m_type(wxSTRING_ARRAY), m_size(strings.size())
        -:  512:    {
        -:  513:        m_data.array = &strings;
        -:  514:    }
        -:  515:
        -:  516:    // construct an adapter from a wxString[]
        -:  517:    wxArrayStringsAdapter(unsigned int n, const wxString *strings)
        -:  518:        : m_type(wxSTRING_POINTER), m_size(n)
        -:  519:    {
        -:  520:        m_data.ptr = strings;
        -:  521:    }
        -:  522:
        -:  523:#if wxUSE_STD_CONTAINERS_COMPATIBLY
        -:  524:    // construct an adapter from a vector of strings
        -:  525:    wxArrayStringsAdapter(const std::vector<wxString>& strings)
        -:  526:        : m_type(wxSTRING_POINTER), m_size(strings.size())
        -:  527:    {
        -:  528:        m_data.ptr = m_size == 0 ? NULL : &strings[0];
        -:  529:    }
        -:  530:#endif // wxUSE_STD_CONTAINERS_COMPATIBLY
        -:  531:
        -:  532:    // construct an adapter from a single wxString
        -:  533:    wxArrayStringsAdapter(const wxString& s)
        -:  534:        : m_type(wxSTRING_POINTER), m_size(1)
        -:  535:    {
        -:  536:        m_data.ptr = &s;
        -:  537:    }
        -:  538:
        -:  539:    // default copy constructor is ok
        -:  540:
        -:  541:    // iteration interface
        -:  542:    size_t GetCount() const { return m_size; }
        -:  543:    bool IsEmpty() const { return GetCount() == 0; }
        -:  544:    const wxString& operator[] (unsigned int i) const
        -:  545:    {
        -:  546:        wxASSERT_MSG( i < GetCount(), wxT("index out of bounds") );
        -:  547:        if(m_type == wxSTRING_POINTER)
        -:  548:            return m_data.ptr[i];
        -:  549:        return m_data.array->Item(i);
        -:  550:    }
        -:  551:    wxArrayString AsArrayString() const
        -:  552:    {
        -:  553:        if(m_type == wxSTRING_ARRAY)
        -:  554:            return *m_data.array;
        -:  555:        return wxArrayString(GetCount(), m_data.ptr);
        -:  556:    }
        -:  557:
        -:  558:private:
        -:  559:    // type of the data being held
        -:  560:    enum wxStringContainerType
        -:  561:    {
        -:  562:        wxSTRING_ARRAY,  // wxArrayString
        -:  563:        wxSTRING_POINTER // wxString[]
        -:  564:    };
        -:  565:
        -:  566:    wxStringContainerType m_type;
        -:  567:    size_t m_size;
        -:  568:    union
        -:  569:    {
        -:  570:        const wxString *      ptr;
        -:  571:        const wxArrayString * array;
        -:  572:    } m_data;
        -:  573:
        -:  574:    wxDECLARE_NO_ASSIGN_CLASS(wxArrayStringsAdapter);
        -:  575:};
        -:  576:
        -:  577:#endif // _WX_ARRSTR_H
