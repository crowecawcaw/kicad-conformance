        -:  954:    wxString            m_name;
        -:  955:    wxString            m_keyWords;         ///< Search keywords
        -:  956:    wxArrayString       m_fpFilters;        ///< List of suitable footprint names for the symbol (wild card
        -:  957:                                            ///< names accepted).
        -:  958:
        -:  959:    /// A list of jumper pin groups, each of which is a set of pin numbers that should be jumpered
        -:  960:    /// together (treated as internally connected for the purposes of connectivity)
        -:  961:    std::vector<std::set<wxString> > m_jumperPinGroups;
        -:  962:
        -:  963:    /// Flag that this symbol should automatically treat sets of two or more pins with the same
        -:  964:    /// number as jumpered pin groups
        -:  965:    bool m_duplicatePinNumbersAreJumpers;
        -:  966:
        -:  967:    std::map<int, wxString> m_unitDisplayNames;
        -:  968:    std::vector<wxString>   m_bodyStyleNames;
        -:  969:
        -:  970:    // Caches for things that are expensive to compute but required every time
        -:  971:    // the symbol chooser or other library list is created
        -:  972:
        -:  973:    std::vector<SEARCH_TERM> m_searchTermsCache;
        -:  974:    int m_pinCountCache;
        -:  975:    wxString m_shownDescriptionCache;
        -:  976:    std::map<wxString, wxString> m_chooserFieldsCache;
        -:  977:};
