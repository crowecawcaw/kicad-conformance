        -:  224:
        -:  225:/**
        -:  226: * Handle access to a stack of flattened #SCH_SHEET objects by way of a path for
        -:  227: * creating a flattened schematic hierarchy.
        -:  228: *
        -:  229: * The #SCH_SHEET objects are stored in a list from first (usually the root sheet) to a
        -:  230: * given sheet in last position.  The _last_ sheet is usually the sheet we want to select
        -:  231: * or reach (which is what the function Last() returns).   Others sheets constitute the
        -:  232: * "path" from the first to the last sheet.
        -:  233: */
        -:  234:class SCH_SHEET_PATH
        -:  235:{
        -:  236:public:
        -:  237:    SCH_SHEET_PATH();
        -:  238:
        -:  239:    SCH_SHEET_PATH( const SCH_SHEET_PATH& aOther );
        -:  240:
        -:  241:    SCH_SHEET_PATH& operator=( const SCH_SHEET_PATH& aOther );
        -:  242:
        -:  243:    // Move assignment operator
        -:  244:    SCH_SHEET_PATH& operator=( SCH_SHEET_PATH&& aOther );
        -:  245:
        -:  246:    SCH_SHEET_PATH operator+( const SCH_SHEET_PATH& aOther );
        -:  247:
    #####:  248:    ~SCH_SHEET_PATH() = default;
        -:  249:
        -:  250:    /// Forwarded method from std::vector
        -:  251:    SCH_SHEET* at( size_t aIndex ) const { return m_sheets.at( aIndex ); }
        -:  252:
        -:  253:    /// Forwarded method from std::vector
        -:  254:    void clear()
        -:  255:    {
        -:  256:        m_sheets.clear();
        -:  257:        Rehash();
        -:  258:    }
        -:  259:
        -:  260:    /// Forwarded method from std::vector
        -:  261:    bool empty() const { return m_sheets.empty(); }
        -:  262:
        -:  263:    /// Forwarded method from std::vector
        -:  264:    void pop_back()
        -:  265:    {
        -:  266:        m_sheets.pop_back();
        -:  267:        Rehash();
        -:  268:    }
        -:  269:
        -:  270:    /// Forwarded method from std::vector
    #####:  271:    void push_back( SCH_SHEET* aSheet )
        -:  272:    {
    #####:  273:        m_sheets.push_back( aSheet );
    #####:  274:        Rehash();
    #####:  275:    }
        -:  276:
        -:  277:    /// Forwarded method from std::vector
        -:  278:    size_t size() const { return m_sheets.size(); }
        -:  279:
        -:  280:    std::vector<SCH_SHEET*>::iterator erase( std::vector<SCH_SHEET*>::const_iterator aPosition )
        -:  281:    {
        -:  282:        std::vector<SCH_SHEET*>::iterator ret = m_sheets.erase( aPosition );
        -:  283:
        -:  284:        // Rehash to keep m_current_hash and the cached path consistent with the shortened list.
        -:  285:        Rehash();
        -:  286:
        -:  287:        return ret;
        -:  288:    }
        -:  289:
        -:  290:    void Rehash();
        -:  291:
        -:  292:    size_t GetCurrentHash() const { return m_current_hash; }
        -:  293:
        -:  294:    /**
        -:  295:     * Set the sheet instance virtual page number.
        -:  296:     *
        -:  297:     * Virtual page numbers are incremental integers set automatically when the sheet path
        -:  298:     * hierarchy is created (@see #SCH_SHEET_LIST::BuildSheetList).  The virtual page
        -:  299:     * numbering is ordered by the X and Y position of the sheet in a schematic which
        -:  300:     * mimics the page numbering code prior to the addition of actual user definable page
        -:  301:     * numbers.  Virtual page numbers should only be use when annotating schematics.
        -:  302:     */
        -:  303:    void SetVirtualPageNumber( int aPageNumber ) { m_virtualPageNumber = aPageNumber; }
        -:  304:
        -:  305:    int GetVirtualPageNumber() const { return m_virtualPageNumber; }
        -:  306:
        -:  307:    /**
        -:  308:     * Set the sheet instance user definable page number.
        -:  309:     *
        -:  310:     * @note User definable page numbers can be any string devoid of white space characters.
        -:  311:     */
        -:  312:    void SetPageNumber( const wxString& aPageNumber );
        -:  313:
