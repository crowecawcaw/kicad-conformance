        -:  319:    {
        -:  320:        SCH_SHEET* retv = nullptr;
        -:  321:
        -:  322:        if( aIndex < size() )
        -:  323:            retv = at( aIndex );
        -:  324:
        -:  325:        return retv;
        -:  326:    }
        -:  327:
        -:  328:    /**
        -:  329:     * Compare if this is the same sheet path as \a aSheetPathToTest.
        -:  330:     *
        -:  331:     * @param aSheetPathToTest is the sheet path to compare.
        -:  332:     * @return 1 if this sheet path has more sheets than aSheetPathToTest,
        -:  333:     *   -1 if this sheet path has fewer sheets than aSheetPathToTest,
        -:  334:     *   or 0 if same
        -:  335:     */
        -:  336:    int Cmp( const SCH_SHEET_PATH& aSheetPathToTest ) const;
        -:  337:
