        -:  108:/**
        -:  109: * The set of pad properties used in Gerber files (Draw files, and P&P files)
        -:  110: * to define some properties in fabrication or test files.  Also used by
        -:  111: * DRC to check some properties.
        -:  112: */
        -:  113:enum class PAD_PROP
        -:  114:{
        -:  115:    NONE,                  ///< no special fabrication property
        -:  116:    BGA,                   ///< Smd pad, used in BGA footprints
        -:  117:    FIDUCIAL_GLBL,         ///< a fiducial (usually a smd) for the full board
        -:  118:    FIDUCIAL_LOCAL,        ///< a fiducial (usually a smd) local to the parent footprint
        -:  119:    TESTPOINT,             ///< a test point pad
        -:  120:    HEATSINK,              ///< a pad used as heat sink, usually in SMD footprints
        -:  121:    CASTELLATED,           ///< a pad with a castellated through hole
        -:  122:    MECHANICAL,            ///< a pad used for mechanical support
        -:  123:    PRESSFIT               ///< a PTH with a hole diameter with tight tolerances for press fit pin
        -:  124:};
