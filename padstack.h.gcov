        -:   99:    SMD,        ///< Smd pad, appears on the solder paste layer (default)
        -:  100:    CONN,       ///< Like smd, does not appear on the solder paste layer (default)
        -:  101:                ///<   Note: also has a special attribute in Gerber X files
        -:  102:                ///<   Used for edgecard connectors for instance
        -:  103:    NPTH,       ///< like PAD_PTH, but not plated
        -:  104:                ///<   mechanical use only, no connection allowed
