        -:  142:
        -:  143:/**
        -:  144: * A PADSTACK defines the characteristics of a single or multi-layer pad, in the IPC sense of
        -:  145: * the word.  This means that a PCB_PAD has a padstack, but also a PCB_VIA.  The padstack for
        -:  146: * a pad defines its geometry on copper, soldermask, and paste layers, as well as any drilling
        -:  147: * or milling associated with the pad (round or slot hole, back-drilling, etc).  Padstacks also
        -:  148: * define thermal relief settings for all copper layers, clearance overrides for all copper
        -:  149: * layers, and potentially other properties in the future.  In other words, the padstack defines
        -:  150: * most of the geometric features of a pad on all layers.  It does not define electrical properties
        -:  151: * or other metadata.
        -:  152: *
        -:  153: * For padstacks that do not vary between layers, F_Cu is used as the copper layer to store all
        -:  154: * padstack properties.
        -:  155: */
        -:  156:class PADSTACK : public SERIALIZABLE
        -:  157:{
        -:  158:public:
        -:  159:    ///! Padstack type, mostly for IPC-7351 naming and attributes
        -:  160:    ///! Note that TYPE::MOUNTING is probably not currently supported by KiCad
        -:  161:    enum class TYPE
        -:  162:    {
        -:  163:        NORMAL,     ///< Padstack for a footprint pad
        -:  164:        VIA,        ///< Padstack for a via
        -:  165:        MOUNTING    ///< A mounting hole (plated or unplated, not associated with a footprint)
        -:  166:    };
        -:  167:
        -:  168:    ///! Copper geometry mode: controls how many unique copper layer shapes this padstack has
        -:  169:    enum class MODE
        -:  170:    {
        -:  171:        NORMAL,           ///< Shape is the same on all layers
        -:  172:        FRONT_INNER_BACK, ///< Up to three shapes can be defined (F_Cu, inner copper layers, B_Cu)
        -:  173:        CUSTOM            ///< Shapes can be defined on arbitrary layers
        -:  174:    };
        -:  175:
        -:  176:    ///! Temporary layer identifier to identify code that is not padstack-aware
        -:  177:    static constexpr PCB_LAYER_ID ALL_LAYERS = F_Cu;
        -:  178:
        -:  179:    ///! The layer identifier to use for "inner layers" on top/inner/bottom padstacks
        -:  180:    static constexpr PCB_LAYER_ID INNER_LAYERS = In1_Cu;
        -:  181:
        -:  182:    ///! Whether or not to remove the copper shape for unconnected layers
        -:  183:    ///! The set of properties that define a pad's shape on a given layer
        -:  184:    struct SHAPE_PROPS
        -:  185:    {
        -:  186:        PAD_SHAPE shape;    ///< Shape of the pad
        -:  187:        PAD_SHAPE anchor_shape; ///< Shape of the anchor when shape == PAD_SHAPE::CUSTOM
        -:  188:        VECTOR2I size;  ///< Size of the shape, or of the anchor pad for custom shape pads
        -:  189:
        -:  190:        /*
        -:  191:         * Most of the time the hole is the center of the shape (m_Offset = 0). But some designers
        -:  192:         * use oblong/rect pads with a hole moved to one of the oblong/rect pad shape ends.
        -:  193:         * In all cases the hole is at the pad position.  This offset is from the hole to the center
        -:  194:         * of the pad shape (ie: the copper area around the hole).
        -:  195:         * ShapePos() returns the board shape position according to the offset and the pad rotation.
        -:  196:         */
        -:  197:        VECTOR2I offset; ///< Offset of the shape center from the pad center
        -:  198:
        -:  199:        double round_rect_radius_ratio;
        -:  200:        double chamfered_rect_ratio;    ///< Size of chamfer: ratio of smallest of X,Y size
        -:  201:        int chamfered_rect_positions;   ///< @see RECT_CHAMFER_POSITIONS
        -:  202:
        -:  203:        /**
        -:  204:         *  Delta for PAD_SHAPE::TRAPEZOID; half the delta squeezes one end and half expands the
        -:  205:         *  other.  It is only valid to have a single axis be non-zero.
        -:  206:         */
        -:  207:        VECTOR2I trapezoid_delta_size;
        -:  208:
        -:  209:        SHAPE_PROPS();
        -:  210:        bool operator==( const SHAPE_PROPS& aOther ) const;
        -:  211:        int Compare( const SHAPE_PROPS& aOther ) const;
        -:  212:    };
        -:  213:
        -:  214:    /**
        -:  215:     * The features of a padstack that can vary between copper layers
        -:  216:     * All parameters are optional; leaving them un-set means "use parent/rule defaults"
        -:  217:     * Pad clearances, margins, etc. exist in a hierarchy.  If a given level is specified then
        -:  218:     * the remaining levels are NOT consulted.
        -:  219:     *
        -:  220:     * LEVEL 1: (highest priority) local overrides (pad, footprint, etc.)
        -:  221:     * LEVEL 2: Rules
        -:  222:     * LEVEL 3: Accumulated local settings, netclass settings, & board design settings
        -:  223:     *
        -:  224:     * These are the LEVEL 1 settings (overrides) for a pad.
        -:  225:     */
        -:  226:    struct COPPER_LAYER_PROPS
        -:  227:    {
        -:  228:        SHAPE_PROPS shape;
        -:  229:        std::optional<ZONE_CONNECTION> zone_connection;
        -:  230:        std::optional<int> thermal_spoke_width;
        -:  231:        std::optional<EDA_ANGLE> thermal_spoke_angle;
        -:  232:        std::optional<int> thermal_gap;
        -:  233:        std::optional<int> clearance;
        -:  234:
        -:  235:        /*
        -:  236:         * Editing definitions of primitives for custom pad shapes.  In local coordinates relative
        -:  237:         * to m_Pos (NOT shapePos) at orient 0.
        -:  238:         */
        -:  239:        std::vector<std::shared_ptr<PCB_SHAPE>> custom_shapes;
        -:  240:
        -:  241:        bool operator==( const COPPER_LAYER_PROPS& aOther ) const;
        -:  242:        int Compare( const COPPER_LAYER_PROPS& aOther ) const;
        -:  243:
        -:  244:        double Similarity( const COPPER_LAYER_PROPS& aOther ) const;
        -:  245:    };
        -:  246:
        -:  247:    ///! The features of a padstack that can vary on outer layers.
        -:  248:    ///! All parameters are optional; leaving them un-set means "use parent/rule defaults"
        -:  249:    struct MASK_LAYER_PROPS
        -:  250:    {
        -:  251:        std::optional<int> solder_mask_margin;
        -:  252:        std::optional<int> solder_paste_margin;
        -:  253:        std::optional<double> solder_paste_margin_ratio;
        -:  254:
        -:  255:        std::optional<bool> has_solder_mask;   ///< True if this outer layer has mask (is not tented)
        -:  256:        std::optional<bool> has_solder_paste;  ///< True if this outer layer has solder paste
        -:  257:        std::optional<bool> has_covering; ///< True if the pad on this side should have covering
        -:  258:        std::optional<bool> has_plugging; ///< True if the drill hole should be plugged on this side
        -:  259:
        -:  260:        bool operator==( const MASK_LAYER_PROPS& aOther ) const;
        -:  261:        int Compare( const MASK_LAYER_PROPS& aOther ) const;
        -:  262:    };
        -:  263:
        -:  264:    ///! The properties of a padstack drill.  Drill position is always the pad position (origin).
        -:  265:    struct DRILL_PROPS
        -:  266:    {
        -:  267:        VECTOR2I        size;                            ///< Drill diameter (x == y) or slot dimensions (x != y)
        -:  268:        PAD_DRILL_SHAPE shape = PAD_DRILL_SHAPE::UNDEFINED;
        -:  269:        PCB_LAYER_ID    start = UNDEFINED_LAYER;
        -:  270:        PCB_LAYER_ID    end   = UNDEFINED_LAYER;
        -:  271:
        -:  272:        std::optional<bool> is_filled; ///< True if the drill hole should be filled completely
        -:  273:        std::optional<bool> is_capped; ///< True if the drill hole should be capped
        -:  274:
        -:  275:        bool operator==( const DRILL_PROPS& aOther ) const;
        -:  276:        int Compare( const DRILL_PROPS& aOther ) const;
        -:  277:    };
        -:  278:
        -:  279:    struct POST_MACHINING_PROPS
        -:  280:    {
        -:  281:        std::optional<PAD_DRILL_POST_MACHINING_MODE> mode;
        -:  282:        int size = 0;
        -:  283:        int depth = 0;
        -:  284:        int angle = 0;
        -:  285:
        -:  286:        bool operator==( const POST_MACHINING_PROPS& aOther ) const;
        -:  287:        int Compare( const POST_MACHINING_PROPS& aOther ) const;
        -:  288:    };
        -:  289:
        -:  290:public:
        -:  291:    PADSTACK( BOARD_ITEM* aParent );
        -:  292:    virtual ~PADSTACK() = default;
        -:  293:    PADSTACK( const PADSTACK& aOther );
        -:  294:    PADSTACK& operator=( const PADSTACK &aOther );
        -:  295:
        -:  296:    bool operator==( const PADSTACK& aOther ) const;
        -:  297:    bool operator!=( const PADSTACK& aOther ) const { return !operator==( aOther ); }
        -:  298:
        -:  299:    void Serialize( google::protobuf::Any &aContainer ) const override;
        -:  300:    bool Deserialize( const google::protobuf::Any &aContainer ) override;
        -:  301:
        -:  302:    /**
        -:  303:       * Compare two padstacks and return 0 if they are equal.
        -:  304:       *
        -:  305:       * @return less than 0 if left less than right, 0 if equal, or greater than 0 if left
        -:  306:       *         greater than right.
        -:  307:       */
        -:  308:    static int Compare( const PADSTACK* aPadstackRef, const PADSTACK* aPadstackCmp );
        -:  309:
        -:  310:    /**
        -:  311:     * Check if the padstack has an explicit definition for the given layer.
        -:  312:     * This is useful for detecting if a layer removal will cause data loss.
        -:  313:     */
        -:  314:    bool HasExplicitDefinitionForLayer( PCB_LAYER_ID aLayer ) const;
        -:  315:
        -:  316:    /**
        -:  317:     * Return a measure of how likely the other object is to represent the same
        -:  318:     * object.  The scale runs from 0.0 (definitely different objects) to 1.0 (same)
        -:  319:     */
        -:  320:    double Similarity( const PADSTACK& aOther ) const;
        -:  321:
        -:  322:    const LSET& LayerSet() const { return m_layerSet; }
        -:  323:    LSET& LayerSet() { return m_layerSet; }
        -:  324:    void SetLayerSet( const LSET& aSet ) { m_layerSet = aSet; }
        -:  325:
        -:  326:    /**
        -:  327:     * Flips the padstack layers in the case that the pad's parent footprint is flipped to the
        -:  328:     * other side of the board.
        -:  329:     */
        -:  330:    void FlipLayers( BOARD* aBoard );
        -:  331:
