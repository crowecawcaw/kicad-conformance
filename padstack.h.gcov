    #####:  394:    CUSTOM_SHAPE_ZONE_MODE CustomShapeInZoneMode() const { return m_customShapeInZoneMode; }
        -:  395:    void SetCustomShapeInZoneMode( CUSTOM_SHAPE_ZONE_MODE aM ) { m_customShapeInZoneMode = aM; }
        -:  396:
        -:  397:    /**
        -:  398:     * Runs the given callable for each active unique copper layer in this padstack, meaning
        -:  399:     * F_Cu for MODE::NORMAL; F_Cu, PADSTACK::INNER_LAYERS, and B_Cu for top/inner/bottom,
        -:  400:     * and an arbitrary set of layers for full-custom padstacks.
        -:  401:     * @param aMethod will be called once for each independent copper layer in the padstack
        -:  402:     */
        -:  403:    void ForEachUniqueLayer( const std::function<void( PCB_LAYER_ID )>& aMethod ) const;
        -:  404:
        -:  405:    std::vector<PCB_LAYER_ID> UniqueLayers() const;
        -:  406:
        -:  407:    /**
        -:  408:     * Determines which geometry layer should be used for the given input layer.
        -:  409:     * For example, for MODE::NORMAL, this will always be F_Cu, and for MODE::FRONT_INNER_BACK,
        -:  410:     * this will be one of F_Cu, PADSTACK::INNER_LAYERS, and B_Cu depending on the input
        -:  411:     * layer.
        -:  412:     *
        -:  413:     * @param aLayer is a valid board layer
        -:  414:     * @return the layer that the padstack's geometry is stored on for the given input layer
        -:  415:     */
        -:  416:    PCB_LAYER_ID EffectiveLayerFor( PCB_LAYER_ID aLayer ) const;
        -:  417:
        -:  418:    /**
        -:  419:     * Returns the set of layers that must be considered if checking one padstack against another.
        -:  420:     * For example, two normal padstacks will just return a set with ALL_LAYERS, but if one of them
        -:  421:     * is FRONT_INNER_BACK, there are three layers to check.
        -:  422:     */
        -:  423:    LSET RelevantShapeLayers( const PADSTACK& aOther ) const;
        -:  424:
        -:  425:    // The following section has convenience getters for the padstack properties on a given layer.
        -:  426:
        -:  427:    PAD_SHAPE Shape( PCB_LAYER_ID aLayer ) const;
        -:  428:    void SetShape( PAD_SHAPE aShape, PCB_LAYER_ID aLayer );
        -:  429:
        -:  430:    // Setter rather than direct access to enforce only positive sizes
        -:  431:    void SetSize( const VECTOR2I& aSize, PCB_LAYER_ID aLayer );
