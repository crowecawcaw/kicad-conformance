	(gr_line (start -2 -2) (end 42 -2) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 42 -2) (end 42 30) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 42 30) (end -2 30) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start -2 30) (end -2 -2) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(footprint "a:g" (layer "F.Cu") (at 22 6)
		(pad "1" smd rect (at 0 0) (size 1.6 1.6) (layers "F.Cu" "F.Mask") (net 1 "GND"))
	)
	(footprint "a:g" (layer "F.Cu") (at 22 14)
		(pad "1" smd rect (at 0 0) (size 1.6 1.6) (layers "F.Cu" "F.Mask") (net 1 "GND"))
	)
