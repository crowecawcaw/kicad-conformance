(kicad_pcb
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(general (thickness 1.6))
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(25 "Edge.Cuts" user)
		(35 "F.Fab" user)
	)
	(net 0 "")
	(net 1 "GND")
	(gr_line (start 2 2) (end 28 2) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 28 2) (end 28 28) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 28 28) (end 25.1072 28) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 25.1072 28) (end 2 4.8928) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 2 4.8928) (end 2 2) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(footprint "anchor:pad"
		(layer "B.Cu")
		(at 10 10)
		(pad "1" thru_hole circle (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 1 "GND"))
	)
	(zone
		(net 1)
		(net_name "GND")
		(layer "B.Cu")
		(hatch edge 0.5)
		(connect_pads (clearance 0.2))
		(min_thickness 0.25)
		(fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
		(polygon (pts (xy 3 3) (xy 27 3) (xy 27 27) (xy 3 27)))
	)
	(embedded_fonts no)
)
