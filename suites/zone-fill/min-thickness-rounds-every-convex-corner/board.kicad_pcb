(kicad_pcb
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(general (thickness 1.6))
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(25 "Edge.Cuts" user)
		(35 "F.Fab" user)
	)
	(net 0 "")
	(net 1 "ZN")
	(gr_line (start 0 0) (end 40 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 40 0) (end 40 30) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 40 30) (end 0 30) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 0 30) (end 0 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(zone (net 1) (net_name "ZN") (layer "F.Cu") (hatch edge 0.5)
		(connect_pads (clearance 0))
		(min_thickness 0.25)
		(fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5) (island_removal_mode 0))
		(polygon
			(pts (xy 10 8) (xy 30 8) (xy 30 22) (xy 10 22))
		)
	)
	(embedded_fonts no)
)
