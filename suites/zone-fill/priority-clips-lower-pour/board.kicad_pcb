(kicad_pcb
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(general (thickness 1.6))
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(25 "Edge.Cuts" user)
		(35 "F.Fab" user)
	)
	(net 0 "")
	(net 1 "GND")
	(net 2 "VCC")
	(gr_line (start -2 -2) (end 32 -2) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 32 -2) (end 32 12) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 32 12) (end -2 12) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_line (start -2 12) (end -2 -2) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(footprint "a:g" (layer "B.Cu") (at 5 5)
		(pad "1" thru_hole circle (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 1 "GND"))
	)
	(footprint "a:v" (layer "B.Cu") (at 27 5)
		(pad "1" thru_hole circle (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 2 "VCC"))
	)
	(zone (net 1) (net_name "GND") (layer "B.Cu") (hatch edge 0.5)
		(priority 2)
		(connect_pads (clearance 0.2))
		(min_thickness 0.25)
		(fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
		(polygon (pts (xy 0 0) (xy 20 0) (xy 20 10) (xy 0 10)))
	)
	(zone (net 2) (net_name "VCC") (layer "B.Cu") (hatch edge 0.5)
		(priority 1)
		(connect_pads (clearance 0.2))
		(min_thickness 0.25)
		(fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
		(polygon (pts (xy 12 0) (xy 30 0) (xy 30 10) (xy 12 10)))
	)
	(embedded_fonts no)
)
