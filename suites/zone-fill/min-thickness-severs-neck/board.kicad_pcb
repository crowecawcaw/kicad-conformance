(kicad_pcb
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(general (thickness 1.6))
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(25 "Edge.Cuts" user)
		(35 "F.Fab" user)
	)
	(net 0 "")
	(net 1 "ZN")
	(gr_line (start 0 0) (end 80 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 80 0) (end 80 60) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 80 60) (end 0 60) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(gr_line (start 0 60) (end 0 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(zone (net 1) (net_name "ZN") (layer "F.Cu") (hatch edge 0.5)
		(connect_pads (clearance 0))
		(min_thickness 0.25)
		(fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5) (island_removal_mode 0))
		(polygon
			(pts
				(xy 12 20) (xy 32 20) (xy 32 32.4) (xy 48 32.4) (xy 48 20)
				(xy 68 20) (xy 68 45) (xy 48 45) (xy 48 32.6) (xy 32 32.6)
				(xy 32 45) (xy 12 45)
			)
		)
	)
	(embedded_fonts no)
)
