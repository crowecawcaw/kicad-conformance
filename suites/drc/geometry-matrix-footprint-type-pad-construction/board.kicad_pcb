(kicad_pcb (version 20260206) (generator "pcbnew") (generator_version "10.0") (general (thickness 1.6)) (paper "A4")
 (layers (0 "F.Cu" signal) (2 "B.Cu" signal) (25 "Edge.Cuts" user)) (setup (pad_to_mask_clearance 0))
 (footprint "T" (layer "F.Cu") (at 8 10) (property "Reference" "TYPE_SMD_VALID" (at 0 0) (layer "F.Fab") hide (effects (font (size 1 1)))) (attr smd) (pad "1" smd rect (at 0 0) (size 1.2 1.2) (layers "F.Cu" "F.Mask" "F.Paste")))
