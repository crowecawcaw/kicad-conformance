(version 1)
(rule "mask first" (constraint solder_mask_expansion (opt 0.05mm)))
(rule "mask last" (constraint solder_mask_expansion (opt 0.1mm)))
(rule "paste absolute first" (condition "A.Reference == 'ACTIVE'") (constraint solder_paste_abs_margin (opt 0.1mm)))
(rule "paste absolute last" (condition "A.Reference == 'ACTIVE'") (constraint solder_paste_abs_margin (opt 0.2mm)))
(rule "paste absolute isolated" (condition "A.Reference == 'ABS_ONLY'") (constraint solder_paste_abs_margin (opt 0.2mm)))
(rule "paste absolute reverse first" (condition "A.Reference == 'ABS_REVERSE'") (constraint solder_paste_abs_margin (opt 0.2mm)))
(rule "paste absolute reverse last" (condition "A.Reference == 'ABS_REVERSE'") (constraint solder_paste_abs_margin (opt 0.1mm)))
(rule "paste relative first" (condition "A.Reference == 'ACTIVE'") (constraint solder_paste_rel_margin (opt 0.00005mm)))
(rule "paste relative last" (condition "A.Reference == 'ACTIVE'") (constraint solder_paste_rel_margin (opt 0.0001mm)))
(rule "paste relative isolated" (condition "A.Reference == 'SQUARE'") (constraint solder_paste_rel_margin (opt 0.0001mm)))
(rule "paste relative reverse first" (condition "A.Reference == 'REL_REVERSE'") (constraint solder_paste_rel_margin (opt 0.0001mm)))
(rule "paste relative reverse last" (condition "A.Reference == 'REL_REVERSE'") (constraint solder_paste_rel_margin (opt 0.00005mm)))
