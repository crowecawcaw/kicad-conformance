        -:  168:                          typename ITEM_PTR_VECTOR::const_iterator> CONST_ITERATOR;
        -:  169:
        -:  170:
        -:  171:    MULTIVECTOR()
        -:  172:    {
        -:  173:    }
        -:  174:
        -:  175:    void push_back( T* aItem )
        -:  176:    {
        -:  177:        operator[]( aItem->Type() ).push_back( aItem );
        -:  178:    }
        -:  179:
        -:  180:    ITERATOR erase( const ITERATOR& aIterator )
        -:  181:    {
