        -:  187:    }
        -:  188:
        -:  189:    ITERATOR begin( int aType = UNDEFINED_TYPE )
        -:  190:    {
        -:  191:        int bucket = ( aType != UNDEFINED_TYPE ) ? aType : first();
        -:  192:        return ITERATOR( this, operator[]( bucket ).begin(), bucket, aType );
        -:  193:    }
        -:  194:
        -:  195:    ITERATOR end( int aType = UNDEFINED_TYPE )
