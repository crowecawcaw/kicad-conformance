        -:   83:
        -:   84:        ITERATOR_BASE& operator++()
        -:   85:        {
        -:   86:            if( m_it != (*m_parent)[ m_curType ].end() )
        -:   87:                ++m_it;
        -:   88:
        -:   89:            validate();
        -:   90:
        -:   91:            return *this;
        -:   92:        }
        -:   93:
        -:   94:        bool operator!=( const ITERATOR_BASE& aOther ) const
        -:   95:        {
        -:   96:            if( aOther.m_parent != m_parent )
        -:   97:                return true;
        -:   98:
        -:   99:            if( aOther.m_filter != m_filter )
        -:  100:                return true;
        -:  101:
        -:  102:            if( aOther.m_curType != m_curType )
        -:  103:                return true;
        -:  104:
        -:  105:            return aOther.m_it != m_it;
        -:  106:        }
        -:  107:
        -:  108:    protected:
        -:  109:        /**
        -:  110:         * @param aItems is the container to wrap.
        -:  111:         * @param aIt is the iterator to initialize this iterator (usually some begin() or end()
        -:  112:         * iterator).
        -:  113:         * @param aBucket is the type ID of the given iterator.
        -:  114:         * @param aType enables item type filtering. When aType is UNDEFINED_TYPE, there is no
        -:  115:         * filtering and all item types are accessible by the iterator.
        -:  116:         */
        -:  117:        ITERATOR_BASE( ITEM_CONTAINER* aItems, ITEM_CONTAINER_IT aIt,
        -:  118:                       int aBucket, int aType = UNDEFINED_TYPE )
