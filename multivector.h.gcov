        -:   59:    /**
        -:   60:    * Helper for defining a list of library draw object pointers.
        -:   61:    *
        -:   62:    * The Boost pointer containers are responsible for deleting object pointers placed
        -:   63:    * in them.  If you access a object pointer from the list, do not delete it directly.
        -:   64:    */
        -:   65:    typedef boost::ptr_vector<T> ITEM_PTR_VECTOR;
