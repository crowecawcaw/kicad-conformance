        -:  198:        return ITERATOR( this, operator[]( bucket ).end(), bucket, aType );
        -:  199:    }
        -:  200:
        -:  201:    CONST_ITERATOR begin( int aType = UNDEFINED_TYPE ) const
        -:  202:    {
