        -:  908:    double           m_hatchHoleMinArea;        // min size before holes are dropped (ratio)
        -:  909:    int              m_hatchBorderAlgorithm;    // 0 = use min zone thickness
        -:  910:                                                // 1 = use hatch thickness
        -:  911:    int              m_localFlgs;               // Variable used in polygon calculations.
        -:  912:
        -:  913:    /* set of filled polygons used to draw a zone as a filled area.
        -:  914:     * from outlines (m_Poly) but unlike m_Poly these filled polygons have no hole
        -:  915:     * (they are all in one piece)  In very simple cases m_FilledPolysList is same
        -:  916:     * as m_Poly.  In less simple cases (when m_Poly has holes) m_FilledPolysList is
        -:  917:     * a polygon equivalent to m_Poly, without holes but with extra outline segment
        -:  918:     * connecting "holes" with external main outline.  In complex cases an outline
        -:  919:     * described by m_Poly can have many filled areas
        -:  920:     */
        -:  921:    mutable std::mutex                                      m_filledPolysListMutex;
        -:  922:    std::map<PCB_LAYER_ID, std::shared_ptr<SHAPE_POLY_SET>> m_FilledPolysList;
        -:  923:
        -:  924:    /// Temp variables used while filling
        -:  925:    mutable std::mutex                     m_fillFlagsMutex;
        -:  926:    LSET                                   m_fillFlags;
        -:  927:
        -:  928:    /// A hash value used in zone filling calculations to see if the filled areas are up to date
        -:  929:    std::map<PCB_LAYER_ID, HASH_128>       m_filledPolysHash;
        -:  930:
        -:  931:    ZONE_BORDER_DISPLAY_STYLE m_borderStyle;       // border display style, see enum above
        -:  932:    int                       m_borderHatchPitch;  // for DIAGONAL_EDGE, distance between 2 lines
        -:  933:    std::vector<SEG>          m_borderHatchLines;  // hatch lines
        -:  934:
        -:  935:    /// For each layer, a set of insulated islands that were not removed
        -:  936:    std::map<PCB_LAYER_ID, std::set<int>> m_insulatedIslands;
        -:  937:
        -:  938:    double                    m_area;              // The filled zone area
        -:  939:    double                    m_outlinearea;       // The outline zone area
        -:  940:
        -:  941:};
