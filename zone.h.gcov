        -:   49:/**
        -:   50: * A struct recording the isolated and single-pad islands within a zone.  Each array holds
        -:   51: * indexes into the outlines of a SHAPE_POLY_SET for a zone fill on a particular layer.
        -:   52: *
        -:   53: * Isolated outlines are those whose *connectivity cluster* contains no pads.  These generate
        -:   54: * DRC violations.
        -:   55: *
        -:   56: * Single-connection outlines are those with a *direct* connection to only a single item.  These
        -:   57: * participate in thermal spoke counting as a pad spoke to an *otherwise* unconnected island
        -:   58: * provides no connectivity to the pad.
        -:   59: */
        -:   60:struct ISOLATED_ISLANDS
        -:   61:{
        -:   62:    std::vector<int> m_IsolatedOutlines;
        -:   63:    std::vector<int> m_SingleConnectionOutlines;
        -:   64:};
