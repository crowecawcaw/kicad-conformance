        -:  568:
        -:  569:
        -:  570:/**
        -:  571: * A radial dimension indicates either the radius or diameter of an arc or circle.
        -:  572: *
        -:  573: * A guide to the geometry of a circle dimension:
        -:  574: *
        -:  575: *     |
        -:  576: *   --a--
        -:  577: *     |
        -:  578: *
        -:  579: *
        -:  580: *          b_
        -:  581: *          |\
        -:  582: *            \
        -:  583: *             c---d TEXT
        -:  584: *
        -:  585: * Point a (the center of the arc or circle) is m_start, point b (a point on the arc or circle)
        -:  586: * is m_end, point c is m_leaderLength away from b on the a-b vector, and point d is the end of
        -:  587: * the "text line". The c-d line is drawn from c to the text center, and clipped on the text
        -:  588: * bounding box.
        -:  589: */
        -:  590:class PCB_DIM_RADIAL : public PCB_DIMENSION_BASE
        -:  591:{
        -:  592:public:
        -:  593:    PCB_DIM_RADIAL( BOARD_ITEM* aParent );
        -:  594:
        -:  595:    void CopyFrom( const BOARD_ITEM* aOther ) override;
        -:  596:    void Serialize( google::protobuf::Any &aContainer ) const override;
        -:  597:    bool Deserialize( const google::protobuf::Any &aContainer ) override;
        -:  598:
        -:  599:    static inline bool ClassOf( const EDA_ITEM* aItem )
        -:  600:    {
        -:  601:        return aItem && aItem->Type() == PCB_DIM_RADIAL_T;
        -:  602:    }
        -:  603:
        -:  604:    EDA_ITEM* Clone() const override;
        -:  605:
        -:  606:    void SetLeaderLength( int aLength ) { m_leaderLength = aLength; }
    #####:  607:    int GetLeaderLength() const { return m_leaderLength; }
        -:  608:
        -:  609:    void ChangeLeaderLength( int aLength )
        -:  610:    {
        -:  611:        SetLeaderLength( aLength );
        -:  612:        Update();
        -:  613:    }
        -:  614:
        -:  615:    // Returns the point (c).
        -:  616:    VECTOR2I GetKnee() const;
        -:  617:
        -:  618:    BITMAPS GetMenuImage() const override;
        -:  619:
        -:  620:    wxString GetClass() const override
        -:  621:    {
        -:  622:        return wxT( "PCB_DIM_RADIAL" );
        -:  623:    }
        -:  624:
        -:  625:protected:
        -:  626:    virtual void swapData( BOARD_ITEM* aImage ) override;
        -:  627:
        -:  628:    void updateText() override;
        -:  629:    void updateGeometry() override;
        -:  630:
        -:  631:private:
        -:  632:    int  m_leaderLength;
        -:  633:};
        -:  634:
        -:  635:
        -:  636:/**
        -:  637: * A leader is a dimension-like object pointing to a specific point.
        -:  638: *
        -:  639: * A guide to the geometry of a leader:
        -:  640: *
        -:  641: *     a_
        -:  642: *     |\
        -:  643: *       \
        -:  644: *        b---c TEXT
        -:  645: *
        -:  646: * Point (a) is m_start, point (b) is m_end, point (c) is the end of the "text line"
        -:  647: * The b-c line is drawn from b to the text center, and clipped on the text bounding box.
        -:  648: */
        -:  649:class PCB_DIM_LEADER : public PCB_DIMENSION_BASE
        -:  650:{
