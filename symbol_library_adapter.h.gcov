        -:  116:
        -:  117:    /**
        -:  118:     * Write @a aSymbol to an existing library given by @a aNickname.
        -:  119:     *
        -:  120:     * If a #LIB_SYMBOL by the same name already exists or there are any conflicting alias
        -:  121:     * names, the new #LIB_SYMBOL will silently overwrite any existing aliases and/or part
        -:  122:     * because libraries cannot have duplicate alias names.  It is the responsibility of
        -:  123:     * the caller to check the library for conflicts before saving.
        -:  124:     *
        -:  125:     * @param aNickname is a locator for the "library", it is a "name" in LIB_TABLE_ROW
        -:  126:     * @param aSymbol is what to store in the library. The library owns the symbol after this
        -:  127:     *                call.
        -:  128:     * @param aOverwrite when true means overwrite any existing symbol by the same name,
        -:  129:     *                   else if false means skip the write and return SAVE_SKIPPED.
        -:  130:     * @return SAVE_T - SAVE_OK or SAVE_SKIPPED.  If error saving, then IO_ERROR is thrown.
        -:  131:     * @throw IO_ERROR if there is a problem saving the symbol.
        -:  132:     */
        -:  133:    SAVE_T SaveSymbol( const wxString& aNickname, const LIB_SYMBOL* aSymbol,
        -:  134:                       bool aOverwrite = true );
        -:  135:
        -:  136:    /**
        -:  137:     * Deletes the @a aSymbolName from the library given by @a aNickname.
        -:  138:     *
        -:  139:     * @param aNickname is a locator for the "library", it is a "name" in LIB_TABLE_ROW.
        -:  140:     * @param aSymbolName is the name of a symbol to delete from the specified library.
        -:  141:     * @throw IO_ERROR if there is a problem finding the footprint or the library, or deleting it.
        -:  142:     */
        -:  143:    void DeleteSymbol( const wxString& aNickname, const wxString& aSymbolName );
        -:  144:
        -:  145:    /**
        -:  146:     * Return true if the library given by @a aNickname is writable.
        -:  147:     *
        -:  148:     * It is possible that some symbols libraries are read only because of where they are
        -:  149:     * installed.
        -:  150:     *
        -:  151:     * @param aNickname is the library nickname in the symbol library table.
        -:  152:     * @throw IO_ERROR if no library at @a aNickname exists.
        -:  153:     */
        -:  154:    bool IsSymbolLibWritable( const wxString& aNickname );
        -:  155:
