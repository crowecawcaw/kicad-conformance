        -:  108:    /**
        -:  109:     * The set of return values from SaveSymbol() below.
        -:  110:     */
        -:  111:    enum SAVE_T
        -:  112:    {
        -:  113:        SAVE_OK,
        -:  114:        SAVE_SKIPPED,
