        -:   92:    /**
        -:   93:     * Load a #LIB_SYMBOL having @a aName from the library given by @a aNickname.
        -:   94:     *
        -:   95:     * @param aNickname is a locator for the "library", it is a "name" in #LIB_TABLE_ROW
        -:   96:     * @param aName is the name of the #LIB_SYMBOL to load.
        -:   97:     * @return the symbol alias if found or NULL if not found.
        -:   98:     * @throw IO_ERROR if the library cannot be found or read.  No exception
        -:   99:     *                 is thrown in the case where \a aNickname cannot be found.
        -:  100:     */
        -:  101:    LIB_SYMBOL* LoadSymbol( const wxString& aNickname, const wxString& aName );
        -:  102:
    #####:  103:    LIB_SYMBOL* LoadSymbol( const LIB_ID& aLibId )
        -:  104:    {
    #####:  105:        return LoadSymbol( aLibId.GetLibNickname(), aLibId.GetLibItemName() );
        -:  106:    }
