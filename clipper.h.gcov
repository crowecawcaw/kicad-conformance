        -:  304:          else if (outsideCnt < -1) break;
        -:  305:        }
        -:  306:
        -:  307:        // now check any nested children too
        -:  308:        if (child->Count() > 0 && !PolyPath64ContainsChildren(*child))
        -:  309:          return false;
        -:  310:      }
        -:  311:      return true;
        -:  312:    }
