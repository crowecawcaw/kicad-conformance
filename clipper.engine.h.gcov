        -:  316:
    #####:  317:		unsigned Level() const
        -:  318:		{
    #####:  319:			unsigned result = 0;
    #####:  320:			const PolyPath* p = parent_;
    #####:  321:			while (p) { ++result; p = p->parent_; }
    #####:  322:			return result;
        -:  323:		}
        -:  324:
