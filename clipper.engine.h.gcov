        -:  331:
    #####:  332:		bool IsHole() const
        -:  333:		{
    #####:  334:			unsigned lvl = Level();
        -:  335:			//Even levels except level 0
    #####:  336:			return lvl && !(lvl & 1);
        -:  337:		}
        -:  338:	};
